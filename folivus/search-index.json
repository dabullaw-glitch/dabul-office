banking"],"p":"08-0000808","promo":false,"sample":true,"claimed":false}],"pages":[{"k":"מדריך","n":"חובות כבדים? חדלות פירעון ליחיד: הצעדים הראשונים","d":"מה זה הליך חדלות פירעון ליחיד לפי החוק מ-2018, מתי הוא מתאים, מהם השלבים מצו פתיחת הליכים ועד הפטר, ואילו צעדים לעשות לפני שמגישים בקשה.","h":"/dabul-office/folivus/מאמרים/חדלות-פירעון-ליחיד-צעדים-ראשונים/"},{"k":"מדריך","n":"קניתם באינטרנט והתחרטתם? זכות הביטול לפי חוק הגנת הצרכן","d":"כמה ימים יש לבטל קנייה באתר או בטלפון, כמה דמי ביטול מותר לגבות, מתי מקבלים 4 חודשים, אילו מוצרים אי אפשר להחזיר ותוך כמה זמן חייבים להחזיר את הכסף.","h":"/dabul-office/folivus/מאמרים/ביטול-עסקה-שנעשתה-באינטרנט/"},{"k":"מדריך","n":"ייפוי כוח מתמשך או אפוטרופוס: מה ההבדל ומה מתאים לכם","d":"ייפוי כוח מתמשך מאפשר לבחור מראש מי ינהל את ענייניכם אם לא תוכלו, בלי הליך בבית משפט. השוואה מלאה לאפוטרופסות: מי ממנה, מתי נכנס לתוקף, פיקוח ועלויות.","h":"/dabul-office/folivus/מאמרים/ייפוי-כוח-מתמשך-או-אפוטרופסות-מה-ההבדל/"},{"k":"מדריך","n":"נפגעתם בתאונת דרכים? שלבי התביעה לפיצוי, צעד אחר צעד","d":"מי מפצה נפגע בתאונת דרכים בישראל, את מי תובעים, מה עושים בימים הראשונים, כמה זמן יש להגיש תביעה ומה התקרה לשכר טרחת עורך דין. מדריך מעשי.","h":"/dabul-office/folivus/מאמרים/תביעת-נזקי-גוף-בתאונת-דרכים-שלב-אחר-שלב/"},{"k":"מדריך","n":"פיקדון בשכירות: כמה מותר לדרוש ומתי מחזירים, לפי החוק","d":"חוק שכירות הוגנת מגביל את גובה הערובה בשכירות ומחייב להחזיר אותה בתוך 60 יום. כך בודקים אם הסכום חוקי, מה מותר לקזז, ומה עושים כשהכסף לא חוזר.","h":"/dabul-office/folivus/מאמרים/פיקדון-בשכירות-וחוק-שכירות-הוגנת/"},{"k":"מדריך","n":"צוואה בלי עורך דין: האם היא תקפה ומה חייב להופיע בה","d":"החוק בישראל מכיר בארבע צורות של צוואה, וחלקן אפשר לעשות לבד. מה הופך צוואה בכתב יד או בעדים לתקפה, מה הטעויות שפוסלות אותה, ומתי כדאי להיעזר בעורך דין.","h":"/dabul-office/folivus/מאמרים/צוואה-בלי-עורך-דין-האם-היא-תקפה/"},{"k":"מדריך","n":"קונים דירה? מה עורך הדין בודק לפני שחותמים","d":"רשימת הבדיקות שעורך דין עושה בקניית דירה: נסח רישום, משכנתאות ועיקולים, חריגות בנייה, מיסים, מנגנון תשלום והערת אזהרה. כולל הבדלים בדירה חדשה מקבלן.","h":"/dabul-office/folivus/מאמרים/מה-עורך-דין-בודק-בקניית-דירה/"},{"k":"מדריך","n":"פוטרתם? הזכויות שלכם: שימוע, הודעה מוקדמת ופיצויים","d":"מה מגיע לעובד שמפוטר בישראל: שימוע כדין, הודעה מוקדמת לפי ותק, פיצויי פיטורים, טופס 161, הגנות מיוחדות ודמי אבטלה. מדריך מעשי נכון ל-2026.","h":"/dabul-office/folivus/מאמרים/זכויות-עובד-בפיטורים/"},{"k":"מדריך","n":"איך מגישים תביעה קטנה: מדריך שלב אחר שלב, נכון ל-2026","d":"תקרת התביעות הקטנות עלתה ל-39,900 ש\"ח מינואר 2026. כך מגישים תביעה, כמה עולה האגרה, מה קורה בדיון, ומה עושים אם הנתבע לא משלם.","h":"/dabul-office/folivus/מאמרים/איך-מגישים-תביעה-קטנה-שלב-אחר-שלב/"},{"k":"מדריך","n":"זומנתם לחקירה במשטרה? הזכויות שלכם ואיך בוחרים עורך דין","d":"מה ההבדל בין עדות לחקירה באזהרה, מתי מותר לדחות פגישה עם עורך דין, מה מגיע לקטינים, ואיך בוחרים עורך דין פלילי בזמן קצר ובלחץ.","h":"/dabul-office/folivus/מאמרים/זומנתי-לחקירה-במשטרה-איך-בוחרים-עורך-דין-פלילי/"},{"k":"מדריך","n":"שכר טרחת עורך דין בישראל: איך נקבע ומה בודקים בהסכם","d":"איך נקבע שכר טרחה של עורך דין, מה ההבדל בין שעתי, גלובלי ואחוזים, מתי יש תקרה בחוק, ומה חייב להופיע בהסכם שכר טרחה לפני שחותמים.","h":"/dabul-office/folivus/מאמרים/שכר-טרחת-עורך-דין-והסכם-שכר-טרחה/"},{"k":"מדריך","n":"כמה עולים גירושין בישראל ואיך נראה התהליך, שלב אחר שלב","d":"מדריך לגירושין בישראל: בקשה ליישוב סכסוך, בית הדין הרבני או בית המשפט לענייני משפחה, אגרות נכון ל-2026, ממה מורכבת העלות ואיך אפשר לחסוך.","h":"/dabul-office/folivus/מאמרים/כמה-עולים-גירושין-ומה-התהליך/"},{"k":"כלי","n":"מחשבון הערכת היטל השבחה","d":"הערכת היטל השבחה: מחצית מעליית שווי המקרקעין בעקבות תכנית, הקלה או שימוש חורג. כולל חלק בעלות והסבר על השגה ופטורים.","h":"/dabul-office/folivus/כלים/מחשבון-היטל-השבחה/"},{"k":"כלי","n":"מחשבון הערכת מס שבח בחישוב ליניארי מוטב","d":"הערכת מס שבח במכירת דירת מגורים: שבח ריאלי, חישוב ליניארי מוטב (פטור עד 1.1.2014 ו-25% מאז) ובדיקת תקרת הפטור לדירה יחידה.","h":"/dabul-office/folivus/כלים/מחשבון-מס-שבח/"},{"k":"כלי","n":"מחולל מכתב דרישה לקבלן בגין ליקויי בנייה","d":"מחולל מכתב הודעה על אי התאמה לקבלן לפי חוק המכר (דירות): פירוט ליקויים, חוות דעת מצורפת, בקשה לתיאום תיקון ושמירת זכויות.","h":"/dabul-office/folivus/כלים/מכתב-ליקויי-בנייה/"},{"k":"כלי","n":"מחשבון ביטול עסקה ודמי ביטול (קנייה מרחוק)","d":"מחשבון ביטול עסקת מכר מרחוק: האם אתם עדיין בזמן, כמה דמי ביטול מותר לגבות (5% או 100 ₪, הנמוך) ומתי צריך לקבל את הכסף.","h":"/dabul-office/folivus/כלים/מחשבון-ביטול-עסקה/"},{"k":"כלי","n":"מחשבון מועדים משפטיים בהליך אזרחי","d":"מחשבון מועדים בהליך אזרחי: מתי מסתיים המועד להגשת כתב הגנה, ערעור, בקשת רשות ערעור או בקשה לביטול פסק דין, כולל ימי פגרה ודחייה של מועד שחל בשבת.","h":"/dabul-office/folivus/כלים/מחשבון-מועדים-משפטיים/"},{"k":"כלי","n":"מחשבון אגרת בית משפט בתביעה כספית","d":"הערכת אגרת בית משפט לתביעה כספית לפי התעריף של 2026: כמה משלמים בהגשה וכמה בשלב השני, בבית משפט השלום, במחוזי או בתביעה קטנה.","h":"/dabul-office/folivus/כלים/מחשבון-אגרת-בית-משפט/"},{"k":"כלי","n":"מחשבון פיצוי על איחור במסירת דירה מקבלן","d":"מחשבון פיצוי סטטוטורי לפי חוק המכר (דירות) על איחור במסירת דירה חדשה, לפי דמי שכירות של דירה דומה ומועד חתימת החוזה.","h":"/dabul-office/folivus/כלים/מחשבון-פיצוי-איחור-במסירת-דירה/"},{"k":"כלי","n":"מחולל מכתב דרישה להחזרת פיקדון בשכירות","d":"מחולל מכתב דרישה למשכיר להשבת פיקדון, המחאת ביטחון, ערבות בנקאית או שטר חוב בתום השכירות, עם בקשה לפירוט כל ניכוי.","h":"/dabul-office/folivus/כלים/מכתב-החזרת-פיקדון/"},{"k":"כלי","n":"מחולל פרוטוקול מסירת דירה","d":"מחולל פרוטוקול מסירת דירה חדשה: פרטי הצדדים, קריאת מונים, מפתחות, טבלת ליקויים וסעיף שמירת זכויות של הקונה. טיוטה להדפסה.","h":"/dabul-office/folivus/כלים/פרוטוקול-מסירת-דירה/"},{"k":"כלי","n":"מחולל הסכם שכירות דירה למגורים","d":"מחולל הסכם שכירות דירה למגורים בהתאם לעקרונות חוק השכירות ההוגנת: ראויות למגורים, תיקונים, חלוקת הוצאות, ערובה והודעות.","h":"/dabul-office/folivus/כלים/הסכם-שכירות-דירה/"},{"k":"כלי","n":"מחולל מכתב הודעה על סיום שכירות","d":"מכתב מסודר שמודיע לצד השני בהסכם השכירות על סיום השכירות או על אי הארכתה, עם תאריך פינוי ובקשה להשבת הביטחונות.","h":"/dabul-office/folivus/כלים/מכתב-הודעה-על-סיום-שכירות/"},{"k":"כלי","n":"בודק התיישנות תביעה","d":"בודק התיישנות: הזינו סוג תביעה ותאריך האירוע וקבלו הערכה מתי התביעה מתיישנת, כולל גילוי מאוחר ותובע שהיה קטין.","h":"/dabul-office/folivus/כלים/בודק-התיישנות/"},{"k":"כלי","n":"מחשבון החזר חודשי במשכנתא (לוח שפיצר)","d":"מחשבון משכנתא בלוח שפיצר: החזר חודשי קבוע, סך הריבית וסך התשלומים לפי סכום ההלוואה, הריבית השנתית ומספר השנים.","h":"/dabul-office/folivus/כלים/מחשבון-משכנתא-שפיצר/"},{"k":"כלי","n":"מחשבון הודעה מוקדמת לפיטורים ולהתפטרות","d":"כמה ימי הודעה מוקדמת מגיעים לכם? מחשבון לפי חוק הודעה מוקדמת, לעובד חודשי ולעובד שעתי, כולל מועד סיום ותמורת הודעה. 2026.","h":"/dabul-office/folivus/כלים/מחשבון-הודעה-מוקדמת/"},{"k":"כלי","n":"מחשבון שעות נוספות","d":"מחשבון שעות נוספות 2026: חשבו גמול 125% ו-150% לפי שבוע עבודה של 42 שעות, לעובד שעתי או חודשי, כולל עבודה ביום המנוחה.","h":"/dabul-office/folivus/כלים/מחשבון-שעות-נוספות/"},{"k":"כלי","n":"מחשבון מס רכישה לדירה 2026","d":"מחשבון מס רכישה 2026: חישוב מדרגות לדירה יחידה, לדירה חלופית ולדירה נוספת, עם פירוט כל מדרגה ושיעור המס האפקטיבי.","h":"/dabul-office/folivus/כלים/מחשבון-מס-רכישה/"},{"k":"כלי","n":"מחשבון דמי הבראה 2026","d":"מחשבון דמי הבראה 2026: ערך יום הבראה 451.50 ₪ במגזר הפרטי. חשבו כמה ימים וכמה כסף מגיעים לפי ותק והיקף משרה.","h":"/dabul-office/folivus/כלים/מחשבון-דמי-הבראה/"},{"k":"כלי","n":"מחולל כתב ערבות לשכירות דירה","d":"מחולל כתב ערבות לשכירות דירה עם תקרת סכום, פירוט החיובים שהערבות מכסה, הודעה לערב לפני דרישה ותוקף מוגדר.","h":"/dabul-office/folivus/כלים/כתב-ערבות-לשכירות/"},{"k":"כלי","n":"מחשבון הצמדת שכר דירה למדד","d":"מחשבון הצמדת שכר דירה למדד המחירים לצרכן: מזינים שכר בסיס, מדד בסיס ומדד חדש ומקבלים את השכר המעודכן וההפרש החודשי.","h":"/dabul-office/folivus/כלים/מחשבון-הצמדת-שכר-דירה/"},{"k":"כלי","n":"מחשבון פיצויי פיטורים","d":"מחשבון פיצויי פיטורים 2026: הזינו תאריכי עבודה ושכר אחרון, וקבלו הערכה של הפיצויים, ההשלמה מהמעסיק ותקרת הפטור ממס.","h":"/dabul-office/folivus/כלים/מחשבון-פיצויי-פיטורים/"},{"k":"כלי","n":"מחשבון דמי מחלה","d":"מחשבון דמי מחלה 2026: כמה ימי מחלה צברתם וכמה תקבלו על היעדרות. יום ראשון ללא תשלום, ימים 2 ו-3 ב-50%, ומהרביעי 100%.","h":"/dabul-office/folivus/כלים/מחשבון-דמי-מחלה/"},{"k":"כלי","n":"מחולל טיוטת כתב תביעה קטנה","d":"מחולל כתב תביעה קטנה: מלאו את פרטי הצדדים, העובדות והסכום, וקבלו טיוטה מסודרת להגשה לבית המשפט לתביעות קטנות, עם רשימת בדיקה.","h":"/dabul-office/folivus/כלים/מחולל-כתב-תביעה-קטנה/"},{"k":"כלי","n":"מחשבון חלוקת ירושה על פי דין","d":"מחשבון ירושה על פי דין: מי יורש כשאין צוואה ובאיזה חלק? בן זוג, ילדים, הורים ואחים לפי חוק הירושה. מותאם ל-2026.","h":"/dabul-office/folivus/כלים/מחשבון-ירושה-על-פי-דין/"},{"k":"כלי","n":"מחשבון ימי חופשה שנתית ופדיון חופשה","d":"מחשבון ימי חופשה ופדיון חופשה 2026: כמה ימים מגיעים לפי ותק ושבוע עבודה, וכמה כסף מגיע על ימים שלא נוצלו בסיום העבודה.","h":"/dabul-office/folivus/כלים/מחשבון-ימי-חופשה-ופדיון/"},{"k":"כלי","n":"מחולל טיוטת צוואה בעדים","d":"מחולל טיוטת צוואה בעדים: מלאו פרטים וקבלו נוסח מסודר עם אישור עדים ודרישות החוק. כולל הסבר מה פוסל צוואה ומתי לפנות לעורך דין.","h":"/dabul-office/folivus/כלים/מחולל-צוואה-בעדים/"},{"k":"בית משפט","n":"בית הדין האזורי לעבודה בבאר שבע","d":"","h":"/dabul-office/folivus/בתי-משפט/בית-הדין-האזורי-לעבודה-באר-שבע/"},{"k":"בית משפט","n":"בית הדין האזורי לעבודה בחיפה","d":"","h":"/dabul-office/folivus/בתי-משפט/בית-הדין-האזורי-לעבודה-חיפה/"},{"k":"בית משפט","n":"בית הדין האזורי לעבודה בירושלים","d":"","h":"/dabul-office/folivus/בתי-משפט/בית-הדין-האזורי-לעבודה-ירושלים/"},{"k":"בית משפט","n":"בית הדין האזורי לעבודה בנוף הגליל-נצרת","d":"","h":"/dabul-office/folivus/בתי-משפט/בית-הדין-האזורי-לעבודה-נוף-הגליל-נצרת/"},{"k":"בית משפט","n":"בית הדין האזורי לעבודה בתל אביב-יפו","d":"","h":"/dabul-office/folivus/בתי-משפט/בית-הדין-האזורי-לעבודה-תל-אביב/"},{"k":"בית משפט","n":"בית הדין הארצי לעבודה","d":"","h":"/dabul-office/folivus/בתי-משפט/בית-הדין-הארצי-לעבודה/"},{"k":"בית משפט","n":"ב