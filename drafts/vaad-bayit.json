article .lvbl-faq-q::-webkit-details-marker{display:none;}.lvbl-article .lvbl-faq-num{display:inline-flex;align-items:center;justify-content:center;width:1.85rem;height:1.85rem;border-radius:50%;background:var(--lvbl-accent-soft);color:var(--lvbl-accent);font-size:.9rem;font-weight:800;flex-shrink:0;border:1px solid var(--lvbl-accent-chip-border);}.lvbl-article .lvbl-faq-qt{flex:1;}.lvbl-article .lvbl-faq-a{padding:1.1rem 1.25rem 1.35rem;font-size:1.1rem;line-height:1.85;color:var(--lvbl-fg);border-top:1px dashed var(--lvbl-border);}.lvbl-article .lvbl-faq-a p{margin:.6rem 0;}.lvbl-article .lvbl-glossary{margin:1rem 0 1.5rem;padding:1.2em 1.4em;background:var(--lvbl-accent-softer);border-radius:.625rem;border:1px solid var(--lvbl-accent-chip-border);}.lvbl-article .lvbl-glossary dl{margin:0;}.lvbl-article .lvbl-glossary dt{font-weight:700;color:var(--lvbl-ink);margin-top:.8em;}.lvbl-article .lvbl-glossary dd{margin:.2em 0 0;padding-inline-start:0;color:var(--lvbl-fg);line-height:1.7;}.lvbl-article ol.lvbl-refs{list-style-type:none !important;padding-inline-start:0;margin-inline-start:0;}.lvbl-article .lvbl-refs li{margin:.5rem 0;line-height:1.7;list-style:none;}.lvbl-article .lvbl-refs li::marker{content:\"\";}@media (max-width:640px){.lvbl-article{font-size:1rem;}.lvbl-article h1{font-size:1.6rem;}.lvbl-article .lvbl-h2,.lvbl-article .lvbl-h2-lead{font-size:1.35rem;padding-inline-start:.625rem;}.lvbl-article .lvbl-h2-lead{padding:.75rem .875rem;}.lvbl-article .lvbl-h3{font-size:1.2rem;}.lvbl-article th,.lvbl-article td{padding:.65rem .75rem;font-size:.95rem;}.lvbl-article .lvbl-p-lead,.lvbl-article .lvbl-ul-check{padding:.875rem 1rem;}.lvbl-article .lvbl-faq-q{padding:.875rem 1rem;font-size:1.05rem;}.lvbl-article .lvbl-faq-a{padding:.875rem 1rem 1rem;font-size:1rem;}}.lvbl-article th, .lvbl-article td { min-width: 140px !important; overflow-wrap: break-word !important; }</style><style>.vb{--gold:#a8873f;--gold2:#8a6d2c;--gold3:#e4d19c;--ink:#1c1b19;--mut:#5f5a50;--line:#e4ded0;--soft:#f3ead3;color:var(--ink);margin:22px 0;font-size:16px;line-height:1.7} .vb *{box-sizing:border-box} .vb .chips{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px} .vb .chips div{background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px 12px;font-size:14px;line-height:1.45} .vb .chips b{display:block;font-size:17px} .vb .cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px} .vb .card{background:#fff;border:1.5px solid var(--line);border-radius:18px;padding:16px;display:grid;grid-template-columns:46px minmax(0,1fr);gap:12px;align-items:start} .vb .ic{width:46px;height:46px;border-radius:14px;background:var(--ink);color:var(--gold3);display:grid;place-items:center} .vb .ic svg{width:24px;height:24px;display:block} .vb h3{font-size:18px;margin:0 0 4px;line-height:1.35;color:var(--ink)} .vb p{margin:0;color:var(--mut);font-size:15px;line-height:1.6} .vb p a{color:var(--gold2);font-weight:700} @media (max-width:720px){.vb .chips{grid-template-columns:repeat(2,minmax(0,1fr))} .vb .cards{grid-template-columns:minmax(0,1fr)}}</style><div class=\"lvbl-article\" data-audience=\"adults_30_60\" data-font-scale=\"lg\"><p class=\"lvbl-p lvbl-p-lead\">עורך דין לוועד בית מלווה את נציגות הבית המשותף בצד המשפטי של ניהול הבניין: גבייה מדיירים שלא משלמים, אסיפות והחלטות שעומדות במבחן, תקנון, חוזים עם ספקים וסכסוכים על הרכוש המשותף. רוב הסכסוכים בין בעלי הדירות מתבררים אצל המפקח על רישום המקרקעין, שיש לו סמכות של שופט בית משפט השלום. <sup class=\"citation-ref\"><a href=\"#ref-2\">[2]</a></sup> בדף הזה תמצאו במה עורך דין יכול לעזור לוועד, איך נראה הליך גבייה ומה כדאי להכין לפני שפונים.</p>\n<h2 id=\"עיקרי-הדברים\" class=\"lvbl-h2 lvbl-h2-lead\">עיקרי הדברים</h2>\n<ul class=\"lvbl-ul lvbl-ul-check\"><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">כל בעל דירה חייב להשתתף בהוצאות ההחזקה והניהול של הרכוש המשותף, לפי שטח הדירה, אלא אם התקנון קובע אחרת. <sup class=\"citation-ref\"><a href=\"#ref-1\">[1]</a></sup></span></li><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">הנציגות או בעלי הדירות יכולים להגיש תביעה למפקח על רישום המקרקעין, שיש לו סמכות של שופט שלום. <sup class=\"citation-ref\"><a href=\"#ref-2\">[2]</a></sup> <sup class=\"citation-ref\"><a href=\"#ref-3\">[3]</a></sup></span></li><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">שינוי של תקנון מוסכם דורש החלטה של בעלי דירות ששני שלישים מהרכוש המשותף צמודים לדירות שלהם. <sup class=\"citation-ref\"><a href=\"#ref-3\">[3]</a></sup></span></li><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">עורך דין לוועד בית הוא לא חברת ניהול: הוא מטפל בצד המשפטי, וחברת הניהול בתפעול היומיומי.</span></li><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">לפני תביעה שולחים בדרך כלל מכתב התראה, ולעיתים הוא מספיק כדי לסגור את החוב.</span></li></ul>\n<div class=\"vb\" dir=\"rtl\"><div class=\"chips\"><div><b>סעיף 58</b>חובת ההשתתפות בהוצאות</div><div><b>סעיף 74</b>למפקח סמכות של שופט שלום</div><div><b>2/3</b>מהרכוש המשותף לשינוי תקנון</div><div><b>תקנון מצוי</b>חל כשאין תקנון מוסכם</div></div></div>\n<p class=\"lvbl-p\"><strong>נעים להכיר: אני עו&quot;ד יקיר דבול, עורך דין מקרקעין. אני מלווה ועדי בתים ונציגויות בגבייה, באסיפות ובסכסוכים בבניין, ומתמנה על ידי בית המשפט בתיקי רישום בתים משותפים.</strong></p>\n<h2 id=\"במה-עוזר-עורך-דין-לוועד-בית\" class=\"lvbl-h2\">במה עורך דין לוועד בית עוזר?</h2>\n<div class=\"vb\" dir=\"rtl\"><div class=\"cards\"><div class=\"card\"><span class=\"ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3z\"/><path d=\"M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6\"/><path d=\"M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6\"/></svg></span><div><h3>גביית חובות ועד בית</h3><p>מכתב התראה, תביעה למפקח וגבייה בהוצאה לפועל מול <a href=\"https://dabullaw.co.il/neighbor-refuses-house-committee-dues-guide/\">דייר שמסרב לשלם ועד בית</a>.</p></div></div><div class=\"card\"><span class=\"ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"10\" rx=\"2\"/><path d=\"M9 10V5h6v5\"/><path d=\"m10 7 1.5 1.5L14 6\"/></svg></span><div><h3>אסיפות והחלטות</h3><p>זימון, מניין, הצבעה ופרוטוקול, כדי שההחלטה תעמוד גם אם מישהו יערער עליה. הרחבה ב<a href=\"https://dabullaw.co.il/house-committee-election-guide/\">בחירת ועד בית באסיפה כללית</a>.</p></div></div><div class=\"card\"><span class=\"ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z\"/><path d=\"M5 17a3 3 0 0 1 3-3h11\"/><path d=\"M9 8h6\"/></svg></span><div><h3>תקנון מוסכם</h3><p>ניסוח או תיקון של <a href=\"https://dabullaw.co.il/%d7%aa%d7%a9%d7%a8%d7%99%d7%98-%d7%95%d7%aa%d7%a7%d7%a0%d7%95%d7%9f-%d7%91%d7%99%d7%aa-%d7%9e%d7%a9%d7%95%d7%aa%d7%a3-2/\">תקנון לבית המשותף</a>: חלוקת ההוצאות, שימוש ברכוש המשותף, חניות ומחסנים.</p></div></div><div class=\"card\"><span class=\"ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11 12 4l9 7\"/><path d=\"M5 10v10h14V10\"/><path d=\"M10 20v-5h4v5\"/></svg></span><div><h3>סכסוכים על הרכוש המשותף</h3><p>השתלטות על גג, מחסן או לובי, בנייה בלי הסכמה ונזילות בין דירות.</p></div></div><div class=\"card\"><span class=\"ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 4l6 6-10 10H4v-6z\"/><path d=\"M12 6l6 6\"/></svg></span><div><h3>חוזים עם ספקים</h3><p>בדיקת הסכמים עם חברת ניהול, ניקיון, מעליות או שיפוץ, לפני שהוועד חותם.</p></div></div><div class=\"card\"><span class=\"ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5h16v11H9l-5 4z\"/><path d=\"M8 9h8M8 12h5\"/></svg></span><div><h3>ייעוץ שוטף לנציגות</h3><p>תשובה משפטית כשהוועד צריך להחליט: עבודות בבניין, דייר שמשפץ, עמדת טעינה לרכב חשמלי או אישור היעדר חובות למוכר.</p></div></div></div></div>\n<h2 id=\"דייר-לא-משלם-ועד-בית\" class=\"lvbl-h2\">דייר לא משלם ועד בית: כך נראה הטיפול</h2>\n<p class=\"lvbl-p\">ועד בית שלא מצליח לגבות מכמה דיירים נשאר בלי כסף לניקיון, לחשמל ולתיקונים. החוק נותן לנציגות דרך מסודרת לגבות, צעד אחרי צעד:</p>\n<ol class=\"lvbl-ol\"><li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">1</span><span class=\"lvbl-li-body\"><strong>מרכזים את המסמכים:</strong> התקנון, החלטות האסיפה על גובה התשלום, פירוט החוב לפי חודשים והקבלות של מי ששילם.</span></li><li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">2</span><span class=\"lvbl-li-body\"><strong>בודקים את החישוב:</strong> שחלוקת ההוצאות תואמת את התקנון של הבניין, ואם אין תקנון מוסכם, את התקנון המצוי שבחוק. <sup class=\"citation-ref\"><a href=\"#ref-1\">[1]</a></sup></span></li><li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">3</span><span class=\"lvbl-li-body\"><strong>שולחים מכתב התראה:</strong> מכתב מעורך דין עם הסכום, הפירוט ומועד לתשלום. לא פעם המכתב מספיק כדי שהחוב ישולם.</span></li><li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">4</span><span class=\"lvbl-li-body\"><strong>מגישים תביעה:</strong> אם החוב לא שולם, הנציגות מגישה תביעה ל<a href=\"https://dabullaw.co.il/%d7%a1%d7%9b%d7%a1%d7%95%d7%9b%d7%99-%d7%a9%d7%9b%d7%a0%d7%99%d7%9d-%d7%95%d7%91%d7%99%d7%aa-%d7%9e%d7%a9%d7%95%d7%aa%d7%a3-%d7%9e%d7%a4%d7%a7%d7%97-%d7%a8%d7%9b%d7%95%d7%a9-%d7%9e%d7%a9%d7%95%d7%aa/\">מפקח על רישום המקרקעין</a>, שיש לו סמכות של שופט בית משפט השלום. <sup class=\"citation-ref\"><a href=\"#ref-2\">[2]</a></sup></span></li><li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">5</span><span class=\"lvbl-li-body\"><strong>גובים בפועל:</strong> אם גם אחרי ההחלטה הדייר לא משלם, פותחים תיק בהוצאה לפועל על סמך ההחלטה.</span></li></ol>\n<div style=\"background-color: #f5edda; border: 1px solid #d9c08a; border-right: 4px solid #a8873f; border-radius: 10px; padding: 14px 20px; margin: 24px 0; color: #5c4528; line-height: 1.8;\"><strong>טיפ מעשי:</strong> רשמו פרוטוקול בכל אסיפה ושמרו את ההחלטות על גובה התשלום החודשי. בתביעת גבייה, המסמכים האלה הם הבסיס להוכחת החוב.</div>\n<div style=\"background-color: #f5edda; border: 1px solid #d9c08a; border-right: 4px solid #a8873f; border-radius: 10px; padding: 14px 20px; margin: 24px 0; color: #5c4528; line-height: 1.8;\"><strong>שימו לב:</strong> אסור לנתק לדייר שלא משלם מים או חשמל, או למנוע ממנו להשתמש במעלית. צעד כזה חושף את הוועד לתביעה. פועלים רק בדרך החוקית: התראה, תביעה וגבייה.</div>\n<h2 id=\"מתי-כדאי-לפנות\" class=\"lvbl-h2\">בדקו: מתי כדאי לפנות לעורך דין?</h2>\n<p class=\"lvbl-p\">אם אחד המצבים האלה מוכר לכם מהבניין, כדאי לבדוק את המצב המשפטי לפני שהבעיה גדלה:</p>\n<ul class=\"lvbl-ul lvbl-ul-check\"><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">דייר לא משלם כבר כמה חודשים, והפניות של הוועד לא עזרו.</span></li><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">דייר בונה, סוגר או משתמש בשטח משותף בלי הסכמה של השכנים.</span></li><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">הבניין רוצה לשנות את חלוקת ההוצאות או לנסח תקנון מוסכם.</span></li><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">הוועד עומד לחתום על חוזה גדול: חברת ניהול, שיפוץ או מעליות.</span></li><li class=\"lvbl-li\"><span class=\"lvbl-check\" aria-hidden=\"true\">✓</span><span class=\"lvbl-li-body\">יש מחלוקת אם אסיפה או החלטה התקבלו כדין.</span></li></ul>\n<h2 id=\"ההבדל-מחברת-ניהול\" class=\"lvbl-h2\">עורך דין לוועד בית או חברת ניהול: מה ההבדל?</h2>\n<div class=\"lvbl-table-wrap\"><table><thead><tr><th>נושא</th><th>חברת ניהול</th><th>עורך דין לוועד בית</th></tr></thead><tbody><tr><td><strong>התפקיד</strong></td><td>ניקיון, תחזוקה, תיאום ספקים וגבייה שוטפת</td><td>ייעוץ משפטי, החלטות, תקנון, מכתבי התראה ותביעות</td></tr><tr><td><strong>דייר שלא משלם</strong></td><td>תזכורות ודרישות תשלום</td><td>מכתב התראה, תביעה למפקח וגבייה בהוצאה לפועל</td></tr><tr><td><strong>חוזים</strong></td><td>עובדת לפי החוזה שנחתם</td><td>בודק ומנסח את החוזה לפני החתימה</td></tr><tr><td><strong>סכסוכים בבניין</strong></td><td>לא מטפלת בהם</td><td>ייצוג אצל המפקח על רישום המקרקעין ובבית המשפט</td></tr></tbody></table></div>\n<p class=\"lvbl-p\">אנחנו לא חברת ניהול. בבניינים רבים חברת הניהול ועורך הדין עובדים יחד: החברה מתפעלת את הבניין, ועורך הדין נכנס כשצריך החלטה משפטית או הליך.</p>\n<h2 id=\"ועד-בית-או-נציגות-בהתחדשות\" class=\"lvbl-h2\">ועד בית רגיל או נציגות בהתחדשות עירונית?</h2>\n<p class=\"lvbl-p\">הדף הזה עוסק בניהול השוטף של בית משותף. בפרויקט תמ&quot;א 38 או פינוי בינוי הדיירים בוחרים לפעמים נציגות לפרויקט, עם תפקיד אחר: משא ומתן מול היזם ובחירת עורך דין לדיירים. על כך בהרחבה ב<a href=\"https://dabullaw.co.il/%d7%a0%d7%a6%d7%99%d7%92%d7%95%d7%aa-%d7%93%d7%99%d7%99%d7%a8%d7%99%d7%9d-%d7%91%d7%9e%d7%aa%d7%97%d7%9d-%d7%94%d7%aa%d7%97%d7%93%d7%a9%d7%95%d7%aa-%d7%a2%d7%99%d7%a8%d7%95%d7%a0%d7%99%d7%aa-2/\">נציגות דיירים במתחם התחדשות עירונית</a>.</p>\n<h2 id=\"איך-מתנהל-הליווי\" class=\"lvbl-h2\">איך מתנהל הליווי?</h2>\n<ol class=\"lvbl-ol\"><li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">1</span><span class=\"lvbl-li-body\"><strong>שיחה ראשונה:</strong> מספרים מה קורה בבניין ומה הוועד רוצה להשיג.</span></li><li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">2</span><span class=\"lvbl-li-body\"><strong>בדיקת מסמכים:</strong> תקנון, פרוטוקולים, פירוט חובות וחוזים קיימים.</span></li><li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">3</span><span class=\"lvbl-li-body\"><strong>הצעת שכר טרחה בכתב:</strong> לייעוץ שוטף או לטיפול בתיק מסוים, לפי היקף העבודה.</span></li><li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">4</span><span class=\"lvbl-li-body\"><strong>טיפול ועדכונים:</strong> מכתבים, תביעה או ליווי של אסיפה, עם עדכון לוועד בכל שלב.</span></li></ol>\n<h2 id=\"מה-הצעד-הבא\" class=\"lvbl-h2\">מה הצעד הבא שלכם?</h2>\n<p class=\"lvbl-p\">ועד בית עובד בהתנדבות, ולרוב מגלה את הצד המשפטי רק כשיש בעיה: דייר שלא משלם, שכן שבונה על הגג או אסיפה שמישהו טוען שלא התקיימה כדין. בדיקה מוקדמת של התקנון, ההחלטות והחוזים חוסכת בדרך כלל זמן, כסף ומתח בין השכנים.</p>\n<p class=\"lvbl-p\">משרד עו&quot;ד יקיר דבול מלווה ועדי בתים ונציגויות בבתים משותפים: גבייה, אסיפות, תקנון, חוזים וסכסוכים על הרכוש המשותף.</p>\n<p class=\"lvbl-p\">אין באמור משום ייעוץ משפטי. המידע כללי, נכון למועד הפרסום וכפוף לנסיבות פרטניות ולשינויי חקיקה ופסיקה. בכל שאלה ספציפית מומלץ להיוועץ בעורך דין. התוכן נבדק מול המקורות המופיעים ברשימת המקורות בסוף הדף, בליווי מקצועי של עו&quot;ד יקיר דבול.</p>\n<div style=\"background-color: #d9c08a; border: 1px solid #c9a961; border-radius: 14px; padding: 28px 32px; margin: 40px 0; text-align: center;\"><div style=\"color: #5c4528; font-size: 22px; font-weight: 800; margin: 0 0 10px; line-height: 1.35;\">הוועד צריך תשובה משפטית?</div><div style=\"color: #6b5530; font-size: 17px; line-height: 1.7; margin: 0;\">לגבייה מדייר שלא משלם, אסיפה, תקנון או סכסוך על הרכוש המשותף, <a style=\"color: #5c4528; font-weight: 800; text-decoration: underline;\" href=\"https://dabullaw.co.il/%d7%a6%d7%a8%d7%95-%d7%a7%d7%a9%d7%a8/\">צרו קשר</a> עם משרד עו&quot;ד יקיר דבול, או התקשרו 09-8613413.</div></div>\n<h2 id=\"faq\" class=\"lvbl-h2\">שאלות ותשובות</h2>\n<div class=\"lvbl-faq\"><details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">1</span><span class=\"lvbl-faq-qt\">האם ועד הבית יכול לתבוע דייר שלא משלם?</span></summary><div class=\"lvbl-faq-a\"><p class=\"lvbl-p\">כן. הנציגות, וגם בעל דירה, יכולים להגיש תביעה למפקח על רישום המקרקעין בסכסוך על תשלומי ועד בית. <sup class=\"citation-ref\"><a href=\"#ref-3\">[3]</a></sup> לפני התביעה שולחים בדרך כלל מכתב התראה. אם אחרי ההחלטה החוב עדיין לא שולם, פותחים תיק בהוצאה לפועל.</p></div></details><details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">2</span><span class=\"lvbl-faq-qt\">דייר בקומת הקרקע טוען שהוא לא משתמש במעלית. הוא פטור מתשלום?</span></summary><div class=\"lvbl-faq-a\"><p class=\"lvbl-p\">בדרך כלל לא. החובה להשתתף בהוצאות של הרכוש המשותף חלה על כל בעל דירה, לפי היחס בין שטח הדירה שלו לשטח כל הדירות, אלא אם התקנון קובע חלוקה אחרת. <sup class=\"citation-ref\"><a href=\"#ref-1\">[1]</a></sup> גם טענות על איכות הניקיון או התחזוקה לא מצדיקות הפסקת תשלום.</p></div></details><details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">3</span><span class=\"lvbl-faq-qt\">מי משלם ועד בית בדירה מושכרת?</span></summary><div class=\"lvbl-faq-a\"><p class=\"lvbl-p\">מול הנציגות, החובה לפי החוק היא של בעל הדירה. <sup class=\"citation-ref\"><a href=\"#ref-1\">[1]</a></sup> בחוזה השכירות אפשר לקבוע שהשוכר ישלם את התשלום השוטף, אבל אם הוא לא משלם, הוועד יכול לדרוש את החוב מבעל הדירה.</p></div></details><details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">4</span><span class=\"lvbl-faq-qt\">האם הוועד יכול לשנות לבד את התקנון?</span></summary><div class=\"lvbl-faq-a\"><p class=\"lvbl-p\">לא. שינוי של תקנון מוסכם דורש החלטה של בעלי דירות ששני שלישים מהרכוש המשותף צמודים לדירות שלהם. <sup class=\"citation-ref\"><a href=\"#ref-3\">[3]</a></sup> בחלק מהנושאים, למשל הצמדה של חלק מהרכוש המשותף לדירה מסוימת, נדרשת הסכמה רחבה יותר.</p></div></details><details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">5</span><span class=\"lvbl-faq-qt\">האם צריך עורך דין כדי להגיש תביעה למפקח?</span></summary><div class=\"lvbl-faq-a\"><p class=\"lvbl-p\">לא חובה. אפשר להגיש תביעה גם בלי עורך דין. עורך דין עוזר להכין את התביעה, לחשב את החוב לפי התקנון ולצרף את המסמכים הנכונים, כדי שהתיק לא יתעכב.</p></div></details></div>\n<h2 id=\"sources\" class=\"lvbl-h2\">מקורות שצוטטו בדף (3)</h2>\n<ol class=\"lvbl-refs article-sources lvbl-ol\"><li id=\"ref-1\" class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">1</span><span class=\"lvbl-li-body\"><strong>[1]</strong> <a href=\"https://he.wikisource.org/wiki/%D7%97%D7%95%D7%A7_%D7%94%D7%9E%D7%A7%D7%A8%D7%A7%D7%A2%D7%99%D7%9F\" target=\"_blank\" rel=\"noopener noreferrer\">חוק המקרקעין, התשכ\"ט-1969, פרק ו׳: בתים משותפים</a>, <em>ויקיטקסט</em></span></li><li id=\"ref-2\" class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">2</span><span class=\"lvbl-li-body\"><strong>[2]</strong> <a href=\"https://www.gov.il/he/service/condominiums-supervisor-claims\" target=\"_blank\" rel=\"noopener noreferrer\">הגשת תביעות וניהול הליכים בפני המפקח על רישום המקרקעין (בתים משותפים)</a>, <em>אתר השירותים הממשלתי gov.il</em></span></li><li id=\"ref-3\" class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">3</span><span class=\"lvbl-li-body\"><strong>[3]</strong> <a href=\"https://www.kolzchut.org.il/he/%D7%AA%D7%A7%D7%A0%D7%95%D7%9F_%D7%91%D7%99%D7%AA_%D7%9E%D7%A9%D7%95%D7%AA%D7%A3\" target=\"_blank\" rel=\"noopener noreferrer\">תקנון בית משותף</a>, <em>כל זכות</em></span></li></ol>\n<h2 id=\"glossary\" class=\"lvbl-h2\">מילון מושגים</h2>\n<div class=\"lvbl-glossary\"><dl><dt>נציגות הבית המשותף</dt><dd>הגוף שבעלי הדירות בוחרים כדי לנהל את הבית המשותף ולייצג אותם בענייני הבניין. בשפה היומיומית: ועד הבית.</dd><dt>רכוש משותף</dt><dd>כל חלקי הבית המשותף חוץ מהדירות עצמן, כמו חדר המדרגות, הגג, המעלית והמקלט, אלא אם הוצמדו לדירה מסוימת.</dd><dt>תקנון מצוי</dt><dd>התקנון שבחוק המקרקעין, שחל על בניין שאין לו תקנון מוסכם.</dd><dt>תקנון מוסכם</dt><dd>תקנון שבעלי הדירות ניסחו בעצמם ורשמו בלשכת רישום המקרקעין, במקום התקנון המצוי.</dd><dt>המפקח על רישום המקרקעין</dt><dd>ערכאה שיפוטית שמכריעה בסכסוכים בין בעלי דירות בבית משותף, בסמכות של שופט בית משפט השלום.</dd></dl></div></div><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"WebPage\", \"@id\": \"https://dabullaw.co.il/%d7%a2%d7%95%d7%a8%d7%9a-%d7%93%d7%99%d7%9f-%d7%9c%d7%95%d7%95%d7%a2%d7%93-%d7%91%d7%99%d7%aa/#webpage\", \"url\": \"https://dabullaw.co.il/%d7%a2%d7%95%d7%a8%d7%9a-%d7%93%d7%99%d7%9f-%d7%9c%d7%95%d7%95%d7%a2%d7%93-%d7%91%d7%99%d7%aa/\", \"name\": \"עורך דין לוועד בית ולנציגות בית משותף\", \"description\": \"ליווי משפטי לוועד בית ולנציגות: גבייה מדייר שלא משלם, תביעה למפקח על רישום המקרקעין, אסיפות ופרוטוקולים, תקנון מוסכם וחוזים עם ספקים.\", \"inLanguage\": \"he-IL\"}, {\"@type\": \"Service\", \"@id\": \"https://dabullaw.co.il/%d7%a2%d7%95%d7%a8%d7%9a-%d7%93%d7%99%d7%9f-%d7%9c%d7%95%d7%95%d7%a2%d7%93-%d7%91%d7%99%d7%aa/#service\", \"name\": \"עורך דין לוועד בית ולנציגות בית משותף\", \"serviceType\": \"ליווי משפטי לוועדי בתים ולנציגויות בבתים משותפים\", \"url\": \"https://dabullaw.co.il/%d7%a2%d7%95%d7%a8%d7%9a-%d7%93%d7%99%d7%9f-%d7%9c%d7%95%d7%95%d7%a2%d7%93-%d7%91%d7%99%d7%aa/\", \"areaServed\": {\"@type\": \"AdministrativeArea\", \"name\": \"השרון\"}, \"provider\": {\"@type\": \"LegalService\", \"name\": \"יקיר דבול - משרד עורכי דין\", \"url\": \"https://dabullaw.co.il/\", \"telephone\": \"+972-9-8613413\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"רזיאל 1\", \"addressLocality\": \"נתניה\", \"addressCountry\": \"IL\"}}}, {\"@type\": \"HowTo\", \"@id\": \"https://dabullaw.co.il/%d7%a2%d7%95%d7%a8%d7%9a-%d7%93%d7%99%d7%9f-%d7%9c%d7%95%d7%95%d7%a2%d7%93-%d7%91%d7%99%d7%aa/#howto\", \"name\": \"דייר לא משלם ועד בית: כך נראה הטיפול\", \"inLanguage\": \"he-IL\", \"step\": [{\"@type\": \"HowToStep\", \"position\": 1, \"name\": \"מרכזים את המסמכים\", \"text\": \"התקנון, החלטות האסיפה על גובה התשלום, פירוט החוב לפי חודשים והקבלות של מי ששילם.\"}, {\"@type\": \"HowToStep\", \"position\": 2, \"name\": \"בודקים את החישוב\", \"text\": \"שחלוקת ההוצאות תואמת את התקנון של הבניין, ואם אין תקנון מוסכם, את התקנון המצוי שבחוק.\"}, {\"@type\": \"HowToStep\", \"position\": 3, \"name\": \"שולחים מכתב התראה\", \"text\": \"מכתב מעורך דין עם הסכום, הפירוט ומועד לתשלום. לא פעם המכתב מספיק כדי שהחוב ישולם.\"}, {\"@type\": \"HowToStep\", \"position\": 4, \"name\": \"מגישים תביעה\", \"text\": \"אם החוב לא שולם, הנציגות מגישה תביעה למפקח על רישום המקרקעין, שיש לו סמכות של שופט בית משפט השלום.\"}, {\"@type\": \"HowToStep\", \"position\": 5, \"name\": \"גובים בפועל\", \"text\": \"אם גם אחרי ההחלטה הדייר לא משלם, פותחים תיק בהוצאה לפועל על סמך ההחלטה.\"}]}, {\"@type\": \"FAQPage\", \"@id\": \"https://dabullaw.co.il/%d7%a2%d7%95%d7%a8%d7%9a-%d7%93%d7%99%d7%9f-%d7%9c%d7%95%d7%95%d7%a2%d7%93-%d7%91%d7%99%d7%aa/#faq\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"האם ועד הבית יכול לתבוע דייר שלא משלם?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"כן. הנציגות, וגם בעל דירה, יכולים להגיש תביעה למפקח על רישום המקרקעין בסכסוך על תשלומי ועד בית. לפני התביעה שולחים בדרך כלל מכתב התראה. אם אחרי ההחלטה החוב עדיין לא שולם, פותחים תיק בהוצאה לפועל.\"}}, {\"@type\": \"Question\", \"name\": \"דייר בקומת הקרקע טוען שהוא לא משתמש במעלית. הוא פטור מתשלום?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"בדרך כלל לא. החובה להשתתף בהוצאות של הרכוש המשותף חלה על כל בעל דירה, לפי היחס בין שטח הדירה שלו לשטח כל הדירות, אלא אם התקנון קובע חלוקה אחרת. גם טענות על איכות הניקיון או התחזוקה לא מצדיקות הפסקת תשלום.\"}}, {\"@type\": \"Question\", \"name\": \"מי משלם ועד בית בדירה מושכרת?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"מול הנציגות, החובה לפי החוק היא של בעל הדירה. בחוזה השכירות אפשר לקבוע שהשוכר ישלם את התשלום השוטף, אבל אם הוא לא משלם, הוועד יכול לדרוש את החוב מבעל הדירה.\"}}, {\"@type\": \"Question\", \"name\": \"האם הוועד יכול לשנות לבד את התקנון?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"לא. שינוי של תקנון מוסכם דורש החלטה של בעלי דירות ששני שלישים מהרכוש המשותף צמודים לדירות שלהם. בחלק מהנושאים, למשל הצמדה של חלק מהרכוש המשותף לדירה מסוימת, נדרשת הסכמה רחבה יותר.\"}}, {\"@type\": \"Question\", \"name\": \"האם צריך עורך דין כדי להגיש תביעה למפקח?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"לא חובה. אפשר להגיש תביעה גם בלי עורך דין. עורך דין עוזר להכין את התביעה, לחשב את החוב לפי התקנון ולצרף את המסמכים הנכונים, כדי שהתיק לא יתעכב.\"}}]}, {\"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"דף הבית\", \"item\": \"https://dabullaw.co.il/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"עורך דין לוועד בית ולנציגות בית משותף\", \"item\": \"https://dabullaw.co.il/%d7%a2%d7%95%d7%a8%d7%9a-%d7%93%d7%99%d7%9f-%d7%9c%d7%95%d7%95%d7%a2%d7%93-%d7%91%d7%99%d7%aa/\"}]}]}</script>", "excerpt": "ליווי משפטי לוועד בית ולנציגות: גבייה מדייר שלא משלם, תביעה למפקח על רישום המקרקעין, אסיפות ופרוטוקולים, תקנון מוסכם וחוזים עם ספקים.", "meta": {"_yoast_wpseo_title": "עורך דין לוועד בית ולנציגות בית משותף | יקיר דבול - משרד עורכי דין", "_yoast_wpseo_metadesc": "ליווי משפטי לוועד בית ולנציגות: גבייה מדייר שלא משלם, תביעה למפקח על רישום המקרקעין, אסיפות ופרוטוקולים, תקנון מוסכם וחוזים עם ספקים.", "_yoast_wpseo_focuskw": "עורך דין לוועד בית"}}