box-shadow:0 10px 30px rgba(20,20,20,.06)}\n.dmag .cover{position:relative;display:block}\n.dmag .cover img{width:100%;height:auto;border-radius:8px;display:block;box-shadow:0 18px 40px rgba(0,0,0,.35)}\n.dmag .new{position:absolute;top:-12px;right:-12px;background:var(--g1);color:var(--ink);font-weight:800;font-size:14px;border-radius:30px;padding:5px 14px}\n.dmag .meta{font-size:15px;color:var(--mut);font-weight:500}\n.dmag .latest h2{font-size:clamp(26px,3.2vw,40px);line-height:1.2;margin:8px 0 16px}\n.dmag ul.heads{list-style:none;display:grid;gap:10px;margin:0 0 26px;padding:0}\n.dmag ul.heads li{font-size:18px;display:flex;gap:12px;align-items:baseline}\n.dmag ul.heads li:before{content:\"\";width:9px;height:9px;background:var(--g2);transform:rotate(45deg);flex:none;margin-top:8px}\n.dmag .btns{display:flex;gap:10px;flex-wrap:wrap}\n.dmag .btn{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;padding:12px 22px;font-weight:700;font-size:16px;border:1.5px solid var(--ink)}\n.dmag .btn.pri{background:var(--ink);color:var(--g1)}\n.dmag .btn.sec{color:var(--ink);background:#fff}\n.dmag .btn.sm{padding:8px 14px;font-size:14.5px}\n.dmag .inside{margin-top:36px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:30px 32px}\n.dmag .inside h2{font-size:26px;margin-bottom:4px}\n.dmag .inside .sub{color:var(--mut);font-size:15px;margin:0 0 14px}\n.dmag .story{display:grid;grid-template-columns:44px minmax(0,1fr);gap:16px;padding:18px 0;border-top:1px solid var(--line)}\n.dmag .story .n{width:40px;height:40px;border-radius:50%;background:var(--ink);color:var(--g1);display:flex;align-items:center;justify-content:center;font-weight:800}\n.dmag .story h3{font-size:19px;margin-bottom:4px;line-height:1.4}\n.dmag .story p{font-size:16px;line-height:1.65;color:#3a3f45;margin:0}\n.dmag .story p b{color:var(--ink)}\n.dmag .story .src{font-size:14px;color:var(--g3);margin-top:6px}\n.dmag .story .src a{color:var(--g3);text-decoration:underline}\n.dmag .author{margin-top:36px;display:flex;gap:22px;align-items:center;background:#fff;border:1px solid var(--line);border-right:4px solid var(--g2);border-radius:16px;padding:24px 28px}\n.dmag .author img{width:96px!important;height:96px!important;border-radius:50%;object-fit:cover;flex:none}\n.dmag .author b{font-size:20px;display:block}\n.dmag .author .role{color:var(--g3);font-weight:700;font-size:15px;margin:2px 0 6px}\n.dmag .author p{font-size:15.5px;color:#3a3f45;line-height:1.6;margin:0}\n.dmag .author .upd{font-size:13.5px;color:var(--mut);margin-top:6px}\n.dmag .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}\n.dmag .card{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}\n.dmag .card img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;display:block}\n.dmag .card .b{padding:18px 20px 20px;display:flex;flex-direction:column;gap:6px;flex:1}\n.dmag .card .no{font-size:14px;color:var(--g3);font-weight:800}\n.dmag .card h3{font-size:19px;line-height:1.35}\n.dmag .card p{font-size:15px;color:var(--mut);line-height:1.55;flex:1;margin:0 0 8px}\n.dmag .cta{margin-top:52px;background:var(--ink);color:#fff;border-radius:16px;padding:30px 36px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}\n.dmag .cta b{font-size:23px;display:block}\n.dmag .cta span{display:block;color:#C9D1DD;font-size:16.5px;margin-top:4px}\n.dmag .cta .btn{background:var(--g1);color:var(--ink);border-color:var(--g1)}\n.dmag .disc{font-size:14px;color:var(--mut);margin-top:18px}\n@media (max-width:767px){\n .dmag{padding:12px 12px 48px}\n .dmag .hero{padding:34px 20px 38px;border-radius:16px}\n .dmag .latest{grid-template-columns:1fr;gap:24px;padding:20px}\n .dmag .cover{width:78%;margin:0 auto}\n .dmag ul.heads li{font-size:16.5px}\n .dmag .latest .btn{flex:1}\n .dmag .inside{padding:20px}\n .dmag .story{grid-template-columns:34px minmax(0,1fr);gap:10px}\n .dmag .story .n{width:32px;height:32px;font-size:14px}\n .dmag .story p{font-size:15px}\n .dmag .author{flex-direction:column;text-align:center;padding:20px}\n .dmag .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n .dmag .card .b{padding:12px}\n .dmag .card h3{font-size:15.5px}\n .dmag .card p{display:none}\n .dmag .card .btns{flex-direction:column}\n .dmag .cta{padding:22px}\n .dmag .cta .btn{width:100%}\n}\n</style>\n<div class=\"dmag\" style=\"--heroimg:url(https://dabullaw.co.il/wp-content/uploads/2026/10/magazine-hero-buildings.jpg)\">\n<header class=\"hero\"><div class=\"kick\">גיליון חדש בכל יום שישי</div><h1>מגזין הנדל״ן</h1>\n<p>כל שבוע, החדשות החשובות בנדל״ן, במיסוי ובהתחדשות עירונית, ומה הן אומרות לכם. בשפה פשוטה, בעשרה עמודים קצרים, מעו״ד יקיר דבול.</p>\n<div class=\"badges\"><a class=\"badge\" href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" target=\"_blank\" rel=\"noopener\">צפייה ישירה בדפדפן</a><a class=\"badge\" href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" download>הורדה כקובץ PDF</a><a class=\"badge\" href=\"#archive\">ארכיון כל הגיליונות</a></div></header>\n<div class=\"st\">הגיליון של השבוע</div><section class=\"latest\"><a class=\"cover\" href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" target=\"_blank\" rel=\"noopener\"><img src=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1-cover.jpg\" alt=\"שער מגזין הנדל״ן, גיליון 1, 17-23.10.2026\" width=\"800\" height=\"1000\" loading=\"eager\"><span class=\"new\">חדש</span></a>\n<div><div class=\"meta\">גיליון #1 · <span dir=\"ltr\">17-23.10.2026</span></div><h2>מס הרכישה על דירה נוספת לא יורד בינואר</h2><ul class=\"heads\"><li>הריבית נשארה על 3.25%, ומה עם המשכנתא?</li><li>קרנות קונות דירות חדשות בסיטונאות, בהנחה</li><li>רשות ניירות ערך בודקת את מבצעי 20/80</li><li>ההתחדשות העירונית נעצרת בתל אביב ופורחת בחיפה</li></ul>\n<div class=\"btns\"><a class=\"btn pri\" href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" target=\"_blank\" rel=\"noopener\">צפייה במגזין</a><a class=\"btn sec\" href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" download>הורדה (PDF)</a></div></div></section>\n<section class=\"inside\" aria-labelledby=\"dmag-in\"><h2 id=\"dmag-in\">בגיליון הזה</h2><p class=\"sub\">עיקרי הדברים בקצרה. כל ידיעה מבוססת על מקור רשמי או כלי תקשורת, עם קישור.</p><div class=\"story\"><span class=\"n\">1</span><div><h3>מס הרכישה על דירה נוספת נשאר 8% גם בינואר</h3><p>בגלל פיזור הכנסת, הוראת השעה (8% עד 6,055,070 ש״ח, ו־10% מעל) בתוקף עד 10.2.2027. <b>מה זה אומר לכם:</b> מי שדחה קנייה של דירה נוספת לינואר כדי לשלם פחות מס, לא יקבל הקלה.</p><div class=\"src\">מקור: <a href=\"https://www.emess.co.il/radio/1943010\" target=\"_blank\" rel=\"noopener\">אמס, הודעת רשות המסים</a> · להרחבה: <a href=\"https://dabullaw.co.il/%d7%94%d7%9e%d7%93%d7%a8%d7%99%d7%9a-%d7%9c%d7%9e%d7%a1-%d7%a8%d7%9b%d7%99%d7%a9%d7%94-2025-%d7%9b%d7%9e%d7%94-%d7%aa%d7%a9%d7%9c%d7%9e%d7%95-%d7%9c%d7%9e%d7%93%d7%99%d7%a0%d7%94-%d7%95%d7%90%d7%99/\">המדריך למס רכישה</a></div></div></div><div class=\"story\"><span class=\"n\">2</span><div><h3>הריבית נשארה 3.25%, הפריים 4.75%</h3><p>ב־21.10 השאיר בנק ישראל את הריבית ללא שינוי. האינפלציה בשנה האחרונה: 1.6%. <b>מה זה אומר לכם:</b> במסלול פריים ההחזר החודשי לא יורד כרגע. לפני משכנתא חדשה כדאי להשוות הצעות ולבדוק את תמהיל המסלולים.</p><div class=\"src\">מקור: <a href=\"https://www.mako.co.il/news-money/2026_q4/Article-00f811eb45e51a1026.htm\" target=\"_blank\" rel=\"noopener\">מאקו, הודעת בנק ישראל</a> · להרחבה: <a href=\"https://dabullaw.co.il/calculators/\">מחשבונים וכלים</a></div></div></div><div class=\"story\"><span class=\"n\">3</span><div><h3>קרנות קונות דירות חדשות בהנחה של כ־14%</h3><p>קרן ריט קונה 80 דירות בכ־14% מתחת להערכת השמאי. לפי הלמ״ס נותרו כ־85,680 דירות חדשות לא מכורות. <b>מה זה אומר לכם:</b> יש כוח מיקוח מול קבלנים, אבל חשוב לבדוק את לוח התשלומים, ההצמדה, הבטוחות ומועד המסירה.</p><div class=\"src\">מקור: <a href=\"https://www.bizportal.co.il/realestates/news/article/20045562\" target=\"_blank\" rel=\"noopener\">ביזפורטל</a> · להרחבה: <a href=\"https://dabullaw.co.il/%d7%a7%d7%a0%d7%99%d7%94-%d7%9e%d7%a7%d7%91%d7%9c%d7%9f/\">קניית דירה מקבלן</a></div></div></div><div class=\"story\"><span class=\"n\">4</span><div><h3>רשות ניירות ערך בודקת את מבצעי 20/80</h3><p>חברות יזמיות ציבוריות יתבקשו לפרט בתשקיפים מבצעי מימון וביטולי עסקאות. <b>מה זה אומר לכם:</b> 80% מהמחיר משלמים במסירה. לוודא משכנתא מראש, וערבות חוק מכר על כל תשלום לקבלן.</p><div class=\"src\">מקור: <a href=\"https://www.bizportal.co.il/realestates/news/article/20045077\" target=\"_blank\" rel=\"noopener\">ביזפורטל</a> · להרחבה: <a href=\"https://dabullaw.co.il/%d7%a7%d7%a0%d7%99%d7%94-%d7%9e%d7%a7%d7%91%d7%9c%d7%9f/\">קניית דירה מקבלן</a></div></div></div><div class=\"story\"><span class=\"n\">5</span><div><h3>בקשות ההיתר בהתחדשות עירונית ירדו ב־51%</h3><p>לפי מדלן, בשמונה ערים גדולות. בתל אביב ירידה של 83%, בחיפה עלייה של 465%. <b>מה זה אומר לכם:</b> קצב הפרויקט תלוי בתוכנית של העירייה. לפני שחותמים, לבדוק את מצב התכנון ואת היזם, ולהיות מיוצגים מטעם הדיירים.</p><div class=\"src\">מקור: <a href=\"https://www.ynet.co.il/economy/article/r1ewpglhfe\" target=\"_blank\" rel=\"noopener\">ynet</a> · להרחבה: <a href=\"https://dabullaw.co.il/%d7%94%d7%aa%d7%97%d7%93%d7%a9%d7%95%d7%aa-%d7%a2%d7%99%d7%a8%d7%95%d7%a0%d7%99%d7%aa/\">התחדשות עירונית</a></div></div></div></section>\n<aside class=\"author\"><img src=\"https://dabullaw.co.il/wp-content/uploads/2026/10/magazine-author-yakir.jpg\" alt=\"עו״ד יקיר דבול\" width=\"96\" height=\"96\" loading=\"lazy\"><div><b>נכתב ונבדק על ידי עו״ד יקיר דבול</b><div class=\"role\">עורך דין מקרקעין ונדל״ן, נתניה</div>\n<p>מלווה יותר מ־100 עסקאות נדל״ן בשנה בשרון. חבר בחמש ועדות של לשכת עורכי הדין, מחוז מרכז, ובהן ועדת התחדשות עירונית וועדת מקרקעין. התראיין בחדשות 13, ישראל היום, וואלה נדל״ן וביזפורטל.</p><div class=\"upd\">עודכן לאחרונה: 23.10.2026</div></div></aside>\n<div class=\"st\" id=\"archive\">כל הגיליונות</div><section class=\"grid\"><article class=\"card\"><a href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" target=\"_blank\" rel=\"noopener\"><img src=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1-cover.jpg\" alt=\"שער מגזין הנדל״ן, גיליון 1\" width=\"800\" height=\"1000\" loading=\"lazy\"></a><div class=\"b\"><span class=\"no\">גיליון #1 · <span dir=\"ltr\">17-23.10.2026</span></span><h3>מס הרכישה על דירה נוספת לא יורד בינואר</h3><p>הריבית, קרנות שקונות דירות בהנחה, מבצעי 20/80, וירידה בבקשות להיתר בהתחדשות עירונית.</p>\n<div class=\"btns\"><a class=\"btn pri sm\" href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" target=\"_blank\" rel=\"noopener\">צפייה</a><a class=\"btn sec sm\" href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" download>הורדה</a></div></div></article></section>\n<div class=\"cta\"><div><b>יש לכם שאלה על עסקה שראיתם במגזין?</b><span>השאירו פרטים ונחזור אליכם.</span></div><a class=\"btn\" href=\"https://dabullaw.co.il/%d7%a6%d7%a8%d7%95-%d7%a7%d7%a9%d7%a8/\">השארת פרטים</a></div>\n<p class=\"disc\">המידע במגזין כללי ואינו ייעוץ משפטי. לפני החלטה בעסקה, כדאי להתייעץ עם עורך דין.</p></div>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"Periodical\", \"@id\": \"https://dabullaw.co.il/magazine/#periodical\", \"name\": \"מגזין הנדל״ן\", \"inLanguage\": \"he\", \"url\": \"https://dabullaw.co.il/magazine/\", \"author\": {\"@type\": \"Person\", \"@id\": \"https://dabullaw.co.il/#yakir\", \"name\": \"עו״ד יקיר דבול\", \"jobTitle\": \"עורך דין מקרקעין ונדל״ן\", \"url\": \"https://dabullaw.co.il/%d7%90%d7%95%d7%93%d7%95%d7%aa-%d7%94%d7%9e%d7%a9%d7%a8%d7%93/\", \"image\": \"https://dabullaw.co.il/wp-content/uploads/2026/10/magazine-author-yakir.jpg\"}, \"publisher\": {\"@type\": \"LegalService\", \"name\": \"יקיר דבול - משרד עורכי דין\", \"url\": \"https://dabullaw.co.il/\"}, \"description\": \"מגזין שבועי: החדשות החשובות בנדל״ן, במיסוי ובהתחדשות עירונית, ומה הן אומרות לקוראים.\"}, {\"@type\": \"CollectionPage\", \"url\": \"https://dabullaw.co.il/magazine/\", \"name\": \"מגזין הנדל״ן\", \"inLanguage\": \"he\", \"dateModified\": \"2026-10-23\", \"mainEntity\": {\"@id\": \"https://dabullaw.co.il/magazine/#periodical\"}, \"hasPart\": [{\"@type\": \"PublicationIssue\", \"issueNumber\": \"1\", \"name\": \"מגזין הנדל״ן, גיליון 1: מס הרכישה על דירה נוספת לא יורד בינואר\", \"datePublished\": \"2026-10-23\", \"url\": \"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\", \"image\": \"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1-cover.jpg\", \"author\": {\"@type\": \"Person\", \"@id\": \"https://dabullaw.co.il/#yakir\", \"name\": \"עו״ד יקיר דבול\", \"jobTitle\": \"עורך דין מקרקעין ונדל״ן\", \"url\": \"https://dabullaw.co.il/%d7%90%d7%95%d7%93%d7%95%d7%aa-%d7%94%d7%9e%d7%a9%d7%a8%d7%93/\", \"image\": \"https://dabullaw.co.il/wp-content/uploads/2026/10/magazine-author-yakir.jpg\"}, \"isPartOf\": {\"@id\": \"https://dabullaw.co.il/magazine/#periodical\"}}]}]}</script>\n\n<!-- /wp:html -->"}