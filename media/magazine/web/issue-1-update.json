{"content": "<!-- wp:html -->\n<style>\n.dmag{--ink:#141414;--g1:#E7CD96;--g2:#C5A25A;--g3:#A88A4C;--bg:#F8F8FD;--mut:#54595F;--line:#E7E7F1;\n color:var(--ink);font-family:inherit;font-size:17px;line-height:1.7;max-width:1192px;margin:0 auto;padding:24px 16px 64px}\n.dmag *{box-sizing:border-box}\n.dmag h1,.dmag h2,.dmag h3{margin:0;font-weight:800;color:inherit;text-wrap:balance}\n.dmag a{text-decoration:none}\n.dmag .hero{position:relative;overflow:hidden;border-radius:22px;background:radial-gradient(120% 140% at 85% 0%,#2a2620 0%,#141414 50%,#0B0B0B 100%);color:#fff;padding:52px 48px 56px}\n.dmag .hero:before{content:\"\";position:absolute;inset:0;background:var(--heroimg) center 62%/cover no-repeat;opacity:.34;filter:grayscale(.2)}\n.dmag .hero>*{position:relative}\n.dmag .kick{color:var(--g2);font-weight:700;letter-spacing:.06em;font-size:15px;display:flex;align-items:center;gap:12px}\n.dmag .kick:after{content:\"\";width:110px;height:2px;background:linear-gradient(to left,var(--g2),transparent)}\n.dmag .hero h1{font-size:clamp(40px,6vw,72px);line-height:1.1;margin:12px 0 14px;color:var(--g1)}\n.dmag .hero p{font-size:clamp(17px,2vw,21px);line-height:1.6;max-width:720px;color:#DCE2EC;margin:0}\n.dmag .badges{display:flex;gap:10px;margin-top:24px;flex-wrap:wrap}\n.dmag .badge{border:1.5px solid rgba(231,205,150,.6);color:#fff;border-radius:40px;padding:7px 16px;font-size:15px;font-weight:500}\n.dmag .badge:hover{background:rgba(231,205,150,.12)}\n.dmag .st{display:flex;align-items:center;gap:14px;font-size:15px;font-weight:800;color:var(--g3);letter-spacing:.06em;margin:52px 0 18px}\n.dmag .st:after{content:\"\";flex:1;height:1px;background:var(--line)}\n.dmag .latest{display:grid;grid-template-columns:minmax(0,360px) minmax(0,1fr);gap:48px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:16px;padding:32px;box-shadow:0 10px 30px rgba(20,20,20,.06)}\n.dmag .cover{position:relative;display:block}\n.dmag .cover img{width:100%;height:auto;border-radius:8px;display:block;box-shadow:0 18px 40px rgba(0,0,0,.35)}\n.dmag .new{position:absolute;top:-12px;right:-12px;background:var(--g1);color:var(--ink);font-weight:800;font-size:14px;border-radius:30px;padding:5px 14px}\n.dmag .meta{font-size:15px;color:var(--mut);font-weight:500}\n.dmag .latest h2{font-size:clamp(26px,3.2vw,40px);line-height:1.2;margin:8px 0 16px}\n.dmag ul.heads{list-style:none;display:grid;gap:10px;margin:0 0 26px;padding:0}\n.dmag ul.heads li{font-size:18px;display:flex;gap:12px;align-items:baseline}\n.dmag ul.heads li:before{content:\"\";width:9px;height:9px;background:var(--g2);transform:rotate(45deg);flex:none;margin-top:8px}\n.dmag .btns{display:flex;gap:10px;flex-wrap:wrap}\n.dmag .btn{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;padding:12px 22px;font-weight:700;font-size:16px;border:1.5px solid var(--ink)}\n.dmag .btn.pri{background:var(--ink);color:var(--g1)}\n.dmag .btn.sec{color:var(--ink);background:#fff}\n.dmag .btn.sm{padding:8px 14px;font-size:14.5px}\n.dmag .inside{margin-top:36px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:30px 32px}\n.dmag .inside h2{font-size:26px;margin-bottom:4px}\n.dmag .inside .sub{color:var(--mut);font-size:15px;margin:0 0 14px}\n.dmag .story{display:grid;grid-template-columns:44px minmax(0,1fr);gap:16px;padding:18px 0;border-top:1px solid var(--line)}\n.dmag .story .n{width:40px;height:40px;border-radius:50%;background:var(--ink);color:var(--g1);display:flex;align-items:center;justify-content:center;font-weight:800}\n.dmag .story h3{font-size:19px;margin-bottom:4px;line-height:1.4}\n.dmag .story p{font-size:16px;line-height:1.65;color:#3a3f45;margin:0}\n.dmag .story p b{color:var(--ink)}\n.dmag .author{margin-top:36px;display:flex;gap:22px;align-items:center;background:#fff;border:1px solid var(--line);border-right:4px solid var(--g2);border-radius:16px;padding:24px 28px}\n.dmag .author img{width:96px!important;height:96px!important;border-radius:50%;object-fit:cover;flex:none}\n.dmag .author b{font-size:20px;display:block}\n.dmag .author .role{color:var(--g3);font-weight:700;font-size:15px;margin:2px 0 6px}\n.dmag .author p{font-size:15.5px;color:#3a3f45;line-height:1.6;margin:0}\n.dmag .author .upd{font-size:13.5px;color:var(--mut);margin-top:6px}\n.dmag .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}\n.dmag .card{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}\n.dmag .card img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;display:block}\n.dmag .card .b{padding:18px 20px 20px;display:flex;flex-direction:column;gap:6px;flex:1}\n.dmag .card .no{font-size:14px;color:var(--g3);font-weight:800}\n.dmag .card .dt{align-self:flex-start;margin-top:-4px;font-size:13.5px;color:var(--mut);font-weight:500;white-space:nowrap;unicode-bidi:isolate}\n.dmag .meta .dt{white-space:nowrap;unicode-bidi:isolate}\n.dmag .card h3{font-size:19px;line-height:1.35}\n.dmag .card p{font-size:15px;color:var(--mut);line-height:1.55;flex:1;margin:0 0 8px}\n.dmag .cta{margin-top:52px;background:var(--ink);color:#fff;border-radius:16px;padding:30px 36px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}\n.dmag .cta b{font-size:23px;display:block}\n.dmag .cta span{display:block;color:#C9D1DD;font-size:16.5px;margin-top:4px}\n.dmag .cta .btn{background:var(--g1);color:var(--ink);border-color:var(--g1)}\n.dmag .disc{font-size:14px;color:var(--mut);margin-top:18px}\n.dmag .story h3 a{color:inherit}\n.dmag .srcname{font-size:14px;color:var(--mut);margin-top:6px}\n.dmag .more{display:inline-block;margin-top:8px;font-weight:700;color:var(--g3);font-size:15px}\n.dmag .toc{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px 28px;margin-top:28px}\n.dmag .toc b{display:block;font-size:17px;margin-bottom:8px}\n.dmag .toc ol{margin:0;padding:0 22px 0 0;display:grid;gap:6px}\n.dmag .toc a{color:var(--ink);text-decoration:underline;text-decoration-color:var(--g2);text-underline-offset:3px}\n.dmag .art{margin-top:28px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:8px 32px 28px}\n.dmag .art section{padding-top:26px;scroll-margin-top:110px}\n.dmag .art section+section{border-top:1px solid var(--line);margin-top:22px}\n.dmag .art h2{font-size:clamp(22px,2.6vw,28px);line-height:1.3;margin-bottom:10px;display:flex;gap:12px;align-items:flex-start}\n.dmag .art h2 .n{flex:none;width:36px;height:36px;border-radius:50%;background:var(--ink);color:var(--g1);display:inline-flex;align-items:center;justify-content:center;font-size:16px;margin-top:2px}\n.dmag .art p{margin:0 0 12px;font-size:17px;line-height:1.8;color:#2b2f34}\n.dmag .art p a{color:var(--g3);font-weight:700;text-decoration:underline;text-underline-offset:3px}\n.dmag .means{background:var(--bg);border-right:4px solid var(--g2);border-radius:10px;padding:14px 18px;font-size:16.5px;line-height:1.7}\n.dmag .means b{color:var(--g3)}\n.dmag .faq{margin-top:28px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px 32px}\n.dmag .faq h2{font-size:24px;margin-bottom:8px}\n.dmag .faq h3{font-size:18px;margin:16px 0 4px}\n.dmag .faq p{margin:0;font-size:16.5px;color:#3a3f45}\n.dmag .pn{display:flex;justify-content:space-between;gap:12px;margin-top:28px;flex-wrap:wrap}\n.dmag .crumbs{font-size:14px;color:#C9D1DD;margin-bottom:6px}\n.dmag .crumbs a{color:var(--g1)}\n.dmag .hero.small h1{font-size:clamp(30px,4.4vw,52px)}\n@media (max-width:767px){\n .dmag .art{padding:4px 18px 20px}\n .dmag .art p{font-size:16px}\n .dmag .toc,.dmag .faq{padding:18px}\n}\n@media (max-width:767px){\n .dmag{padding:12px 12px 48px}\n .dmag .hero{padding:40px 20px 44px;border-radius:0;width:100vw;max-width:100vw;margin:-12px calc(50% - 50vw) 0}\n .dmag .latest{grid-template-columns:1fr;gap:24px;padding:20px}\n .dmag .cover{width:78%;margin:0 auto}\n .dmag ul.heads li{font-size:16.5px}\n .dmag .latest .btn{flex:1}\n .dmag .inside{padding:20px}\n .dmag .story{grid-template-columns:34px minmax(0,1fr);gap:10px}\n .dmag .story .n{width:32px;height:32px;font-size:14px}\n .dmag .story p{font-size:15px}\n .dmag .author{flex-direction:column;text-align:center;padding:20px}\n .dmag .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n .dmag .card .b{padding:12px}\n .dmag .card h3{font-size:15.5px}\n .dmag .card p{display:none}\n .dmag .card .btns{flex-direction:column}\n .dmag .cta{padding:22px}\n .dmag .cta .btn{width:100%}\n}\n</style>\n<div class=\"dmag\" style=\"--heroimg:url(https://dabullaw.co.il/wp-content/uploads/2026/10/magazine-hero-buildings.jpg)\">\n<header class=\"hero small\"><div class=\"crumbs\"><a href=\"https://dabullaw.co.il/magazine/\">מגזין הנדל״ן</a> · גיליון #1 · <span dir=\"ltr\" style=\"unicode-bidi:isolate\">17-23.10.2026</span></div><h1>מגזין הנדל״ן, גיליון 1: מס הרכישה על דירה נוספת לא יורד בינואר</h1>\n<p>מס הרכישה על דירה נוספת לא יורד בינואר כמו שרבים קיוו, בנק ישראל השאיר את הריבית, קרנות קונות דירות חדשות בהנחה, רשות ניירות ערך בודקת את מבצעי 20/80, וההתחדשות העירונית מאטה בתל אביב ומאיצה בחיפה. אלה החדשות של השבוע 17 עד 23 באוקטובר 2026, ומה הן אומרות לכם.</p>\n<div class=\"badges\"><a class=\"badge\" href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" target=\"_blank\" rel=\"noopener\">צפייה במגזין המלא</a><a class=\"badge\" href=\"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1.pdf\" download>הורדה כקובץ PDF</a><a class=\"badge\" href=\"https://dabullaw.co.il/magazine/#archive\">כל הגיליונות</a></div></header>\n<nav class=\"toc\" aria-label=\"תוכן הגיליון\"><b>בגיליון הזה</b><ol><li><a href=\"#s1\">מס הרכישה על דירה נוספת נשאר 8% גם בינואר</a></li><li><a href=\"#s2\">הריבית נשארה 3.25%, הפריים 4.75%</a></li><li><a href=\"#s3\">קרנות קונות דירות חדשות בהנחה של כ־14%</a></li><li><a href=\"#s4\">רשות ניירות ערך בודקת את מבצעי 20/80</a></li><li><a href=\"#s5\">בקשות ההיתר בהתחדשות עירונית ירדו ב־51%</a></li></ol></nav>\n<article class=\"art\"><section id=\"s1\"><h2><span class=\"n\">1</span><span>מס הרכישה על דירה נוספת נשאר 8% גם בינואר</span></h2><p>הוראת השעה שקובעת מס רכישה מוגבה על דירה נוספת הייתה אמורה להסתיים, ולא מעט אנשים תכננו לדחות את הקנייה לינואר כדי לשלם פחות. לפי הודעת רשות המסים, בגלל פיזור הכנסת הוראת השעה נשארת בתוקף עד 10.2.2027.</p><p>המדרגות לא משתנות: 8% על החלק של המחיר עד 6,055,070 ש״ח, ו־10% על החלק שמעל הסכום הזה.</p><p>חשוב לבדוק אם הדירה שאתם קונים היא באמת &quot;דירה נוספת&quot; לפי החוק. מי שמוכר את הדירה הקודמת שלו בתוך פרק הזמן שהחוק מאפשר, יכול לפעמים לשלם מס לפי המדרגות של דירה יחידה. כל הפרטים ב<a href=\"https://dabullaw.co.il/%d7%94%d7%9e%d7%93%d7%a8%d7%99%d7%9a-%d7%94%d7%9e%d7%9c%d7%90-%d7%9c%d7%9e%d7%a1-%d7%a8%d7%9b%d7%99%d7%a9%d7%94-%d7%9c%d7%93%d7%99%d7%a8%d7%94-%d7%a9%d7%a0%d7%99%d7%99%d7%94-%d7%90%d7%95-%d7%a0%d7%95/\">מדריך למס רכישה על דירה נוספת</a>.</p><div class=\"means\"><b>מה זה אומר לכם:</b> מי שדחה קנייה של דירה נוספת לינואר כדי לשלם פחות מס, לא יקבל הקלה.</div><div class=\"srcname\">מקור: אמס, הודעת רשות המסים</div></section><section id=\"s2\"><h2><span class=\"n\">2</span><span>הריבית נשארה 3.25%, הפריים 4.75%</span></h2><p>ב־21.10 החליט בנק ישראל להשאיר את הריבית על 3.25%. ריבית הפריים, שהיא ריבית בנק ישראל ועוד 1.5%, עומדת על 4.75%. האינפלציה בשנה האחרונה הייתה 1.6%.</p><p>במסלול הפריים ההחזר החודשי זז יחד עם הריבית, ולכן כל עוד היא לא יורדת, גם ההחזר לא יורד. במסלולים שצמודים למדד, האינפלציה משפיעה על יתרת ההלוואה. הסבר רחב יותר נמצא במאמר <a href=\"https://dabullaw.co.il/%d7%94%d7%a9%d7%a4%d7%a2%d7%aa-%d7%94%d7%a8%d7%99%d7%91%d7%99%d7%aa-%d7%a2%d7%9c-%d7%a9%d7%95%d7%a7-%d7%94%d7%a0%d7%93%d7%9c%d7%9f/\">איך הריבית משפיעה על הכיס ועל שוק הנדל״ן</a>.</p><p>מי שעומד לקחת משכנתא: לבקש הצעות מכמה בנקים, להשוות את הריבית בכל מסלול ואת התמהיל, ולא להסתכל רק על ההחזר החודשי.</p><div class=\"means\"><b>מה זה אומר לכם:</b> במסלול פריים ההחזר החודשי לא יורד כרגע. לפני משכנתא חדשה כדאי להשוות הצעות ולבדוק את תמהיל המסלולים.</div><div class=\"srcname\">מקור: מאקו, הודעת בנק ישראל</div></section><section id=\"s3\"><h2><span class=\"n\">3</span><span>קרנות קונות דירות חדשות בהנחה של כ־14%</span></h2><p>קרן ריט, קרן שמשקיעה בנדל״ן ונסחרת בבורסה, קונה 80 דירות חדשות במחיר של כ־14% מתחת להערכת השמאי. זה קורה בזמן שלפי הלמ״ס נותרו כ־85,680 דירות חדשות שלא נמכרו.</p><p>יש היום הרבה דירות חדשות בשוק והקבלנים מחפשים קונים. מי שקונה דירה אחת לא יקבל את התנאים של קרן שקונה 80 דירות, אבל יש לו יותר מקום למשא ומתן מבעבר.</p><p>כשמקבלים הצעה מקבלן כדאי לבדוק יותר מהמחיר: את לוח התשלומים, את ההצמדה למדד תשומות הבנייה, את הבטוחות על כל תשלום, ואת מועד המסירה והפיצוי על איחור. ריכזנו את כל השלבים בעמוד <a href=\"https://dabullaw.co.il/%d7%a7%d7%a0%d7%99%d7%94-%d7%9e%d7%a7%d7%91%d7%9c%d7%9f/\">קניית דירה מקבלן</a>.</p><div class=\"means\"><b>מה זה אומר לכם:</b> יש כוח מיקוח מול קבלנים, אבל חשוב לבדוק את לוח התשלומים, ההצמדה, הבטוחות ומועד המסירה.</div><div class=\"srcname\">מקור: ביזפורטל</div></section><section id=\"s4\"><h2><span class=\"n\">4</span><span>רשות ניירות ערך בודקת את מבצעי 20/80</span></h2><p>רשות ניירות ערך בודקת את מבצעי המימון של הקבלנים. חברות יזמיות ציבוריות יתבקשו לפרט בתשקיפים את מבצעי המימון ואת ביטולי העסקאות.</p><p>במבצע 20/80 משלמים 20% מהמחיר בחתימה ואת 80% הנותרים במסירה. זה נשמע נוח, אבל חלק מהסיכון עובר לקונה: ביום המסירה צריך לקבל משכנתא בגובה הנדרש, גם אם הריבית או התנאים השתנו עד אז. על ההבדלים בין המבצעים אפשר לקרוא במדריך <a href=\"https://dabullaw.co.il/%d7%94%d7%9c%d7%95%d7%95%d7%90%d7%aa-%d7%a7%d7%91%d7%9c%d7%9f-%d7%94%d7%9e%d7%93%d7%a8%d7%99%d7%9a-%d7%94%d7%9e%d7%9c%d7%90/\">הלוואת קבלן</a>.</p><p>לפני שחותמים: לבדוק מראש מול הבנק כמה משכנתא תוכלו לקבל, ולוודא שעל כל תשלום לקבלן מקבלים בטוחה לפי חוק המכר. ההבדלים בין הבטוחות מוסברים במאמר <a href=\"https://dabullaw.co.il/sale-law-guarantee-vs-autonomous-guarantee/\">ערבות חוק מכר מול ערבות אוטונומית</a>.</p><div class=\"means\"><b>מה זה אומר לכם:</b> 80% מהמחיר משלמים במסירה. לוודא משכנתא מראש, וערבות חוק מכר על כל תשלום לקבלן.</div><div class=\"srcname\">מקור: ביזפורטל</div></section><section id=\"s5\"><h2><span class=\"n\">5</span><span>בקשות ההיתר בהתחדשות עירונית ירדו ב־51%</span></h2><p>לפי נתוני מדלן, מספר הבקשות להיתר בנייה בפרויקטים של התחדשות עירונית ירד ב־51% בשמונה ערים גדולות. בתל אביב הירידה הגיעה ל־83%, ובחיפה דווקא נרשמה עלייה של 465%.</p><p>קצב הפרויקט תלוי מאוד בתוכנית של העירייה ובמדיניות שלה. אותו סוג פרויקט יכול להתקדם מהר בעיר אחת ולהיתקע בעיר אחרת.</p><p>לפני שחותמים על הסכם עם יזם: לבדוק באיזה שלב התכנון נמצא, לבדוק את היזם ואת הפרויקטים שכבר השלים, ולוודא שלדיירים יש עורך דין שמייצג רק אותם. נורות האזהרה מפורטות במאמר <a href=\"https://dabullaw.co.il/how-to-choose-urban-renewal-developer/\">איך לבחור יזם להתחדשות עירונית</a>.</p><div class=\"means\"><b>מה זה אומר לכם:</b> קצב הפרויקט תלוי בתוכנית של העירייה. לפני שחותמים, לבדוק את מצב התכנון ואת היזם, ולהיות מיוצגים מטעם הדיירים.</div><div class=\"srcname\">מקור: ynet</div></section></article>\n<section class=\"faq\"><h2>שאלות קצרות על הגיליון</h2><h3>האם מס הרכישה על דירה נוספת יורד בינואר 2027?</h3><p>לא. לפי הודעת רשות המסים, בגלל פיזור הכנסת הוראת השעה נשארת בתוקף עד 10.2.2027: 8% עד 6,055,070 ש״ח ו־10% מעל.</p><h3>מה הריבית של בנק ישראל באוקטובר 2026?</h3><p>ב־21.10.2026 הושארה הריבית על 3.25%, וריבית הפריים עומדת על 4.75%.</p><h3>מה זה מבצע 20/80 בדירה מקבלן?</h3><p>משלמים 20% מהמחיר בחתימה ואת 80% במסירה. חשוב לבדוק מראש את האפשרות לקבל משכנתא, ולקבל בטוחה לפי חוק המכר על כל תשלום.</p></section>\n<aside class=\"author\"><img src=\"https://dabullaw.co.il/wp-content/uploads/2026/10/magazine-author-yakir.jpg\" alt=\"עו״ד יקיר דבול\" width=\"96\" height=\"96\" loading=\"lazy\"><div><b>עו״ד יקיר דבול</b><div class=\"role\">יקיר דבול - משרד עורכי דין</div>\n<p>מלווה יותר מ־100 עסקאות נדל״ן בשנה בשרון. חבר בחמש ועדות של לשכת עורכי הדין, מחוז מרכז, ובהן ועדת התחדשות עירונית וועדת מקרקעין. התראיין בחדשות 13, ישראל היום, וואלה נדל״ן וביזפורטל.</p><div class=\"upd\">עודכן לאחרונה: 23.10.2026</div></div></aside>\n<div class=\"pn\"><a class=\"btn pri\" href=\"https://dabullaw.co.il/magazine/#archive\">כל הגיליונות</a></div>\n<div class=\"cta\"><div><b>יש לכם שאלה על עסקה שראיתם במגזין?</b><span>השאירו פרטים ונחזור אליכם.</span></div><a class=\"btn\" href=\"https://dabullaw.co.il/%d7%a6%d7%a8%d7%95-%d7%a7%d7%a9%d7%a8/\">השארת פרטים</a></div>\n<p class=\"disc\">המידע במגזין כללי ואינו ייעוץ משפטי. לפני החלטה בעסקה, כדאי להתייעץ עם עורך דין.</p></div>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"NewsArticle\", \"@id\": \"https://dabullaw.co.il/magazine/issue-1/#article\", \"headline\": \"מגזין הנדל״ן, גיליון 1: מס הרכישה על דירה נוספת לא יורד בינואר\", \"description\": \"החדשות של 17-23.10.2026 בשפה פשוטה: מס הרכישה על דירה נוספת נשאר 8% עד 10.2.2027, הריבית 3.25%, קרנות שקונות דירות בהנחה ומבצעי 20/80.\", \"inLanguage\": \"he\", \"datePublished\": \"2026-10-23\", \"dateModified\": \"2026-10-23\", \"image\": \"https://dabullaw.co.il/wp-content/uploads/2026/10/real-estate-magazine-1-cover.jpg\", \"url\": \"https://dabullaw.co.il/magazine/issue-1/\", \"mainEntityOfPage\": \"https://dabullaw.co.il/magazine/issue-1/\", \"author\": {\"@type\": \"Person\", \"@id\": \"https://dabullaw.co.il/#yakir\", \"name\": \"עו״ד יקיר דבול\", \"jobTitle\": \"עורך דין\", \"url\": \"https://dabullaw.co.il/%d7%90%d7%95%d7%93%d7%95%d7%aa-%d7%94%d7%9e%d7%a9%d7%a8%d7%93/\", \"image\": \"https://dabullaw.co.il/wp-content/uploads/2026/10/magazine-author-yakir.jpg\"}, \"publisher\": {\"@type\": \"Organization\", \"name\": \"יקיר דבול - משרד עורכי דין\", \"url\": \"https://dabullaw.co.il/\"}, \"isPartOf\": {\"@type\": \"PublicationIssue\", \"issueNumber\": \"1\", \"isPartOf\": {\"@type\": \"Periodical\", \"@id\": \"https://dabullaw.co.il/magazine/#periodical\", \"name\": \"מגזין הנדל״ן\", \"url\": \"https://dabullaw.co.il/magazine/\"}}, \"articleSection\": [\"מס הרכישה על דירה נוספת נשאר 8% גם בינואר\", \"הריבית נשארה 3.25%, הפריים 4.75%\", \"קרנות קונות דירות חדשות בהנחה של כ־14%\", \"רשות ניירות ערך בודקת את מבצעי 20/80\", \"בקשות ההיתר בהתחדשות עירונית ירדו ב־51%\"]}, {\"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"דף הבית\", \"item\": \"https://dabullaw.co.il/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"מגזין הנדל״ן\", \"item\": \"https://dabullaw.co.il/magazine/\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"גיליון 1\", \"item\": \"https://dabullaw.co.il/magazine/issue-1/\"}]}, {\"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"האם מס הרכישה על דירה נוספת יורד בינואר 2027?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"לא. לפי הודעת רשות המסים, בגלל פיזור הכנסת הוראת השעה נשארת בתוקף עד 10.2.2027: 8% עד 6,055,070 ש״ח ו־10% מעל.\"}}, {\"@type\": \"Question\", \"name\": \"מה הריבית של בנק ישראל באוקטובר 2026?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"ב־21.10.2026 הושארה הריבית על 3.25%, וריבית הפריים עומדת על 4.75%.\"}}, {\"@type\": \"Question\", \"name\": \"מה זה מבצע 20/80 בדירה מקבלן?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"משלמים 20% מהמחיר בחתימה ואת 80% במסירה. חשוב לבדוק מראש את האפשרות לקבל משכנתא, ולקבל בטוחה לפי חוק המכר על כל תשלום.\"}}]}]}</script>\n\n<!-- /wp:html -->"}