---
// Page shell: head (title, description, canonical, hreflang, Open Graph, JSON-LD), preview ribbon, header, footer.
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { REGIONS } from '../lib/data';
import SiteTools from '../components/SiteTools.astro';
import { BRAND, PREVIEW } from '../config/brand';
import { P, u, abs } from '../config/routes';
import { areas, cities, areaGroups, firms } from '../lib/data';
import { organization, website, graph } from '../lib/schema';

type Props = { title: string; description: string; path: string; schema?: any[]; noindex?: boolean; nav?: string; ogType?: string; bodyClass?: string; fullTitle?: boolean };
const { title, description, path, schema = [], noindex = false, nav = '', ogType = 'website', bodyClass, fullTitle = false } = Astro.props as Props;
const t = fullTitle ? title : `${title} | ${BRAND.name}`;
const canonical = abs(path);
const robots = PREVIEW || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ld = graph(organization(), website(), ...schema);
const topCities = ['tel-aviv', 'jerusalem', 'haifa', 'netanya', 'petah-tikva', 'beer-sheva'].map((s) => cities().find((c) => c.slug === s)).filter(Boolean);
const NAV = [
  { k: 'areas', href: u(P.page('areas')), label: 'תחומים' },
  { k: 'cities', href: u(P.page('cities')), label: 'ערים' },
  { k: 'courts', href: u(P.page('courts')), label: 'בתי משפט' },
  { k: 'articles', href: u(P.page('articles')), label: 'מדריכים' },
  { k: 'tools', href: u(P.page('tools')), label: 'כלים' },
];
const groups = areaGroups().slice(0, 4);
const seoAreas = ['real-estate', 'divorce', 'labor-law', 'car-accidents', 'criminal', 'inheritance-wills'].map((s) => areas().find((a) => a.slug === s)).filter(Boolean);
const allFirms = await firms();
const hasCombo = (a: string, c: string) => allFirms.some((f) => f.city === c && f.areas.includes(a));
const seoCities = ['tel-aviv', 'jerusalem', 'haifa', 'netanya', 'beer-sheva', 'rishon-lezion'].map((s) => cities().find((c) => c.slug === s)).filter(Boolean);
const FOOT = [
  { t: 'תחומים', l: [...groups.map((g, i) => ({ h: u(P.page('areas')) + '#g-' + i, x: g.group })), { h: u(P.page('areas')), x: `כל ${areas().length} התחומים` }] },
  { t: 'ערים', l: [...topCities.slice(0, 4).map((c) => ({ h: u(P.city(c!.he)), x: c!.name })), { h: u(P.page('cities')), x: 'כל הערים' }] },
  { t: 'מידע', l: [{ h: u(P.page('courts')), x: 'בתי משפט' }, { h: u(P.page('articles')), x: 'מדריכים ומאמרים' }, { h: u(P.page('tools')), x: 'כלים חינמיים' }, { h: u(P.page('editorial')), x: 'מדיניות עריכה' }] },
  { t: BRAND.name, l: [{ h: u(P.page('method')), x: 'איך מדרגים' }, { h: u(P.page('join')), x: 'פרסום לעורכי דין' }, { h: u(P.page('portal')), x: 'כניסה למשרדים' }, { h: u(P.page('about')), x: 'אודות' }, { h: u(P.page('contact')), x: 'צור קשר' }] },
];
const top = ['real-estate', 'divorce', 'labor-law', 'criminal', 'inheritance-wills', 'car-accidents'].map((s) => areas().find((a) => a.slug === s)).filter(Boolean);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{t}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="he-IL" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta name="theme-color" content="#0F2236" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={u('icon-512.png')} />
  <link rel="preload" href={u('fonts/noto-he-400.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={u('fonts/frl-he-600.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="alternate" type="application/rss+xml" title={`${BRAND.name}: מדריכים ומאמרים`} href={u('rss.xml')} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:site_name" content={BRAND.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={abs('og/default.png')} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script is:inline>try{var a=JSON.parse(localStorage.getItem('fol-a11y')||'null'),h=document.documentElement;if(a){if(a.size===1)h.classList.add('a11y-t1');if(a.size===2)h.classList.add('a11y-t2');['hc','ul','rf','nm'].forEach(function(k){if(a[k])h.classList.add('a11y-'+k)})}}catch(e){}</script>
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">דילוג לתוכן</a>
  <SiteTools />
  {PREVIEW && (
    <aside class="ribbon" aria-label="הודעה על גרסת התצוגה"><div class="wrap"><b>גרסת תצוגה לאישור.</b> המשרדים, הביקורות והכותבים באתר הם דוגמה בלבד. השם {BRAND.name} זמני.</div></aside>
  )}
  <header class="top on-dark">
    <div class="wrap top-in">
      <Logo tagline />
      <nav class="nav show-lg" aria-label="ניווט ראשי">
        {NAV.map((n) => <a href={n.href} aria-current={nav === n.k ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="top-end">
        <a class="toplink show-lg" href={u(P.page('method'))}>איך מדרגים</a>
        <a class="toplink show-lg" href={u(P.page('portal'))}>כניסה למשרדים</a>
        <a class="btn btn-o show-lg" href={u(P.page('join'))} aria-current={nav === 'join' ? 'page' : undefined}>פרסום לעורכי דין</a>
        <details class="dd hide-lg" data-dd>
          <summary aria-label="חיפוש"><Icon name="search" size={22} /></summary>
          <div class="dd-panel">
            <form class="stack gp12" action={u(P.page('search'))} method="get" role="search" style="padding-top:var(--sp-8)">
              <div class="field"><label class="lbl" for="hdr-q">תחום משפטי, בעיה או שם משרד</label><input class="inp" id="hdr-q" name="q" type="search" placeholder="לדוגמה: מקרקעין, פיטורים" autocomplete="off" /></div>
              <div class="field"><label class="lbl" for="hdr-c">עיר</label><select class="inp" id="hdr-c" name="city"><option value="">כל הארץ</option>{REGIONS.map((r) => <optgroup label={'אזור ' + r}>{cities().filter((c) => c.region === r).map((c) => <option value={c.he}>{c.name}</option>)}</optgroup>)}</select></div>
              <button class="btn btn-p btn-lg btn-block" type="submit"><Icon name="search" size={18} /><span>חיפוש</span></button>
            </form>
          </div>
        </details>
        <details class="dd hide-lg" data-dd>
          <summary aria-label="תפריט"><Icon name="menu" size={22} /></summary>
          <div class="dd-panel">
            <nav aria-label="ניווט ראשי בנייד" class="stack">
              {NAV.map((n) => <a class="mrow" href={n.href} aria-current={nav === n.k ? 'page' : undefined}><span>{n.label}</span><Icon name="chev" size={18} /></a>)}
              <a class="mrow" href={u(P.page('method'))}><span>איך מדרגים</span><Icon name="chev" size={18} /></a>
              <a class="mrow" href={u(P.page('portal'))}><span>כניסה למשרדים</span><Icon name="chev" size={18} /></a>
            </nav>
            <a class="btn btn-p btn-block mnav-cta" href={u(P.page('join'))}><Icon name="megaphone" size={18} /><span>פרסום לעורכי דין</span></a>
          </div>
        </details>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="foot on-dark">
    <div class="wrap foot-in">
      <div class="foot-grid show-lg">
        <div class="foot-col" style="gap:var(--sp-14)"><Logo /><p style="max-width:300px">{BRAND.short} האתר עצמאי ואינו קשור לאף משרד עורכי דין.</p></div>
        {FOOT.map((c) => <nav class="foot-col" aria-label={c.t}><strong>{c.t}</strong>{c.l.map((x) => <a href={x.h}>{x.x}</a>)}</nav>)}
      </div>
      <div class="hide-lg stack gp16"><Logo /><p>{BRAND.short} האתר עצמאי ואינו קשור לאף משרד עורכי דין.</p></div>
      <div class="facc hide-lg">
        {FOOT.map((c) => <details><summary><span>{c.t}</span><Icon name="chevd" size={18} /></summary><div class="lst">{c.l.map((x) => <a href={x.h}>{x.x}</a>)}</div></details>)}
      </div>
      <details class="seo"><summary><span>חיפושים לפי תחום ועיר</span><Icon name="chevd" size={18} /></summary>
        <div class="seo-grid">{seoAreas.map((a) => <div><strong style="color:var(--on-ink);display:block;padding-bottom:var(--sp-4)">{a!.title}</strong><a href={u(P.area(a!.he))}>{a!.title} בכל הארץ</a>{seoCities.filter((c) => hasCombo(a!.slug, c!.slug)).map((c) => <a href={u(P.areaCity(a!.he, c!.he))}>{a!.title} ב{c!.name}</a>)}</div>)}</div>
      </details>
      <div class="foot-bot">
        <p>המידע באתר כללי ואינו ייעוץ משפטי. פרטי המשרדים נאספו ממקורות ציבוריים ומעדכונים של המשרדים עצמם, והם אינם המלצה. משרד שמסומן ״משרד מקודם״ שילם על מיקום בולט, והדירוג אינו ניתן לרכישה.</p>
        <p style="white-space:nowrap">© {year} {BRAND.name}</p>
      </div>
      <nav class="foot-legal" aria-label="מידע משפטי">
        <a href={u(P.page('terms'))}>תנאי שימוש</a>
        <a href={u(P.page('privacy'))}>מדיניות פרטיות</a>
        <a href={u(P.page('cookies'))}>מדיניות עוגיות</a>
        <a href={u(P.page('cookies'))} data-ck-open>הגדרות עוגיות</a>
        <a href={u(P.page('a11y'))}>הצהרת נגישות</a>
        <a href={u(P.page('removal'))}>בקשה לתיקון או הסרה</a>
      </nav>
    </div>
  </footer>
  <script>
    // header drop downs: one open at a time, Escape closes, a click outside closes
    const dds = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-dd]'));
    dds.forEach((d) => d.addEventListener('toggle', () => {
      if (d.open) { dds.forEach((o) => { if (o !== d) o.open = false; }); d.querySelector<HTMLElement>('input, a.mrow')?.focus({ preventScroll: true }); }
    }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') dds.forEach((d) => { if (d.open) { d.open = false; d.querySelector('summary')?.focus(); } }); });
    document.addEventListener('click', (e) => { dds.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; }); });
  </script>
</body>
</html>
