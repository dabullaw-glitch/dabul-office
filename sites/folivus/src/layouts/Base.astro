---
// Page shell: head (title, description, canonical, hreflang, Open Graph, JSON-LD), preview ribbon, header, footer.
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { BRAND, PREVIEW } from '../config/brand';
import { P, u, abs } from '../config/routes';
import { areas, cities } from '../lib/data';
import { organization, website, graph } from '../lib/schema';

type Props = { title: string; description: string; path: string; schema?: any[]; noindex?: boolean; nav?: string; ogType?: string; bodyClass?: string; fullTitle?: boolean };
const { title, description, path, schema = [], noindex = false, nav = '', ogType = 'website', bodyClass, fullTitle = false } = Astro.props as Props;
const t = fullTitle ? title : `${title} | ${BRAND.name}`;
const canonical = abs(path);
const robots = PREVIEW || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ld = graph(organization(), website(), ...schema);
const NAV = [
  { k: 'areas', href: u(P.page('areas')), label: 'תחומים' },
  { k: 'cities', href: u(P.page('cities')), label: 'ערים' },
  { k: 'tools', href: u(P.page('tools')), label: 'כלים חינמיים' },
  { k: 'articles', href: u(P.page('articles')), label: 'מדריכים' },
  { k: 'courts', href: u(P.page('courts')), label: 'בתי משפט' },
];
const top = ['real-estate', 'divorce', 'labor-law', 'criminal', 'inheritance-wills', 'car-accidents'].map((s) => areas().find((a) => a.slug === s)).filter(Boolean);
const topCities = ['tel-aviv', 'jerusalem', 'haifa', 'rishon-lezion', 'petah-tikva', 'beer-sheva'].map((s) => cities().find((c) => c.slug === s)).filter(Boolean);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{t}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="he-IL" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta name="theme-color" content="#153d36" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={u('icon-512.png')} />
  <link rel="preload" href={u('fonts/plex-he-400.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={u('fonts/frl-he-900.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="alternate" type="application/rss+xml" title={`${BRAND.name}: מדריכים ומאמרים`} href={u('rss.xml')} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:site_name" content={BRAND.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={abs('og/default.png')} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">דילוג לתוכן</a>
  {PREVIEW && (
    <div class="ribbon" role="note"><div class="wrap"><span><b>גרסת תצוגה לאישור.</b> כל המשרדים, חוות הדעת והכותבים באתר הם דוגמה בלבד. השם {BRAND.name} זמני.</span></div></div>
  )}
  <header class="hdr">
    <div class="wrap">
      <Logo />
      <nav class="nav" aria-label="ניווט ראשי">
        {NAV.map((n) => <a href={n.href} aria-current={nav === n.k ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="hdr-end">
        <a class="icon-btn" href={u(P.page('search'))} aria-label="חיפוש באתר"><Icon name="search" /></a>
        <a class="btn btn-pine btn-sm join" href={u(P.page('join'))}>למשרדי עורכי דין</a>
        <button class="icon-btn menu-btn" type="button" aria-label="פתיחת תפריט" aria-expanded="false" aria-controls="menu" data-menu-open><Icon name="menu" /></button>
      </div>
    </div>
  </header>
  <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="תפריט">
    <div class="scrim" data-menu-close></div>
    <div class="panel">
      <button class="icon-btn close" type="button" aria-label="סגירת תפריט" data-menu-close><Icon name="close" /></button>
      {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href={u(P.page('search'))}>חיפוש</a>
      <a class="btn btn-pine" href={u(P.page('join'))}>למשרדי עורכי דין</a>
    </div>
  </div>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="ftr on-dark">
    <div class="wrap">
      <div class="ftr-top">
        <div class="about">
          <Logo dark />
          <p>{BRAND.short} האתר עצמאי ואינו קשור לאף משרד עורכי דין.</p>
        </div>
        <nav aria-labelledby="f1"><h2 id="f1">תחומים מבוקשים</h2><ul>{top.map((a) => <li><a href={u(P.area(a!.he))}>{a!.title}</a></li>)}<li><a href={u(P.page('areas'))}>כל התחומים</a></li></ul></nav>
        <nav aria-labelledby="f2"><h2 id="f2">ערים</h2><ul>{topCities.map((c) => <li><a href={u(P.city(c!.he))}>עורכי דין ב{c!.name}</a></li>)}<li><a href={u(P.page('cities'))}>כל הערים</a></li></ul></nav>
        <nav aria-labelledby="f3"><h2 id="f3">מידע ושירותים</h2><ul>
          <li><a href={u(P.page('articles'))}>מדריכים ומאמרים</a></li>
          <li><a href={u(P.page('tools'))}>מחשבונים ומחוללי מסמכים</a></li>
          <li><a href={u(P.page('courts'))}>בתי משפט</a></li>
          <li><a href={u(P.page('method'))}>איך בנויות הרשימות והדירוג</a></li>
          <li><a href={u(P.page('editorial'))}>מדיניות עריכה</a></li>
        </ul></nav>
        <nav aria-labelledby="f4"><h2 id="f4">למשרדים</h2><ul>
          <li><a href={u(P.page('join'))}>הצטרפות וחבילות</a></li>
          <li><a href={u(P.page('claim'))}>אישור בעלות על פרופיל</a></li>
          <li><a href={u(P.page('removal'))}>תיקון או הסרת פרטים</a></li>
          <li><a href={u(P.page('contact'))}>צור קשר</a></li>
          <li><a href={u(P.page('about'))}>אודות</a></li>
        </ul></nav>
      </div>
      <div class="ftr-bottom">
        <p class="mb0">פרטי המשרדים הם פרטים עסקיים ממקורות ציבוריים ומעדכונים של המשרדים עצמם. הם אינם המלצה, והמידע באתר אינו ייעוץ משפטי. משרד שמסומן "משרד מקודם" שילם על מיקום בולט, והדירוג אינו ניתן לרכישה. <a href={u(P.page('removal'))}>בקשה לתיקון או הסרת פרטים</a>.</p>
        <div class="ftr-legal">
          <span>© {year} {BRAND.name}</span>
          <a href={u(P.page('terms'))}>תנאי שימוש</a>
          <a href={u(P.page('privacy'))}>מדיניות פרטיות</a>
          <a href={u(P.page('a11y'))}>הצהרת נגישות</a>
          <a href={u(P.page('removal'))}>בקשת הסרה</a>
        </div>
      </div>
    </div>
  </footer>
  <script>
    const menu = document.getElementById('menu')!;
    const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    const setOpen = (o: boolean) => {
      menu.classList.toggle('open', o); openBtn?.setAttribute('aria-expanded', String(o));
      document.body.style.overflow = o ? 'hidden' : '';
      if (o) menu.querySelector<HTMLElement>('.close')?.focus(); else openBtn?.focus();
    };
    openBtn?.addEventListener('click', () => setOpen(true));
    menu.querySelectorAll('[data-menu-close]').forEach((b) => b.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('open')) setOpen(false); });
  </script>
</body>
</html>
