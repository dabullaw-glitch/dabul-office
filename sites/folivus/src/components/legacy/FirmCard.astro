---
// One firm in a list. Paid placement always carries the "מקודם" label; sample data carries "דוגמה".
import Icon from '../Icon.astro';
import Stars from './Stars.astro';
import { P, u } from '../../config/routes';
import { areaBySlug, cityBySlug, avg, type Firm } from '../../lib/data';
import { SETTINGS } from '../../config/brand';
const { f, promo = false, area, level = 3 } = Astro.props as { f: Firm; promo?: boolean; area?: string; level?: 2 | 3 };
const city = cityBySlug(f.city);
const shown = [...(area ? [area] : []), ...f.areas.filter((a) => a !== area)].slice(0, 3).map((s) => areaBySlug(s)).filter(Boolean);
const more = f.areas.length - shown.length;
const initials = f.name.replace(/[("'].*$/, '').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('');
const r = avg(f.reviews);
const H = level === 2 ? 'h2' : 'h3';
---
<article class={'firm' + (promo ? ' promo' : '')}>
  <div class="firm-top">
    <div class="mono" aria-hidden="true">{initials}</div>
    <div>
      <H style="display:inline"><a href={u(P.firm(f.slug))}>{f.name}</a></H>
      <span class="badges">
        {promo && <span class="badge b-promo"><Icon name="megaphone" />משרד מקודם</span>}
        {f.claimed && <span class="badge b-ok"><Icon name="check" />המשרד אישר את הפרטים</span>}
        {f.isSample && <span class="badge b-sample">דוגמה</span>}
      </span>
      <div class="meta mt1">
        {city && <span><Icon name="pin" />{city.name}</span>}
        {f.reviews.length > 0 && <span class="rating"><Stars value={r} /><b>{r.toFixed(1)}</b><span class="muted">({f.reviews.length} חוות דעת מאומתות)</span></span>}
        {SETTINGS.show_google_ratings && f.google.rating != null && <span class="rating gr" title="דירוג מגוגל"><span class="xs muted">דירוג מגוגל</span><b>{Number(f.google.rating).toFixed(1)}</b><span class="muted">({(f.google.count || 0).toLocaleString('he-IL')})</span><span class="gattr" lang="en">Google</span></span>}
      </div>
      <div class="tags">
        {shown.map((a) => <span class="tag">{a!.name}</span>)}
        {more > 0 && <span class="tag">ועוד {more}</span>}
      </div>
    </div>
  </div>
  <div class="acts">
    <a class="btn btn-pine btn-sm" href={u(P.firm(f.slug))}>לפרופיל המשרד</a>
    {f.phone && <a class="btn btn-line btn-sm" href={'tel:' + f.phone.replace(/[^0-9+]/g, '')}><Icon name="phone" /><span>{f.phone}</span></a>}
  </div>
</article>
