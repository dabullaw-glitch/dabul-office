---
import { P, u } from '../../config/routes';
const { title = 'עורכי דין? הפרופיל שלכם כבר מחכה', text = 'אשרו בעלות על הפרופיל בחינם, עדכנו תחומים, שעות ופרטי קשר, וקבלו חוות דעת מאומתות מלקוחות.' } = Astro.props as { title?: string; text?: string };
---
<div class="band on-dark">
  <div>
    <span class="eyebrow">למשרדי עורכי דין</span>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="acts">
    <a class="btn btn-brass" href={u(P.page('claim'))}>אישור בעלות על פרופיל</a>
    <a class="btn btn-ghost" href={u(P.page('join'))}>חבילות קידום</a>
  </div>
</div>
