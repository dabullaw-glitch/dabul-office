---
// Area + city finder. Without JavaScript the form goes to the search page; with it, straight to the area (+city) page.
import Icon from '../Icon.astro';
import { areaGroups, cities, REGIONS } from '../../lib/data';
import { P, u } from '../../config/routes';
const { area = '', city = '', id = 'fd' } = Astro.props as { area?: string; city?: string; id?: string };
const cs = cities();
---
<div class="finder">
  <form action={u(P.page('search'))} method="get" data-finder data-base={u('')}>
    <div>
      <label for={id + '-a'}>תחום משפטי</label>
      <select id={id + '-a'} name="area" required>
        <option value="">בחרו תחום</option>
        {areaGroups().map((g) => (
          <optgroup label={g.group}>{g.items.map((a) => <option value={a.he} selected={a.slug === area}>{a.name}</option>)}</optgroup>
        ))}
      </select>
    </div>
    <div>
      <label for={id + '-c'}>עיר</label>
      <select id={id + '-c'} name="city">
        <option value="">כל הארץ</option>
        {REGIONS.map((r) => (
          <optgroup label={'אזור ' + r}>{cs.filter((c) => c.region === r).map((c) => <option value={c.he} selected={c.slug === city}>{c.name}</option>)}</optgroup>
        ))}
      </select>
    </div>
    <button class="btn btn-brass" type="submit"><Icon name="search" />חיפוש משרדים</button>
  </form>
</div>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-finder]').forEach((f) => {
    f.addEventListener('submit', (e) => {
      const a = (f.elements.namedItem('area') as HTMLSelectElement).value;
      const c = (f.elements.namedItem('city') as HTMLSelectElement).value;
      if (!a) return;
      e.preventDefault();
      location.href = f.dataset.base + a + '/' + (c ? c + '/' : '');
    });
  });
</script>
