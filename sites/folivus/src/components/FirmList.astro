---
// Paid cards apart (labelled "מודעה", outside the ranking), then the ranking in the published order.
import FirmRow from './FirmRow.astro';
import { P, u } from '../config/routes';
import type { Firm } from '../lib/data';
const { featured, rest, area, city, emptyText, restTitle = 'הדירוג', id = 'fl', compare = true } = Astro.props as { featured: Firm[]; rest: Firm[]; area?: string; city?: string; emptyText?: string; promoTitle?: string; restTitle?: string; id?: string; compare?: boolean };
---
{featured.length > 0 && (
  <section aria-label="מודעות" class="stack gp8">
    <p class="adlbl"><b>מודעה</b>מוצג כאן בתשלום, מחוץ לדירוג</p>
    <div class="frs">{featured.map((f) => <FirmRow f={f} promo area={area} city={city} compare={compare} />)}</div>
  </section>
)}
{rest.length > 0 && (
  <section aria-labelledby={id + '-r'} class="stack gp8">
    <h2 class="ranklbl" id={id + '-r'}>{restTitle}</h2>
    <p class="cap num" aria-live="polite" data-lt-count={id + '-rank'}></p>
    <div class="frs" id={id + '-rank'}>{rest.map((f, i) => <FirmRow f={f} rank={i + 1} area={area} city={city} compare={compare} />)}</div>
  </section>
)}
{featured.length + rest.length === 0 && (
  <div class="empty">
    <p>{emptyText || 'עדיין אין משרדים ברשימה הזו.'}</p>
    <p class="small">עורכי דין שעובדים בתחום ובאזור יכולים <a class="lnk" href={u(P.page('join'))}>להצטרף לאתר</a>.</p>
  </div>
)}
