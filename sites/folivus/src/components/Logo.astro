---
// Wordmark: a quiet pillar mark and the name in Frank Ruhl Libre. The name comes from src/config/brand.ts only.
import Icon from './Icon.astro';
import { BRAND } from '../config/brand';
import { u } from '../config/routes';
const { tagline = false } = Astro.props as { tagline?: boolean };
---
<a class="logo" href={u('')}><span aria-hidden="true" style="display:inline-flex;color:var(--brass-on-ink)"><Icon name="pillar" size={24} /></span><span class="logo-w">{BRAND.name}</span><span class="sr">, לדף הבית</span>{tagline && <span class="logo-d show-lg">האינדקס הארצי של עורכי הדין</span>}</a>
