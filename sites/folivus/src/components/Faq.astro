---
import type { Faq } from '../lib/data';
const { items, title = 'שאלות נפוצות', id = 'faq' } = Astro.props as { items: Faq[]; title?: string; id?: string };
---
{items.length > 0 && (
  <section aria-labelledby={id} class="mt3">
    <h2 id={id}>{title}</h2>
    <div class="faq">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <div class="a">{f.a}</div>
        </details>
      ))}
    </div>
  </section>
)}
