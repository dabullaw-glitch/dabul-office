---
import Icon from './Icon.astro';
const { kind = 'info' } = Astro.props as { kind?: 'info' | 'tool' | 'list' };
const T = {
  info: 'המידע כאן הוא מידע כללי ואינו ייעוץ משפטי. כל מקרה שונה, ולפני החלטה כדאי להתייעץ עם עורך דין.',
  tool: 'התוצאה היא הערכה כללית לפי הנתונים שהוזנו והכללים שמפורטים בעמוד. היא אינה ייעוץ משפטי או ייעוץ מס ואינה מחליפה בדיקה של עורך דין או של רשות המסים.',
  list: 'הרשימה מבוססת על פרטים עסקיים ממקורות ציבוריים ועל מה שמשרדים עדכנו בעצמם. היא אינה המלצה. משרד שמסומן "משרד מקודם" שילם על מיקום בולט, וזה לא משפיע על חוות הדעת או על הדירוג. האתר אינו מפנה פניות למשרדים ואינו גובה עמלה על פנייה.',
}[kind];
---
<p class="note"><Icon name="info" size={18} /><span>{T}</span></p>
