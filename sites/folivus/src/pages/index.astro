---
// Home (direction ג "מה מגיע לי"): the page opens with a rights check written as one sentence the visitor completes,
// by life event. Then the questions people check (each one leads to a free tool), then topics that lead to firms,
// the national package slot (always "מודעה"), guides, and a short line for lawyers.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FirmRow from '../components/FirmRow.astro';
import { BRAND } from '../config/brand';
import { P, u } from '../config/routes';
import { areas, firms, tools, articles, homeFeatured, areaBySlug } from '../lib/data';
import { itemList } from '../lib/schema';
import { readMinutes } from '../lib/md';

const fs = await firms();
const featured = homeFeatured(fs).slice(0, 3);
const T = (s: string) => tools().find((t) => t.slug === s);
const tu = (s: string) => (T(s) ? u(P.tool(T(s)!.he)) : u(P.page('tools')));
const au = (s: string) => (areaBySlug(s) ? u(P.area(areaBySlug(s)!.he)) : u(P.page('areas')));
const count = (s: string) => fs.filter((f) => f.areas.includes(s)).length;
const opts = (list: [string, string][], sel = 0) => list.map(([v, l], i) => ({ v, l, s: i === sel }));
// the life events (direction א) as the tabs of the check (direction ג)
const EVENTS = [
  { k: 'fired', t: 'פוטרתי', area: 'labor-law', tool: tu('severance-pay'), cta: 'מה מגיע לי?' },
  { k: 'home', t: 'קונים דירה', area: 'real-estate', tool: tu('purchase-tax'), cta: 'כמה מס נשלם?' },
  { k: 'divorce', t: 'מתגרשים', area: 'divorce', tool: tu('child-support-estimate'), cta: 'מה בודקים קודם?' },
  { k: 'accident', t: 'תאונה', area: 'work-accidents', tool: tu('work-injury-allowance'), cta: 'מה מגיע לי?' },
  { k: 'debt', t: 'הוצאה לפועל', area: 'enforcement', tool: tu('debt-rescheduling-agreement'), cta: 'מה אפשר לעשות?' },
  { k: 'estate', t: 'ירושה', area: 'inheritance-wills', tool: tu('statutory-inheritance'), cta: 'מי יורש?' },
  { k: 'other', t: 'משהו אחר', area: '', tool: '', cta: 'למי לפנות?' },
];
const years = opts([['1', 'שנה'], ['2', 'שנתיים'], ['3', '3 שנים'], ['4', '4 שנים'], ['5', '5 שנים'], ['7', '7 שנים'], ['10', '10 שנים'], ['15', '15 שנים'], ['20', '20 שנים']], 3);
const QS = [
  ['כמה פיצויי פיטורים מגיעים לי?', 'severance-pay'], ['בעל הבית לא מחזיר את הפיקדון. מה כותבים לו?', 'deposit-return-letter'],
  ['אין צוואה. מי יורש ובאיזה חלק?', 'statutory-inheritance'], ['כמה מס רכישה נשלם על הדירה?', 'purchase-tax'],
  ['נפגעתי בעבודה. כמה דמי פגיעה מגיעים לי?', 'work-injury-allowance'], ['כמה דמי הבראה מגיעים לי השנה?', 'recuperation-pay'],
  ['הטיסה התעכבה. מגיע לי פיצוי?', 'flight-delay-compensation'], ['האם התביעה שלי כבר התיישנה?', 'limitation-period'],
].map(([q, s]) => ({ q, t: T(s) })).filter((x) => x.t);
const TOPICS = [
  ['פוטרתי או לא קיבלתי שכר', 'labor-law'], ['קונים או מוכרים דירה', 'real-estate'], ['ליקויים בדירה חדשה', 'construction-defects'], ['מתגרשים או נפרדים', 'divorce'],
  ['צוואה וירושה', 'inheritance-wills'], ['תאונת דרכים', 'car-accidents'], ['חובות והוצאה לפועל', 'enforcement'], ['זימון לחקירה', 'criminal'], ['שכירות ופיקדון', 'leases'],
].map(([t, s]) => ({ t, a: areaBySlug(s) })).filter((x) => x.a);
const arts = articles().slice(0, 4);
const title = `${BRAND.name}: מה מגיע לי? בדיקת זכויות, מחשבונים ועורכי דין`;
const description = 'בודקים זכויות בכמה דקות, בחינם ובלי הרשמה: פיטורים, דירה, גירושין, תאונה, חובות וירושה. אם צריך עזרה, ממשיכים למשרד שעוסק בדיוק בזה.';
---
<Base title={title} fullTitle description={description} path="" schema={[itemList('בדיקות וכלים', QS.map((x) => ({ name: x.q, path: P.tool(x.t!.he) })))]}>
  <section class="chk-hero" aria-labelledby="hero-h">
    <div class="wrap chk-grid">
      <div>
        <p class="kick">זכויות, חישובים, ועורכי דין כשצריך</p>
        <h1 id="hero-h">מה מגיע לי<span class="q">?</span></h1>
        <p class="lede">בודקים זכויות בכמה דקות, בחינם ובלי הרשמה. אם צריך עזרה, ממשיכים למשרד שעוסק בדיוק בזה.</p>
        <ul class="tstrip show-lg"><li><b>בחינם</b>כל הבדיקות</li><li><b>בלי הרשמה</b>ובלי טלפון</li><li><b>שקוף</b>איך מדרגים</li></ul>
      </div>
      <div class="ccard" data-check data-areas={JSON.stringify(Object.fromEntries(EVENTS.map((e) => [e.k, { area: e.area, tool: e.tool, au: e.area ? au(e.area) : '' }])))} data-area-urls={JSON.stringify(Object.fromEntries(areas().map((a) => [a.slug, { h: u(P.area(a.he)), t: a.title, g: a.group }])))}>
        <div class="ctabs" role="tablist" aria-label="מה קרה?">
          {EVENTS.map((e, i) => <button type="button" role="tab" id={'tab-' + e.k} aria-controls={'pane-' + e.k} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={e.k}>{e.t}</button>)}
        </div>
        <form class="cpane" role="tabpanel" id="pane-fired" aria-labelledby="tab-fired" data-pane="fired">
          <p class="sent"><span class="fill"><label class="sr" for="c1">מה קרה</label><select id="c1" name="reason"><option value="dismissal">פוטרתי</option><option value="resignation_entitled">התפטרתי בנסיבות מזכות</option></select><Icon name="chevd" size={16} /></span> אחרי <span class="fill"><label class="sr" for="c2">כמה זמן עבדתם</label><select id="c2" name="years">{years.map((o) => <option value={o.v} selected={o.s}>{o.l}</option>)}</select><Icon name="chevd" size={16} /></span> בעבודה, בשכר של <span class="fill"><label class="sr" for="c3">שכר חודשי ברוטו בשקלים</label><input id="c3" name="salary" inputmode="numeric" value="12,000" dir="ltr" /></span> ₪ לחודש.</p>
        </form>
        <form class="cpane" role="tabpanel" id="pane-home" aria-labelledby="tab-home" data-pane="home" hidden>
          <p class="sent">אנחנו קונים <span class="fill"><label class="sr" for="h1">איזו דירה</label><select id="h1" name="type"><option value="single">דירה יחידה</option><option value="replacement">דירה במקום הקיימת</option><option value="additional">דירה נוספת</option></select><Icon name="chevd" size={16} /></span> במחיר <span class="fill"><label class="sr" for="h2">מחיר הדירה בשקלים</label><input id="h2" name="price" inputmode="numeric" value="2,400,000" dir="ltr" /></span> ₪.</p>
        </form>
        <form class="cpane" role="tabpanel" id="pane-divorce" aria-labelledby="tab-divorce" data-pane="divorce" hidden>
          <p class="sent">אנחנו <span class="fill"><label class="sr" for="d1">מצב</label><select id="d1" name="kind"><option>מתגרשים</option><option>נפרדים בלי נישואים</option></select><Icon name="chevd" size={16} /></span> ויש לנו ילדים בגילים <span class="fill"><label class="sr" for="d2">גילי הילדים, מופרדים בפסיק</label><input id="d2" name="ages" value="5, 9" dir="ltr" /></span>.</p>
        </form>
        <form class="cpane" role="tabpanel" id="pane-accident" aria-labelledby="tab-accident" data-pane="accident" hidden>
          <p class="sent">נפגעתי ב<span class="fill"><label class="sr" for="a1">סוג התאונה</label><select id="a1" name="kind"><option value="work">תאונת עבודה</option><option value="road">תאונת דרכים</option></select><Icon name="chevd" size={16} /></span> ולא עבדתי <span class="fill"><label class="sr" for="a2">ימים בלי עבודה</label><select id="a2" name="days"><option value="14">שבועיים</option><option value="30" selected>חודש</option><option value="60">חודשיים</option><option value="91">3 חודשים</option></select><Icon name="chevd" size={16} /></span>, בשכר של <span class="fill"><label class="sr" for="a3">שכר חודשי בשקלים</label><input id="a3" name="salary" inputmode="numeric" value="10,000" dir="ltr" /></span> ₪.</p>
        </form>
        <form class="cpane" role="tabpanel" id="pane-debt" aria-labelledby="tab-debt" data-pane="debt" hidden>
          <p class="sent">קיבלתי <span class="fill"><label class="sr" for="b1">מה קיבלתם</label><select id="b1" name="kind"><option>אזהרה</option><option>הודעה על עיקול</option><option>הודעה על פתיחת תיק</option></select><Icon name="chevd" size={16} /></span> מההוצאה לפועל על חוב של <span class="fill"><label class="sr" for="b2">סכום החוב בשקלים</label><input id="b2" name="sum" inputmode="numeric" value="20,000" dir="ltr" /></span> ₪.</p>
        </form>
        <form class="cpane" role="tabpanel" id="pane-estate" aria-labelledby="tab-estate" data-pane="estate" hidden>
          <p class="sent">הורה שלי נפטר בלי צוואה. נשארו <span class="fill"><label class="sr" for="e1">בן או בת זוג</label><select id="e1" name="spouse"><option value="married">בן או בת זוג</option><option value="none">בלי בן או בת זוג</option></select><Icon name="chevd" size={16} /></span> ו־<span class="fill"><label class="sr" for="e2">מספר הילדים</label><select id="e2" name="kids"><option value="1">ילד אחד</option><option value="2" selected>2 ילדים</option><option value="3">3 ילדים</option><option value="4">4 ילדים</option><option value="5">5 ילדים</option></select><Icon name="chevd" size={16} /></span>.</p>
        </form>
        <form class="cpane" role="tabpanel" id="pane-other" aria-labelledby="tab-other" data-pane="other" hidden>
          <div class="field"><label class="lbl" for="o1">ספרו במשפט אחד מה קרה</label><textarea id="o1" class="inp" rows="3" placeholder="לדוגמה: השכן בנה מחסן על השטח המשותף"></textarea></div>
          <div class="stack gp8" aria-live="polite" data-story-out style="margin-top:var(--sp-10)"></div>
        </form>
        <div class="cact"><button class="btn btn-v btn-block" type="button" data-go>מה מגיע לי?</button></div>
        <p class="disc">הבדיקה כללית ואינה ייעוץ משפטי. הנתונים נשארים בדפדפן שלכם.</p>
      </div>
      <ul class="tstrip hide-lg"><li><b>בחינם</b>כל הבדיקות</li><li><b>בלי הרשמה</b>ובלי טלפון</li><li><b>שקוף</b>איך מדרגים</li></ul>
    </div>
  </section>

  <section class="sec qhub" aria-labelledby="q-h" style="padding-top:var(--sp-32)">
    <div class="wrap">
      <h2 id="q-h">שאלות שאנשים בודקים</h2>
      <p class="muted" style="margin-top:var(--sp-6)">כל שאלה מובילה לבדיקה קצרה, ואחריה למשרדים שעוסקים בנושא.</p>
      <ul class="qlist">{QS.map((x) => <li><a class="qi" href={u(P.tool(x.t!.he))}><span class="tx"><span class="tt">{x.q}</span><span class="ty"><Icon name={x.t!.type === 'generator' ? 'doc' : 'calc'} size={15} />{x.t!.type === 'generator' ? 'מכתב מוכן' : 'מחשבון'}</span></span><Icon name="chev" size={20} /></a></li>)}</ul>
      <a class="more" href={u(P.page('tools'))} style="margin-top:var(--sp-10)"><span>לכל {tools().length} הבדיקות והמחשבונים</span><Icon name="chev" size={18} /></a>
    </div>
  </section>

  <section class="sec" aria-labelledby="t-h" style="background:var(--card);border-block:1px solid var(--line)">
    <div class="wrap">
      <h2 class="h2" id="t-h">כשצריך עורך דין</h2>
      <p class="muted" style="margin-top:var(--sp-6);max-width:60ch">כל נושא מוביל לרשימת משרדים שעוסקים בו, עם מפה. הרשימה מסודרת לפי קשר לתחום, ביקורות מאומתות ומרחק, ותשלום לא משנה את הסדר.</p>
      <div class="topics" style="margin-top:var(--sp-16)">{TOPICS.map((x) => <a href={u(P.area(x.a!.he))}><span class="stack"><b>{x.t}</b><span>{x.a!.title}{count(x.a!.slug) > 0 ? ` · ${count(x.a!.slug) === 1 ? 'משרד אחד' : count(x.a!.slug) + ' משרדים'}` : ''}</span></span><Icon name="chev" size={18} /></a>)}</div>
      <div class="flex" style="margin-top:var(--sp-16)"><a class="more" href={u(P.page('areas'))}><span>כל {areas().length} התחומים</span><Icon name="chev" size={18} /></a><a class="more" href={u(P.page('cities'))}><span>לפי עיר, במפה</span><Icon name="chev" size={18} /></a></div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="sec" aria-labelledby="ad-h" style="padding-bottom:0">
      <div class="wrap stack gp8">
        <h2 class="sr" id="ad-h">מודעות</h2>
        <p class="adlbl"><b>מודעה</b>משרדים בפרסום ארצי. מוצגים בתשלום, מחוץ לכל דירוג.</p>
        <div class="frs">{featured.map((f) => <FirmRow f={f} promo tile />)}</div>
      </div>
    </section>
  )}

  {arts.length > 0 && (
    <section class="sec" aria-labelledby="g-h">
      <div class="wrap">
        <h2 class="h2" id="g-h">לקרוא לפני שמחליטים</h2>
        <div class="glist" style="margin-top:var(--sp-16)">{arts.map((a, i) => <a class="gitem" href={u(P.article(a.he))}><span class="gn num">{i + 1}</span><h3 class="h4" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">{a.title}</h3><span class="cap">{areaBySlug(a.areas[0])?.name || 'מדריך'} · {readMinutes(a.body)} דק׳ קריאה{a.draft ? ' · טיוטה' : ''}</span></a>)}</div>
        <a class="more" href={u(P.page('articles'))} style="margin-top:var(--sp-10)"><span>לכל המדריכים</span><Icon name="chev" size={18} /></a>
      </div>
    </section>
  )}

  <section class="sec" aria-label="לעורכי דין" style="padding-top:0">
    <div class="wrap"><div class="how" style="display:flex;flex-wrap:wrap;gap:var(--sp-12);align-items:center;justify-content:space-between">
      <p style="margin:0;color:var(--text)"><b>עורכי דין?</b> הפרופיל במדריך בחינם. מודעות מסומנות תמיד, ולא משנות את הסדר.</p>
      <a class="btn btn-s" href={u(P.page('join'))}>פרסום לעורכי דין</a>
    </div></div>
  </section>
  <script>import '../scripts/home-check';</script>
</Base>
