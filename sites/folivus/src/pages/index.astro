---
import Base from '../layouts/Base.astro';
import Finder from '../components/legacy/Finder.astro';
import Icon from '../components/Icon.astro';
import GroupIcon from '../components/legacy/GroupIcon.astro';
import FirmCard from '../components/legacy/FirmCard.astro';
import JoinBand from '../components/legacy/JoinBand.astro';
import { BRAND } from '../config/brand';
import { P, u } from '../config/routes';
import { areas, areaGroups, cities, REGIONS, firms, tools, articles, courts, fmtDate, homeFeatured } from '../lib/data';
import { itemList } from '../lib/schema';
import '../styles/legacy-home.css';

const fs = await firms();
const featured = homeFeatured(fs).slice(0, 6);
const popular = ['real-estate', 'divorce', 'labor-law', 'criminal', 'inheritance-wills', 'car-accidents', 'insolvency'].map((s) => areas().find((a) => a.slug === s)!).filter(Boolean);
const ts = tools().slice(0, 6);
const as = articles().slice(0, 3);
const cs = cities();
const title = `${BRAND.name}: מדריך עורכי הדין בישראל לפי תחום ועיר`;
const description = 'מוצאים עורך דין לפי תחום ועיר, קוראים מדריכים משפטיים בשפה פשוטה עם מקורות ותאריך עדכון, ומשתמשים במחשבונים ובמחוללי מסמכים חינמיים.';
---
<Base title={title} fullTitle description={description} path="" schema={[itemList('תחומי משפט', areas().map((a) => ({ name: a.title, path: P.area(a.he) })))]}>
  <div class="lh">
  <section class="hero on-dark">
    <div class="wrap hero-in">
      <div>
        <span class="eyebrow">{BRAND.tagline}</span>
        <h1>מוצאים עורך דין <em>לפי תחום ועיר.</em></h1>
        <p class="lead">רשימות מסודרות של משרדים בכל הארץ, חוות דעת של לקוחות שעברו אימות, ומדריכים משפטיים שנכתבים ונבדקים עם מקורות רשמיים.</p>
        <Finder id="hero" />
        <div class="quick">
          <span>חיפושים נפוצים:</span>
          {popular.slice(0, 6).map((a) => <a href={u(P.area(a.he))}>{a.title}</a>)}
        </div>
      </div>
      <aside class="promise" aria-labelledby="pr-h">
        <h2 id="pr-h">מה תמצאו כאן</h2>
        <ul>
          <li><span class="ic"><Icon name="shield" /></span><span><b>חוות דעת מאומתות בלבד</b>כל חוות דעת עוברת אימות של הלקוח לפני פרסום, ומוצגות גם ביקורות שאינן מושלמות.</span></li>
          <li><span class="ic"><Icon name="megaphone" /></span><span><b>קידום תמיד מסומן</b>משרד ששילם על מיקום בולט מסומן "משרד מקודם". הדירוג אינו ניתן לרכישה.</span></li>
          <li><span class="ic"><Icon name="book" /></span><span><b>מידע עם מקורות</b>בכל מדריך יש כותב, תאריך עדכון ורשימת מקורות רשמיים.</span></li>
          <li><span class="ic"><Icon name="calc" /></span><span><b>כלים חינמיים</b>מחשבונים ומחוללי מסמכים שעובדים בדפדפן, בלי הרשמה.</span></li>
        </ul>
      </aside>
    </div>
  </section>
  <div class="stats on-dark" aria-label="האתר במספרים">
    <div class="wrap">
      <div class="stat"><b>{areas().length}</b><span>תחומי משפט</span></div>
      <div class="stat"><b>{cs.length}</b><span>ערים ויישובים</span></div>
      <div class="stat"><b>{tools().length}</b><span>כלים חינמיים</span></div>
      <div class="stat"><b>{articles().length + areas().filter((a) => a.guide).length}</b><span>מדריכים ומאמרים</span></div>
    </div>
  </div>

  <section class="sec" aria-labelledby="areas-h">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">תחומי משפט</span><h2 id="areas-h">באיזה נושא אתם צריכים עורך דין?</h2><p>בחרו תחום כדי לראות משרדים בכל הארץ או בעיר שלכם, ומדריך שמסביר את התחום בשפה פשוטה.</p></div>
        <a class="more" href={u(P.page('areas'))}>כל התחומים<Icon name="arrow" /></a>
      </div>
      <div class="grid g4">
        {areaGroups().map((g) => (
          <div class="card group-card">
            <header><GroupIcon group={g.group} /><h3>{g.group}</h3></header>
            <ul class="links">{g.items.slice(0, 6).map((a) => <li><a href={u(P.area(a.he))}>{a.name}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec white" aria-labelledby="how-h">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">איך זה עובד</span><h2 id="how-h">שלושה צעדים לבחירה רגועה</h2></div></div>
      <div class="grid g3 steps">
        <div class="step"><h3>מבינים את התחום</h3><p class="muted">בכל עמוד תחום יש מדריך קצר שמסביר מה עורך הדין עושה, מה שואלים בפגישה הראשונה ואילו מסמכים להכין.</p></div>
        <div class="step"><h3>משווים משרדים</h3><p class="muted">רואים תחומי עיסוק, כתובת, שעות, חוות דעת מאומתות ופרטים שהמשרד עדכן בעצמו.</p></div>
        <div class="step"><h3>פונים ישירות</h3><p class="muted">יוצרים קשר ישירות עם המשרד בטלפון או באתר שלו. האתר לא מתווך, לא מעביר פניות ולא גובה מכם תשלום.</p></div>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="sec" aria-labelledby="ft-h">
      <div class="wrap">
        <div class="sec-head"><div><span class="eyebrow">משרדים מקודמים</span><h2 id="ft-h">משרדים בפרופיל ארצי</h2><p>מודעה: משרדים ששילמו על הצגה בעמוד הבית. התשלום לא משפיע על הדירוג או על חוות הדעת.</p></div></div>
        <div class="firms">{featured.map((f) => <FirmCard f={f} promo />)}</div>
      </div>
    </section>
  )}

  <section class={'sec' + (featured.length ? ' white' : '')} aria-labelledby="tools-h">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">כלים חינמיים</span><h2 id="tools-h">מחשבונים ומחוללי מסמכים</h2><p>חישוב ראשוני ומסמכים פשוטים, ישר בדפדפן. כל כלי מציין את המקורות ואת תאריך העדכון.</p></div>
        <a class="more" href={u(P.page('tools'))}>כל הכלים<Icon name="arrow" /></a>
      </div>
      {ts.length ? (
        <div class="grid g3">{ts.map((t) => (
          <a class="card tcard" href={u(P.tool(t.he))}><span class="gicon"><Icon name={t.type === 'generator' ? 'doc' : 'calc'} /></span><span><h3>{t.name}</h3><p>{t.description}</p></span></a>
        ))}</div>
      ) : <div class="empty">הכלים בהכנה.</div>}
    </div>
  </section>

  <section class="sec" aria-labelledby="art-h">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">מדריכים</span><h2 id="art-h">מידע משפטי בשפה פשוטה</h2><p>מאמרים חדשים שלוש פעמים בשבוע, עם כותב, מקורות ותאריך עדכון.</p></div>
        <a class="more" href={u(P.page('articles'))}>לכל המדריכים<Icon name="arrow" /></a>
      </div>
      {as.length ? (
        <div class="grid g3">{as.map((a) => (
          <a class="card acard" href={u(P.article(a.he))}>
            <span class="kicker">{a.areas.map((s) => areas().find((x) => x.slug === s)?.name).filter(Boolean)[0] || 'מדריך'}</span>
            <h3>{a.title}</h3><p>{a.description}</p>
            <span class="afoot"><span>{fmtDate(a.updated)}</span><span>{Math.max(1, Math.round(a.words / 200))} דקות קריאה</span></span>
          </a>
        ))}</div>
      ) : (
        <div class="grid g3">{areas().filter((a) => a.guide).slice(0, 3).map((a) => (
          <a class="card acard" href={u(P.area(a.he))}><span class="kicker">מדריך תחום</span><h3>{a.title}: מה חשוב לדעת</h3><p>{a.description}</p></a>
        ))}</div>
      )}
    </div>
  </section>

  <section class="sec white" aria-labelledby="city-h">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">לפי מקום</span><h2 id="city-h">עורכי דין לפי עיר</h2></div>
        <a class="more" href={u(P.page('cities'))}>כל הערים<Icon name="arrow" /></a>
      </div>
      <div class="regions">
        {REGIONS.map((r) => (
          <div><h3>{r}</h3><ul>{cs.filter((c) => c.region === r).slice(0, 10).map((c) => <li><a href={u(P.city(c.he))}>{c.name}</a></li>)}</ul></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap"><JoinBand /></div>
  </section>
  </div>
</Base>
