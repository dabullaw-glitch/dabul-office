---
// Design direction A: warm consumer service. Rubik (headings) + Assistant (text). One confident blue, sand neutrals.
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/600.css';
import '@fontsource/rubik/700.css';
import '@fontsource/assistant/400.css';
import '@fontsource/assistant/600.css';
import '@fontsource/assistant/700.css';
import DesignBase from '../layouts/DesignBase.astro';
import { BRAND } from '../config/brand';
import { homeData, DRAW } from '../lib/design';
const d = await homeData();
const L = d.links;
---
<DesignBase title="כיוון א" label="א">
<div class="A">
  <header class="hd">
    <div class="w hd-in">
      <a class="brand" href={L.home}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 26C6 14 13 7 26 6c0 12-7 19-20 20Z" fill="#f2b84b"/><path d="M6 26 18 14" stroke="#1f2a37" stroke-width="2" stroke-linecap="round"/></svg><span>{BRAND.name}</span></a>
      <nav class="nav" aria-label="ניווט ראשי">
        <a href={L.areas}>תחומים</a><a href={L.cities}>ערים</a><a href={L.tools}>כלים</a><a href={L.articles}>מדריכים</a><a href={L.courts}>בתי משפט</a>
      </nav>
      <a class="hd-cta" href={L.join}>למשרדי עורכי דין</a>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="w hero-in">
        <div class="hero-txt">
          <h1>במה צריך עזרה משפטית?</h1>
          <p class="sub">כתבו את הנושא ובחרו עיר. נראה לכם משרדים שעוסקים בזה, עם טלפון, כתובת וחוות דעת של לקוחות.</p>
          <form class="ask" action={L.search} method="get" data-ask data-base={L.base} data-areas={JSON.stringify(d.areaOptions)}>
            <label class="f1"><span>הנושא</span><input name="q" list="a-areas" placeholder="למשל: קניית דירה, גירושין, פיטורים" autocomplete="off" /></label>
            <datalist id="a-areas">{d.areaOptions.map((o) => <option value={o.label} />)}</datalist>
            <label class="f2"><span>עיר</span>
              <select name="city"><option value="">כל הארץ</option>{d.cityOptions.map((g) => <optgroup label={'אזור ' + g.region}>{g.items.map((c) => <option value={c.value}>{c.label}</option>)}</optgroup>)}</select>
            </label>
            <button type="submit">חיפוש</button>
          </form>
          <p class="pop">נפוץ עכשיו: {d.situations.slice(0, 5).map((s, i) => <>{i > 0 && ', '}<a href={s.href}>{s.title.replace('עורך דין ', '')}</a></>)}</p>
        </div>
        <div class="hero-art" set:html={DRAW.street('#f2b84b', '#1f2a37')} />
      </div>
    </section>

    <section class="sec">
      <div class="w split">
        <div class="split-head">
          <h2>מה קרה?</h2>
          <p>לא בטוחים איך קוראים לתחום? בחרו את המצב שהכי קרוב לשלכם, ונעביר אתכם לעמוד שמסביר אותו ומראה משרדים.</p>
        </div>
        <ul class="sit">
          {d.situations.map((s) => <li><a href={s.href}><span>{s.text}</span><small>{s.title}</small></a></li>)}
        </ul>
      </div>
    </section>

    <section class="sec sand">
      <div class="w">
        <div class="row-head"><h2>משרדים באתר</h2><a href={L.areas}>לכל התחומים</a></div>
        <p class="lead2">משרד שמסומן "משרד מקודם" שילם על מיקום בולט. זה לא משפיע על חוות הדעת. השאר מופיעים לפי סדר אלפביתי.</p>
        <ol class="firms">
          {d.firms.map((f) => (
            <li class={f.promo ? 'promo' : ''}>
              <div class="fm">{f.initials}</div>
              <div class="fi">
                <h3><a href={f.href}>{f.name}</a></h3>
                <p class="fx">{f.city}{f.areas.length > 0 && <> · {f.areas.join(', ')}{f.more > 0 && ` ועוד ${f.more}`}</>}</p>
                <p class="fl">
                  {f.promo && <span class="lab">משרד מקודם</span>}
                  {f.reviews > 0 && <span class="rt"><b>{f.rating.toFixed(1)}</b> מתוך 5, לפי {f.reviews} חוות דעת מאומתות</span>}
                  {f.sample && <span class="smp">משרד לדוגמה</span>}
                </p>
              </div>
              <div class="fa">
                <a class="b1" href={f.tel}>{f.phone}</a>
                {f.website ? <a class="b2" href={f.website} rel="nofollow noopener" target="_blank">לאתר המשרד</a> : <a class="b2" href={f.href}>לפרופיל</a>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec">
      <div class="w tools">
        <div class="tools-art" set:html={DRAW.doc('#f2b84b', '#1f2a37')} />
        <div>
          <h2>מחשבונים ומכתבים, בחינם</h2>
          <p class="lead2">{d.counts.tools} כלים שעובדים בדפדפן, בלי הרשמה. מה שאתם מקלידים לא נשלח לשום מקום.</p>
          <ul class="tl">
            {d.tools.map((t) => <li><a href={t.href}><span class="k">{t.kind}</span><span class="n">{t.name}</span></a></li>)}
          </ul>
          <a class="more" href={L.tools}>לכל הכלים</a>
        </div>
      </div>
    </section>

    <section class="sec sand">
      <div class="w">
        <div class="row-head"><h2>מדריכים בשפה פשוטה</h2><a href={L.articles}>לכל המדריכים</a></div>
        <div class="arts">
          {d.articles[0] && (
            <a class="art-main" href={d.articles[0].href}>
              <span class="ar">{d.articles[0].area}</span>
              <h3>{d.articles[0].title}</h3>
              <p>{d.articles[0].text}</p>
              <span class="am">עודכן {d.articles[0].date} · {d.articles[0].minutes} דקות קריאה</span>
            </a>
          )}
          <ul class="art-list">
            {d.articles.slice(1).map((a) => <li><a href={a.href}><span class="ar">{a.area}</span><b>{a.title}</b><span class="am">{a.minutes} דקות קריאה</span></a></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="w">
        <h2>כל התחומים</h2>
        <div class="idx">
          {d.groups.map((g) => (
            <div><h3>{g.group}</h3><ul>{g.items.map((a) => <li><a href={a.href}>{a.name}</a></li>)}</ul></div>
          ))}
        </div>
        <p class="cities">לפי עיר: {d.topCities.map((c, i) => <>{i > 0 && ' · '}<a href={c.href}>{c.name}</a></>)} · <a href={L.cities}>כל הערים</a></p>
      </div>
    </section>

    <section class="sec">
      <div class="w how">
        <div><b>1</b><h3>מבינים את הנושא</h3><p>בכל תחום יש מדריך שמסביר מה עושים, מה שואלים בפגישה הראשונה ומה להכין.</p></div>
        <div><b>2</b><h3>משווים משרדים</h3><p>תחומים, כתובת, שעות וחוות דעת של לקוחות שעברו אימות.</p></div>
        <div><b>3</b><h3>פונים ישירות</h3><p>מתקשרים למשרד או נכנסים לאתר שלו. אנחנו לא מתווכים ולא גובים מכם כלום.</p></div>
      </div>
    </section>

    <section class="sec">
      <div class="w join">
        <div>
          <h2>עורכי דין? יש לכם כבר פרופיל</h2>
          <p>אשרו שהמשרד שלכם, עדכנו פרטים, ותנו ללקוחות לכתוב חוות דעת. הפרופיל הבסיסי בחינם.</p>
          <ul><li>בלי עמלה על פניות</li><li>קידום בתשלום תמיד מסומן</li><li>הדירוג לא נקנה בכסף</li></ul>
        </div>
        <div class="join-b">
          <a class="b1" href={L.claim}>אישור בעלות על פרופיל</a>
          <a class="b3" href={L.join}>חבילות למשרדים</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="w ft-in">
      <div><a class="brand" href={L.home}><span>{BRAND.name}</span></a><p>מדריך עצמאי של משרדי עורכי דין ומידע משפטי בשפה פשוטה. לא קשור לאף משרד.</p></div>
      <ul><li><a href={L.areas}>תחומים</a></li><li><a href={L.cities}>ערים</a></li><li><a href={L.tools}>כלים</a></li><li><a href={L.articles}>מדריכים</a></li></ul>
      <ul><li><a href={L.join}>למשרדים</a></li><li><a href={L.claim}>אישור בעלות</a></li><li><a href={L.removal}>תיקון או הסרה</a></li><li><a href={L.contact}>צור קשר</a></li></ul>
      <ul><li><a href={L.terms}>תנאי שימוש</a></li><li><a href={L.privacy}>פרטיות</a></li><li><a href={L.a11y}>נגישות</a></li><li><a href={L.method}>איך בנויות הרשימות</a></li></ul>
    </div>
    <p class="w disc">פרטי המשרדים הם פרטים עסקיים ממקורות ציבוריים ומהמשרדים עצמם. הם אינם המלצה, והמידע באתר אינו ייעוץ משפטי. <a href={L.removal}>בקשה לתיקון או הסרה</a></p>
  </footer>
</div>
</DesignBase>

<style is:global>
  :root { color-scheme: light; }
  body { margin: 0; background: #fffdf9; }
  .skip { position: absolute; top: -60px; inset-inline-start: 10px; background: #1958c9; color: #fff; padding: 8px 14px; border-radius: 8px; z-index: 9; }
  .skip:focus { top: 10px; }
  .dz-note { background: #1f2a37; color: #fff; font: 600 14px/1.4 Assistant, sans-serif; text-align: center; padding: 6px 12px; }
  .A { --ink: #1f2a37; --ink2: #4a5565; --blue: #1958c9; --blue2: #1449a8; --sun: #f2b84b; --sand: #f6f1e8; --line: #e6dfd2;
    font: 400 18px/1.65 Assistant, Arial, sans-serif; color: var(--ink); }
  .A * { box-sizing: border-box; }
  .A h1, .A h2, .A h3 { font-family: Rubik, Arial, sans-serif; color: var(--ink); margin: 0 0 .4em; line-height: 1.2; letter-spacing: -.01em; }
  .A h1 { font-size: clamp(32px, 4.2vw, 50px); font-weight: 700; }
  .A h2 { font-size: clamp(26px, 2.6vw, 34px); font-weight: 600; }
  .A h3 { font-size: 20px; font-weight: 600; }
  .A a { color: var(--blue); text-underline-offset: 3px; }
  .A a:focus-visible, .A button:focus-visible, .A input:focus-visible, .A select:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }
  .A .w { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  .A .hd { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
  .A .hd-in { display: flex; align-items: center; gap: 28px; min-height: 68px; }
  .A .brand { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--ink); font: 700 26px/1 Rubik, sans-serif; }
  .A .brand svg { width: 30px; height: 30px; }
  .A .nav { display: none; gap: 22px; }
  .A .nav a { color: var(--ink); text-decoration: none; font-weight: 600; font-size: 17px; }
  .A .nav a:hover { color: var(--blue); }
  .A .hd-cta { margin-inline-start: auto; font-weight: 700; text-decoration: none; border: 2px solid var(--ink); color: var(--ink); padding: 8px 16px; border-radius: 10px; font-size: 16px; }
  .A .hd-cta:hover { background: var(--ink); color: #fff; }
  @media (min-width: 900px) { .A .nav { display: flex; } }

  .A .hero { background: linear-gradient(180deg, #fff 0%, var(--sand) 100%); border-bottom: 1px solid var(--line); }
  .A .hero-in { display: grid; gap: 30px; padding: 44px 20px 52px; align-items: center; }
  @media (min-width: 980px) { .A .hero-in { grid-template-columns: 1.15fr .85fr; padding: 72px 20px 80px; } }
  .A .sub { font-size: 20px; color: var(--ink2); max-width: 34em; margin: 0 0 26px; }
  .A .ask { display: grid; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 12px; }
  @media (min-width: 720px) { .A .ask { grid-template-columns: 1.6fr 1fr auto; align-items: end; padding: 10px; } }
  .A .ask label span { display: block; font-size: 14px; font-weight: 700; color: var(--ink2); margin: 2px 6px 4px; }
  .A .ask input, .A .ask select { width: 100%; height: 54px; border: 1.5px solid var(--line); border-radius: 12px; padding: 0 14px; font: 600 18px Assistant, sans-serif; color: var(--ink); background: #fffdf9; }
  .A .ask input::placeholder { color: #7a8494; font-weight: 400; }
  .A .ask button { height: 54px; border: 0; border-radius: 12px; background: var(--blue); color: #fff; font: 600 19px Rubik, sans-serif; padding: 0 30px; cursor: pointer; }
  .A .ask button:hover { background: var(--blue2); }
  .A .pop { margin: 16px 4px 0; color: var(--ink2); font-size: 17px; }
  .A .hero-art { color: var(--ink); max-width: 460px; justify-self: center; width: 100%; }
  @media (max-width: 979px) { .A .hero-art { display: none; } }

  .A .sec { padding: 64px 0; }
  .A .sec.sand { background: var(--sand); }
  .A .split { display: grid; gap: 24px; }
  @media (min-width: 900px) { .A .split { grid-template-columns: 1fr 1.6fr; gap: 60px; } }
  .A .split-head p { color: var(--ink2); }
  .A .sit { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--line); }
  @media (min-width: 700px) { .A .sit { grid-template-columns: 1fr 1fr; column-gap: 36px; } }
  .A .sit a { display: flex; flex-direction: column; padding: 15px 0 13px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); position: relative; padding-inline-end: 28px; }
  .A .sit a::after { content: '←'; position: absolute; inset-inline-end: 4px; top: 18px; color: var(--blue); font-weight: 700; }
  .A .sit span { font-weight: 700; font-size: 19px; }
  .A .sit small { color: var(--ink2); font-size: 15px; }
  .A .sit a:hover span { color: var(--blue); }

  .A .row-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .A .row-head a, .A .more { font-weight: 700; }
  .A .lead2 { color: var(--ink2); margin: 0 0 22px; max-width: 46em; }
  .A .firms { list-style: none; margin: 0; padding: 0; background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .A .firms li { display: grid; grid-template-columns: 52px 1fr; gap: 14px; padding: 20px; border-top: 1px solid var(--line); }
  .A .firms li:first-child { border-top: 0; }
  .A .firms li.promo { background: #fffaf0; }
  @media (min-width: 820px) { .A .firms li { grid-template-columns: 56px 1fr auto; align-items: center; padding: 20px 24px; } }
  .A .fm { width: 52px; height: 52px; border-radius: 50%; background: var(--sand); border: 1px solid var(--line); display: grid; place-items: center; font: 600 19px Rubik, sans-serif; color: var(--ink); }
  .A .fi h3 { margin: 0; font-size: 20px; }
  .A .fi h3 a { color: var(--ink); text-decoration: none; }
  .A .fi h3 a:hover { color: var(--blue); text-decoration: underline; }
  .A .fx { margin: 2px 0 6px; color: var(--ink2); font-size: 16px; }
  .A .fl { margin: 0; display: flex; gap: 12px; flex-wrap: wrap; font-size: 15px; align-items: center; }
  .A .lab { background: var(--sun); color: #3d2a00; font-weight: 700; font-size: 13px; padding: 2px 8px; border-radius: 6px; }
  .A .rt b { font-weight: 700; }
  .A .smp { color: #6b5a3a; font-size: 13px; border: 1px dashed #c9b48a; padding: 1px 7px; border-radius: 6px; }
  .A .fa { display: flex; gap: 8px; grid-column: 1 / -1; }
  @media (min-width: 820px) { .A .fa { grid-column: auto; } }
  .A .b1, .A .b2, .A .b3 { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 18px; border-radius: 10px; font-weight: 700; text-decoration: none; font-size: 17px; white-space: nowrap; }
  .A .b1 { background: var(--blue); color: #fff; }
  .A .b1:hover { background: var(--blue2); }
  .A .b2 { border: 1.5px solid var(--line); color: var(--ink); background: #fff; }
  .A .b2:hover { border-color: var(--ink); }
  .A .b3 { border: 2px solid var(--ink); color: var(--ink); }

  .A .tools { display: grid; gap: 30px; align-items: center; }
  @media (min-width: 900px) { .A .tools { grid-template-columns: .7fr 1.3fr; gap: 70px; } }
  .A .tools-art { max-width: 260px; justify-self: center; color: var(--ink); }
  .A .tl { list-style: none; margin: 0 0 18px; padding: 0; border-top: 1px solid var(--line); }
  .A .tl a { display: flex; gap: 14px; align-items: baseline; padding: 13px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .A .tl .k { font-size: 14px; color: var(--ink2); min-width: 64px; }
  .A .tl .n { font-weight: 700; font-size: 18px; }
  .A .tl a:hover .n { color: var(--blue); }

  .A .arts { display: grid; gap: 28px; }
  @media (min-width: 900px) { .A .arts { grid-template-columns: 1.1fr 1fr; gap: 44px; } }
  .A .art-main { display: block; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 28px; text-decoration: none; color: var(--ink); border-inline-start: 6px solid var(--sun); }
  .A .art-main h3 { font-size: 26px; }
  .A .art-main p { color: var(--ink2); }
  .A .art-main:hover h3 { color: var(--blue); }
  .A .ar { display: block; font-size: 14px; font-weight: 700; color: var(--blue); margin-bottom: 6px; }
  .A .am { font-size: 14px; color: var(--ink2); }
  .A .art-list { list-style: none; margin: 0; padding: 0; }
  .A .art-list a { display: block; padding: 16px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .A .art-list li:first-child a { padding-top: 0; }
  .A .art-list b { display: block; font: 600 19px/1.35 Rubik, sans-serif; margin-bottom: 4px; }
  .A .art-list a:hover b { color: var(--blue); }

  .A .idx { display: grid; gap: 26px 36px; margin-top: 18px; }
  @media (min-width: 640px) { .A .idx { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .A .idx { grid-template-columns: repeat(4, 1fr); } }
  .A .idx h3 { font-size: 17px; color: var(--ink2); font-weight: 600; border-bottom: 2px solid var(--sun); padding-bottom: 6px; }
  .A .idx ul { list-style: none; margin: 0; padding: 0; }
  .A .idx li { padding: 4px 0; }
  .A .idx a { color: var(--ink); text-decoration: none; font-weight: 600; }
  .A .idx a:hover { color: var(--blue); text-decoration: underline; }
  .A .cities { margin-top: 28px; color: var(--ink2); }

  .A .how { display: grid; gap: 26px; border-top: 1px solid var(--line); padding-top: 40px; }
  @media (min-width: 860px) { .A .how { grid-template-columns: repeat(3, 1fr); gap: 40px; } }
  .A .how b { font: 700 40px/1 Rubik, sans-serif; color: var(--sun); display: block; margin-bottom: 8px; }
  .A .how p { color: var(--ink2); margin: 0; }

  .A .join { background: var(--ink); color: #e8ecf1; border-radius: 20px; padding: 36px 28px; display: grid; gap: 24px; }
  @media (min-width: 900px) { .A .join { grid-template-columns: 1.4fr 1fr; align-items: center; padding: 48px 56px; } }
  .A .join h2 { color: #fff; }
  .A .join ul { margin: 14px 0 0; padding-inline-start: 1.1em; color: #fff; }
  .A .join li::marker { color: var(--sun); }
  .A .join-b { display: flex; flex-direction: column; gap: 10px; }
  .A .join .b1 { background: var(--sun); color: #2b1d00; }
  .A .join .b3 { border-color: #fff; color: #fff; }

  .A .ft { background: var(--sand); border-top: 1px solid var(--line); margin-top: 40px; padding: 44px 0 30px; font-size: 16px; }
  .A .ft-in { display: grid; gap: 24px; }
  @media (min-width: 860px) { .A .ft-in { grid-template-columns: 1.5fr 1fr 1fr 1fr; } }
  .A .ft ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .A .ft a { color: var(--ink); text-decoration: none; }
  .A .ft a:hover { text-decoration: underline; }
  .A .ft p { color: var(--ink2); }
