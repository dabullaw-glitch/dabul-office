---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Seal from '../../components/Seal.astro';
import Faq from '../../components/Faq.astro';
import { AREAS, GROUPS, loadData, areaBySlug } from '../../lib/data';
import { RANK_FEE } from '../../data/site';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { ranks } = await loadData();
const published = [...ranks].sort((a, b) => b.year - a.year);
const faq = [
  { q: 'מה זה נבחרת פוליבוס?', a: 'רשימה שנתית בכל תחום עיסוק של משרדים שנבחרו לפי שיטה כתובה ופומבית. הרשימה מתפרסמת פעם בשנה, עם השיטה ועם תאריך הפרסום.' },
  { q: 'האם התשלום מבטיח מקום בנבחרת?', a: 'לא. התשלום הוא על הגשת המועמדות ועל הבדיקה. משרד שהגיש מועמדות יכול שלא להיכלל ברשימה, והכסף משמש לבדיקה עצמה.' },
  { q: 'אילו נתונים בודקים?', a: 'חוות דעת מאומתות של לקוחות, ותק ורישום, שלמות הפרופיל, מענה לפניות דרך האתר, ומידע שהמשרד מגיש על תיקים ועל עבודה בתחום. כל נתון נבדק לפי אותה שיטה לכל המשרדים.' },
  { q: 'האם אפשר להופיע באתר בלי להגיש מועמדות?', a: 'כן. הופעה ברשימות עורכי הדין ובציון פוליבוס לא תלויה בנבחרת ולא בתשלום.' },
];
---
<Base title="נבחרת פוליבוס: דירוג שנתי של משרדי עורכי דין" description="נבחרת פוליבוס היא דירוג שנתי בכל תחום עיסוק, לפי שיטה כתובה ופומבית. ההגשה כרוכה בתשלום והתשלום לא מבטיח מקום. ההרשמה לדירוג הראשון פתוחה." schema={[]}>
  <section class="phead"><div class="wrap">
    <Crumbs items={[{ name: 'נבחרת פוליבוס' }]} />
    <h1>נבחרת פוליבוס</h1>
    <p>דירוג שנתי של משרדי עורכי דין בכל תחום, לפי שיטה שכל אחד יכול לקרוא.</p>
  </div></section>
  <section class="sec-tight"><div class="wrap cols">
    <div class="prose">
      {published.length === 0 ? (
        <div class="panel" style="border:2px solid var(--ink)">
          <span class="launch">ההרשמה פתוחה</span>
          <h2 style="margin-top:10px">הדירוג הראשון בהכנה</h2>
          <p style="margin:0">עדיין לא פורסם דירוג. משרדים יכולים להגיש עכשיו מועמדות בתחום אחד או יותר. כשהדירוג יפורסם, הוא יופיע כאן לפי תחום ושנה.</p>
        </div>
      ) : (
        <div class="panel">
          <h2>דירוגים שפורסמו</h2>
          <ul>{published.map((r) => <li><a href={`${B}nivcheret/${r.year}/${r.area}/`}>{areaBySlug(r.area)!.he}, {r.year}</a></li>)}</ul>
        </div>
      )}
      <h2>איך זה עובד</h2>
      <ol>
        <li>משרד מגיש מועמדות בתחום מסוים ומשלם דמי הגשה.</li>
        <li>אנחנו בודקים את הנתונים לפי <a href={`${B}shita/`}>השיטה הפומבית</a>: חוות דעת מאומתות, ותק, שלמות הפרופיל ומענה לפניות, ומידע שהמשרד מגיש.</li>
        <li>בכל תחום מתפרסמת רשימה אחת בשנה, עם תאריך ועם הסבר על השיטה.</li>
        <li>משרד שנכלל ברשימה מקבל תג "נבחרת פוליבוס" בפרופיל ונקודות בחלק "הכרה מקצועית" של הציון.</li>
      </ol>
      <blockquote><b>השתתפות בדירוג כרוכה בתשלום.</b> התשלום הוא על ההגשה והבדיקה, ואינו מבטיח מקום ברשימה. משרדים שלא הגישו מועמדות לא נכללים בנבחרת, אבל מופיעים באתר כרגיל עם הציון שלהם.</blockquote>
      <Faq items={faq} />
    </div>
    <aside>
      <div class="panel panel-ink" style="text-align:center"><Seal /><p style="margin:12px 0 0">דמי הגשה: {RANK_FEE}</p><p class="note">מחיר השקה</p></div>
      <div class="panel">
        <form class="form" data-dir="join" novalidate>
          <h2 style="margin:0">הגשת מועמדות לנבחרת</h2>
          <div class="fields form">
            <input type="hidden" name="kind" value="rank" />
            <div class="hp" aria-hidden="true"><label>אתר <input name="website" tabindex="-1" autocomplete="off" /></label></div>
            <label>שם עורך הדין<input name="name" required autocomplete="name" /></label>
            <label>שם המשרד<input name="firm" /></label>
            <label>טלפון<input name="phone" type="tel" required dir="ltr" style="text-align:right" /></label>
            <label>מייל<input name="email" type="email" required dir="ltr" style="text-align:right" /></label>
            <label>תחום<select name="area" required><option value="">בחירה</option>{GROUPS.map((g) => <optgroup label={g}>{AREAS.filter((a) => a.group === g).map((a) => <option value={a.slug}>{a.he}</option>)}</optgroup>)}</select></label>
            <label class="check"><input type="checkbox" name="consent" required />ידוע לי שההגשה כרוכה בתשלום ושהתשלום לא מבטיח מקום ברשימה. נחזור אליכם עם פרטי התשלום.</label>
            <button class="btn btn-or" type="submit">שליחת מועמדות</button>
          </div>
          <p class="status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </aside>
  </div></section>
</Base>
