---
import Base from '../layouts/Base.astro';
import Finder from '../components/Finder.astro';
import { P, u } from '../config/routes';
---
<Base title="העמוד לא נמצא" description="העמוד שחיפשתם לא נמצא." path="404/" noindex>
  <section class="wrap err404">
    <div class="code">404</div>
    <h1>העמוד לא נמצא</h1>
    <p class="lead" style="margin-inline:auto">אולי הכתובת השתנתה. אפשר לחפש עורך דין לפי תחום ועיר, או לחזור ל<a href={u('')}>דף הבית</a>.</p>
    <div style="max-width:860px;margin:0 auto;text-align:start"><Finder id="nf" /></div>
    <p class="mt2"><a href={u(P.page('areas'))}>כל התחומים</a> · <a href={u(P.page('articles'))}>מדריכים</a> · <a href={u(P.page('tools'))}>כלים</a></p>
  </section>
</Base>
