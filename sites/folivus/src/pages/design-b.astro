---
// Design direction B: calm, civic, very clear. IBM Plex Sans Hebrew only. Deep green accent, white and soft grey.
import '@fontsource/ibm-plex-sans-hebrew/400.css';
import '@fontsource/ibm-plex-sans-hebrew/500.css';
import '@fontsource/ibm-plex-sans-hebrew/600.css';
import '@fontsource/ibm-plex-sans-hebrew/700.css';
import DesignBase from '../layouts/DesignBase.astro';
import { BRAND } from '../config/brand';
import { homeData, DRAW } from '../lib/design';
const d = await homeData();
const L = d.links;
---
<DesignBase title="כיוון ב" label="ב">
<div class="B">
  <header class="hd">
    <div class="w hd-in">
      <a class="brand" href={L.home}><span class="mk" aria-hidden="true"></span>{BRAND.name}</a>
      <nav class="nav" aria-label="ניווט ראשי">
        <a href={L.areas}>תחומים</a><a href={L.cities}>ערים</a><a href={L.tools}>כלים חינמיים</a><a href={L.articles}>מדריכים</a><a href={L.courts}>בתי משפט</a>
      </nav>
      <a class="hd-cta" href={L.join}>הצטרפות משרדים</a>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="w">
        <h1>במה צריך עזרה?</h1>
        <form class="ask" action={L.search} method="get" data-ask data-base={L.base} data-areas={JSON.stringify(d.areaOptions)}>
          <div class="q"><label for="bq">נושא</label><input id="bq" name="q" list="b-areas" placeholder="כתבו נושא, למשל ירושה או שכירות" autocomplete="off" /></div>
          <datalist id="b-areas">{d.areaOptions.map((o) => <option value={o.label} />)}</datalist>
          <div class="c"><label for="bc">עיר</label><select id="bc" name="city"><option value="">כל הארץ</option>{d.cityOptions.map((g) => <optgroup label={'אזור ' + g.region}>{g.items.map((c) => <option value={c.value}>{c.label}</option>)}</optgroup>)}</select></div>
          <button type="submit">מציאת משרד</button>
        </form>
        <div class="facts">
          <span><b>{d.counts.areas}</b> תחומי משפט</span><span><b>{d.counts.cities}</b> ערים</span><span><b>{d.counts.tools}</b> כלים חינמיים</span><span>חוות דעת רק אחרי אימות</span>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="w">
        <h2>מה המצב שלכם?</h2>
        <ol class="sit">
          {d.situations.map((s, i) => <li><a href={s.href}><span class="nu">{String(i + 1).padStart(2, '0')}</span><span class="tx">{s.text}</span><span class="ar">{s.title}</span></a></li>)}
        </ol>
      </div>
    </section>

    <section class="sec grey">
      <div class="w">
        <div class="hrow"><h2>משרדים</h2><p>משרד מקודם מסומן תמיד. התשלום לא משנה את הדירוג.</p></div>
        <div class="tbl" role="table" aria-label="משרדים">
          <div class="tr th" role="row"><span role="columnheader">משרד</span><span role="columnheader">תחומים</span><span role="columnheader">עיר</span><span role="columnheader">חוות דעת</span><span role="columnheader"><span class="sr">פעולות</span></span></div>
          {d.firms.map((f) => (
            <div class={'tr' + (f.promo ? ' promo' : '')} role="row">
              <span role="cell" class="nm"><a href={f.href}>{f.name}</a>{f.promo && <em>משרד מקודם</em>}</span>
              <span role="cell" class="as">{f.areas.join(', ')}{f.more > 0 && ` +${f.more}`}</span>
              <span role="cell">{f.city}</span>
              <span role="cell">{f.reviews ? <><b>{f.rating.toFixed(1)}</b> ({f.reviews})</> : <span class="mut">אין עדיין</span>}</span>
              <span role="cell" class="ac"><a class="bt" href={f.tel}>חיוג</a><a class="bt o" href={f.href}>פרופיל</a></span>
            </div>
          ))}
        </div>
        <p class="mut small">כל המשרדים ברשימה הם דוגמה בגרסת התצוגה.</p>
      </div>
    </section>

    <section class="sec">
      <div class="w two">
        <div>
          <h2>כלים חינמיים</h2>
          <ol class="num">
            {d.tools.map((t) => <li><a href={t.href}>{t.name}</a><span>{t.text}</span></li>)}
          </ol>
          <a class="lnk" href={L.tools}>לכל {d.counts.tools} הכלים</a>
        </div>
        <div>
          <h2>מדריכים</h2>
          <ul class="news">
            {d.articles.map((a) => <li><span class="dt">{a.area} · {a.minutes} דקות</span><a href={a.href}>{a.title}</a></li>)}
          </ul>
          <a class="lnk" href={L.articles}>לכל המדריכים</a>
        </div>
      </div>
    </section>

    <section class="sec grey">
      <div class="w">
        <h2>תחומי משפט</h2>
        <div class="idx">
          {d.groups.map((g) => <section><h3>{g.group}</h3><ul>{g.items.map((a) => <li><a href={a.href}>{a.name}</a>{a.count > 0 && <span>{a.count}</span>}</li>)}</ul></section>)}
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="w rules">
        <div class="art" set:html={DRAW.scales('#cfe7dc', '#17323a')} />
        <div>
          <h2>איך האתר עובד</h2>
          <dl>
            <div><dt>מאיפה הפרטים</dt><dd>פרטים עסקיים ממקורות ציבוריים ומהמשרדים עצמם. משרד יכול לתקן או להסיר.</dd></div>
            <div><dt>חוות דעת</dt><dd>מתפרסמות רק אחרי אימות של הלקוח. מוצגות גם חוות דעת שליליות.</dd></div>
            <div><dt>קידום</dt><dd>משרד ששילם מסומן "משרד מקודם". הדירוג לא נקנה בכסף.</dd></div>
            <div><dt>עלות</dt><dd>בשבילכם האתר חינם. אנחנו לא מעבירים פניות ולא גובים עמלה.</dd></div>
          </dl>
          <a class="lnk" href={L.method}>השיטה המלאה</a>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="w join">
        <h2>לעורכי דין</h2>
        <p>אשרו בעלות על הפרופיל בחינם, עדכנו תחומים ושעות, והגיבו לחוות דעת.</p>
        <div><a class="bt" href={L.claim}>אישור בעלות</a><a class="bt o" href={L.join}>חבילות</a></div>
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="w ft-in">
      <div><b class="fb">{BRAND.name}</b><p>מדריך עצמאי של משרדי עורכי דין ומידע משפטי. לא קשור לאף משרד.</p></div>
      <ul><li><a href={L.areas}>תחומים</a></li><li><a href={L.cities}>ערים</a></li><li><a href={L.tools}>כלים</a></li><li><a href={L.articles}>מדריכים</a></li><li><a href={L.courts}>בתי משפט</a></li></ul>
      <ul><li><a href={L.join}>הצטרפות משרדים</a></li><li><a href={L.claim}>אישור בעלות</a></li><li><a href={L.removal}>תיקון או הסרה</a></li><li><a href={L.contact}>צור קשר</a></li></ul>
      <ul><li><a href={L.terms}>תנאי שימוש</a></li><li><a href={L.privacy}>פרטיות</a></li><li><a href={L.a11y}>נגישות</a></li><li><a href={L.editorial}>מדיניות עריכה</a></li></ul>
    </div>
    <p class="w disc">הפרטים על משרדים אינם המלצה, והמידע באתר אינו ייעוץ משפטי. <a href={L.removal}>בקשה לתיקון או הסרה</a></p>
  </footer>
</div>
</DesignBase>

<style is:global>
  body { margin: 0; background: #fff; }
  .skip { position: absolute; top: -60px; inset-inline-start: 10px; background: #0e6b52; color: #fff; padding: 8px 14px; z-index: 9; }
  .skip:focus { top: 10px; }
  .dz-note { background: #17323a; color: #fff; font: 500 14px/1.4 'IBM Plex Sans Hebrew', sans-serif; text-align: center; padding: 6px 12px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .B { --ink: #17323a; --ink2: #4d5f66; --g: #0e6b52; --g2: #0a563f; --mint: #e6f2ec; --grey: #f4f5f3; --line: #dfe3e0;
    font: 400 17.5px/1.7 'IBM Plex Sans Hebrew', Arial, sans-serif; color: var(--ink); }
  .B * { box-sizing: border-box; }
  .B h1, .B h2, .B h3 { margin: 0 0 .45em; line-height: 1.25; color: var(--ink); }
  .B h1 { font-size: clamp(34px, 4vw, 48px); font-weight: 700; }
  .B h2 { font-size: clamp(24px, 2.4vw, 30px); font-weight: 700; }
  .B h3 { font-size: 17px; font-weight: 600; }
  .B a { color: var(--g); text-underline-offset: 3px; }
  .B :focus-visible { outline: 3px solid #f0b429; outline-offset: 2px; }
  .B .w { max-width: 1160px; margin: 0 auto; padding: 0 20px; }
  .B .small { font-size: 15px; } .B .mut { color: var(--ink2); }
  .B .hd { border-bottom: 1px solid var(--line); background: #fff; }
  .B .hd-in { display: flex; align-items: center; gap: 30px; min-height: 66px; }
  .B .brand { display: inline-flex; align-items: center; gap: 10px; font: 700 24px/1 'IBM Plex Sans Hebrew', sans-serif; color: var(--ink); text-decoration: none; }
  .B .mk { width: 14px; height: 26px; background: var(--g); border-radius: 14px 2px 14px 2px; }
  .B .nav { display: none; gap: 4px; }
  .B .nav a { color: var(--ink); text-decoration: none; font-weight: 500; padding: 8px 12px; border-radius: 6px; }
  .B .nav a:hover { background: var(--grey); }
  .B .hd-cta { margin-inline-start: auto; color: var(--g); font-weight: 600; text-decoration: none; }
  .B .hd-cta:hover { text-decoration: underline; }
  @media (min-width: 900px) { .B .nav { display: flex; } }

  .B .hero { background: var(--mint); padding: 44px 0 30px; border-bottom: 1px solid #cfe2d8; }
  @media (min-width: 900px) { .B .hero { padding: 64px 0 36px; } }
  .B .ask { display: grid; gap: 0; border: 2px solid var(--ink); border-radius: 8px; background: #fff; overflow: hidden; max-width: 940px; }
  @media (min-width: 760px) { .B .ask { grid-template-columns: 1.7fr 1fr auto; } }
  .B .ask > div { padding: 10px 16px 8px; border-bottom: 1px solid var(--line); }
  @media (min-width: 760px) { .B .ask > div { border-bottom: 0; border-inline-end: 1px solid var(--line); } }
  .B .ask label { display: block; font-size: 13px; font-weight: 600; color: var(--ink2); }
  .B .ask input, .B .ask select { width: 100%; border: 0; font: 500 19px 'IBM Plex Sans Hebrew', sans-serif; color: var(--ink); background: transparent; padding: 4px 0; outline-offset: 4px; }
  .B .ask input::placeholder { color: #81908f; font-weight: 400; }
  .B .ask button { border: 0; background: var(--g); color: #fff; font: 600 18px 'IBM Plex Sans Hebrew', sans-serif; padding: 18px 28px; cursor: pointer; }
  .B .ask button:hover { background: var(--g2); }
  .B .facts { display: flex; flex-wrap: wrap; gap: 6px 26px; margin-top: 22px; color: var(--ink2); font-size: 16px; }
  .B .facts b { color: var(--ink); font-weight: 700; }

  .B .sec { padding: 56px 0; }
  .B .sec.grey { background: var(--grey); }
  .B .sit { list-style: none; margin: 18px 0 0; padding: 0; display: grid; border-top: 2px solid var(--ink); }
  @media (min-width: 760px) { .B .sit { grid-template-columns: 1fr 1fr; column-gap: 40px; } }
  .B .sit a { display: grid; grid-template-columns: 40px 1fr; padding: 14px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .B .nu { color: var(--g); font-weight: 700; font-size: 15px; padding-top: 3px; }
  .B .tx { font-weight: 600; font-size: 18.5px; }
  .B .sit .ar { grid-column: 2; color: var(--ink2); font-size: 15px; }
  .B .sit a:hover .tx { color: var(--g); text-decoration: underline; }

  .B .hrow { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 20px; }
  .B .hrow p { margin: 0; color: var(--ink2); }
  .B .tbl { background: #fff; border: 1px solid var(--line); border-radius: 8px; margin: 16px 0 10px; }
  .B .tr { display: grid; gap: 4px 16px; padding: 16px 18px; border-top: 1px solid var(--line); align-items: center; }
  .B .tr:first-child { border-top: 0; }
  .B .th { display: none; font-size: 14px; font-weight: 600; color: var(--ink2); background: #fafbfa; padding: 10px 18px; }
  @media (min-width: 900px) { .B .tr { grid-template-columns: 1.6fr 1.6fr .8fr .8fr auto; } .B .th { display: grid; } }
  .B .tr.promo { background: #fffbef; }
  .B .nm a { font-weight: 700; font-size: 18px; color: var(--ink); text-decoration: none; }
  .B .nm a:hover { color: var(--g); text-decoration: underline; }
  .B .nm em { font-style: normal; display: inline-block; margin-inline-start: 8px; font-size: 12.5px; font-weight: 600; background: #f0b429; color: #3a2900; padding: 1px 7px; border-radius: 4px; vertical-align: 2px; }
  .B .as { color: var(--ink2); font-size: 16px; }
  .B .ac { display: flex; gap: 8px; }
  .B .bt { display: inline-flex; align-items: center; min-height: 42px; padding: 0 16px; border-radius: 6px; background: var(--g); color: #fff; font-weight: 600; text-decoration: none; }
  .B .bt:hover { background: var(--g2); }
  .B .bt.o { background: #fff; color: var(--ink); border: 1.5px solid var(--ink); }

  .B .two { display: grid; gap: 40px; }
  @media (min-width: 900px) { .B .two { grid-template-columns: 1fr 1fr; gap: 70px; } }
  .B .num { margin: 0 0 14px; padding-inline-start: 1.4em; }
  .B .num li { padding: 8px 0; border-bottom: 1px solid var(--line); }
  .B .num li::marker { color: var(--g); font-weight: 700; }
  .B .num a { font-weight: 600; color: var(--ink); text-decoration: none; display: block; }
  .B .num a:hover { color: var(--g); text-decoration: underline; }
  .B .num span { color: var(--ink2); font-size: 15px; display: block; }
  .B .news { list-style: none; margin: 0 0 14px; padding: 0; }
  .B .news li { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .B .dt { display: block; font-size: 14px; color: var(--ink2); }
  .B .news a { font-weight: 600; font-size: 18.5px; color: var(--ink); text-decoration: none; line-height: 1.4; }
  .B .news a:hover { color: var(--g); text-decoration: underline; }
  .B .lnk { font-weight: 600; }

  .B .idx { columns: 1; column-gap: 40px; margin-top: 10px; }
  @media (min-width: 640px) { .B .idx { columns: 2; } }
  @media (min-width: 1000px) { .B .idx { columns: 4; } }
  .B .idx section { break-inside: avoid; margin-bottom: 24px; }
  .B .idx h3 { color: var(--g); border-bottom: 1px solid var(--line); padding-bottom: 4px; }
  .B .idx ul { list-style: none; margin: 0; padding: 0; }
  .B .idx li { display: flex; justify-content: space-between; padding: 3px 0; }
  .B .idx a { color: var(--ink); text-decoration: none; }
  .B .idx a:hover { color: var(--g); text-decoration: underline; }
  .B .idx span { color: var(--ink2); font-size: 14px; }

  .B .rules { display: grid; gap: 30px; align-items: center; }
  @media (min-width: 900px) { .B .rules { grid-template-columns: .6fr 1.4fr; gap: 60px; } }
  .B .art { max-width: 240px; justify-self: center; color: var(--ink); }
  .B dl { margin: 0 0 16px; display: grid; gap: 0; }
  .B dl > div { display: grid; gap: 2px 20px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 700px) { .B dl > div { grid-template-columns: 150px 1fr; } }
  .B dt { font-weight: 700; }
  .B dd { margin: 0; color: var(--ink2); }

  .B .join { border: 2px solid var(--ink); border-radius: 8px; padding: 30px; display: grid; gap: 8px; }
  @media (min-width: 900px) { .B .join { grid-template-columns: auto 1fr auto; align-items: center; gap: 30px; } .B .join h2 { margin: 0; } .B .join p { margin: 0; } }
  .B .join div { display: flex; gap: 10px; flex-wrap: wrap; }

  .B .ft { background: var(--ink); color: #c9d6d9; padding: 44px 0 26px; font-size: 15.5px; }
  .B .ft-in { display: grid; gap: 22px; }
  @media (min-width: 860px) { .B .ft-in { grid-template-columns: 1.6fr 1fr 1fr 1fr; } }
  .B .fb { color: #fff; font-size: 22px; }
  .B .ft ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .B .ft a { color: #fff; text-decoration: none; }
  .B .ft a:hover { text-decoration: underline; }
  .B .disc { font-size: 14px; border-top: 1px solid #2f4a52; margin-top: 24px; padding-top: 16px; }
</style>
