---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Faq from '../components/Faq.astro';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const rows = [
  { n: 50, t: 'חוות דעת מאומתות', d: 'הממוצע של הדירוגים (עד 35 נקודות) וכמות חוות הדעת (עד 15 נקודות, מלא מ־10 חוות דעת ומעלה). רק חוות דעת של מי שאישר מספר טלפון או הגיע מקישור של עורך הדין נספרות.' },
  { n: 15, t: 'שנות רישיון', d: 'נקודה לכל שנה מאז הרישיון, עד 15 נקודות.' },
  { n: 15, t: 'שלמות הפרופיל', d: 'טלפון, מייל, אתר, כתובת, תיאור, שנת רישיון, תמונה, שפות, תחומים וערים. כל פרט מוסיף חלק שווה.' },
  { n: 10, t: 'מענה לפניות', d: 'החלק מהפניות דרך האתר שקיבלו מענה. עד שיש מספיק פניות, החלק הזה נשאר על אפס לכולם.' },
  { n: 10, t: 'הכרה מקצועית', d: 'הכללה בנבחרת פוליבוס או הכרה ציבורית אחרת שאפשר לבדוק. 5 נקודות לכל הכרה, עד 10.' },
];
const faq = [
  { q: 'האם עורך דין יכול לשלם כדי לקבל ציון גבוה יותר?', a: 'לא. חבילות בתשלום משנות רק את מקום ההצגה (תמיד עם תווית "מקודם") ואת מה שמופיע בפרופיל. הציון מחושב באותה שיטה לכולם.' },
  { q: 'למה לעורך דין חדש באתר יש ציון נמוך?', a: 'כי עוד אין לו חוות דעת מאומתות ואולי הפרופיל לא מלא. ציון נמוך לא אומר שהשירות לא טוב, רק שעוד אין מספיק מידע.' },
  { q: 'האם חוות דעת שליליות מתפרסמות?', a: 'כן, אחרי בדיקה שהן מאומתות ושאין בהן פרטים אישיים, קללות או טענות שאינן על השירות. עורך הדין יכול לפרסם תגובה.' },
  { q: 'מה עושים אם יש טעות בפרטים?', a: 'עורך הדין יכול לאשר שהפרופיל שלו ולעדכן אותו, או לבקש הסרה. כל אחד יכול לדווח על טעות דרך עמוד יצירת הקשר.' },
];
---
<Base title="איך מחושב ציון פוליבוס" description="ציון פוליבוס הוא מספר בין 0 ל-100 שמחושב בשיטה פומבית: חוות דעת מאומתות, שנות רישיון, שלמות הפרופיל, מענה לפניות והכרה מקצועית. תשלום לא משנה אותו.">
  <section class="phead"><div class="wrap">
    <Crumbs items={[{ name: 'איך מדרגים' }]} />
    <h1>איך מחושב ציון פוליבוס</h1>
    <p>מספר בין 0 ל־100 ליד כל עורך דין. הנה בדיוק ממה הוא מורכב.</p>
  </div></section>
  <section class="sec-tight"><div class="wrap prose">
    <p>הציון נועד לעזור להשוות בין עורכי דין לפי מידע שאפשר לבדוק. הוא לא ממליץ על עורך דין מסוים ולא מחליף שיחה איתו. כשיש מעט מידע על עורך דין, הציון שלו יהיה נמוך יותר, גם אם השירות שלו טוב.</p>
    <div class="panel" style="padding:8px 20px">
      <dl class="facts">
        {rows.map((r) => <div style="grid-template-columns:90px 1fr"><dt><b style="font:700 1.4rem/1 var(--serif);color:var(--ink)">{r.n}</b> נק׳</dt><dd><b>{r.t}</b><br /><span class="muted">{r.d}</span></dd></div>)}
      </dl>
    </div>
    <h2>מה לא משפיע על הציון</h2>
    <ul>
      <li>תשלום על חבילה באתר. מיקום מקודם מסומן תמיד במילה "מקודם", והוא נפרד מהציון.</li>
      <li>גודל המשרד או מספר עורכי הדין בו.</li>
      <li>דירוגים ממקורות אחרים שלא אפשר לבדוק.</li>
    </ul>
    <h2>הסדר ברשימות</h2>
    <p>בכל עמוד תחום או עיר מופיעים קודם עד שלושה עורכי דין מקודמים, עם תווית ברורה. אחריהם כל השאר, לפי הציון. בעמודי עיר ואזור הרשימה "לפי ציון" היא בלי קידום בכלל.</p>
    <h2>נבחרת פוליבוס</h2>
    <p>פעם בשנה מתפרסמת <a href={`${B}nivcheret/`}>נבחרת פוליבוס</a> בכל תחום. ההגשה כרוכה בתשלום ואינה מבטיחה מקום. משרד שנכלל בנבחרת מקבל נקודות בחלק "הכרה מקצועית".</p>
    <Faq items={faq} />
  </div></section>
</Base>
