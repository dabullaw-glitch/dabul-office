---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import FormShell from '../components/FormShell.astro';
import { BRAND } from '../config/brand';
import { P, u } from '../config/routes';
import { plans, addons } from '../lib/data';
import { breadcrumbs, faqPage } from '../lib/schema';
const { path } = Astro.props as any;
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'הצטרפות משרדים', path }];
const faq = [
  { q: 'האם הפרופיל הבסיסי באמת בחינם?', a: 'כן. כל משרד יכול לאשר בעלות על הפרופיל, לעדכן פרטים ולקבל חוות דעת מאומתות בלי תשלום.' },
  { q: 'האם תשלום משפיע על הדירוג או על חוות הדעת?', a: 'לא. תשלום קונה רק מיקום בולט שמסומן "משרד מקודם". הדירוג וחוות הדעת לא ניתנים לרכישה, ומשרד לא יכול להסיר חוות דעת שלילית שעברה אימות.' },
  { q: 'האם האתר מעביר אליי פניות או גובה עמלה על לקוח?', a: 'לא. האתר הוא מדריך. לקוחות פונים אליכם ישירות בטלפון, באתר או בוואטסאפ שלכם, ואין עמלה על פנייה או על תיק.' },
  { q: 'מה צריך כדי להתחיל?', a: 'ממלאים את הטופס, מאמתים שאתם מורשים לפעול בשם המשרד, ובוחרים חבילה. לאחר האישור מקבלים גישה לעריכת הפרופיל.' },
  { q: 'אילו פרטים מופיעים בפרופיל?', a: 'בפרופיל החינמי: שם המשרד, כתובת, טלפון, אתר, שעות ותחומי עיסוק. בפרופיל מורחב: גם מה שהמשרד מוסיף בעצמו, כמו תיאור, לוגו, תמונות, סרטון ותיקים בולטים.' },
];
---
<Base title="הצטרפות משרדי עורכי דין: פרופיל וחבילות קידום" description="פרופיל חינמי לכל משרד, וחבילות קידום שמסומנות בבירור. בלי עמלה על פניות, והדירוג לא ניתן לרכישה." path={path} schema={[breadcrumbs(crumbs), faqPage(faq)]}>
  <section class="hero on-dark">
    <div class="wrap" style="padding-block:48px 56px">
      <Crumbs items={crumbs} />
      <span class="eyebrow mt2">למשרדי עורכי דין</span>
      <h1 style="max-width:20ch">לקוחות מחפשים עורך דין לפי תחום ועיר. שיהיו לכם פרטים נכונים מול העיניים שלהם.</h1>
      <p class="lead">פרופיל חינמי לכל משרד, חוות דעת מאומתות, וקידום בתשלום שמסומן תמיד. אין עמלה על פניות ואין תיווך.</p>
      <div class="flex mt2"><a class="btn btn-brass" href="#order">בקשת הצטרפות</a><a class="btn btn-ghost" href={u(P.page('claim'))}>אישור בעלות על פרופיל קיים</a></div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">חבילות</span><h2>בוחרים כמה לבלוט</h2><p>כל החבילות שנתיות. המחירים ייקבעו לפני ההשקה.</p></div></div>
      <div class="plans">
        {plans().map((p) => (
          <div class={'plan' + (p.highlight ? ' hl' : '')}>
            {p.highlight && <span class="flag">מתאים לרוב המשרדים</span>}
            <h3>{p.name}</h3>
            <p class="small muted mb0">{p.pitch}</p>
            <div class="price">{p.is_final && p.price_year !== null ? (p.price_year === 0 ? 'ללא עלות' : p.price_year.toLocaleString('he-IL') + ' ₪ לשנה + מע"מ') : p.price_note}<small>{p.tier > 0 ? 'אפשר לשלם בתשלומים' : 'לכל משרד שמופיע במאגר'}</small></div>
            <ul>{p.features.map((x) => <li><Icon name="check" /><span>{x}</span></li>)}</ul>
            <a class={'btn ' + (p.highlight ? 'btn-pine' : 'btn-line')} href={p.tier === 0 ? u(P.page('claim')) : '#order'} data-plan={p.id}>{p.tier === 0 ? 'לאישור בעלות' : 'בקשת הצטרפות'}</a>
          </div>
        ))}
      </div>
      <h2 class="mt3" style="font-size:1.5rem">תוספות</h2>
      <div class="grid g4">{addons().map((x) => <div class="card"><h3 style="font-size:1.08rem">{x.name}</h3><p class="small">{x.text}</p><p class="xs muted mb0">{x.price_note}</p></div>)}</div>
    </div>
  </section>
  <section class="sec white">
    <div class="wrap grid g3">
      <div><span class="gicon"><Icon name="shield" /></span><h3 class="mt1">שקיפות מלאה</h3><p class="muted">כל מיקום בתשלום מסומן "משרד מקודם" או "מודעה". הגולשים יודעים מה פרסום ומה מידע.</p></div>
      <div><span class="gicon"><Icon name="scale" /></span><h3 class="mt1">דירוג שלא נקנה בכסף</h3><p class="muted">הדירוג נבנה לפי <a href={u(P.page('method'))}>שיטה גלויה</a>. תשלום לא משנה אותו.</p></div>
      <div><span class="gicon"><Icon name="phone" /></span><h3 class="mt1">פנייה ישירה אליכם</h3><p class="muted">אין תיווך ואין עמלה. הלקוח רואה את הטלפון והאתר שלכם ופונה ישירות.</p></div>
    </div>
  </section>
  <section class="sec" id="order">
    <div class="wrap layout" style="padding-top:0">
      <div>
        <h2>בקשת הצטרפות</h2>
        <p class="muted">נחזור אליכם כדי לאמת את פרטי המשרד ולהשלים את ההצטרפות. המייל שנשלח אחרי הטופס הוא אישור קבלה בלבד.</p>
        <FormShell kind="order" ok="תודה. קיבלנו את הבקשה ונחזור אליכם." submit="שליחת בקשה">
          <div class="field"><label for="o-plan">חבילה</label><select id="o-plan" name="plan">{plans().filter((p) => p.tier > 0).map((p) => <option value={p.id} selected={p.highlight}>{p.name}</option>)}</select></div>
          <div class="row2">
            <div class="field"><label for="o-firm">שם המשרד</label><input id="o-firm" name="firmName" required autocomplete="organization" /></div>
            <div class="field"><label for="o-name">שם מלא</label><input id="o-name" name="name" required autocomplete="name" /></div>
          </div>
          <div class="row2">
            <div class="field"><label for="o-mail">מייל</label><input id="o-mail" name="email" type="email" required autocomplete="email" /></div>
            <div class="field"><label for="o-ph">טלפון</label><input id="o-ph" name="phone" type="tel" required autocomplete="tel" /></div>
          </div>
          <div class="field"><label for="o-note">תחומים וערים שמעניינים אתכם (לא חובה)</label><textarea id="o-note" name="note"></textarea></div>
        </FormShell>
      </div>
      <aside class="aside"><div class="box brass"><h2>כבר מופיעים באתר?</h2><p class="small">אפשר לאשר בעלות על הפרופיל ולעדכן אותו בחינם, בלי לבחור חבילה.</p><a class="btn btn-pine btn-sm btn-block" href={u(P.page('claim'))}>אישור בעלות</a></div></aside>
    </div>
    <div class="wrap"><Faq items={faq} /></div>
  </section>
  <script>
    document.querySelectorAll<HTMLAnchorElement>('[data-plan]').forEach((a) => a.addEventListener('click', () => {
      const s = document.getElementById('o-plan') as HTMLSelectElement | null; if (s && [...s.options].some((o) => o.value === a.dataset.plan)) s.value = a.dataset.plan!;
    }));
  </script>
</Base>
