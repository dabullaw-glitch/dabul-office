---
// Sponsored articles (paid, approved by the firm, always labelled "תוכן ממומן"). Read live from the database.
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { P, u } from '../config/routes';
import '../styles/commerce.css';
const { path } = Astro.props as any;
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'תוכן ממומן', path }];
---
<Base title="תוכן ממומן" description="מאמרים בחסות משרדים, מסומנים תוכן ממומן." path={path} noindex>
  <section class="phead on-dark"><div class="wrap"><Crumbs items={crumbs} /><h1 data-title>תוכן ממומן</h1></div></section>
  <div class="wrap" style="padding-block:var(--sp-24) var(--sp-64);max-width:820px" id="sponsored" data-firm-base={u(P.firm('__slug__'))} data-self={u(P.page('sponsored'))} data-editorial={u(P.page('editorial'))}>
    <div data-out><p class="muted">טוען...</p></div>
  </div>
  <script>import '../scripts/commerce/sponsored';</script>
</Base>
