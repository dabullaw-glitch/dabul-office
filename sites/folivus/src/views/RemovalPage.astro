---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import '../styles/commerce.css';
import { P, u } from '../config/routes';
import { firms, cityBySlug } from '../lib/data';
import { breadcrumbs } from '../lib/schema';
const { path } = Astro.props as any;
const fs = (await firms()).slice().sort((a, b) => a.name.localeCompare(b.name, 'he'));
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'בקשת תיקון או הסרה', path }];
---
<Base title="בקשה לתיקון או הסרת פרטים" description="משרד או עורך דין שרוצים לתקן או להסיר פרטים מהאתר יכולים להגיש בקשה כאן. כל בקשה נבדקת ומטופלת." path={path} schema={[breadcrumbs(crumbs)]}>
  <section class="phead tint">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <h1>תיקון או הסרת פרטים</h1>
      <p class="lead">הפרטים באתר הם פרטים עסקיים ממקורות ציבוריים. אם משהו לא נכון, או שאתם לא רוצים להופיע, ספרו לנו. כל בקשה נבדקת, ונעדכן אתכם במייל או בטלפון.</p>
    </div>
  </section>
  <div class="wrap layout">
    <div>
      <form class="form" data-cm-form="removal" novalidate>
        <fieldset class="field" style="border:0;padding:0;margin:0">
          <legend style="font-weight:600;font-size:.93rem;margin-bottom:8px">מה לעשות?</legend>
          <div class="radio-cards"><label><input type="radio" name="type" value="fix" checked />לתקן פרטים</label><label><input type="radio" name="type" value="remove" />להסיר את הפרופיל</label></div>
        </fieldset>
        <div class="field"><label for="r-firm">המשרד</label><select id="r-firm" name="firm"><option value="">בחרו משרד (או כתבו בפרטים)</option>{fs.map((f) => <option value={f.slug}>{f.name}{cityBySlug(f.city) ? ', ' + cityBySlug(f.city)!.name : ''}</option>)}</select></div>
        <div class="row2">
          <div class="field"><label for="r-name">שם מלא</label><input id="r-name" name="name" required autocomplete="name" /></div>
          <div class="field"><label for="r-role">הקשר שלכם למשרד</label><select id="r-role" name="role"><option>בעל המשרד או שותף</option><option>עובד במשרד</option><option>אחר</option></select></div>
        </div>
        <div class="row2">
          <div class="field"><label for="r-mail">מייל</label><input id="r-mail" name="email" type="email" required autocomplete="email" dir="ltr" /></div>
          <div class="field"><label for="r-ph">טלפון</label><input id="r-ph" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field"><label for="r-det">מה צריך לתקן או למה להסיר</label><textarea id="r-det" name="details"></textarea><div class="help">נשלח למייל אישור קבלה וקוד אימות. בקשת הסרה ממייל בדומיין של אתר המשרד מבוצעת מיד אחרי האימות. כל בקשה אחרת מטופלת תוך 48 שעות.</div></div>
        <div class="hp" aria-hidden="true"><label>אתר<input name="website_hp" tabindex="-1" autocomplete="off" /></label></div>
        <label class="check"><input type="checkbox" name="consent" required /><span>קראתי את <a href={u(P.page('privacy'))} target="_blank">מדיניות הפרטיות</a> ומסכים/ה שהפרטים ישמשו לטיפול בבקשה. לא נשלח דיוור שיווקי.</span></label>
        <div class="msg" data-msg role="status" tabindex="-1"></div>
        <div><button class="btn btn-pine" type="submit">שליחה</button></div>
      </form>
      <div class="cm-panel cm-hidden" data-cm-code="removal">
        <p>שלחנו קוד בן 6 ספרות למייל שכתבתם. הקלידו אותו כדי לאמת את הבקשה.</p>
        <div class="field"><label for="v-code-removal">קוד</label><input id="v-code-removal" inputmode="numeric" maxlength="6" dir="ltr" /></div>
        <button type="button" class="btn btn-pine" data-cm-check>אישור</button>
        <div class="msg" data-msg2 role="status"></div>
      </div>
      <script>import '../scripts/commerce/verify-forms';</script>
    </div>
    <aside class="aside">
      <div class="box"><h2>מה קורה אחרי הבקשה</h2><p class="small">אנחנו מאמתים שהבקשה הגיעה מהמשרד, ואז מתקנים או מסירים. בקשת הסרה של פרופיל שנאסף ממקורות ציבוריים מכובדת. חוות דעת מאומתות נשמרות לפי <a href={u(P.page('terms'))}>תנאי השימוש</a>.</p></div>
      <div class="box brass"><h2>רוצים לעדכן בעצמכם?</h2><p class="small">אשרו בעלות על הפרופיל ועדכנו אותו ישירות.</p><a class="btn btn-pine btn-sm btn-block" href={u(P.page('claim'))}>אישור בעלות</a></div>
    </aside>
  </div>
  <script>
    const q = new URLSearchParams(location.search).get('firm');
    const s = document.getElementById('r-firm') as HTMLSelectElement | null;
    if (q && s && [...s.options].some((o) => o.value === q)) s.value = q;
  </script>
</Base>
