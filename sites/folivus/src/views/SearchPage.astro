---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { P, u } from '../config/routes';
import { areaGroups, cities, REGIONS } from '../lib/data';
import { breadcrumbs } from '../lib/schema';
const { path } = Astro.props as any;
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'חיפוש', path }];
---
<Base title="חיפוש עורך דין, מדריך או כלי" description="חיפוש משרדי עורכי דין לפי שם, תחום ועיר, וחיפוש במדריכים, בכלים ובעמודי בתי המשפט." path={path} noindex schema={[breadcrumbs(crumbs)]}>
  <section class="phead tint">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <h1>חיפוש</h1>
      <form class="search-bar mt2" role="search" id="sform" action="" method="get">
        <div class="field"><label for="q">מה מחפשים?</label><input id="q" name="q" type="search" placeholder="שם משרד, נושא או שאלה" autocomplete="off" /></div>
        <div class="field"><label for="sa">תחום</label><select id="sa" name="area"><option value="">כל התחומים</option>{areaGroups().map((g) => <optgroup label={g.group}>{g.items.map((a) => <option value={a.he}>{a.name}</option>)}</optgroup>)}</select></div>
        <div class="field"><label for="sc">עיר</label><select id="sc" name="city"><option value="">כל הארץ</option>{REGIONS.map((r) => <optgroup label={'אזור ' + r}>{cities().filter((c) => c.region === r).map((c) => <option value={c.he}>{c.name}</option>)}</optgroup>)}</select></div>
      </form>
    </div>
  </section>
  <div class="wrap" style="padding-bottom:60px">
    <p class="result-count" id="count" aria-live="polite">הקלידו או בחרו תחום ועיר.</p>
    <div id="pages" class="grid g3"></div>
    <div id="firms" class="firms mt2"></div>
    <noscript><p>החיפוש דורש JavaScript. אפשר לעבור ל<a href={u(P.page('areas'))}>רשימת התחומים</a> או ל<a href={u(P.page('cities'))}>רשימת הערים</a>.</p></noscript>
    <Disclaimer kind="list" />
  </div>
  <script define:vars={{ idx: u('search-index.json') }}>
    const $ = (s) => document.querySelector(s);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const norm = (s) => String(s || '').replace(/["'׳״\-]/g, ' ').replace(/\s+/g, ' ').trim().toLowerCase();
    let D = null;
    const qs = new URLSearchParams(location.search);
    $('#q').value = qs.get('q') || ''; $('#sa').value = qs.get('area') || ''; $('#sc').value = qs.get('city') || '';
    fetch(idx).then((r) => r.json()).then((d) => { D = d; run(); });
    function run() {
      if (!D) return;
      const q = norm($('#q').value), ah = $('#sa').value, ch = $('#sc').value;
      const area = D.areas.find((a) => a.he === ah), city = D.cities.find((c) => c.he === ch);
      const words = q ? q.split(' ') : [];
      const hit = (txt) => words.every((w) => norm(txt).includes(w));
      let fs = D.firms.filter((f) => (!area || f.a.includes(area.s)) && (!city || f.c === city.s));
      if (words.length) fs = fs.filter((f) => hit(f.n + ' ' + f.cn + ' ' + f.a.map((s) => (D.areas.find((a) => a.s === s) || {}).n).join(' ')));
      fs.sort((a, b) => (b.promo - a.promo) || a.n.localeCompare(b.n, 'he'));
      const ps = words.length ? [...D.areas.filter((a) => hit(a.t)).map((a) => ({ k: 'תחום', n: a.t, d: '', h: a.h })), ...D.pages.filter((p) => hit(p.n + ' ' + p.d))].slice(0, 9) : [];
      $('#pages').innerHTML = ps.map((p) => `<a class="card acard" href="${esc(p.h)}"><span class="kicker">${esc(p.k)}</span><h3>${esc(p.n)}</h3>${p.d ? `<p>${esc(p.d)}</p>` : ''}</a>`).join('');
      $('#firms').innerHTML = fs.map((f) => `<article class="firm${f.promo ? ' promo' : ''}"><div class="firm-top"><div class="mono" aria-hidden="true">${esc(f.n.trim()[0])}</div><div><h3 style="display:inline"><a href="${esc(f.h)}">${esc(f.n)}</a></h3> <span class="badges">${f.promo ? '<span class="badge b-promo">משרד מקודם</span>' : ''}${f.sample ? '<span class="badge b-sample">דוגמה</span>' : ''}</span><div class="meta mt1"><span>${esc(f.cn)}</span></div><div class="tags">${f.a.slice(0, 3).map((s) => `<span class="tag">${esc((D.areas.find((a) => a.s === s) || {}).n)}</span>`).join('')}</div></div></div><div class="acts"><a class="btn btn-pine btn-sm" href="${esc(f.h)}">לפרופיל המשרד</a></div></article>`).join('');
      const any = q || area || city;
      $('#count').textContent = any ? `נמצאו ${fs.length} משרדים${ps.length ? ' ו־' + ps.length + ' עמודים' : ''}` : 'הקלידו או בחרו תחום ועיר.';
      if (any && area && fs.length === 0) $('#count').innerHTML += ` · <a href="${esc(area.h)}">לעמוד ${esc(area.t)}</a>`;
    }
    let t; $('#q').addEventListener('input', () => { clearTimeout(t); t = setTimeout(run, 150); });
    $('#sa').addEventListener('change', run); $('#sc').addEventListener('change', run);
    $('#sform').addEventListener('submit', (e) => { e.preventDefault(); run(); });
  </script>
</Base>
