---
// Tool page (canvas round 4): ink head with the sponsor slot ("בחסות", live from the database, one firm per tool),
// the form drawn from the tool's JSON spec, the result on ink, then how it works, FAQ and sources.
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import PaidSlots from '../components/PaidSlots.astro';
import Faq from '../components/Faq.astro';
import Sources from '../components/Sources.astro';
import { P, u } from '../config/routes';
import { tools, areaBySlug, fmtDate } from '../lib/data';
import { breadcrumbs, howTo, webApp, faqPage } from '../lib/schema';
const { path, tool } = Astro.props as any;
const t = tools().find((x) => x.slug === tool)!;
const area = t.area ? areaBySlug(t.area) : null;
const others = tools().filter((x) => x.slug !== t.slug && (x.category === t.category || (t.area && x.area === t.area))).slice(0, 5);
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'כלים חינמיים', path: P.page('tools') }, { name: t.name, path }];
const opt = (o: any) => (typeof o === 'object' && o ? { value: String(o.value ?? o.id ?? o.label), label: String(o.label ?? o.value) } : { value: String(o), label: String(o) });
const spec = { type: t.type, inputs: t.inputs, outputs: t.outputs, module: t.module ? u('tool-modules/' + t.module + '.js') : null };
const updated = fmtDate(t.updated);
const isGen = t.type === 'generator';
const dv = (i: any) => (i.default !== undefined && i.default !== null && typeof i.default !== 'boolean' ? String(i.default) : undefined);
---
<Base title={t.name} description={t.description.slice(0, 158)} path={path} nav="tools" schema={[breadcrumbs(crumbs), webApp(t, path), howTo(t, path), faqPage(t.faq)]}>
  <section class="phead">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <div class="phead-in">
        <p class="eyebrow">{isGen ? 'מחולל מסמכים' : 'מחשבון'} חינמי · {t.category} {t.draft && <span class="draft-b">טיוטה</span>}</p>
        <h1 class="h1">{t.name}</h1>
        <p class="lead" style="max-width:640px">{t.description}</p>
        <p class="facts"><span style="display:inline-flex;gap:var(--sp-6);align-items:center"><Icon name="lock" size={16} />{isGen ? 'המסמך נוצר בדפדפן שלכם' : 'החישוב נעשה בדפדפן שלכם'}, בלי שליחת נתונים</span>{updated && <><span aria-hidden="true">·</span><span>עודכן {updated}</span></>}</p>
        <PaidSlots kind="tool" target={t.slug} title="בחסות" cta={false} />
      </div>
    </div>
  </section>
  <div class="wrap cols" style="padding-top:var(--sp-32);padding-bottom:var(--sp-56)">
    <div class="stack" style="gap:var(--sp-32);min-width:0">
      <div class="tool" data-tool={JSON.stringify(spec)}>
        <form class="tool-in" novalidate aria-labelledby="calc-h">
          <h2 id="calc-h" class="sr">{isGen ? 'פרטי המסמך' : 'החישוב'}</h2>
          {t.inputs.map((i) => {
            const id = 'in-' + i.id;
            const help = i.help ? <span class="hint" id={id + '-h'}>{i.help}</span> : null;
            const desc = i.help ? id + '-h' : undefined;
            const req = i.required ? <span aria-hidden="true"> *</span> : null;
            if (i.type === 'radio') return (
              <fieldset class="field"><legend>{i.label}{req}</legend>
                <div class="radio-cards">{(i.options || []).map(opt).map((o, n) => (
                  <label><input type="radio" name={i.id} value={o.value} checked={i.default != null ? String(i.default) === o.value : n === 0} />{o.label}</label>
                ))}</div>{help}
              </fieldset>
            );
            if (i.type === 'select') return (
              <div class="field"><label for={id}>{i.label}{req}</label>
                <select id={id} name={i.id} required={i.required} aria-describedby={desc}>{(i.options || []).map(opt).map((o) => <option value={o.value} selected={String(i.default) === o.value}>{o.label}</option>)}</select>{help}</div>
            );
            if (i.type === 'checkbox' || i.type === 'boolean') return (
              <div class="field"><label class="chk" style="font-weight:500"><input type="checkbox" name={i.id} checked={!!i.default} aria-describedby={desc} /><span>{i.label}</span></label>{help}</div>
            );
            if (i.type === 'textarea') return (
              <div class="field"><label for={id}>{i.label}{req}</label><textarea id={id} name={i.id} required={i.required} aria-describedby={desc} placeholder={i.placeholder}>{dv(i)}</textarea>{help}</div>
            );
            const num = ['number', 'currency', 'money', 'percent', 'integer'].includes(i.type);
            const type = i.type === 'date' ? 'date' : i.type === 'email' ? 'email' : i.type === 'tel' ? 'tel' : 'text';
            return (
              <div class="field"><label for={id}>{i.label}{req}</label>
                <input id={id} name={i.id} type={type} inputmode={num ? 'decimal' : undefined} data-num={num ? '1' : undefined} required={i.required} dir={num ? 'ltr' : undefined} style={num ? 'text-align:right' : undefined}
                  aria-describedby={desc} placeholder={i.placeholder} value={dv(i)} autocomplete="off" />{help}</div>
            );
          })}
          <div class="msg bad" role="alert" data-err></div>
          <button class="btn btn-p btn-lg" type="submit"><Icon name={isGen ? 'doc' : 'calc'} size={18} /><span>{isGen ? 'הפקת המסמך' : 'חישוב'}</span></button>
          {!t.module && <p class="msg info show">הכלי בהכנה.</p>}
        </form>
        <div class="result on-dark" data-out aria-live="polite" tabindex="-1"></div>
      </div>
      <p class="note"><Icon name="info" size={18} /><span>{t.disclaimer || 'התוצאה היא הערכה כללית ואינה ייעוץ משפטי. יש מקרים שהכלי לא מכיר, ולכן הוא לא מחליף בדיקה של עורך דין.'}</span></p>

      {t.intro && <section class="stack gp12" aria-labelledby="in-h"><h2 id="in-h" class="h3" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">{isGen ? 'מתי משתמשים במסמך' : 'איך מחושב'}</h2><div class="prose"><p>{t.intro}</p></div></section>}
      <section class="stack gp12" aria-labelledby="how-h">
        <h2 id="how-h" class="h3" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">איך משתמשים בכלי</h2>
        <ol class="howsteps h3c" style="grid-template-columns:minmax(0,1fr)">
          <li><b class="num">01</b><p class="small">ממלאים את השדות. שדה עם כוכבית הוא חובה.</p></li>
          <li><b class="num">02</b><p class="small">{isGen ? 'לוחצים על הפקת המסמך וקוראים את הנוסח.' : 'לוחצים על חישוב ורואים את הפירוט שלב אחרי שלב.'}</p></li>
          <li><b class="num">03</b><p class="small">{isGen ? 'מעתיקים, מורידים או מדפיסים, ובודקים לפני שימוש.' : 'בודקים את ההנחות. במקרה מורכב כדאי להתייעץ עם עורך דין.'}</p></li>
        </ol>
      </section>
      <Faq items={t.faq} />
      <Sources items={t.sources} updated={updated} />
    </div>
    <aside class="stack gp16">
      {area && (
        <div class="aside-box"><h3>רוצים שמישהו יבדוק את המקרה?</h3><p class="small muted">יש מקרים שהכלי לא מכיר. רשימת משרדים בתחום {area.name}, לפי עיר. פונים ישירות למשרד.</p><a class="btn btn-p" href={u(P.area(area.he))}><span>ל{area.title.replace('עורך דין', 'משרדי')}</span><Icon name="arrow" size={18} /></a></div>
      )}
      {others.length > 0 && (
        <div class="aside-box"><h3>כלים נוספים</h3><div class="stack">
          {others.map((x, i) => <a class="titem" style={'padding:var(--sp-8) 0;' + (i === 0 ? 'border-top:0' : '')} href={u(P.tool(x.he))}><span class="ac-ic"><Icon name={x.type === 'generator' ? 'doc' : 'calc'} size={18} /></span><span class="tn">{x.name}</span></a>)}
        </div></div>
      )}
      <div class="aside-box"><span><span class="tag">בחסות</span></span><h3>חסות על הכלי</h3><p class="small muted">משרד אחד בלבד לכל כלי, מסומן ״בחסות״. החסות לא משנה את החישוב. 1,500 ₪ לשנה, לפני מע״מ.</p><a class="more" href={u(P.page('order')) + '?plan=tool-sponsor&target=' + encodeURIComponent(t.slug)}><span>להזמנת החסות</span><Icon name="arrow" size={18} /></a></div>
    </aside>
  </div>
  <script>import '../scripts/tool-runner';</script>
</Base>
