---
// Generic tool page: the form is drawn from the tool's JSON spec; the logic is the tool's own ES module
// (compute(inputs) for calculators, generate(inputs) for document generators). Runs in the browser only.
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Sources from '../components/Sources.astro';
import FirmCard from '../components/FirmCard.astro';
import { P, u } from '../config/routes';
import { tools, areaBySlug, firms, rankFor, fmtDate } from '../lib/data';
import { breadcrumbs, howTo, webApp, faqPage } from '../lib/schema';
const { path, tool } = Astro.props as any;
const t = tools().find((x) => x.slug === tool)!;
const area = t.area ? areaBySlug(t.area) : null;
const sponsors = area ? rankFor((await firms()).filter((f) => f.areas.includes(area.slug)), area.slug).featured.slice(0, 2) : [];
const others = tools().filter((x) => x.slug !== t.slug && (x.category === t.category || x.area === t.area)).slice(0, 4);
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'כלים', path: P.page('tools') }, { name: t.name, path }];
const opt = (o: any) => (typeof o === 'object' && o ? { value: String(o.value ?? o.id ?? o.label), label: String(o.label ?? o.value) } : { value: String(o), label: String(o) });
const spec = { type: t.type, inputs: t.inputs, outputs: t.outputs, module: t.module ? u('tool-modules/' + t.module + '.js') : null };
const updated = fmtDate(t.updated);
---
<Base title={t.name} description={t.description.slice(0, 158)} path={path} nav="tools" schema={[breadcrumbs(crumbs), webApp(t, path), howTo(t, path), faqPage(t.faq)]}>
  <section class="phead tint">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <span class="eyebrow">{t.type === 'generator' ? 'מחולל מסמכים' : 'מחשבון'} · {t.category}</span>
      <h1 style="margin-top:0">{t.name}</h1>
      <p class="lead">{t.description}</p>
      <div class="chips">
        {updated && <span class="chip"><Icon name="calendar" />עודכן {updated}</span>}
        <span class="chip"><Icon name="lock" />החישוב נעשה בדפדפן שלכם, בלי שליחת נתונים</span>
        {t.draft && <span class="badge b-draft">טיוטה</span>}
      </div>
    </div>
  </section>
  <div class="wrap layout">
    <div>
      <div class="tool" data-tool={JSON.stringify(spec)}>
        <form class="tool-in" novalidate>
          {t.inputs.map((i) => {
            const id = 'in-' + i.id;
            const help = i.help ? <div class="help" id={id + '-h'}>{i.help}</div> : null;
            const desc = i.help ? id + '-h' : undefined;
            if (i.type === 'radio') return (
              <fieldset class="field" style="border:0;padding:0;margin:0">
                <legend style="font-weight:600;font-size:.93rem;margin-bottom:8px">{i.label}{i.required && <span aria-hidden="true"> *</span>}</legend>
                <div class="radio-cards">{(i.options || []).map(opt).map((o, n) => (
                  <label><input type="radio" name={i.id} value={o.value} checked={i.default !== undefined ? String(i.default) === o.value : n === 0} />{o.label}</label>
                ))}</div>{help}
              </fieldset>
            );
            if (i.type === 'select') return (
              <div class="field"><label for={id}>{i.label}{i.required && <span aria-hidden="true"> *</span>}</label>
                <select id={id} name={i.id} required={i.required} aria-describedby={desc}>{(i.options || []).map(opt).map((o) => <option value={o.value} selected={String(i.default) === o.value}>{o.label}</option>)}</select>{help}</div>
            );
            if (i.type === 'checkbox' || i.type === 'boolean') return (
              <div class="field"><label class="check" style="font-weight:500"><input type="checkbox" name={i.id} checked={!!i.default} aria-describedby={desc} />{i.label}</label>{help}</div>
            );
            if (i.type === 'textarea') return (
              <div class="field"><label for={id}>{i.label}{i.required && <span aria-hidden="true"> *</span>}</label><textarea id={id} name={i.id} required={i.required} aria-describedby={desc} placeholder={i.placeholder}></textarea>{help}</div>
            );
            const num = ['number', 'currency', 'money', 'percent', 'integer'].includes(i.type);
            const type = i.type === 'date' ? 'date' : i.type === 'email' ? 'email' : i.type === 'tel' ? 'tel' : 'text';
            return (
              <div class="field"><label for={id}>{i.label}{i.required && <span aria-hidden="true"> *</span>}</label>
                <input id={id} name={i.id} type={type} inputmode={num ? 'decimal' : undefined} data-num={num ? '1' : undefined} required={i.required}
                  aria-describedby={desc} placeholder={i.placeholder} value={i.default !== undefined && typeof i.default !== 'boolean' ? String(i.default) : undefined} autocomplete="off" />{help}</div>
            );
          })}
          <div class="msg bad" role="alert" data-err></div>
          <div><button class="btn btn-pine" type="submit"><Icon name={t.type === 'generator' ? 'doc' : 'calc'} />{t.type === 'generator' ? 'הפקת המסמך' : 'חישוב'}</button></div>
          {!t.module && <p class="msg info show">הכלי בהכנה.</p>}
        </form>
        <div class="result on-dark" data-out aria-live="polite" tabindex="-1"></div>
      </div>
      <p class="note warn mt2"><Icon name="info" /><span>{t.disclaimer || 'התוצאה היא הערכה כללית ואינה ייעוץ משפטי.'}</span></p>

      {t.intro && <section class="mt3"><h2>{t.type === 'generator' ? 'מתי משתמשים במסמך' : 'איך מחושב'}</h2><div class="prose"><p>{t.intro}</p></div></section>}
      <section class="mt3" aria-labelledby="how-h">
        <h2 id="how-h">איך משתמשים בכלי</h2>
        <ol class="prose">
          {t.inputs.slice(0, 6).map((i) => <li>{i.label}{i.help ? ': ' + i.help : ''}</li>)}
          <li>{t.type === 'generator' ? 'לוחצים על הפקת המסמך, קוראים את הנוסח ומעתיקים, מורידים או מדפיסים.' : 'לוחצים על חישוב ומקבלים פירוט.'}</li>
        </ol>
      </section>
      <Faq items={t.faq} />
      <Sources items={t.sources} updated={updated} />
    </div>
    <aside class="aside">
      <div class="sticky">
        {area && (
          <div class="box dark on-dark">
            <h2>צריכים עזרה של עורך דין?</h2>
            <p class="small">רשימת משרדים בתחום {area.name}, לפי עיר. פונים ישירות למשרד.</p>
            <a class="btn btn-brass btn-sm btn-block" href={u(P.area(area.he))}>{area.title}</a>
          </div>
        )}
        {others.length > 0 && <div class="box mt1"><h2>כלים נוספים</h2><ul class="links">{others.map((x) => <li><a href={u(P.tool(x.he))}>{x.name}</a></li>)}</ul></div>}
      </div>
    </aside>
  </div>
  {sponsors.length > 0 && (
    <section class="sec tight white"><div class="wrap"><p class="promo-note"><Icon name="info" />תוכן ממומן: משרדים מקודמים בתחום</p><div class="firms">{sponsors.map((f) => <FirmCard f={f} promo area={area!.slug} />)}</div></div></section>
  )}
  <script>
    const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    const ils = (n: number) => n.toLocaleString('he-IL', { maximumFractionDigits: 2 }) + ' ₪';
    const HEAD: Record<string, string> = { heir: 'יורש', fraction: 'חלק', percent: 'אחוז', amount: 'סכום', name: 'שם', label: 'פריט', value: 'ערך', share: 'חלק', date: 'תאריך', days: 'ימים', rate: 'שיעור', tax: 'מס' };
    const dt = (v: string) => { const d = new Date(v); return /^\d{4}-\d{2}-\d{2}/.test(v) && !isNaN(+d) ? d.toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' }) : esc(v); };
    function fmt(v: any, f?: string): string {
      if (v == null || v === '') return '<span style="opacity:.6">אין</span>';
      if (f === 'html') return String(v);
      if (f === 'boolean' || typeof v === 'boolean') return v ? 'כן' : 'לא';
      if (f === 'date') return dt(String(v));
      if (f === 'list' || Array.isArray(v) && f !== 'table') return '<ul style="margin:0;padding-inline-start:1.1em">' + [].concat(v).map((x) => `<li>${esc(x)}</li>`).join('') + '</ul>';
      if (f === 'table') return table(v);
      if (typeof v !== 'number') return esc(v);
      if (f === 'currency' || f === 'money') return ils(Math.round(v * 100) / 100);
      if (f === 'percent') return v.toLocaleString('he-IL', { maximumFractionDigits: 2 }) + '%';
      if (f === 'days') return v.toLocaleString('he-IL') + ' ימים';
      return v.toLocaleString('he-IL', { maximumFractionDigits: 2 });
    }
    function table(v: any) {
      const t = Array.isArray(v) ? (v.length && typeof v[0] === 'object' && !Array.isArray(v[0]) ? { head: Object.keys(v[0]).map((k) => HEAD[k] || k), rows: v.map((r: any) => Object.entries(r).map(([k, x]) => k === 'amount' && typeof x === 'number' ? ils(x) : typeof x === 'number' ? fmt(x) : esc(x ?? ''))) } : { head: [], rows: v.map((r: any) => [].concat(r).map((x) => esc(x))) })
        : { head: (v.head || []).map(esc), rows: (v.rows || []).map((r: any[]) => r.map((x) => (typeof x === 'number' ? fmt(x) : esc(x)))) };
      return `<div style="overflow-x:auto"><table>${t.head.length ? `<thead><tr>${t.head.map((x: string) => `<th>${x}</th>`).join('')}</tr></thead>` : ''}<tbody>${t.rows.map((r: string[]) => `<tr>${r.map((c) => `<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
    }
    document.querySelectorAll<HTMLElement>('[data-tool]').forEach((root) => {
      const spec = JSON.parse(root.dataset.tool!);
      const form = root.querySelector('form')!;
      const out = root.querySelector<HTMLElement>('[data-out]')!;
      const err = root.querySelector<HTMLElement>('[data-err]')!;
      form.querySelectorAll<HTMLInputElement>('input[data-num]').forEach((el) => el.addEventListener('blur', () => {
        const n = Number(el.value.replace(/[^\d.]/g, '')); if (el.value && !isNaN(n)) el.value = n.toLocaleString('he-IL');
      }));
      form.addEventListener('submit', async (e) => {
        e.preventDefault(); err.classList.remove('show');
        if (!spec.module) return;
        const vals: Record<string, any> = {}; const missing: string[] = [];
        for (const i of spec.inputs) {
          const els = form.querySelectorAll<HTMLInputElement>(`[name="${i.id}"]`);
          let v: any;
          if (i.type === 'radio') v = [...els].find((x) => x.checked)?.value ?? '';
          else if (i.type === 'checkbox' || i.type === 'boolean') v = !!els[0]?.checked;
          else v = (els[0] as any)?.value ?? '';
          if (['number', 'currency', 'money', 'percent', 'integer'].includes(i.type) && v !== '') v = Number(String(v).replace(/[^\d.\-]/g, ''));
          if (i.required && (v === '' || v == null || (typeof v === 'number' && isNaN(v)))) missing.push(i.label);
          vals[i.id] = v;
        }
        if (missing.length) { err.textContent = 'חסר: ' + missing.join(', '); err.classList.add('show'); return; }
        let res: any;
        try {
          const m = await import(/* @vite-ignore */ spec.module);
          res = spec.type === 'generator' ? (m.generate || m.default)(vals) : (m.compute || m.default)(vals);
          if (res && typeof res.then === 'function') res = await res;
        } catch (x) { err.textContent = 'משהו השתבש בחישוב. נסו שוב.'; err.classList.add('show'); return; }
        const errs = [].concat(res?.errors || res?.error || []).filter(Boolean);
        if (errs.length) { err.textContent = errs.join(' '); err.classList.add('show'); return; }
        out.innerHTML = spec.type === 'generator' ? renderDoc(res) : renderCalc(res, spec.outputs);
        out.classList.add('show'); out.focus({ preventScroll: true }); out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        wire(out, res);
      });
    });
    function renderCalc(res: any, outputs: any[]) {
      if (typeof res !== 'object' || !res) return `<p>${esc(res)}</p>`;
      const vals = res.outputs && typeof res.outputs === 'object' ? res.outputs : res;
      const prim = outputs.find((o) => o.primary) || outputs.find((o) => ['currency', 'money'].includes(o.format) && typeof vals[o.id] === 'number') || null;
      let h = '';
      if (prim) h += `<h2 style="font-size:1.05rem;margin:0;color:#cfdcd6">${esc(prim.label)}${res.label ? ' · ' + esc(res.label) : ''}</h2><div class="big">${fmt(vals[prim.id], prim.format)}</div>`;
      else h += `<h2 style="font-size:1.2rem">התוצאה</h2>`;
      const rest = outputs.length ? outputs.filter((o) => o !== prim && o.id in vals) : Object.keys(vals).filter((k) => !['label', 'table', 'notes', 'steps'].includes(k)).map((k) => ({ id: k, label: k }));
      const simple = rest.filter((o) => !['table', 'list', 'html'].includes(o.format) && !Array.isArray(vals[o.id]));
      const complex = rest.filter((o) => !simple.includes(o));
      if (simple.length) h += `<div class="kv">${simple.map((o) => `<div>${esc(o.label)}</div><div>${fmt(vals[o.id], o.format)}</div>`).join('')}</div>`;
      for (const o of complex) h += `<h3 style="font-size:1rem;margin:18px 0 6px">${esc(o.label)}</h3>${fmt(vals[o.id], o.format === 'html' ? 'html' : o.format || (Array.isArray(vals[o.id]) && typeof vals[o.id][0] === 'object' ? 'table' : 'list'))}`;
      if (res.table) h += table(res.table);
      const steps = [].concat(res.steps || []);
      if (steps.length) h += `<details style="margin-top:16px"><summary style="cursor:pointer;color:#fff;font-weight:600">פירוט החישוב</summary><ol style="margin:10px 0 0;padding-inline-start:1.2em;line-height:1.7">${steps.map((x) => `<li>${esc(x)}</li>`).join('')}</ol></details>`;
      const notes = [].concat(res.notes || res.note || res.warnings || []);
      if (notes.length) h += `<div class="note"><span>${notes.map(esc).join('<br>')}</span></div>`;
      return h;
    }
    const docText = (res: any) => typeof res === 'string' ? res : res?.text ?? res?.body ?? res?.document ?? '';
    function renderDoc(res: any) {
      const body = res?.html ? `<div class="doc-out doc-html" data-doc>${res.html}</div>` : `<div class="doc-out" data-doc>${esc(docText(res))}</div>`;
      const notes = [].concat(res?.warnings || res?.notes || []);
      return `<h2 style="font-size:1.15rem">${esc(res?.title || 'המסמך שלכם')}</h2><p class="sub">זו טיוטה. קראו אותה, תקנו לפי הצורך ושמרו עותק.</p>${body}
        <div class="tool-acts"><button class="btn btn-brass btn-sm" type="button" data-copy>העתקה</button><button class="btn btn-ghost btn-sm" type="button" data-dl>${res?.html ? 'הורדה כקובץ Word' : 'הורדה כקובץ טקסט'}</button><button class="btn btn-ghost btn-sm" type="button" data-print>הדפסה או שמירה כ־PDF</button></div>
        ${notes.length ? `<div class="note"><span><b>לבדיקה לפני שימוש:</b><br>${notes.map(esc).join('<br>')}</span></div>` : ''}`;
    }
    function wire(out: HTMLElement, res: any) {
      const doc = out.querySelector<HTMLElement>('[data-doc]');
      const html = res?.html ? String(res.html) : '';
      const page = (inner: string) => `<!doctype html><html lang="he" dir="rtl"><head><meta charset="utf-8"><title>${esc(res?.title || '')}</title><style>body{font:15px/1.8 Arial,sans-serif;direction:rtl;padding:40px;max-width:760px;margin:auto}table{border-collapse:collapse;width:100%}td,th{border:1px solid #999;padding:6px}</style></head><body>${inner}</body></html>`;
      out.querySelector('[data-copy]')?.addEventListener('click', async (e) => { await navigator.clipboard.writeText(doc?.innerText || docText(res)); (e.target as HTMLElement).textContent = 'הועתק'; });
      out.querySelector('[data-dl]')?.addEventListener('click', () => {
        const blob = html ? new Blob(['\ufeff' + page(html)], { type: 'application/msword' }) : new Blob(['\ufeff' + docText(res)], { type: 'text/plain;charset=utf-8' });
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = (res?.title || 'document') + (html ? '.doc' : '.txt'); a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      });
      out.querySelector('[data-print]')?.addEventListener('click', () => {
        const w = window.open('', '_blank'); if (!w) return;
        w.document.write(page(html || `<div style="white-space:pre-wrap">${esc(docText(res))}</div>`)); w.document.close(); w.focus(); w.print();
      });
    }
  </script>
</Base>
