---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import '../styles/commerce.css';
import { P, u } from '../config/routes';
import { firms, cityBySlug } from '../lib/data';
import { breadcrumbs } from '../lib/schema';
const { path } = Astro.props as any;
const fs = (await firms()).slice().sort((a, b) => a.name.localeCompare(b.name, 'he'));
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'ניהול פרופיל', path }];
---
<Base title="אישור בעלות על פרופיל משרד ועדכון פרטים" description="משרד עורכי דין שמופיע באתר יכול לאשר בעלות על הפרופיל בחינם, לעדכן פרטים ולהגיב לחוות דעת." path={path} schema={[breadcrumbs(crumbs)]}>
  <section class="phead tint">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <h1>זה המשרד שלכם?</h1>
      <p class="lead">אשרו בעלות על הפרופיל בחינם. אחרי האימות תוכלו לעדכן פרטים, להוסיף תחומים ושעות, ולהגיב לחוות דעת.</p>
    </div>
  </section>
  <div class="wrap layout">
    <div>
      <ol class="grid g3 steps" style="list-style:none;padding:0;margin:0 0 34px">
        <li class="step"><h3>מאתרים את המשרד</h3><p class="muted small">בוחרים את המשרד מהרשימה. לא מוצאים? אפשר <a href={u(P.page('join'))}>להצטרף</a>.</p></li>
        <li class="step"><h3>מאמתים</h3><p class="muted small">בקוד במייל. מייל בדומיין של אתר המשרד מאושר מיד, ומייל אחר נבדק ידנית.</p></li>
        <li class="step"><h3>מעדכנים</h3><p class="muted small">אחרי האישור נכנסים לאזור המשרדים ומעדכנים את הפרופיל.</p></li>
      </ol>
      <h2>בקשה לאישור בעלות</h2>
      <form class="form" data-cm-form="claim" data-portal={u(P.page('portal'))} novalidate>
        <div class="field"><label for="c-firm">המשרד</label>
          <select id="c-firm" name="firm" required><option value="">בחרו משרד</option>{fs.map((f) => <option value={f.slug}>{f.name}{cityBySlug(f.city) ? ', ' + cityBySlug(f.city)!.name : ''}</option>)}</select>
        </div>
        <p class="small muted">נשלח קוד אימות למייל שתכתבו. מייל בדומיין של אתר המשרד (למשל office@שם-המשרד.co.il) מאושר מיד. ממייל אחר, הבקשה עוברת אימות ידני קצר (מספר רישיון או טלפון המשרד).</p>
        <div class="row2">
          <div class="field"><label for="c-name">שם מלא</label><input id="c-name" name="name" required autocomplete="name" /></div>
          <div class="field"><label for="c-lic">מספר רישיון בלשכת עורכי הדין (לא חובה)</label><input id="c-lic" name="license" inputmode="numeric" /></div>
        </div>
        <div class="row2">
          <div class="field"><label for="c-mail">מייל</label><input id="c-mail" name="email" type="email" required autocomplete="email" /></div>
          <div class="field"><label for="c-ph">טלפון</label><input id="c-ph" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="hp" aria-hidden="true"><label>אתר<input name="website_hp" tabindex="-1" autocomplete="off" /></label></div>
        <label class="check"><input type="checkbox" name="consent" required /><span>קראתי את <a href={u(P.page('privacy'))} target="_blank">מדיניות הפרטיות</a> ומסכים/ה שהפרטים ישמשו לטיפול בבקשה. לא נשלח דיוור שיווקי.</span></label>
        <div class="msg" data-msg role="status" tabindex="-1"></div>
        <div><button class="btn btn-pine" type="submit">שליחה</button></div>
      </form>
      <div class="cm-panel cm-hidden" data-cm-code="claim">
        <p>שלחנו קוד בן 6 ספרות למייל שכתבתם. הקלידו אותו כדי לאמת את הבקשה.</p>
        <div class="field"><label for="v-code-claim">קוד</label><input id="v-code-claim" inputmode="numeric" maxlength="6" dir="ltr" /></div>
        <button type="button" class="btn btn-pine" data-cm-check>אישור</button>
        <div class="msg" data-msg2 role="status"></div>
      </div>
      <script>import '../scripts/commerce/verify-forms';</script>
    </div>
    <aside class="aside">
      <div class="box"><h2>מה אפשר לעדכן</h2><ul class="small" style="margin:0 0 8px"><li>כתובת, טלפון ואתר</li><li>תחומי עיסוק וערים</li><li>שעות פעילות</li><li>תגובה לחוות דעת</li></ul><p class="xs muted mt1 mb0">חוות דעת שעברה אימות לא נמחקת לבקשת המשרד. אפשר להגיב עליה או לדווח עליה אם היא מפרה את הכללים.</p></div>
      <div class="box brass"><h2>רוצים להסיר את הפרופיל?</h2><p class="small">אפשר לבקש הסרה או תיקון.</p><a class="btn btn-line btn-sm btn-block" href={u(P.page('removal'))}>בקשת תיקון או הסרה</a></div>
    </aside>
  </div>
  <script>
    const q = new URLSearchParams(location.search).get('firm');
    const s = document.getElementById('c-firm') as HTMLSelectElement | null;
    if (q && s && [...s.options].some((o) => o.value === q)) s.value = q;
  </script>
</Base>
