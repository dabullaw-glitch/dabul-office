---
// Checkout (canvas round 4 structure): stepper in the page head, one panel per step, the order summary beside it
// (sticky on desktop, folded on phones), and a sticky bottom bar with the total and the next step on phones.
// Prices, limits and availability come from the server (fol-api quote); the page only collects choices.
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import { P, u } from '../config/routes';
import '../styles/commerce.css';
const { path } = Astro.props as any;
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'פרסום לעורכי דין', path: P.page('join') }, { name: 'הזמנה', path }];
const STEPS = ['מוצר', 'מקומות', 'פרטים', 'סיכום ותשלום'];
const sum = `<div class="sum" data-sum><div><span class="cap">בחרו מוצר כדי לראות מחיר.</span></div></div>`;
---
<Base title="הזמנת חבילה או מודעה" description="בחירת חבילה, מקומות ופרטי משרד, ותשלום מאובטח. כל מיקום בתשלום מסומן באתר." path={path} noindex nav="join">
  <section class="phead"><div class="wrap"><Crumbs items={crumbs} />
    <div class="phead-in" style="padding-bottom:var(--sp-24)">
      <h1 class="h2">הזמנה</h1>
      <ol class="co-steps" aria-label="שלבי ההזמנה" data-steps>
        {STEPS.map((t, i) => <li data-s={String(i + 1)} data-on={i === 0 ? 'true' : 'false'} aria-current={i === 0 ? 'step' : undefined}><span class="sb" aria-hidden="true"></span><span class="st"><span class="n num">{i + 1}</span><span class="show-md">{t}</span><span class="sr">שלב {i + 1}: {t}</span></span></li>)}
      </ol>
      <p class="small hide-md" style="color:var(--on-ink)"><b data-step-label>שלב 1 מתוך 4 · מוצר</b></p>
    </div>
  </div></section>
  <div class="wrap cols" style="padding-top:var(--sp-24);padding-bottom:var(--sp-32)" id="order" data-targets={u('commerce-targets.json')} data-portal={u(P.page('portal'))} data-claim={u(P.page('claim'))} data-terms={u(P.page('terms'))} data-method={u(P.page('method'))}>
    <div class="stack gp16" style="min-width:0">
      <div class="cm-test cm-hidden" data-test>מצב בדיקה: התשלום לא אמיתי. הכפתור בסוף מבצע רכישת בדיקה בלי חיוב, וכל השאר עובד כמו באמת.</div>
      <div class="msg" data-top role="status"></div>

      <section data-step="1" class="co-panel" aria-labelledby="s1-h">
        <div class="stack gp4"><h2 class="h3" id="s1-h" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">מה מתאים לכם?</h2><p class="small muted">המחירים לפני מע״מ. תשלום לא משפיע על הדירוג ועל הביקורות. <a class="lnk" data-method-link>איך בנוי הדירוג</a></p></div>
        <div class="cm-products" data-products role="radiogroup" aria-labelledby="s1-h"><p class="muted">טוען את המוצרים...</p></div>
        <div class="co-nav"><span></span><button type="button" class="btn btn-p btn-lg show-lg" data-next="2">המשך</button></div>
        <div class="msg" data-msg1 role="status"></div>
      </section>

      <section data-step="2" class="co-panel cm-hidden" aria-labelledby="s2-h">
        <h2 class="h3" id="s2-h" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)" data-step2-title>איפה להופיע</h2>
        <div data-slots class="stack gp12"></div>
        <div class="co-nav"><button type="button" class="btn btn-s btn-lg" data-back>חזרה</button><button type="button" class="btn btn-p btn-lg show-lg" data-next="3">המשך</button></div>
        <div class="msg" data-msg2 role="status"></div>
      </section>

      <section data-step="3" class="co-panel cm-hidden" aria-labelledby="s3-h">
        <h2 class="h3" id="s3-h" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">פרטים</h2>
        <div data-firm-choice></div>
        <div data-firm-new class="stack gp12">
          <div class="fgrid">
            <div class="field"><label for="f-name">שם המשרד</label><input id="f-name" autocomplete="organization" /></div>
            <div class="field"><label for="f-city">עיר המשרד</label><select id="f-city"></select></div>
            <div class="field"><label for="f-addr">כתובת (לא חובה)</label><input id="f-addr" /></div>
            <div class="field"><label for="f-web">אתר המשרד (לא חובה)</label><input id="f-web" type="url" placeholder="https://" dir="ltr" /></div>
            <div class="field"><label for="f-phone">טלפון המשרד</label><input id="f-phone" type="tel" autocomplete="tel" dir="ltr" style="text-align:right" /></div>
          </div>
          <div class="field"><label for="f-areas">תחומי עיסוק (עד 10, אפשר לבחור כמה עם Ctrl)</label><select id="f-areas" multiple size="6"></select></div>
        </div>
        <div data-ad class="cm-hidden fgrid">
          <div class="field"><label for="a-name">שם העסק</label><input id="a-name" /></div>
          <div class="field"><label for="a-cat">תחום השירות</label><select id="a-cat"></select></div>
          <div class="field"><label for="a-phone">טלפון</label><input id="a-phone" type="tel" dir="ltr" style="text-align:right" /></div>
          <div class="field"><label for="a-web">אתר (לא חובה)</label><input id="a-web" type="url" placeholder="https://" dir="ltr" /></div>
          <div class="field" style="grid-column:1/-1"><label for="a-text">שורה קצרה על השירות (עד 160 תווים)</label><input id="a-text" maxlength="160" /></div>
        </div>
        <h3 class="h4">איש קשר להזמנה</h3>
        <div class="fgrid">
          <div class="field"><label for="c-name">שם מלא</label><input id="c-name" autocomplete="name" /></div>
          <div class="field"><label for="c-mail">מייל (לשם תישלח הקבלה)</label><input id="c-mail" type="email" autocomplete="email" dir="ltr" /></div>
          <div class="field"><label for="c-phone">טלפון</label><input id="c-phone" type="tel" autocomplete="tel" dir="ltr" style="text-align:right" /></div>
        </div>
        <div class="co-nav"><button type="button" class="btn btn-s btn-lg" data-back>חזרה</button><button type="button" class="btn btn-p btn-lg show-lg" data-next="4">לסיכום</button></div>
        <div class="msg" data-msg3 role="status"></div>
      </section>

      <section data-step="4" class="co-panel cm-hidden" aria-labelledby="s4-h">
        <div class="stack gp4"><h2 class="h3" id="s4-h" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">סיכום ותשלום</h2><p class="small muted">תשלום מאובטח בדף התשלום. הקבלה נשלחת למייל שכתבתם.</p></div>
        <div data-summary></div>
        <div class="field" data-inst-wrap><label for="o-inst">מספר תשלומים בכרטיס אשראי</label><select id="o-inst"></select></div>
        <div data-auto class="cm-hidden">
          <label class="chk"><input type="checkbox" id="o-auto" /><span>חידוש שנתי אוטומטי של התוספת הזו.</span></label>
          <label class="chk"><input type="checkbox" id="o-auto-ok" /><span>אני מאשר/ת חידוש אוטומטי לפי המחיר שיהיה אז, ויודע/ת שאפשר לבטל אותו בכל רגע באזור המשרדים. בלי הסימון הזה אין חידוש אוטומטי.</span></label>
        </div>
        <label class="chk"><input type="checkbox" id="o-terms" /><span>קראתי את <a class="lnk" data-terms-link target="_blank">תנאי השימוש</a>. ידוע לי שכל מיקום בתשלום מסומן ״משרד מקודם״, ״מודעה״, ״בחסות״ או ״תוכן ממומן״, ושהתשלום לא משפיע על הדירוג.</span></label>
        <p class="note"><Icon name="lock" size={18} /><span>חידוש אוטומטי קיים רק בתוספות, ורק אם סימנתם אותו. בלי הסימון שולחים אליכם קישור לחידוש לפני סוף התקופה.</span></p>
        <div class="co-nav"><button type="button" class="btn btn-s btn-lg" data-back>חזרה</button><button type="button" class="btn btn-p btn-lg show-lg" data-pay>למעבר לתשלום</button></div>
        <div class="msg" data-msg4 role="status"></div>
      </section>

      <section data-done class="co-panel cm-hidden" aria-live="polite"></section>
      <details class="panel sum-d hide-lg" data-sumd><summary><span>סיכום ההזמנה</span><span style="display:inline-flex;gap:var(--sp-8);align-items:center"><b class="num" data-total>אין עדיין</b><Icon name="chevd" size={18} /></span></summary><div style="padding:0 var(--sp-16) var(--sp-16)" set:html={sum}></div></details>
      <p class="cap" data-wa></p>
    </div>
    <aside class="show-lg"><div class="sticky-aside stack gp16">
      <div class="panel pad stack gp12"><h2 class="h4">סיכום ההזמנה</h2><Fragment set:html={sum} /><p class="cap" data-scope></p></div>
      <div class="aside-box"><h3>חשוב לדעת</h3><p class="small muted">כל מיקום בתשלום מסומן ולא משנה את הדירוג. חידוש אוטומטי רק אם סימנתם זאת במפורש.</p></div>
    </div></aside>
  </div>
  <div class="sbar" role="region" aria-label="המשך ההזמנה" data-sbar>
    <span class="sbar-tot"><span class="cap">סך הכול כולל מע״מ</span><b data-total>אין עדיין</b></span>
    <button type="button" class="btn btn-p btn-lg" style="flex:0 0 auto;min-width:150px" data-sbar-next>המשך</button>
  </div>
  <script>import '../scripts/commerce/order';</script>
</Base>
