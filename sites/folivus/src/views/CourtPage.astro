---
// Court page (canvas round 4): details panel, up to 3 firms and 4 service providers as paid slots (labelled "מודעה",
// live from the database), what to know before a hearing (the court guide), and firms in the city by the ranking.
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Sources from '../components/Sources.astro';
import Toc from '../components/Toc.astro';
import Disclaimer from '../components/Disclaimer.astro';
import PaidSlots from '../components/PaidSlots.astro';
import FirmTile from '../components/FirmTile.astro';
import { P, u } from '../config/routes';
import { courts, cities, firms, fmtDate, areaBySlug, rankFor } from '../lib/data';
import { render } from '../lib/md';
import { breadcrumbs, courthouse, faqPage } from '../lib/schema';
import { scoreOf } from '../lib/ui';
const { path, court } = Astro.props as any;
const c = courts().find((x) => x.slug === court)!;
const city = cities().find((x) => x.name === c.city || x.slug === c.city || (c.city && c.city.includes(x.name)));
const { html, toc } = render(c.body);
const map = c.lat && c.lng ? `https://www.google.com/maps/search/?api=1&query=${c.lat},${c.lng}` : c.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.name + ' ' + c.address)}` : '';
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'בתי משפט', path: P.page('courts') }, { name: c.name, path }];
const updated = fmtDate(c.updated);
const TYPE: Record<string, string> = { supreme: 'בית המשפט העליון', magistrate: 'בית משפט השלום', magistrates: 'בית משפט השלום', district: 'בית משפט מחוזי', family: 'בית משפט לענייני משפחה', labor: 'בית הדין לעבודה', rabbinical: 'בית דין רבני' };
const all = await firms();
const local = city ? all.filter((f) => f.city === city.slug) : [];
const r = rankFor(local);
const ranked = [...r.featured, ...r.rest].sort((a, b) => scoreOf(b).score - scoreOf(a).score || a.name.localeCompare(b.name, 'he')).slice(0, 4);
---
<Base title={`${c.name}: כתובת, שעות ומידע לפני דיון`} description={`${c.name}${c.address ? ', ' + c.address : ''}. שעות קבלת קהל, דרכי הגעה, טלפון ומה כדאי לדעת לפני דיון.`.slice(0, 158)} path={path} nav="courts" schema={[breadcrumbs(crumbs), courthouse(c, path), faqPage(c.faq)]}>
  <section class="phead">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <div class="phead-in">
        <p class="eyebrow">{TYPE[c.type] || 'בית משפט'}{c.district ? ' · מחוז ' + c.district.replace(/^מחוז\s*/, '') : ''} {c.draft && <span class="draft-b">טיוטה</span>}</p>
        <h1 class="h1">{c.name}</h1>
        <p class="lead" style="max-width:620px">כתובת, שעות ומה להביא לדיון. ומשרדים ונותני שירות שעובדים מול בית המשפט, מסומנים ״מודעה״.</p>
        <div class="flex">
          {map && <a class="btn btn-w btn-lg" href={map} target="_blank" rel="noopener"><Icon name="pin" size={18} /><span>ניווט לבית המשפט</span></a>}
          {c.officialPage && <a class="btn btn-o btn-lg" href={c.officialPage} target="_blank" rel="noopener"><Icon name="link" size={18} /><span>לעמוד הרשמי</span></a>}
        </div>
      </div>
    </div>
  </section>
  <div class="wrap cols" style="padding-top:var(--sp-32);padding-bottom:var(--sp-56)">
    <div class="stack" style="gap:var(--sp-40);min-width:0">
      <section aria-labelledby="ci-h" class="panel pad">
        <h2 id="ci-h" class="h4" style="margin-bottom:var(--sp-8)">פרטי בית המשפט</h2>
        <dl class="dl">
          {c.address && <div><dt>כתובת</dt><dd>{c.address}</dd></div>}
          {c.hours && <div><dt>שעות</dt><dd>{c.hours}</dd></div>}
          {c.phone && <div><dt>טלפון</dt><dd class="num"><a class="lnk" href={'tel:' + c.phone.replace(/[^0-9+*]/g, '')}>{c.phone}</a>{c.phoneNote && <span class="cap" style="display:block;font-weight:400">{c.phoneNote}</span>}</dd></div>}
          {c.district && <div><dt>מחוז</dt><dd>{c.district}</dd></div>}
          {updated && <div><dt>נבדק</dt><dd>{updated}</dd></div>}
        </dl>
        <p class="cap" style="margin-top:var(--sp-8)">לפני הגעה כדאי לבדוק באתר הרשמי של הרשות השופטת שאין שינוי בשעות.</p>
      </section>
      <section aria-labelledby="ca-h" class="stack gp12">
        <div class="sec-head" style="margin:0"><div class="sec-head-t"><h2 class="h3" id="ca-h" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">משרדים שעובדים מול בית המשפט</h2><p class="small muted">עד 3 משרדים בתשלום, מסומנים ״מודעה״. הם לא חלק מהדירוג.</p></div></div>
        <PaidSlots kind="court" target={c.slug} />
      </section>
      <section aria-labelledby="cp-h" class="stack gp12">
        <div class="sec-head" style="margin:0"><div class="sec-head-t"><h2 class="h3" id="cp-h" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">נותני שירות ליד בית המשפט</h2><p class="small muted">שמאים, מגשרים, מתורגמנים וחוקרים. עד 4 מקומות בתשלום, מסומנים ״מודעה״.</p></div></div>
        <PaidSlots kind="provider" target={c.slug} />
      </section>
      <section aria-labelledby="cg-h" class="stack gp16">
        <p class="eyebrow">לפני הדיון</p>
        <h2 id="cg-h" class="h3" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif);margin-top:-8px">מה חשוב לדעת</h2>
        <Toc items={toc} mobile />
        <div class="prose" set:html={html} />
        <Disclaimer kind="info" />
      </section>
      <Faq items={c.faq} />
      <Sources items={c.sources} updated={updated} />
    </div>
    <aside class="stack gp16" aria-label={`עוד על ${c.name}`}>
      {city && ranked.length > 0 && (
        <div class="aside-box"><p class="eyebrow">דירוג שקוף</p><h3>משרדים ב{city.name} לפי הדירוג</h3>
          <div class="list" style="border:0;border-radius:0;background:transparent;margin:0 -16px">
            {ranked.map((f, i) => { const s = scoreOf(f); return (
              <article class="row-c"><FirmTile f={f} /><div class="row-b"><h4 class="row-n" style="font-size:var(--fs-16)"><span class="rank">{i + 1}.</span> <a class="row-link" href={u(P.firm(f.slug))}>{f.name}</a></h4><p class="row-m">{f.areas.slice(0, 2).map((s) => areaBySlug(s)?.name).filter(Boolean).join(', ')}</p></div>{s.count > 0 ? <span class="score" aria-label={`ציון ${s.score.toFixed(1)}`}>{s.score.toFixed(1)}</span> : <span class="cap">חדש</span>}</article>
            ); })}
          </div>
          <a class="btn btn-s" href={u(P.city(city.he))}><span>לכל המשרדים ב{city.name}</span><Icon name="arrow" size={18} /></a>
        </div>
      )}
      <div class="sticky-aside show-lg"><Toc items={toc} /></div>
      <div class="aside-box on-dark" style="background:var(--ink);color:var(--on-ink);border-color:var(--ink)"><h3>מופיעים מול בית המשפט הזה?</h3><p class="small" style="color:var(--on-ink-muted)">דף בית משפט: 1,900 ₪ לשנה, עד 3 משרדים. נותני שירות: 350 ₪ לחודש, עד 4. לפני מע״מ.</p>
        <a class="btn btn-w" href={u(P.page('order')) + '?plan=court-page&target=' + encodeURIComponent(c.slug)}>משרד: להזמנת מקום</a>
        <a class="btn btn-o" href={u(P.page('order')) + '?plan=service-provider&target=' + encodeURIComponent(c.slug)}>נותן שירות: להזמנת מקום</a>
      </div>
    </aside>
  </div>
</Base>
