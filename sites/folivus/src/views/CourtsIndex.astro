---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import { P, u } from '../config/routes';
import { courts } from '../lib/data';
import { breadcrumbs, itemList, collection } from '../lib/schema';
const { path } = Astro.props as any;
const cs = courts();
const ORDER = ['supreme', 'district', 'magistrate', 'magistrates', 'family', 'labor', 'rabbinical'];
const typeName = (t: string) => ({ supreme: 'בית המשפט העליון', magistrate: 'בתי משפט השלום', magistrates: 'בתי משפט השלום', district: 'בתי המשפט המחוזיים', family: 'בתי משפט לענייני משפחה', labor: 'בתי הדין לעבודה', rabbinical: 'בתי הדין הרבניים' } as Record<string, string>)[t] || 'בתי משפט נוספים';
const groups = [...new Set(cs.map((c) => c.type || 'other'))].sort((a, b) => (ORDER.indexOf(a) + 99) % 99 - (ORDER.indexOf(b) + 99) % 99).map((t) => ({ t, items: cs.filter((c) => (c.type || 'other') === t) }));
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'בתי משפט', path }];
const title = 'בתי משפט בישראל: כתובות, שעות ומידע שימושי';
const description = 'מידע על בתי משפט בישראל: כתובת, טלפון, שעות קבלת קהל, איך מגיעים ומה כדאי לדעת לפני דיון. כל פרט עם מקור רשמי.';
---
<Base title={title} description={description} path={path} nav="courts" schema={[breadcrumbs(crumbs), collection(title, path, description), itemList(title, cs.map((c) => ({ name: c.name, path: P.court(c.he) })))]}>
  <section class="phead on-dark"><div class="wrap"><Crumbs items={crumbs} /><div class="phead-in">
    <p class="eyebrow">{cs.length} בתי משפט ובתי דין</p>
    <h1 class="h1">בתי משפט</h1>
    <p class="lead" style="max-width:640px">כתובת, דרכי הגעה, שעות ומה כדאי לדעת לפני דיון. הפרטים נבדקים מול האתרים הרשמיים של מערכת בתי המשפט.</p>
    <nav class="chips" aria-label="סוגי בתי משפט" style="margin-top:var(--sp-6)">{groups.map((g, i) => <a class="chip" href={'#ct-' + i} style="background:transparent;color:var(--on-ink);border-color:var(--ink-line)">{typeName(g.t)} <span class="c" style="color:var(--on-ink-muted)">{g.items.length}</span></a>)}</nav>
  </div></div></section>
  <div class="wrap stack" style="gap:var(--sp-36);padding-top:var(--sp-32);padding-bottom:var(--sp-56)">
    {groups.map((g, i) => (
      <section id={'ct-' + i} aria-labelledby={'cth-' + i} class="stack gp12" style="scroll-margin-top:80px">
        <h2 class="h3" id={'cth-' + i} style="font:600 var(--fs-22)/1.3 var(--serif)">{typeName(g.t)}</h2>
        <div class="tlist">{g.items.map((c) => (
          <a class="titem" href={u(P.court(c.he))}><span class="ac-ic"><Icon name="landmark" size={18} /></span><span class="stack" style="min-width:0"><span class="tn">{c.name}{c.draft && <span class="draft-b">טיוטה</span>}</span><span class="cap">{c.address || c.city || c.district}</span></span></a>
        ))}</div>
      </section>
    ))}
    {cs.length === 0 && <div class="empty">עמודי בתי המשפט בהכנה.</div>}
  </div>
</Base>
