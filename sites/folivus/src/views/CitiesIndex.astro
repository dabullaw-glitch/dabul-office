---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import IsraelMap from '../components/IsraelMap.astro';
import { P, u } from '../config/routes';
import { cities, REGIONS, firms } from '../lib/data';
import { breadcrumbs, itemList, collection } from '../lib/schema';
const { path } = Astro.props as any;
const fs = await firms();
const cs = cities();
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'ערים', path }];
const title = 'עורכי דין לפי עיר';
const description = `משרדי עורכי דין ב${cs.length} ערים ויישובים בכל הארץ, מחולקים לפי אזור. בחרו עיר כדי לראות את כל התחומים בה.`;
const n = (s: string) => fs.filter((f) => f.city === s).length;
---
<Base title={title} description={description} path={path} nav="cities" schema={[breadcrumbs(crumbs), collection(title, path, description), itemList(title, cs.map((c) => ({ name: 'עורכי דין ב' + c.name, path: P.city(c.he) })))]}>
  <section class="phead on-dark"><div class="wrap"><Crumbs items={crumbs} /><div class="phead-in">
    <p class="eyebrow">מקריית שמונה ועד אילת</p>
    <h1 class="h1">עורכי דין לפי עיר</h1>
    <p class="lead" style="max-width:640px">בחרו עיר במפה או ברשימה כדי לראות משרדים בכל תחומי המשפט שפועלים בה.</p>
  </div></div></section>
  <section class="sec sec-ink on-dark" aria-label="מפת הערים" style="padding-top:var(--sp-8)">
    <div class="wrap"><IsraelMap /></div>
  </section>
  <div class="wrap stack" style="gap:var(--sp-32);padding-top:var(--sp-40);padding-bottom:var(--sp-56)">
    {REGIONS.map((r, i) => (
      <section aria-labelledby={'rg-' + i} class="stack gp12">
        <h2 class="h3" id={'rg-' + i} style="font:600 var(--fs-22)/1.3 var(--serif)">אזור {r}</h2>
        <div class="linkgrid">{cs.filter((c) => c.region === r).map((c) => <a href={u(P.city(c.he))}><span>עורכי דין ב{c.name}</span><span class="c">{n(c.slug) === 0 ? '' : n(c.slug) === 1 ? 'משרד אחד' : n(c.slug) + ' משרדים'}</span></a>)}</div>
      </section>
    ))}
  </div>
</Base>
