---
// Area page (/עורך-דין-<area>/) and area + city page (/עורך-דין-<area>/<city>/).
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import FirmList from '../components/FirmList.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Faq from '../components/Faq.astro';
import Toc from '../components/Toc.astro';
import Sources from '../components/Sources.astro';
import JoinBand from '../components/JoinBand.astro';
import { P, u } from '../config/routes';
import { areaBySlug, areas, cities, cityBySlug, firms, rankFor, articles, tools, courts, fmtDate } from '../lib/data';
import { render } from '../lib/md';
import { breadcrumbs, itemList, faqPage, guide, collection } from '../lib/schema';

const { path, area: aslug, city: cslug } = Astro.props as any;
const a = areaBySlug(aslug)!;
const c = cslug ? cityBySlug(cslug)! : null;
const all = await firms();
const inArea = all.filter((f) => f.areas.includes(a.slug));
const list = c ? inArea.filter((f) => f.city === c.slug) : inArea;
const { featured, rest } = rankFor(list, a.slug, c?.slug);
const cityCounts = cities().map((x) => ({ c: x, n: inArea.filter((f) => f.city === x.slug).length })).filter((x) => x.n > 0).sort((x, y) => y.n - x.n);
const g = !c && a.guide ? render(a.guide.body) : null;
const faq = !c && a.guide ? a.guide.faq : [];
const related = areas().filter((x) => x.group === a.group && x.slug !== a.slug);
const arts = articles().filter((x) => x.areas.includes(a.slug)).slice(0, 4);
const ts = tools().filter((t) => t.area === a.slug).slice(0, 4);
const cts = c ? courts().filter((x) => x.city === c.name || x.city === c.slug) : [];
const h1 = c ? `${a.title} ב${c.name}` : a.title;
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'תחומים', path: P.page('areas') }, { name: a.title, path: P.area(a.he) }, ...(c ? [{ name: c.name, path }] : [])];
const title = c ? `${a.title} ב${c.name}: משרדים, פרטי קשר וחוות דעת` : (a.guide?.seoTitle || `${a.title}: משרדים לפי עיר ומדריך מלא`);
const description = c
  ? `${list.length ? list.length + ' משרדים' : 'משרדים'} בתחום ${a.name} ב${c.name}: כתובת, טלפון, שעות וחוות דעת מאומתות. ${a.intro}`.slice(0, 158)
  : (a.description || a.intro).slice(0, 158);
const updated = a.guide?.updated ? fmtDate(a.guide.updated) : '';
const schema = [breadcrumbs(crumbs), collection(h1, path, description),
  list.length ? itemList(h1, [...featured, ...rest].map((f) => ({ name: f.name, path: P.firm(f.slug) }))) : null,
  faqPage(faq), !c ? guide(a, path) : null];
---
<Base title={title} description={description} path={path} nav="areas" schema={schema} noindex={!!c && list.length === 0}>
  <section class="phead tint">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <h1>{h1}</h1>
      <p class="lead">{a.intro}</p>
      <div class="chips">
        <span class="chip"><Icon name="building" />{list.length} משרדים ברשימה</span>
        {!c && cityCounts.length > 0 && <span class="chip"><Icon name="pin" />ב־{cityCounts.length} ערים</span>}
        {g && <a class="chip" href="#guide"><Icon name="book" />מדריך מלא לתחום</a>}
        {updated && <span class="chip"><Icon name="calendar" />עודכן {updated}</span>}
        {c && <a class="chip" href={u(P.area(a.he))}><Icon name="globe" />{a.title} בכל הארץ</a>}
      </div>
    </div>
  </section>

  <div class="wrap layout">
    <div>
      <section aria-labelledby="list-h">
        <h2 id="list-h">{c ? `משרדים ב${c.name}` : `משרדים בתחום ${a.name}`}</h2>
        <FirmList featured={featured} rest={rest} area={a.slug} emptyText={c ? `עדיין אין ברשימה משרדים בתחום ${a.name} ב${c.name}.` : undefined} />
        <Disclaimer kind="list" />
      </section>

      {c && (
        <section class="mt3" aria-labelledby="cityinfo-h">
          <h2 id="cityinfo-h">לפני שפונים למשרד ב{c.name}</h2>
          <div class="prose">
            <p>{a.intro} כדאי להכין מראש את המסמכים הרלוונטיים, לכתוב בכמה שורות מה קרה ומה אתם רוצים להשיג, ולשאול בפגישה הראשונה על דרך העבודה, לוחות הזמנים ושכר הטרחה.</p>
            <p>הסבר מלא על התחום, מה עורך הדין עושה ומה שואלים בפגישה הראשונה נמצא <a href={u(P.area(a.he)) + '#guide'}>במדריך לתחום {a.name}</a>.</p>
          </div>
          {cts.length > 0 && <p>בתי משפט ב{c.name}: {cts.map((x, i) => <>{i > 0 && ', '}<a href={u(P.court(x.he))}>{x.name}</a></>)}</p>}
        </section>
      )}

      {g ? (
        <section id="guide" class="mt3" aria-labelledby="guide-h">
          <span class="eyebrow">מדריך</span>
          <h2 id="guide-h" style="margin-top:0">{a.title}: מה חשוב לדעת</h2>
          <div class="meta-line mb2">
            <span><Icon name="user" />מערכת האתר{a.guide!.reviewedBy && <> · נבדק בידי {a.guide!.reviewedBy}</>}</span>
            {updated && <span><Icon name="calendar" />עודכן {updated}</span>}
            {a.guide!.draft && <span class="badge b-draft">טיוטה</span>}
          </div>
          <Toc items={g.toc} mobile />
          <div class="prose" set:html={g.html} />
          <Disclaimer kind="info" />
          <Sources items={a.guide!.sources} updated={updated} />
        </section>
      ) : !c && (
        <section id="guide" class="mt3" aria-labelledby="guide-h">
          <h2 id="guide-h">מה עושה {a.title}</h2>
          <div class="prose"><p>{a.intro}</p><p>מדריך מלא לתחום, עם מקורות ותאריך עדכון, נמצא בכתיבה ויתפרסם כאן.</p></div>
        </section>
      )}

      <Faq items={faq} />

      {arts.length > 0 && (
        <section class="mt3" aria-labelledby="ra-h">
          <h2 id="ra-h">מאמרים בתחום</h2>
          <div class="grid g2">{arts.map((x) => <a class="card acard" href={u(P.article(x.he))}><h3>{x.title}</h3><p>{x.description}</p></a>)}</div>
        </section>
      )}

      {related.length > 0 && (
        <section class="mt3" aria-labelledby="rel-h">
          <h2 id="rel-h">תחומים קרובים</h2>
          <div class="chips">{related.map((x) => <a class="chip" href={u(c ? P.area(x.he) : P.area(x.he))}>{x.title}</a>)}</div>
        </section>
      )}
    </div>

    <aside class="aside">
      {cityCounts.length > 0 && (
        <nav class="box" aria-labelledby="cities-h">
          <h2 id="cities-h">{a.title} לפי עיר</h2>
          <ul class="citylist">
            {cityCounts.map((x) => <li><a href={u(P.areaCity(a.he, x.c.he))} aria-current={c?.slug === x.c.slug ? 'page' : undefined}>{x.c.name}<span class="n">{x.n}</span></a></li>)}
          </ul>
        </nav>
      )}
      {ts.length > 0 && (
        <div class="box">
          <h2>כלים חינמיים בתחום</h2>
          <ul class="links">{ts.map((t) => <li><a href={u(P.tool(t.he))}>{t.name}</a></li>)}</ul>
        </div>
      )}
      <div class="sticky">
        {g && <Toc items={g.toc} />}
        <div class="box brass mt1">
          <h2>עורכי דין בתחום {a.name}?</h2>
          <p class="small">אשרו בעלות על הפרופיל בחינם ועדכנו את הפרטים.</p>
          <a class="btn btn-pine btn-sm btn-block" href={u(P.page('claim'))}>לניהול הפרופיל</a>
        </div>
      </div>
    </aside>
  </div>
  <section class="sec tight"><div class="wrap"><JoinBand /></div></section>
</Base>
