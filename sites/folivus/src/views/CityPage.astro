---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import FirmList from '../components/FirmList.astro';
import ListTools from '../components/ListTools.astro';
import ResultsMap from '../components/ResultsMap.astro';
import HowOrdered from '../components/HowOrdered.astro';
import CompareDock from '../components/CompareDock.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { P, u } from '../config/routes';
import { areas, cities, cityBySlug, firms, rankFor, courts } from '../lib/data';
import { breadcrumbs, itemList, collection } from '../lib/schema';
import { scoreOf } from '../lib/ui';
const { path, city } = Astro.props as any;
const c = cityBySlug(city)!;
const all = await firms();
const list = all.filter((f) => f.city === c.slug);
const { featured, rest } = rankFor(list, undefined, c.slug);
const counts = areas().map((a) => ({ a, n: list.filter((f) => f.areas.includes(a.slug)).length })).filter((x) => x.n > 0).sort((x, y) => y.n - x.n);
const near = cities().filter((x) => x.region === c.region && x.slug !== c.slug).map((x) => ({ c: x, n: all.filter((f) => f.city === x.slug).length })).sort((x, y) => y.n - x.n).slice(0, 10);
const cts = courts().filter((x) => x.city === c.name || x.city === c.slug || x.city.includes(c.name));
const pins = [...featured.map((f) => ({ f, label: 'מ', ad: true, id: 'fr-' + f.slug + '-ad' })), ...rest.map((f, i) => ({ f, label: String(i + 1), ad: false, id: 'fr-' + f.slug }))];
const reviews = list.reduce((s, f) => s + scoreOf(f).count, 0);
const crumbs = [{ name: 'דף הבית', path: '' }, { name: 'ערים', path: P.page('cities') }, { name: 'עורכי דין ב' + c.name, path }];
const title = `עורכי דין ב${c.name}: משרדים לפי תחום`;
const description = `משרדי עורכי דין ב${c.name} בכל תחומי המשפט: כתובת, טלפון, שעות וביקורות מאומתות של לקוחות.`;
---
<Base title={title} description={description} path={path} nav="cities" noindex={list.length === 0} schema={[breadcrumbs(crumbs), collection(title, path, description), list.length ? itemList(title, list.map((f) => ({ name: f.name, path: P.firm(f.slug) }))) : null]}>
  <section class="phead">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <div class="phead-in">
        <p class="eyebrow">אזור {c.region}</p>
        <h1 class="h1">עורכי דין ב{c.name}</h1>
        <p class="facts"><span>{list.length === 1 ? <><b class="num">1</b> משרד</> : <><b class="num">{list.length}</b> משרדים</>}</span><span aria-hidden="true">·</span><span>{reviews === 1 ? <>ביקורת מאומתת אחת</> : <><b class="num">{reviews}</b> ביקורות מאומתות</>}</span><span aria-hidden="true">·</span><span><b class="num">{counts.length}</b> תחומים</span></p>
        {counts.length > 0 && (
          <form class="refine" data-refine data-base={u('')} data-city={c.he}>
            <label class="sr" for="carea">תחום</label>
            <span class="selw"><select class="inp" id="carea" name="area"><option value="">כל התחומים</option>{counts.map((x) => <option value={x.a.he}>{x.a.name} ({x.n})</option>)}</select><Icon name="chevd" size={16} /></span>
            <button class="btn btn-w btn-lg" type="submit"><Icon name="search" size={18} /><span>הצגת משרדים</span></button>
          </form>
        )}
      </div>
    </div>
  </section>
  {rest.length > 1 && <ListTools target="fl-rank" total={rest.length} />}
  <div class="wrap cols" style="padding-top:var(--sp-28);padding-bottom:var(--sp-56)">
    <div class="stack" style="gap:var(--sp-40);min-width:0">
      <div class={'res-cols' + (list.length ? ' withmap' : '')}>
        {list.length > 0 && <ResultsMap items={pins} city={c.slug} />}
        <div class="stack" style="gap:var(--sp-24);min-width:0"><HowOrdered /><FirmList featured={featured} rest={rest} city={c.slug} id="fl" emptyText={`עדיין אין ברשימה משרדים ב${c.name}.`} /></div>
      </div>
      <Disclaimer kind="list" />
      {counts.length > 0 && (
        <section aria-labelledby="ca-h" class="stack gp12"><h2 class="h3" id="ca-h" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">לפי תחום ב{c.name}</h2>
          <div class="linkgrid">{counts.map((x) => <a href={u(P.areaCity(x.a.he, c.he))}><span>{x.a.title} ב{c.name}</span><span class="c">{x.n === 1 ? 'משרד אחד' : x.n + ' משרדים'}</span></a>)}</div></section>
      )}
      {cts.length > 0 && (
        <section aria-labelledby="cc-h" class="stack gp12"><h2 class="h3" id="cc-h" style="font:var(--serif-w) var(--fs-22)/1.3 var(--serif)">בתי משפט ב{c.name}</h2>
          <div class="linkgrid">{cts.map((x) => <a href={u(P.court(x.he))}><span>{x.name}</span><Icon name="chev" size={16} /></a>)}</div></section>
      )}
    </div>
    <aside class="stack gp16" aria-label={`עוד ב${c.name}`}>
      <div class="aside-box"><h3>ערים נוספות באזור {c.region}</h3><div class="linkgrid one">{near.map((x) => <a href={u(P.city(x.c.he))}><span>עורכי דין ב{x.c.name}</span><span class="c">{x.n}</span></a>)}</div></div>
      <div class="aside-box on-dark" style="background:var(--ink);color:var(--on-ink);border-color:var(--ink)"><h3>המשרד שלכם ב{c.name}?</h3><p class="small" style="color:var(--on-ink-muted)">מקום מקודם בראש דף של תחום ועיר: חבילה מקומית, 990 ₪ לשנה, לפני מע״מ.</p><a class="btn btn-w" href={u(P.page('join'))}>פרסום לעורכי דין</a></div>
    </aside>
  </div>
  <CompareDock />
  <script>
    document.querySelectorAll<HTMLFormElement>('form[data-refine]').forEach((f) => f.addEventListener('submit', (e) => {
      e.preventDefault(); const v = (f.elements.namedItem('area') as HTMLSelectElement).value; if (v) location.href = f.dataset.base + v + '/' + f.dataset.city + '/';
    }));
  </script>
</Base>
