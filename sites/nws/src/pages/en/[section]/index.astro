---
import SectionPage from '../../../components/SectionPage.astro';
import { liveSections } from '../../../lib/content';
export function getStaticPaths() { return liveSections().map((s) => ({ params: { section: s.slug }, props: { k: s.key } })); }
const { k } = Astro.props;
---
<SectionPage lang="en" k={k} />
