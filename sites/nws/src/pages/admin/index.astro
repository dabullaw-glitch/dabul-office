---
// Management panel of nws.co.il for Yakir (28.10.2026). A static page; all data comes from the Supabase function hns-panel.
// Login: a password Yakir chose himself (set through a one-time link that hns-panel sends only to his Telegram, #setup=<token>),
// then a 6 digit code sent to his Telegram. The session token (ends after 12 hours idle) is kept in this browser.
// No secret is in this page; every action is checked by hns-panel on the server. noindex, not linked from the site, not in the sitemap.
import { HNS_API } from '../../data/site';
const api = HNS_API + '/hns-panel';
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>לוח ניהול | חדשות נתניה והשרון</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style is:inline>
:root{--ink:#0E1726;--mut:#5B6676;--line:#E3E7ED;--bg:#F4F6F9;--sea:#0B5FCC;--ok:#1E8A4C;--no:#C8102E;--warn:#E08A00}
*{box-sizing:border-box}html,body{margin:0}
body{font-family:system-ui,-apple-system,"Segoe UI",Arial,sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.5}
header{position:sticky;top:0;z-index:5;background:#0E1726;color:#fff;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px}
header b{font-size:17px}header button{background:transparent;color:#C9D6EA;border:1px solid #3A4A63;border-radius:8px;padding:6px 10px;font:inherit;font-size:14px}
main{max-width:860px;margin:0 auto;padding:14px 16px 60px}
.tabs{display:flex;gap:8px;overflow-x:auto;padding:4px 0 12px;scrollbar-width:none}.tabs::-webkit-scrollbar{display:none}
.tab{flex:none;border:1px solid #CBD3DD;background:#fff;border-radius:999px;padding:8px 14px;font:inherit;font-weight:700;font-size:15px;color:var(--ink)}
.tab[aria-selected=true]{background:var(--sea);border-color:var(--sea);color:#fff}
.tab i{font-style:normal;display:inline-block;min-width:22px;padding:0 6px;margin-inline-start:6px;border-radius:999px;background:#E6EEF9;color:var(--sea);font-size:13px}
.tab[aria-selected=true] i{background:#fff}
.sub{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 12px}.sub button{border:1px solid #CBD3DD;background:#fff;border-radius:8px;padding:6px 10px;font:inherit;font-size:14px}
.sub button[aria-pressed=true]{background:#0E1726;color:#fff;border-color:#0E1726}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px;overflow-wrap:anywhere}
.card h3{margin:0 0 4px;font-size:17px}.meta{color:var(--mut);font-size:13.5px}
.card p{margin:6px 0}.pre{white-space:pre-wrap}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.b{min-height:42px;border-radius:10px;border:1px solid #CBD3DD;background:#fff;font:inherit;font-weight:700;font-size:15px;padding:0 14px;color:var(--ink);text-decoration:none;display:inline-flex;align-items:center;justify-content:center}
.b.ok{background:var(--ok);border-color:var(--ok);color:#fff}.b.no{background:#fff;border-color:var(--no);color:var(--no)}.b.pri{background:var(--sea);border-color:var(--sea);color:#fff}
.b:disabled{opacity:.5}
.tag{display:inline-block;font-size:12.5px;font-weight:700;border-radius:6px;padding:1px 7px;background:#EEF4FC;color:var(--sea);margin-inline-end:6px}
.tag.w{background:#FFF4E0;color:#9A5B00}.tag.r{background:#FDECEE;color:var(--no)}.tag.g{background:#EAF6EF;color:var(--ok)}
details{margin-top:8px}summary{cursor:pointer;color:var(--sea);font-weight:700}
form.e{display:grid;gap:10px;margin-top:10px}form.e label{display:grid;gap:4px;font-size:14px;font-weight:700}
form.e input,form.e textarea,form.e select{font:inherit;font-weight:400;border:1px solid #CBD3DD;border-radius:10px;padding:10px 12px;width:100%}
.empty{text-align:center;color:var(--mut);padding:30px 10px}
.msg{position:fixed;inset-inline:16px;bottom:16px;z-index:9;background:#0E1726;color:#fff;border-radius:12px;padding:12px 14px;font-weight:700;display:none}
.login{max-width:440px;margin:40px auto;background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px;text-align:center}
.login h1{font-size:22px;margin:0 0 8px}.login p{color:var(--mut)}
img.ph{max-width:100%;border-radius:10px;margin-top:8px}
a{color:var(--sea)}
</style>
</head>
<body>
<header><b>לוח ניהול: חדשות נתניה והשרון</b><span><a href="/" style="color:#C9D6EA;font-size:14px;margin-inline-end:10px">לאתר</a><button id="out" hidden>יציאה</button></span></header>
<main id="app"><div class="empty">טוען...</div></main>
<div class="msg" id="msg" role="status" aria-live="polite"></div>
<script is:inline define:vars={{ api }}>
(function(){
  var KEY='nwsPanelS', S=null, TAB='requests', SUBS={requests:'new',listings:'pending'}, CATS=[], SUM={};
  try{S=localStorage.getItem(KEY)}catch(e){}
  var app=document.getElementById('app'), msgEl=document.getElementById('msg'), outBtn=document.getElementById('out');
  var esc=function(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})};
  var when=function(t){if(!t)return'';var d=new Date(t);return d.toLocaleString('he-IL',{timeZone:'Asia/Jerusalem',day:'numeric',month:'numeric',hour:'2-digit',minute:'2-digit'})};
  function toast(t,bad){msgEl.textContent=t;msgEl.style.background=bad?'#C8102E':'#0E1726';msgEl.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(function(){msgEl.style.display='none'},3500)}
  function call(action,data){
    var body=Object.assign({action:action,s:S},data||{});
    return fetch(api,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}).then(function(r){return r.json().catch(function(){return{ok:false,error:'שגיאת שרת'}})})
      .then(function(j){ if(j&&j.auth===false){ loginView('החיבור הסתיים (אחרי 12 שעות בלי פעילות או יציאה). התחברו שוב.'); throw new Error('auth'); } return j; })
      .catch(function(e){ if(e.message!=='auth') toast('אין חיבור. נסו שוב.',true); throw e; });
  }
  function post(body){ return fetch(api,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}).then(function(r){return r.json().catch(function(){return{ok:false,error:'שגיאת שרת'}})}); }
  function box(inner){ outBtn.hidden=true; app.innerHTML='<div class="login">'+inner+'<p id="lm" style="font-weight:700"></p></div>'; }
  function say(t,ok){ var m=document.getElementById('lm'); if(m){ m.style.color=ok?'#1E8A4C':'#C8102E'; m.textContent=t||''; } }
  function busy(btn,p,then){ btn.disabled=true; say('רגע...',true); p.then(function(j){ btn.disabled=false; then(j); }).catch(function(){ btn.disabled=false; say('אין חיבור. נסו שוב.'); }); }
  function setupBtn(id,label){ var b=document.getElementById(id); if(!b) return; b.onclick=function(){ busy(b,post({action:'setup_link'}),function(j){ say(j.ok?j.message:(j.error||'נכשל'),j.ok); }); }; }
  var pwRules='לפחות 12 תווים, ולפחות 3 מתוך 4: אותיות קטנות (או עברית), אותיות גדולות באנגלית, ספרות, סימנים. לא סיסמה שאתם משתמשים בה במקום אחר.';
  function setupView(k){
    box('<h1>בחירת סיסמה ללוח הניהול</h1><p>'+pwRules+'</p><form class="e" id="sf" style="text-align:right"><label>סיסמה חדשה<input type="password" name="p1" autocomplete="new-password" required minlength="12" dir="ltr"></label>'
      +'<label>שוב את אותה סיסמה<input type="password" name="p2" autocomplete="new-password" required dir="ltr"></label><label style="display:flex;gap:8px;align-items:center;font-weight:400"><input type="checkbox" id="sh" style="width:auto"> להציג את הסיסמה</label>'
      +'<button class="b pri">שמירת הסיסמה</button></form>');
    var f=document.getElementById('sf');
    document.getElementById('sh').onchange=function(){ f.p1.type=f.p2.type=this.checked?'text':'password'; };
    f.onsubmit=function(e){ e.preventDefault(); if(f.p1.value!==f.p2.value) return say('שתי הסיסמאות לא זהות');
      busy(f.querySelector('button'),post({action:'set_password',k:k,password:f.p1.value}),function(j){ if(j.ok){ f.reset(); loginView(j.message,true); } else say(j.error||'נכשל'); }); };
  }
  function loginView(note,good){
    try{localStorage.removeItem(KEY)}catch(e){} S=null;
    box('<h1>כניסה ללוח הניהול</h1><div id="lv">טוען...</div>');
    if(note) say(note,good);
    post({action:'state'}).then(function(st){
      var lv=document.getElementById('lv');
      if(!st.pw_set){
        lv.innerHTML='<p>עוד לא נבחרה סיסמה. לוחצים על הכפתור, ומקבלים בטלגרם (בבוט של המשרד) כפתור לבחירת סיסמה. רק אתם מקבלים אותו.</p><button class="b pri" id="su" style="width:100%">הגדרת סיסמה</button>';
        return setupBtn('su');
      }
      lv.innerHTML='<form class="e" id="lf" style="text-align:right"><label>סיסמה<input type="password" name="pw" autocomplete="current-password" required dir="ltr"></label><button class="b pri">המשך</button></form>'
        +'<p class="meta" style="margin-top:14px">אחרי הסיסמה יישלח אליכם קוד בן 6 ספרות בטלגרם.</p><button class="b" id="fg" style="margin-top:6px">שכחתי את הסיסמה</button>';
      setupBtn('fg');
      var f=document.getElementById('lf');
      f.onsubmit=function(e){ e.preventDefault(); busy(f.querySelector('button'),post({action:'login',password:f.pw.value}),function(j){ if(j.ok){ f.pw.value=''; codeView(j.pre); } else say(j.error||'נכשל'); }); };
    }).catch(function(){ say('אין חיבור. נסו שוב.'); });
  }
  function codeView(pre){
    box('<h1>קוד מטלגרם</h1><p>שלחנו לכם קוד בן 6 ספרות בטלגרם (בבוט של המשרד). הקוד תקף ל-5 דקות.</p><form class="e" id="cf"><label>הקוד<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required dir="ltr" style="font-size:24px;letter-spacing:6px;text-align:center"></label><button class="b pri">כניסה</button></form>');
    var f=document.getElementById('cf'); f.code.focus();
    f.onsubmit=function(e){ e.preventDefault(); busy(f.querySelector('button'),post({action:'otp',pre:pre,code:f.code.value}),function(j){
      if(j.ok){ S=j.s; try{localStorage.setItem(KEY,S)}catch(e){} start(); } else if(j.again){ loginView(j.error); } else { f.code.value=''; say(j.error||'נכשל'); } }); };
  }
  var TABS=[['requests','פניות','requests'],['listings','מדריך עסקים','listings'],['stories','ידיעות לאישור','stories'],['published','ידיעות שפורסמו'],['events','פס אירוע']];
  function shell(){
    outBtn.hidden=false;
    app.innerHTML='<nav class="tabs" role="tablist">'+TABS.map(function(t){return '<button class="tab" role="tab" data-t="'+t[0]+'" aria-selected="'+(TAB===t[0])+'">'+t[1]+(t[2]&&SUM[t[2]]?'<i>'+SUM[t[2]]+'</i>':'')+'</button>'}).join('')+'</nav><div id="sub"></div><div id="list"><div class="empty">טוען...</div></div>';
    app.querySelectorAll('.tab').forEach(function(b){b.onclick=function(){TAB=b.dataset.t; try{sessionStorage.setItem('nwsTab',TAB)}catch(e){} shell(); load();}});
    var sel=app.querySelector('.tab[aria-selected=true]'); if(sel&&sel.scrollIntoView) sel.scrollIntoView({inline:'center',block:'nearest'});
  }
  function summary(){ return call('summary').then(function(j){ if(j.ok){SUM=j; app.querySelectorAll('.tab').forEach(function(b){var t=TABS.find(function(x){return x[0]===b.dataset.t}); if(t&&t[2]) b.innerHTML=t[1]+(SUM[t[2]]?'<i>'+SUM[t[2]]+'</i>':'');});} }).catch(function(){}); }
  function subBar(opts,key){
    var el=document.getElementById('sub');
    el.innerHTML='<div class="sub">'+opts.map(function(o){return '<button data-v="'+o[0]+'" aria-pressed="'+(SUBS[key]===o[0])+'">'+o[1]+'</button>'}).join('')+'</div>';
    el.querySelectorAll('button').forEach(function(b){b.onclick=function(){SUBS[key]=b.dataset.v; load();}});
  }
  function list(html){ document.getElementById('list').innerHTML=html||'<div class="empty">אין כאן כלום כרגע.</div>'; }
  function act(btn,p,done){ btn.disabled=true; p.then(function(j){ btn.disabled=false; if(j&&j.ok){ done&&done(j); } else { toast((j&&j.error)||'הפעולה נכשלה',true); } }).catch(function(){btn.disabled=false}); }

  var TYPE={contact:'פנייה כללית',advertise:'בקשת פרסום',sponsored:'כתבת תוכן שיווקי',promote:'קידום במדריך',banner:'באנר',tip:'ידיעה מקורא',correction:'תיקון או הסרה',newsletter:'הרשמה לניוזלטר'};
  var OFFER={featured:'קידום במדריך (מומלץ)',leader:'מוביל בקטגוריה',sponsored:'כתבת תוכן שיווקי',tgpost:'פוסט ממומן בטלגרם',banner:'באנר באתר',event:'אירוע מקודם',newsletter:'חסות לניוזלטר',other:'משהו אחר'};
  function wa(p){return /^05\d{8}$/.test(p||'')?'https://wa.me/972'+p.slice(1):''}
  function loadRequests(){
    subBar([['new','חדשות'],['handled','טופלו'],['spam','ספאם'],['all','הכל']],'requests');
    call('requests',{status:SUBS.requests}).then(function(j){
      if(!j.ok) return list('<div class="empty">'+esc(j.error)+'</div>');
      list(j.requests.map(function(r){
        var paid=['advertise','sponsored','promote','banner'].indexOf(r.type)>=0;
        return '<div class="card" data-id="'+r.id+'"><h3><span class="tag'+(paid?' w':'')+'">'+esc(TYPE[r.type]||r.type)+'</span>'+esc(r.business||r.name||'בלי שם')+'</h3>'
          +'<div class="meta">#'+r.id+' · '+when(r.created_at)+(r.is_test?' · בדיקה':'')+(r.status!=='new'?' · '+(r.status==='handled'?'טופל':'ספאם')+' '+when(r.handled_at):'')+'</div>'
          +(r.offer?'<p><b>במה מתעניינים:</b> '+esc(OFFER[r.offer]||r.offer)+'</p>':'')
          +(r.name&&r.business?'<p><b>שם:</b> '+esc(r.name)+'</p>':'')
          +(r.phone?'<p><b>טלפון:</b> <a href="tel:'+esc(r.phone)+'" dir="ltr">'+esc(r.phone)+'</a></p>':'')
          +(r.email?'<p><b>מייל:</b> <a href="mailto:'+esc(r.email)+'" dir="ltr">'+esc(r.email)+'</a></p>':'')
          +(r.url?'<p><b>קישור:</b> <a href="'+esc(r.url)+'" target="_blank" rel="noopener">'+esc(r.url)+'</a></p>':'')
          +(r.message?'<p class="pre">'+esc(r.message)+'</p>':'')
          +(r.photo_url?'<img class="ph" src="'+esc(r.photo_url)+'" alt="התמונה שצורפה"><div class="meta">'+(r.photo_ok?'השולח אישר לפרסם את התמונה':'השולח לא אישר לפרסם את התמונה')+'</div>':'')
          +(r.page?'<div class="meta">נשלח מהדף '+esc(r.page)+(r.lang&&r.lang!=='he'?' ('+esc(r.lang)+')':'')+'</div>':'')
          +(paid?'<div class="meta">התשלום לא מחובר לאתר. חוזרים אליהם ידנית.</div>':'')
          +'<details><summary>הערה פנימית'+(r.note?': '+esc(r.note.slice(0,40)):'')+'</summary><form class="e" data-note><textarea name="note" rows="2">'+esc(r.note||'')+'</textarea><button class="b">שמירת ההערה</button></form></details>'
          +'<div class="row">'
          +(r.phone?'<a class="b" href="tel:'+esc(r.phone)+'">חיוג</a>':'')+(wa(r.phone)?'<a class="b" href="'+wa(r.phone)+'" target="_blank" rel="noopener">וואטסאפ</a>':'')
          +(r.status!=='handled'?'<button class="b ok" data-s="handled">✓ טופל</button>':'')
          +(r.status!=='spam'?'<button class="b no" data-s="spam">ספאם</button>':'')
          +(r.status!=='new'?'<button class="b" data-s="new">להחזיר לחדשות</button>':'')
          +'</div></div>';
      }).join(''));
      document.querySelectorAll('#list .card').forEach(function(c){
        var id=c.dataset.id;
        c.querySelectorAll('[data-s]').forEach(function(b){b.onclick=function(){act(b,call('request_set',{id:id,status:b.dataset.s}),function(){toast('נשמר'); c.remove(); summary();});}});
        var f=c.querySelector('[data-note]'); if(f) f.onsubmit=function(e){e.preventDefault(); act(f.querySelector('button'),call('request_set',{id:id,note:f.note.value}),function(){toast('ההערה נשמרה')});};
      });
    }).catch(function(){});
  }
  function loadListings(){
    subBar([['pending','ממתינים לאישור'],['approved','באתר'],['rejected','נדחו']],'listings');
    call('listings',{status:SUBS.listings}).then(function(j){
      if(!j.ok) return list('<div class="empty">'+esc(j.error)+'</div>');
      CATS=j.categories||[]; var cn={}; CATS.forEach(function(c){cn[c.slug]=c.plural_he});
      list(j.listings.map(function(l){
        var url='/directory/'+l.category+'/b'+l.id+'/';
        var fld=function(n,label,v,t){return '<label>'+label+(t==='ta'?'<textarea name="'+n+'" rows="5">'+esc(v||'')+'</textarea>':'<input name="'+n+'" value="'+esc(v||'')+'"'+(t?' dir="ltr"':'')+'>')+'</label>'};
        return '<div class="card" data-id="'+l.id+'"><h3>'+esc(l.name)+'</h3>'
          +'<div class="meta">#'+l.id+' · '+esc(cn[l.category]||l.category)+' · '+esc(l.area)+' · '+when(l.created_at)+(l.is_test?' · בדיקה':'')+(l.plan==='featured'?' · <span class="tag w">מקודם</span>':'')+'</div>'
          +'<p class="pre">'+esc(l.description)+'</p>'
          +'<p><b>טלפון:</b> <a href="tel:'+esc(l.phone)+'" dir="ltr">'+esc(l.phone)+'</a>'+(l.whatsapp?' · וואטסאפ '+esc(l.whatsapp):'')+(l.email?' · '+esc(l.email):'')+'</p>'
          +(l.website?'<p><a href="'+esc(l.website)+'" target="_blank" rel="noopener nofollow">'+esc(l.website)+'</a></p>':'')
          +(l.address?'<p>כתובת: '+esc(l.address)+'</p>':'')+(l.license_no?'<p>רישיון: '+esc(l.license_no)+'</p>':'')
          +(l.contact_name||l.contact_phone?'<p class="meta">איש קשר (לא מפורסם): '+esc(l.contact_name||'')+' '+esc(l.contact_phone||'')+'</p>':'')
          +(l.interest&&l.interest.length?'<p><span class="tag w">מתעניינים גם ב: '+l.interest.map(function(i){return esc(OFFER[i]||i)}).join(', ')+'</span></p>':'')
          +(l.status==='approved'?'<p><a href="'+url+'" target="_blank">לדף העסק באתר</a> <span class="meta">(שינוי מופיע באתר תוך כרבע שעה)</span></p>':'')
          +'<details><summary>עריכה</summary><form class="e" data-edit>'
          +fld('name','שם העסק',l.name)+'<label>קטגוריה<select name="category">'+CATS.map(function(c){return '<option value="'+c.slug+'"'+(c.slug===l.category?' selected':'')+'>'+esc(c.plural_he)+'</option>'}).join('')+'</select></label>'
          +fld('area','אזור',l.area)+fld('phone','טלפון',l.phone,1)+fld('whatsapp','וואטסאפ',l.whatsapp,1)+fld('email','מייל',l.email,1)+fld('website','אתר',l.website,1)
          +fld('address','כתובת',l.address)+fld('license_no','מספר רישיון',l.license_no)+fld('logo_url','קישור ללוגו',l.logo_url,1)+fld('description','תיאור',l.description,'ta')
          +'<label>מסלול<select name="plan"><option value="free"'+(l.plan!=='featured'?' selected':'')+'>רגיל</option><option value="featured"'+(l.plan==='featured'?' selected':'')+'>מקודם (מומלץ)</option></select></label>'
          +'<label>מקודם עד (לא חובה)<input type="date" name="featured_until" value="'+(l.featured_until?l.featured_until.slice(0,10):'')+'"></label>'
          +fld('notes','הערה פנימית',l.notes)+'<button class="b pri">שמירה</button></form></details>'
          +(l.status==='pending'?'<div class="row"><button class="b ok" data-a="ok">✓ לאשר</button><button class="b no" data-a="no">✗ לדחות</button></div>':'')
          +'</div>';
      }).join(''));
      document.querySelectorAll('#list .card').forEach(function(c){
        var id=c.dataset.id;
        c.querySelectorAll('[data-a]').forEach(function(b){b.onclick=function(){ if(b.dataset.a==='no'&&!confirm('לדחות את העסק?'))return; act(b,call('listing_decide',{id:id,act:b.dataset.a}),function(j){toast(j.already?'כבר טופל':(b.dataset.a==='ok'?'אושר. יופיע באתר תוך כרבע שעה':'נדחה')); c.remove(); summary();});}});
        var f=c.querySelector('[data-edit]'); f.onsubmit=function(e){e.preventDefault(); var d={}; new FormData(f).forEach(function(v,k){d[k]=String(v).trim()}); if(!d.featured_until) d.featured_until=null;
          act(f.querySelector('button'),call('listing_edit',{id:id,fields:d}),function(){toast('נשמר')}); };
      });
    }).catch(function(){});
  }
  function srcs(s){return (s.sources||[]).map(function(x){return x.url?'<a href="'+esc(x.url)+'" target="_blank" rel="noopener">'+esc(x.name||'מקור')+'</a>':esc(x.name)}).join(', ')}
  function loadStories(){
    document.getElementById('sub').innerHTML='<p class="meta" style="margin:0 0 10px">ידיעות שהמערכת שלחה לאישור שלכם בטלגרם. "לפרסם" עובר את אותן בדיקות כמו הכפתור בטלגרם.</p>';
    call('stories').then(function(j){
      list(j.stories.map(function(s){
        var body=Array.isArray(s.body)?s.body.join('\n\n'):'';
        return '<div class="card" data-id="'+s.id+'"><h3>'+esc(s.title||'בלי כותרת')+'</h3>'
          +'<div class="meta">#'+s.id+' · '+when(s.created_at)+' · '+esc(s.section||'')+(s.sensitivity==='sensitive'?' · <span class="tag r">רגיש</span>':'')+(s.basis==='media_exclusive'?' · <span class="tag w">מבוסס רק על כלי תקשורת אחר</span>':'')+'</div>'
          +(s.dek?'<p><b>'+esc(s.dek)+'</b></p>':'')
          +'<details><summary>הטקסט המלא</summary><p class="pre">'+esc(body)+'</p></details>'
          +(s.sources&&s.sources.length?'<p class="meta">מקורות: '+srcs(s)+'</p>':'')
          +(s.pub_note?'<p class="meta">הערה: '+esc(s.pub_note)+'</p>':'')
          +'<div class="row"><button class="b ok" data-a="ok">✓ לפרסם</button><button class="b no" data-a="no">✗ לא לפרסם</button></div></div>';
      }).join(''));
      document.querySelectorAll('#list .card').forEach(function(c){
        c.querySelectorAll('[data-a]').forEach(function(b){b.onclick=function(){ act(b,call('story_decide',{id:c.dataset.id,act:b.dataset.a}),function(j){ toast(j.already?'כבר טופל':(b.dataset.a==='ok'?'פורסם. יופיע באתר תוך כרבע שעה':'לא יפורסם')); c.remove(); summary(); }); }});
      });
    }).catch(function(){});
  }
  function loadPublished(){
    document.getElementById('sub').innerHTML='<p class="meta" style="margin:0 0 10px">60 הידיעות האחרונות באתר. שינוי מופיע באתר תוך כרבע שעה.</p>';
    call('published').then(function(j){
      list(j.stories.map(function(s){
        return '<div class="card" data-id="'+s.id+'"><h3>'+esc(s.title)+'</h3><div class="meta">#'+s.id+' · '+when(s.published_at)+' · '+esc(s.section||'')+(s.kicker?' · <span class="tag">'+esc(s.kicker)+'</span>':'')+'</div>'
          +(s.dek?'<p>'+esc(s.dek)+'</p>':'')
          +'<details><summary>תווית מעל הכותרת</summary><form class="e" data-k><label>עד 5 מילים, בלי שם של כלי תקשורת. ריק = בלי תווית<input name="kicker" value="'+esc(s.kicker||'')+'"></label><button class="b pri">שמירה</button></form></details>'
          +'<details><summary style="color:#C8102E">להוריד מהאתר</summary><form class="e" data-w><label>למה (לרישום פנימי)<input name="note" placeholder="למשל: מידע לא מדויק"></label><button class="b no">להוריד את הידיעה מהאתר</button></form></details></div>';
      }).join(''));
      document.querySelectorAll('#list .card').forEach(function(c){
        var id=c.dataset.id, k=c.querySelector('[data-k]'), w=c.querySelector('[data-w]');
        k.onsubmit=function(e){e.preventDefault(); act(k.querySelector('button'),call('story_kicker',{id:id,kicker:k.kicker.value.trim()}),function(){toast('נשמר')});};
        w.onsubmit=function(e){e.preventDefault(); if(!confirm('להוריד את הידיעה מהאתר?'))return; act(w.querySelector('button'),call('story_withdraw',{id:id,note:w.note.value.trim()}),function(){toast('הידיעה תרד מהאתר תוך כרבע שעה'); c.remove();});};
      });
    }).catch(function(){});
  }
  var KIND={elections:'בחירות',storm:'סערה',holiday:'חג',emergency:'חירום',other:'אחר'};
  function evForm(e){
    e=e||{}; var f=function(n,l,dir){return '<label>'+l+'<input name="'+n+'" value="'+esc(e[n]||'')+'"'+(dir?' dir="ltr"':'')+'></label>'};
    return '<form class="e" data-ev="'+(e.id||'')+'"><label>סוג<select name="kind">'+Object.keys(KIND).map(function(k){return '<option value="'+k+'"'+(e.kind===k?' selected':'')+'>'+KIND[k]+'</option>'}).join('')+'</select></label>'
      +f('title','כותרת הפס')+f('tag','תגית קצרה')+f('stat1','נתון 1')+f('stat1_label','מה זה נתון 1')+f('stat2','נתון 2')+f('stat2_label','מה זה נתון 2')+f('cta_text','טקסט הכפתור')+f('cta_url','קישור הכפתור',1)
      +'<label style="display:flex;gap:8px;align-items:center"><input type="checkbox" name="active" style="width:auto"'+(e.active?' checked':'')+'> פעיל באתר (מכבה כל אירוע אחר)</label><button class="b pri">שמירה</button></form>';
  }
  function loadEvents(){
    document.getElementById('sub').innerHTML='<p class="meta" style="margin:0 0 10px">פס אירוע מיוחד בראש דף הבית (בחירות, סערה, חג). רק אירוע אחד פעיל בכל רגע. שינוי מופיע באתר תוך כרבע שעה.</p>'
      +'<div class="card"><details><summary>אירוע חדש</summary>'+evForm({active:true})+'</details></div>';
    call('events').then(function(j){
      list((j.events||[]).map(function(e){
        return '<div class="card" data-id="'+e.id+'"><h3>'+(e.active?'<span class="tag g">פעיל</span>':'<span class="tag">כבוי</span>')+esc(e.title||'בלי כותרת')+'</h3><div class="meta">#'+e.id+' · '+esc(KIND[e.kind]||e.kind||'')+' · עודכן '+when(e.updated_at)+'</div>'
          +'<details><summary>עריכה</summary>'+evForm(e)+'</details>'+(e.active?'<div class="row"><button class="b no" data-off>לכבות</button></div>':'')+'</div>';
      }).join(''));
      document.querySelectorAll('form[data-ev]').forEach(function(f){ f.onsubmit=function(ev){ ev.preventDefault(); var d={}; ['kind','title','tag','stat1','stat1_label','stat2','stat2_label','cta_text','cta_url'].forEach(function(k){d[k]=f[k].value.trim()||null}); d.active=f.active.checked; if(f.dataset.ev) d.id=Number(f.dataset.ev);
        act(f.querySelector('button'),call('event_set',{event:d}),function(){toast('נשמר'); loadEvents();}); }; });
      document.querySelectorAll('[data-off]').forEach(function(b){ b.onclick=function(){ act(b,call('event_clear',{id:b.closest('.card').dataset.id}),function(){toast('כובה'); loadEvents();}); }; });
    }).catch(function(){});
  }
  function load(){
    document.getElementById('sub').innerHTML=''; list('<div class="empty">טוען...</div>');
    ({requests:loadRequests,listings:loadListings,stories:loadStories,published:loadPublished,events:loadEvents})[TAB]();
  }
  function start(){ try{TAB=sessionStorage.getItem('nwsTab')||TAB}catch(e){} shell(); summary(); load(); }
  outBtn.onclick=function(){ call('logout').catch(function(){}).then(function(){ loginView('יצאתם מלוח הניהול.',true); }); };

  var m=/[#&]setup=([A-Za-z0-9_-]{20,})/.exec(location.hash||'');
  if(m){ history.replaceState(null,'',location.pathname); setupView(m[1]); }
  else if(S){ start(); } else loginView();
})();
</script>
</body>
</html>
