import { SITE_URL, BRAND } from '../../data/site';
const jsonld = [{ '@context': 'https://schema.org', '@type': 'AboutPage', url: SITE_URL + '/about/', name: 'אודות חדשות נתניה והשרון', about: { '@id': SITE_URL + '/#org' } }];
---
<Page title="אודות חדשות נתניה והשרון" h1="אודות חדשות נתניה והשרון" description="חדשות נתניה והשרון הוא אתר חדשות מקומי לנתניה ולשרון: מבזקים, עירייה, נדל״ן, נתונים חיים ומדריך בעלי מקצוע. כך אנחנו עובדים." path="/about/" intro="אתר החדשות המקומי של נתניה והשרון." jsonld={jsonld} alternates={{ he: '/about/', ru: '/ru/about/', fr: '/fr/about/', en: '/en/about/' }}>
  <p><b>חדשות נתניה והשרון</b> הוא אתר חדשות מקומי לתושבי נתניה והיישובים שסביבה: אבן יהודה, קדימה צורן, עמק חפר, כפר יונה, תל מונד ופרדסיה. המטרה שלנו פשוטה: שתדעו מה קורה ליד הבית, מהר, בדיוק ובשפה ברורה.</p>
  <h2>מה תמצאו כאן</h2>
  <ul>
    <li><b>מבזקים:</b> חסימות, עבודות, הפסקות מים וחשמל והודעות דחופות.</li>
    <li><b>חדשות העיר:</b> העירייה, נדל״ן ותכנון, קהילה וחינוך, ספורט, אירועים ותיירות.</li>
    <li><b>נתניה עכשיו:</b> מידע שימושי שמתעדכן, כמו זמני שבת, החופים ובית המרקחת התורן.</li>
    <li><b>מדריך עסקים:</b> בעלי מקצוע מנתניה והשרון. כל עסק נבדק לפני שהוא עולה לאתר.</li>
  </ul>
  <h2>איך אנחנו עובדים</h2>
  <p>אנחנו אתר חדשות עצמאי. כל ידיעה נכתבת כדיווח שלנו, מעובדות שמגיעות ממקורות ראשוניים כמו העירייה, המשטרה, מד״א וגופים רשמיים אחרים. אנחנו כותבים בנוסח שלנו ולא מעתיקים. חלק מתהליך האיסוף והכתיבה נעשה בעזרת מערכת אוטומטית, וידיעות רגישות נבדקות ומאושרות על ידי עורך לפני פרסום. תמונות שמסומנות "להמחשה" נוצרו בבינה מלאכותית ואינן מתעדות את האירוע. הפרטים המלאים ב<a href="/editorial-policy/">מדיניות העריכה</a>.</p>
  <h2>תוכן שיווקי</h2>
  <p>כל תוכן ממומן מסומן באתר בבירור כ"תוכן שיווקי" או "מקודם". המפרסמים לא משפיעים על הסיקור החדשותי.</p>
  <h2>יצירת קשר</h2>
  <p>מייל המערכת: <span dir="ltr">{BRAND.email}</span>. אפשר גם <a href="/send-news/">לשלוח ידיעה</a>, <a href="/corrections/">לבקש תיקון</a> או <a href="/contact/">לפנות אלינו</a>.</p>
</Page>
