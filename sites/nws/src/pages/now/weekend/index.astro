---
// מה עושים בנתניה בסוף השבוע (29.10.2026, the daily search pages Yakir approved): the events of the official calendars from
// Thursday evening to Saturday night of the coming weekend, the latest weekend guide story, and the culture stories of the week.
import NowPage from '../../../components/NowPage.astro';
import { CALENDAR, articlesFor, articleUrl } from '../../../lib/content';
import { eventUrl, eventLd } from '../../../lib/events';
const il = (d: Date, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('he-IL', { timeZone: 'Asia/Jerusalem', ...o }).format(d);
const ymd = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jerusalem' }).format(d);
// the coming weekend: Thursday to Saturday of this week (from Sunday on, the next one)
const today = new Date();
const dow = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Jerusalem', weekday: 'short' }).format(today));
const inWeekend = dow >= 4;
const thu = new Date(today.getTime() + (inWeekend ? -(dow - 4) : 4 - dow) * 864e5);
const from = ymd(inWeekend ? today : thu); const to = ymd(new Date(thu.getTime() + 2 * 864e5));
const events = CALENDAR.filter((c) => { const d = ymd(new Date(c.start)); return d >= from && d <= to; }).slice(0, 40);
const byDay = new Map<string, typeof events>();
for (const e of events) { const k = ymd(new Date(e.start)); if (!byDay.has(k)) byDay.set(k, []); byDay.get(k)!.push(e); }
const all = articlesFor('he');
const guide = all.find((a) => (a as any).format === 'weekend_guide' && Date.now() - Date.parse(a.published) < 6 * 864e5);
const culture = all.filter((a) => a.section === 'leisure' && a !== guide && Date.now() - Date.parse(a.published) < 7 * 864e5).slice(0, 6);
const range = `${il(new Date(from + 'T12:00:00+02:00'), { day: 'numeric', month: 'numeric' })} עד ${il(new Date(to + 'T12:00:00+02:00'), { day: 'numeric', month: 'numeric' })}`;
const faq: [string, string][] = [
  ['מה עושים בנתניה בסוף השבוע?', events.length ? `בסוף השבוע הקרוב (${range}) יש בנתניה ובסביבה ${events.length} אירועים בלוחות האירועים הרשמיים, ובהם ${events.slice(0, 3).map((e) => e.title).join(', ')}.` : 'הרשימה מתעדכנת מלוחות האירועים הרשמיים של העירייה, היכל התרבות והמוזיאונים.'],
  ['מאיפה הרשימה?', 'מלוחות האירועים הרשמיים של העירייה, היכל התרבות, המוזיאונים והמתנ״סים. כדאי לבדוק שעות ומחירים באתר של כל מקום לפני שיוצאים.'],
];
---
<NowPage icon="music" title="מה עושים בנתניה בסוף השבוע: אירועים, הופעות ופעילויות | חדשות נתניה והשרון" h1="מה עושים בנתניה בסוף השבוע" description={`אירועים בנתניה בסוף השבוע (${range}): הופעות, הצגות, פעילויות לילדים ותערוכות, מלוחות האירועים הרשמיים.`} path="/now/weekend/" intro={`סוף השבוע הקרוב, ${range}.`} color="#7A1F5C" img="beach-sunset" faq={faq} jsonld={events.map(eventLd)}>
  {guide && <section class="ncard" style="--c:#C8102E;margin-bottom:18px"><h2>המדריך שלנו לסוף השבוע</h2><p style="margin:0"><a href={articleUrl(guide)} style="font-weight:700">{guide.title}</a></p>{guide.dek && <p style="margin:6px 0 0">{guide.dek}</p>}</section>}
  <section class="ncard" style="--c:#7A1F5C">
    <h2>האירועים לפי יום</h2>
    {byDay.size ? [...byDay.entries()].map(([d, list]) => <div style="margin-top:6px">
      <h3 style="font-size:17px;margin:12px 0 6px">{il(new Date(d + 'T12:00:00+02:00'), { weekday: 'long', day: 'numeric', month: 'numeric' })}</h3>
      <ul style="list-style:none;margin:0;padding:0">{list.map((e) => <li style="padding:8px 0;border-top:1px solid #EFEDE7"><b class="num">{il(new Date(e.start), { hour: '2-digit', minute: '2-digit', hour12: false })}</b> <a href={eventUrl(e)}>{e.title}</a>{e.venue && <span style="color:var(--mut)"> · {e.venue}</span>}</li>)}</ul>
    </div>) : <p style="margin:0">עוד לא פורסמו אירועים לסוף השבוע הקרוב בלוחות הרשמיים. אפשר לראות את <a href="/events/#cal" style="color:#0B5FCC">לוח האירועים המלא</a>.</p>}
    <p class="note" style="margin:12px 0 0"><a href="/events/#cal" style="color:#0B5FCC">ללוח האירועים המלא</a></p>
  </section>
  {culture.length > 0 && <section class="ncard" style="--c:#0D1321;margin-top:18px"><h2>תרבות ופנאי השבוע</h2><ul style="list-style:none;margin:0;padding:0">{culture.map((a) => <li style="padding:8px 0;border-top:1px solid #EFEDE7"><a href={articleUrl(a)}>{a.title}</a></li>)}</ul></section>}
</NowPage>
