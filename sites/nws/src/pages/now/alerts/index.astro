---
import NowPage from '../../../components/NowPage.astro';
const faq: [string, string][] = [
  ['מה עושים כשיש התראה בנתניה?', 'נכנסים למרחב המוגן הקרוב בזמן שנקבע לאזור, ונשארים בו עד הנחיה אחרת של פיקוד העורף.'],
  ['איך יודעים מה זמן ההגעה למרחב מוגן?', 'זמן ההגעה נקבע לכל אזור על ידי פיקוד העורף. אפשר לבדוק אותו באתר ובאפליקציה של פיקוד העורף לפי היישוב.'],
];
---
<NowPage title="פיקוד העורף בנתניה: התראות, מרחב מוגן ומקלטים | חדשות נתניה והשרון" h1="פיקוד העורף: התראות בנתניה" description="מה עושים בזמן התראה בנתניה, איך בודקים את זמן ההגעה למרחב מוגן, ואיפה מקבלים התראות בזמן אמת." path="/now/alerts/" intro="מה עושים בזמן התראה, ואיפה מקבלים מידע רשמי." color="#17603A" img="council" faq={faq}>
  <section class="ncard" style="--c:#1E8A4C">
    <h2>התראות בזמן אמת</h2>
    <p>התראות בזמן אמת מתקבלות רק מהמקור הרשמי: אפליקציית פיקוד העורף והאתר שלו. אנחנו לא מציגים כאן מצב התראות, כדי שלא תסתמכו על מידע שאולי לא עודכן. התקינו את האפליקציה וקבעו בה את נתניה.</p>
    <p><a class="btn pri pill" href="https://www.oref.org.il/" rel="noopener" target="_blank">לאתר פיקוד העורף</a></p>
    <h2 style="margin-top:16px">המקורות הרשמיים</h2>
    <ul><li><a href="https://www.oref.org.il/" rel="noopener" target="_blank" style="color:#0B5FCC">אתר פיקוד העורף</a>: התראות, זמני הגעה למרחב מוגן והנחיות.</li><li>מקלטים ציבוריים בעיר: לפי פרסומי עיריית נתניה.</li></ul>
    <p class="note">בכל מצב חירום פעלו לפי הנחיות פיקוד העורף. חדשות נתניה והשרון מעביר את המידע הרשמי ואינו מחליף אותו.</p>
  </section>
</NowPage>
