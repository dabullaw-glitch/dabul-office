---
// Business directory home (Directory.dc.html, 28.10.2026): photo header with search, the categories with their icons,
// the real approved listings (promoted ones labelled "מקודם") with area filters, and the sidebar.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import DirHero from '../../components/directory/DirHero.astro';
import BizList from '../../components/directory/BizList.astro';
import DirSide from '../../components/directory/DirSide.astro';
import '../../components/directory/dir.css';
import { CATEGORIES } from '../../data/directory';
import { SITE_URL } from '../../data/site';
import { LISTINGS, countBy } from '../../lib/biz';
import { bizCount } from '../../components/directory/util';
const crumbs = [{ name: 'ראשי', href: '/' }, { name: 'בעלי מקצוע', href: '/directory/' }];
const jsonld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'מדריך העסקים של נתניה והשרון', url: SITE_URL + '/directory/',
  mainEntity: { '@type': 'ItemList', itemListElement: CATEGORIES.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: `${c.plural} בנתניה`, url: SITE_URL + `/directory/${c.slug}/` })) } }];
---
<Base title="מדריך עסקים בנתניה והשרון: בעלי מקצוע ועסקים מקומיים | חדשות נתניה והשרון" description="מדריך העסקים של נתניה והשרון: עורכי דין, רואי חשבון, אינסטלטורים, חשמלאים, שיפוצים, מיזוג אוויר ועוד. כל עסק נבדק לפני שהוא עולה לאתר." path="/directory/" crumbs={crumbs} jsonld={jsonld} current="directory" compact alternates={{ he: '/directory/', ru: '/ru/directory/', fr: '/fr/directory/', en: '/en/directory/' }}>
  <DirHero crumbs={crumbs} h1="בעלי מקצוע בנתניה והשרון" intro="עסקים מקומיים שנבדקו לפני שעלו לאתר. פונים ישירות לעסק, בטלפון או בוואטסאפ, בלי עמלות ובלי מתווכים." search />

  <section class="n-wrap d-cats" aria-labelledby="c-h">
    <h2 class="n-sh" id="c-h">תחומים</h2>
    <div class="d-cg" id="dcats">
      {CATEGORIES.map((c) => <a class="d-cc" href={`/directory/${c.slug}/`} data-k={`${c.plural} ${c.he}`} style={`--c:${c.color};--t:${c.tint}`}><span class="ic" aria-hidden="true"><Icon name={c.slug} size={24} /></span><span>{c.plural}{countBy[c.slug] > 0 && <small class="num">{bizCount(countBy[c.slug])}</small>}</span></a>)}
      <a class="d-cc add" href="/directory/join/" style="--c:#0D1321;--t:#EEF0F4"><span class="ic" aria-hidden="true"><Icon name="plus" size={24} /></span><span>הוסיפו עסק</span></a>
    </div>
    <p class="d-nores" id="dnores" hidden>לא מצאנו תחום בשם הזה. <a href="/search/" id="dnores-a">חפשו באתר</a> או בחרו תחום מהרשימה.</p>
  </section>

  <div class="n-wrap d-lay">
    <BizList list={LISTINGS} title="עסקים במדריך" emptyTitle="המדריך נפתח עכשיו" emptyText="עסקים מנתניה והשרון מוזמנים להצטרף ראשונים. רישום בסיסי בלי עלות, וכל עסק נבדק לפני שהוא עולה לאתר." />
    <DirSide />
  </div>
  <script is:inline>(function(){var i=document.getElementById('dq'),n=document.getElementById('dnores'),na=document.getElementById('dnores-a');if(!i)return;i.addEventListener('input',function(){var v=i.value.replace(/["״׳']/g,'').trim(),shown=0;document.querySelectorAll('#dcats a[data-k]').forEach(function(a){var on=!v||a.getAttribute('data-k').replace(/["״׳']/g,'').indexOf(v)>=0;a.hidden=!on;if(on)shown++});n.hidden=!v||shown>0;na.href='/search/?q='+encodeURIComponent(v)})})();</script>
</Base>
