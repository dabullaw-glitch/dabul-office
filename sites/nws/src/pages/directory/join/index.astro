---
// Self-registration for the business directory. Posts to the Supabase function hns-biz (validation, rate limit, honeypot,
// optional Turnstile). Every new listing waits for Yakir's approval in Telegram. No payment here: payments are not connected.
// 28.10.2026: restyled to the directory design; the fields, their names and the sending script are unchanged.
import Base from '../../../layouts/Base.astro';
import DirHero from '../../../components/directory/DirHero.astro';
import DirSide from '../../../components/directory/DirSide.astro';
import '../../../components/directory/dir.css';
import { CATEGORIES } from '../../../data/directory';
import { PLACES } from '../../../data/places';
import { HNS_API, TURNSTILE_SITE_KEY } from '../../../data/site';
const hoods = PLACES.filter((p) => p.kind === 'neighborhood').map((p) => p.he);
const towns = PLACES.filter((p) => p.kind === 'locality').map((p) => p.he);
const cats = [...CATEGORIES].sort((a, b) => a.plural.localeCompare(b.plural, 'he'));
const crumbs = [{ name: 'ראשי', href: '/' }, { name: 'בעלי מקצוע', href: '/directory/' }, { name: 'הוספת עסק', href: '/directory/join/' }];
const jsonld = [{ '@context': 'https://schema.org', '@type': 'WebPage', name: 'הוספת עסק למדריך העסקים של נתניה והשרון', url: 'https://nws.co.il/directory/join/' }];
---
<Base title="הוספת עסק למדריך העסקים של נתניה והשרון | חדשות נתניה והשרון" description="רישום עסק למדריך העסקים של נתניה והשרון, בלי עלות. ממלאים טופס קצר, ואחרי בדיקה העסק עולה לאתר." path="/directory/join/" crumbs={crumbs} jsonld={jsonld} current="directory" compact>
  <DirHero crumbs={crumbs} h1="הוסיפו את העסק למדריך" intro="רישום בסיסי בלי עלות. ממלאים טופס קצר, אנחנו בודקים את הפרטים, והעסק עולה לאתר." />

  <div class="n-wrap d-lay">
    <section aria-labelledby="form-h">
      <h2 class="n-sh" id="form-h">פרטי העסק</h2>
      <p class="d-note" style="margin:0 0 20px;font-size:15.5px;color:var(--ink2)">אנחנו בודקים כל רישום לפני שהוא עולה לאתר. הפרטים שתמלאו (חוץ מפרטי איש הקשר) יופיעו בדף העסק במדריך.</p>
      <form class="f d-form" id="bizf" novalidate>
        <div class="hp" aria-hidden="true"><label>אל תמלאו את השדה הזה<input name="company_fax" tabindex="-1" autocomplete="off"></label></div>
        <fieldset>
          <legend>העסק</legend>
          <label>קטגוריה<select name="category" required><option value="">בחרו קטגוריה</option>{cats.map((c) => <option value={c.slug}>{c.plural}</option>)}</select></label>
          <p class="law" id="lawnote" hidden>עורכי דין: הפרסום כפוף לכללי לשכת עורכי הדין. בלי מילים כמו "הכי" או "מומחה", בלי הבטחות לתוצאה ובלי מחירים. צריך גם מספר רישיון.</p>
          <label>שם העסק<input name="name" required maxlength="80" autocomplete="organization"></label>
          <div class="two">
            <label>איפה העסק נמצא<select name="area" required><option value="">בחרו אזור</option><option>נתניה</option><optgroup label="שכונות בנתניה">{hoods.map((h) => <option>{h}</option>)}</optgroup><optgroup label="השרון">{towns.map((t) => <option>{t}</option>)}</optgroup></select></label>
            <label>כתובת (לא חובה)<input name="address" maxlength="120" autocomplete="street-address"></label>
          </div>
          <fieldset>
            <legend>אזורים נוספים שאתם משרתים (לא חובה)</legend>
            <div class="cks">{['נתניה', ...towns].map((t) => <label class="ck"><input type="checkbox" name="areas_served" value={t}>{t}</label>)}</div>
          </fieldset>
        </fieldset>
        <fieldset>
          <legend>יצירת קשר</legend>
          <div class="two">
            <label>טלפון של העסק<input name="phone" type="tel" required inputmode="tel" autocomplete="tel" dir="ltr" placeholder="050-0000000"></label>
            <label>וואטסאפ (לא חובה)<input name="whatsapp" type="tel" inputmode="tel" dir="ltr"></label>
          </div>
          <div class="two">
            <label>מייל (לא חובה)<input name="email" type="email" dir="ltr" autocomplete="email"></label>
            <label>אתר (לא חובה)<input name="website" type="url" dir="ltr" placeholder="https://"></label>
          </div>
          <div class="two">
            <label>קישור ללוגו או לתמונה (לא חובה)<input name="logo_url" type="url" dir="ltr" placeholder="https://"></label>
            <label id="licl">מספר רישיון (לעורכי דין, רואי חשבון, חשמלאים ועוד)<input name="license_no" maxlength="30" dir="ltr"></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>על העסק</legend>
          <label>תיאור העסק (30 תווים לפחות)<textarea name="description" rows="6" required minlength="30" maxlength="1200" placeholder="מה אתם עושים, לאילו לקוחות, ובאילו אזורים"></textarea></label>
        </fieldset>
        <fieldset>
          <legend>איש הקשר (לא יפורסם)</legend>
          <div class="two">
            <label>שם איש הקשר<input name="contact_name" maxlength="60" autocomplete="name"></label>
            <label>טלפון לחזרה אליכם (לא חובה)<input name="contact_phone" type="tel" inputmode="tel" dir="ltr"></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>מעוניינים גם ב (לא חובה)</legend>
          <label class="ck"><input type="checkbox" name="interest" value="featured">קידום במדריך (עסק מומלץ, מסומן "מקודם")</label>
          <label class="ck"><input type="checkbox" name="interest" value="sponsored">כתבת תוכן שיווקי על העסק</label>
          <p class="hint">אין תשלום דרך האתר. נחזור אליכם עם הפרטים, ורק אחר כך מתקדמים.</p>
        </fieldset>
        <label class="ck top"><input type="checkbox" name="consent" value="1" required><span>אני מאשר/ת לפרסם את פרטי העסק במדריך, הפרטים נכונים, וקראתי את <a href="/privacy/" target="_blank">מדיניות הפרטיות</a>.</span></label>
        {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="he"></div>}
        <button class="n-btn ink" type="submit">שליחה</button>
        <p id="bizmsg" role="status" aria-live="polite" style="font-weight:700;margin:0"></p>
        <p class="fine">שליחת הטופס כפופה ל<a href="/terms/">תנאי השימוש</a> ול<a href="/privacy/">מדיניות הפרטיות</a>. רוצים לדעת על פרסום? <a href="/advertise/">פרסום במדריך</a>.</p>
      </form>
    </section>
    <DirSide join={false} />
  </div>
  {TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script is:inline define:vars={{ api: HNS_API + '/hns-biz' }}>
  (function(){
    var f=document.getElementById('bizf'), msg=document.getElementById('bizmsg'), t0=Date.now();
    var cat=f.elements.category, law=document.getElementById('lawnote');
    try{var sp=new URLSearchParams(location.search), q=sp.get('cat'), pl=sp.get('plan'); if(q){cat.value=q;} if(pl){f.querySelectorAll('input[name=interest]').forEach(function(x){if(x.value===pl)x.checked=true});}}catch(e){}
    function sync(){law.hidden=cat.value!=='lawyers'; f.elements.license_no.required=cat.value==='lawyers';}
    cat.addEventListener('change',sync); sync();
    f.addEventListener('submit',function(ev){
      ev.preventDefault();
      f.querySelectorAll('.ferr').forEach(function(x){x.remove()});
      var d={action:'register',t:Date.now()-t0}, fd=new FormData(f);
      fd.forEach(function(v,k){ if(k==='areas_served'||k==='interest'){(d[k]=d[k]||[]).push(v)} else if(k==='cf-turnstile-response'){d.turnstile=v} else {d[k]=String(v).trim()} });
      d.consent=!!f.elements.consent.checked;
      var btn=f.querySelector('button[type=submit]'); btn.disabled=true; msg.style.color=''; msg.textContent='שולחים...';
      fetch(api,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(d)}).then(function(r){return r.json()}).then(function(j){
        btn.disabled=false;
        if(j.ok){ msg.style.color='#14693A'; msg.textContent=j.message||'תודה! קיבלנו את הפרטים. אחרי בדיקה העסק יעלה למדריך.'; if(!j.duplicate){ var bl=document.createElement('span'); bl.style.cssText='display:block;font-weight:400;margin-top:4px'; bl.textContent='אחרי האישור תוכלו להוסיף לאתר שלכם תג "מופיעים במדריך", מתוך דף העסק במדריך.'; msg.appendChild(bl); } if(!j.duplicate) f.reset(); sync(); if(window.nwsTrack) try{window.nwsTrack('generate_lead',{form:'directory'})}catch(e){} return; }
        msg.style.color='#A50D26'; msg.textContent=j.error||'השליחה נכשלה, נסו שוב.';
        if(j.fields){ Object.keys(j.fields).forEach(function(k){ var el=f.elements[k]; if(!el) return; if(el.length&&!el.tagName) el=el[0]; var p=document.createElement('span'); p.className='ferr note'; p.textContent=j.fields[k]; (el.closest('label')||el.parentNode).appendChild(p); }); }
      }).catch(function(){ btn.disabled=false; msg.style.color='#A50D26'; msg.textContent='אין חיבור. נסו שוב בעוד דקה.'; });
    });
  })();
  </script>
</Base>
