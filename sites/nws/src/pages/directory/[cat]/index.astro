---
// One directory category (Directory.dc.html): photo header with search, the real listings of the category with area filters
// (or the honest "הקטגוריה נפתחת עכשיו" state), what to check before hiring, FAQ, related news, and the sidebar.
import Base from '../../../layouts/Base.astro';
import Card from '../../../components/Card.astro';
import Icon from '../../../components/Icon.astro';
import DirHero from '../../../components/directory/DirHero.astro';
import BizList from '../../../components/directory/BizList.astro';
import DirSide from '../../../components/directory/DirSide.astro';
import '../../../components/directory/dir.css';
import { CATEGORIES, schemaType } from '../../../data/directory';
import { SITE_URL } from '../../../data/site';
import { ARTICLES, clip } from '../../../lib/content';
import { listingsIn, listingUrl, countBy } from '../../../lib/biz';
import { bizCount } from '../../../components/directory/util';
export function getStaticPaths() { return CATEGORIES.map((c) => ({ params: { cat: c.slug }, props: { c } })); }
const { c } = Astro.props;
const path = `/directory/${c.slug}/`;
const crumbs = [{ name: 'ראשי', href: '/' }, { name: 'בעלי מקצוע', href: '/directory/' }, { name: `${c.plural} בנתניה`, href: path }];
const arts = ARTICLES.filter((a) => c.sections.includes(a.section)).slice(0, 3);
const others = CATEGORIES.filter((x) => x.slug !== c.slug);
const list = listingsIn(c.slug);
const jsonld: any[] = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${c.plural} בנתניה`, url: SITE_URL + path, about: { '@type': 'Thing', name: c.plural }, spatialCoverage: { '@type': 'City', name: 'נתניה' },
    ...(list.length ? { mainEntity: { '@type': 'ItemList', itemListElement: list.map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE_URL + listingUrl(l), item: { '@type': schemaType(c), name: l.name, url: SITE_URL + listingUrl(l) } })) } } : {}) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title={`${c.plural} בנתניה והשרון: מה לבדוק לפני שמזמינים | מדריך העסקים`} description={clip(`${c.plural} בנתניה והשרון: ${c.tips[0]} מה לבדוק לפני שמזמינים ${c.he}, ושאלות נפוצות.`, 158)} path={path} crumbs={crumbs} jsonld={jsonld} current="directory" compact>
  <DirHero crumbs={crumbs} intro={list.length ? `${bizCount(list.length)} במדריך. כל עסק נבדק לפני שהוא עולה לאתר, ופונים אליו ישירות, בלי עמלות.` : `הקטגוריה נפתחת עכשיו. ${c.plural} מנתניה והשרון מוזמנים להצטרף ראשונים.`} search>
    <div class="d-bh" slot="head"><span class="d-lg" style={`--c:${c.color}`} aria-hidden="true"><Icon name={c.slug} size={40} sw={1.6} /></span><h1>{c.plural} בנתניה והשרון</h1></div>
  </DirHero>

  <div class="n-wrap d-lay">
    <div>
      <BizList list={list} title={`${c.plural} במדריך`} showCat={false} cat={c.slug} icon={c.slug} c={c.color} t={c.tint}
        emptyText={`${c.plural} מנתניה והשרון מוזמנים להצטרף ראשונים. רישום בסיסי בלי עלות, ואחרי בדיקה העסק עולה לאתר.`} />
      {list.length > 0 && <p class="d-note">יש לכם עסק בתחום? <a href={`/directory/join/?cat=${c.slug}`}>הוסיפו אותו למדריך</a>.</p>}

      <section class="d-blk" aria-labelledby="tips-h">
        <h2 class="n-sh" id="tips-h" style={`--c:${c.color}`}>מה לבדוק לפני שמזמינים {c.he}</h2>
        <ol class="d-steps lg">{c.tips.map((t, i) => <li><b class="num">{i + 1}</b><span>{t}</span></li>)}</ol>
      </section>
      <section class="d-blk n-faq" aria-labelledby="faq-h" style="max-width:none">
        <h2 class="n-sh" id="faq-h" style={`--c:${c.color}`}>שאלות נפוצות על {c.plural} בנתניה</h2>
        {c.faq.map(([q, a]) => <details open><summary>{q}</summary><p>{a}</p></details>)}
      </section>
      {arts.length > 0 && (
        <section class="d-blk" aria-labelledby="news-h">
          <h2 class="n-sh" id="news-h">חדשות קשורות</h2>
          <div class="n-grid n-g3">{arts.map((a) => <Card a={a} />)}</div>
        </section>
      )}
    </div>
    <DirSide cat={c.slug}>
      <section class="d-box" aria-labelledby="oc-h">
        <h2 id="oc-h">תחומים נוספים</h2>
        <ul class="d-oc">{others.map((o) => <li><a href={`/directory/${o.slug}/`} style={`--c:${o.color};--t:${o.tint}`}><span class="ic" aria-hidden="true"><Icon name={o.slug} size={18} /></span>{o.plural}{countBy[o.slug] > 0 && <small class="num">{bizCount(countBy[o.slug])}</small>}</a></li>)}</ul>
      </section>
    </DirSide>
  </div>
</Base>
