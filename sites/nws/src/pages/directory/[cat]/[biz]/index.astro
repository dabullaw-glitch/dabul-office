---
// One business in the directory. Built only for approved listings (scripts/biz.mjs); a removed listing has no page, so the
// middleware answers 410. LocalBusiness schema (subtype per category). Promoted listings are labelled "מקודם".
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import DirHero from '../../../../components/directory/DirHero.astro';
import BizRow from '../../../../components/directory/BizRow.astro';
import DirSide from '../../../../components/directory/DirSide.astro';
import BizBadge from '../../../../components/directory/BizBadge.astro';
import '../../../../components/directory/dir.css';
import { CAT_BY_SLUG, schemaType } from '../../../../data/directory';
import { SITE_URL } from '../../../../data/site';
import { LISTINGS, listingsIn, listingUrl, phoneShow, telHref, waHref, intlPhone, placeOf } from '../../../../lib/biz';
import { placeUrl } from '../../../../lib/content';
import { initials, servedOf } from '../../../../components/directory/util';
export function getStaticPaths() { return LISTINGS.map((l) => ({ params: { cat: l.category, biz: l.slug }, props: { l } })); }
const { l } = Astro.props;
const c = CAT_BY_SLUG[l.category];
const path = listingUrl(l);
const crumbs = [{ name: 'ראשי', href: '/' }, { name: 'בעלי מקצוע', href: '/directory/' }, { name: `${c.plural} בנתניה`, href: `/directory/${c.slug}/` }, { name: l.name, href: path }];
const more = listingsIn(c.slug).filter((x) => x.id !== l.id).slice(0, 3);
const place = placeOf(l.area);
const where = l.area === 'נתניה' ? 'נתניה' : place?.kind === 'neighborhood' ? `${l.area}, נתניה` : l.area;
const desc = `${l.name}, ${c.he} ב${where}. ${l.description}`.slice(0, 155);
const served = servedOf(l);
const site = l.website ? l.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') : '';
const ld: any = { '@context': 'https://schema.org', '@type': schemaType(c), '@id': SITE_URL + path + '#biz', name: l.name, url: SITE_URL + path, description: l.description,
  telephone: intlPhone(l.phone), areaServed: served.map((a) => ({ '@type': 'Place', name: a })),
  address: { '@type': 'PostalAddress', ...(l.address ? { streetAddress: l.address } : {}), addressLocality: place?.kind === 'locality' ? l.area : 'נתניה', addressCountry: 'IL' } };
if (l.logo) ld.image = l.logo;
if (l.email) ld.email = l.email;
if (l.website) ld.sameAs = [l.website];
const jsonld = [ld];
---
<Base title={`${l.name}: ${c.he} ב${l.area} | מדריך העסקים חדשות נתניה והשרון`} description={desc} path={path} crumbs={crumbs} jsonld={jsonld} current="directory" compact>
  <DirHero crumbs={crumbs} trust={false}>
    <div class="d-bh" slot="head" style={`--c:${c.color}`}>
      <span class="d-lg" aria-hidden="true">{l.logo ? <img src={l.logo} alt="" width="88" height="88" referrerpolicy="no-referrer"> : initials(l.name)}</span>
      <div><h1>{l.name}</h1><div class="d-sub">{c.he} · {where}{l.featured && <span class="d-tag">מקודם</span>}</div></div>
    </div>
    <div class="d-hact">
      <a class="n-btn wh" href={telHref(l.phone)}><Icon name="phone" size={18} sw={2} />התקשרו <span dir="ltr" class="num">{phoneShow(l.phone)}</span></a>
      {l.whatsapp && <a class="n-btn wa" href={waHref(l.whatsapp)} rel="noopener nofollow" target="_blank"><Icon name="whatsapp" size={18} sw={2} />וואטסאפ<span class="sr"> (נפתח בחלון חדש)</span></a>}
      {l.website && <a class="n-btn gh" href={l.website} rel="noopener nofollow" target="_blank"><Icon name="link" size={18} sw={2} />לאתר העסק<span class="sr"> (נפתח בחלון חדש)</span></a>}
    </div>
  </DirHero>

  <div class="n-wrap d-lay">
    <div>
      <section aria-labelledby="ab-h">
        <h2 class="n-sh" id="ab-h" style={`--c:${c.color}`}>על העסק</h2>
        <div class="d-about">{l.description.split(/\n+/).map((p) => <p>{p}</p>)}</div>
        <p class="d-note">המידע נמסר על ידי בעל העסק ונבדק לפני פרסום. {l.featured ? 'זהו עסק מקודם (תוכן שיווקי). ' : ''}מצאתם טעות? <a href={`/corrections/?url=${encodeURIComponent(path)}`}>דווחו לנו</a>.</p>
      </section>
      <section class="d-blk" aria-labelledby="det-h">
        <h2 class="n-sh" id="det-h" style={`--c:${c.color}`}>פרטי העסק</h2>
        <dl class="d-dl">
          <dt><Icon name={c.slug} size={17} />תחום</dt><dd><a href={`/directory/${c.slug}/`}>{c.plural}</a></dd>
          <dt><Icon name="pin" size={17} />אזורי שירות</dt><dd>{served.map((a, i) => { const p = placeOf(a); return <>{i > 0 && ', '}{p ? <a href={placeUrl(p.slug)}>{a}</a> : a}</>; })}</dd>
          {l.address && <><dt><Icon name="home" size={17} />כתובת</dt><dd>{l.address}</dd></>}
          <dt><Icon name="phone" size={17} />טלפון</dt><dd><a href={telHref(l.phone)} dir="ltr" class="num">{phoneShow(l.phone)}</a></dd>
          {l.whatsapp && <><dt><Icon name="whatsapp" size={17} />וואטסאפ</dt><dd><a href={waHref(l.whatsapp)} rel="noopener nofollow" target="_blank" dir="ltr" class="num">{phoneShow(l.whatsapp)}</a></dd></>}
          {l.email && <><dt><Icon name="mail" size={17} />מייל</dt><dd><a href={`mailto:${l.email}`} dir="ltr">{l.email}</a></dd></>}
          {l.website && <><dt><Icon name="link" size={17} />אתר</dt><dd><a href={l.website} rel="noopener nofollow" target="_blank" dir="ltr">{site}</a></dd></>}
          {l.license && <><dt><Icon name="shield" size={17} />מספר רישיון</dt><dd class="num">{l.license}</dd></>}
        </dl>
      </section>
      <section class="d-blk" aria-labelledby="tips-h">
        <h2 class="n-sh" id="tips-h" style={`--c:${c.color}`}>לפני שפונים</h2>
        <ol class="d-steps lg">{c.tips.map((t, i) => <li><b class="num">{i + 1}</b><span>{t}</span></li>)}</ol>
        <p class="d-note"><a href={`/directory/${c.slug}/`}>חזרה לרשימת {c.plural} במדריך</a></p>
      </section>
      <BizBadge path={path} />
    </div>
    <DirSide cat={c.slug}>
      <section class="d-box" aria-labelledby="own-h" slot="top">
        <h2 id="own-h">בעלי העסק?</h2>
        <p><a href={`/corrections/?url=${encodeURIComponent(path)}`}>עדכון הפרטים</a> או <a href={`/advertise/?offer=featured&biz=${encodeURIComponent(l.name)}#form`}>קידום העסק במדריך</a>. קידום מסומן תמיד "מקודם".</p>
      </section>
      {more.length > 0 && (
        <section aria-labelledby="more-h">
          <h2 class="n-sh" id="more-h" style={`--c:${c.color};font-size:18px`}>עוד {c.plural}</h2>
          {more.map((x) => <BizRow l={x} showCat={false} compact />)}
        </section>
      )}
    </DirSide>
  </div>
</Base>
