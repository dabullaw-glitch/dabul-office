---
// 29.10.2026 (Yakir): no price lists on the site (it looked cheap). Whoever asks gets a price for what they need.
import Page from '../../components/Page.astro';
import ReqForm from '../../components/ReqForm.astro';
---
<Page title="פרסום בנתניה: קידום עסקים וכתבות תוכן שיווקי | חדשות נתניה והשרון" h1="פרסמו אצלנו" description="פרסום לעסקים בנתניה ובשרון: קידום במדריך העסקים, כתבות תוכן שיווקי, באנרים ופוסטים בערוצים. משאירים פרטים ואנחנו חוזרים עם הצעה." path="/advertise/" intro="משאירים פרטים, ואנחנו חוזרים אליכם עם הצעה שמתאימה למה שאתם צריכים." color="#0B3D6E" img="city" wide>
  <section class="box" style="background:#EEF4FC;border-inline-start:5px solid #0B5FCC;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px"><div><b style="font-family:var(--h);font-size:20px">רוצים קידום או כתבת תוכן שיווקי?</b><p style="margin:4px 0 0">משאירים פרטים בטופס כאן למטה, ואנחנו חוזרים אליכם עם כל הפרטים.</p></div><a class="btn pri" href="/advertise/?offer=sponsored#form">להשארת פרטים</a></section>
  <section class="sec" id="form" style="margin-top:26px;scroll-margin-top:90px">
    <h2 class="sh" style="--c:#0B5FCC"><span class="bar"></span>השאירו פרטים ונחזור אליכם</h2>
    <p style="max-width:620px">בוחרים במה מתעניינים ומשאירים טלפון. נחזור אליכם, נתאים את ההצעה, ורק אחר כך מתקדמים.</p>
    <ReqForm type="advertise" id="adf" />
  </section>
  <p class="note" style="margin-top:18px">כל תוכן ממומן מסומן באתר בבירור כ"תוכן שיווקי", וכך גם עסק מקודם במדריך.</p>
</Page>
