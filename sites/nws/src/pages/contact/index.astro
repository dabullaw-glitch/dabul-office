---
import Page from '../../components/Page.astro';
import ReqForm from '../../components/ReqForm.astro';
const jsonld = [{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'צור קשר עם חדשות נתניה והשרון', url: 'https://nws.co.il/contact/' }];
---
<Page title="צור קשר | חדשות נתניה והשרון" h1="צור קשר" description="יצירת קשר עם מערכת חדשות נתניה והשרון: ידיעות, תיקונים, פרסום ושאלות." path="/contact/" intro="נשמח לשמוע מכם." jsonld={jsonld}>
  <ul>
    <li><b>יש לכם ידיעה מהשכונה?</b> <a href="/send-news/">שלחו ידיעה</a>.</li>
    <li><b>מצאתם טעות?</b> <a href="/corrections/">בקשת תיקון או הסרה</a>.</li>
    <li><b>רוצים לפרסם?</b> <a href="/advertise/">פרסמו אצלנו</a>.</li>
    <li><b>כל דבר אחר:</b> <a href="#form">בטופס כאן למטה</a>.</li>
  </ul>
  <h2 id="form">כתבו לנו</h2>
  <p>שאלה, הצעה או כל דבר אחר. ההודעה מגיעה ישר למערכת, ונחזור אליכם.</p>
  <ReqForm type="contact" id="contactf" />
</Page>
