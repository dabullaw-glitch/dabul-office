<script is:inline define:vars={{ T: { newer: L.newer, newer1: L.newer1, pause: L.pause, play: L.play } }}>
/* page behaviour: shrinking header, back to top, reading progress, ticker pause, phone menu, accessibility panel, cookie consent,
