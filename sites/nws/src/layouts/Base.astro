---
// The frame of every page (redesign approved by Yakir 28.10.2026, Main.dc.html / Article.dc.html / Mobile.dc.html):
// utility bar (date, Hebrew date, IMS weather and sea, links, channels, languages), a sticky masthead that shrinks on scroll,
// the section menu, the flash ticker (pauses on hover, focus or the pause button), the event strip while an event is active,
// the footer, and on phones a fixed tab bar. compact: the short bar of story and directory pages (with a reading progress line).
// Fixed controls outside the page wrapper: back to top, the accessibility panel (built here, no third-party widget), the cookie
// banner (Google Analytics loads only after consent, Consent Mode v2), and the "N ידיעות חדשות" pill (the page polls /latest.json).
import '../styles/global.css';
import '../styles/nws.css';
import Icon from '../components/Icon.astro';
import { SITE_URL, PREVIEW, LANGS, LANG_PREFIX, LANG_LOCALE, LANG_DIR, BRAND, TG_URL, SAME_AS, type Lang } from '../data/site';
import { t } from '../i18n/ui';
import { liveCats, guideHref } from '../data/city/guide';
import { ADSENSE } from '../data/site';
import { liveFeed } from '../lib/livefeed';
import { ARTICLES, articlesFor, articleUrl, sectionUrl, placeUrl, placesOf, fmtTime, fmtShort, EVENT, IMS, hebrewDate, FLASHES, navSections, liveSections } from '../lib/content';
import { PLACES } from '../data/places';

interface Crumb { name: string; href: string }
interface Props {
  lang?: Lang; title: string; description: string; path: string;
  alternates?: Partial<Record<Lang, string>>; ogImage?: string; ogW?: number; ogH?: number; ogType?: string; jsonld?: any[]; noindex?: boolean;
  crumbs?: Crumb[]; current?: string; published?: string; modified?: string; section?: string; tags?: string[];
  compact?: boolean; progress?: boolean; accent?: string;
}
const { lang = 'he', title, description, path, alternates = {}, ogImage = '/og/default.png', ogW, ogH, ogType = 'website', jsonld = [], noindex = false,
  crumbs = [], current = '', published, modified, section, tags = [], compact = false, progress = false, accent = '' } = Astro.props;
const u = t(lang); const he = lang === 'he';
const canonical = SITE_URL + path;
const robots = PREVIEW || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const alts = Object.entries(alternates) as [Lang, string][];
const pre = LANG_PREFIX[lang];
const ogAbs = /^https?:/.test(ogImage) ? ogImage : SITE_URL + ogImage;
// ticker (29.10.2026, Yakir: every flashes list shows the same thing): the same list as the home box and the side boxes
// (lib/livefeed.ts): official flashes and the newest stories, newest first
type Tick = { at: string; text: string; href: string; src?: string };
const tickerItems: Tick[] = liveFeed(lang, 8);
const ilDay = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jerusalem' }).format(d);
const tickTime = (iso: string) => (ilDay(new Date(iso)) === ilDay(new Date()) ? fmtTime(iso) : fmtShort(iso));
const flashCount = he ? tickerItems.filter((x) => Date.now() - Date.parse(x.at) < 6 * 3600e3).length : 0;
const hdate = he ? hebrewDate() : '';
const today = new Intl.DateTimeFormat(he ? 'he-IL' : lang, { timeZone: 'Asia/Jerusalem', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
// weather and sea of the IMS (scripts/ims.mjs); shown only when there is data from today
const todayIl = ilDay(new Date());
const wxDay = IMS?.day && IMS.day.date === todayIl ? IMS.day : null;
const wxIcon = (c: number | null | undefined) => (c == null ? 'sun' : [1140, 1020, 1510, 1540, 1560].includes(c) ? 'rain' : [1220, 1230, 1530, 1160, 1570].includes(c) ? 'cloud' : 'sun');
const sea = IMS?.sea || null;
const seaWord = (m: number) => (m <= 0.5 ? 'ים שקט' : m <= 1 ? 'ים נוח' : m <= 1.6 ? 'ים גלי' : m <= 2.5 ? 'ים גבוה' : 'ים סוער');
const ev = he ? EVENT : null;
const homeHref = (pre || '') + '/';
const langHref = (l: Lang) => (alternates[l] ?? (LANG_PREFIX[l] + '/'));
const langName = (l: Lang) => (l === 'he' ? 'עב' : l.toUpperCase());
const crumbLd = crumbs.length ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE_URL + c.href })) }] : [];
const ld = [...jsonld, ...crumbLd];
const nav = navSections();
const guideCats = liveCats();
// Sharon localities that have a page (an area page exists once a story mentions the place)
const sharonAreas = PLACES.filter((p) => p.kind === 'locality' && ARTICLES.some((a) => placesOf(a).some((x) => x.slug === p.slug))).slice(0, 6);
const tgHref = TG_URL || `${pre}/join/`;
const tgAttr = TG_URL ? { target: '_blank', rel: 'noopener' } : {};
const fb = SAME_AS.find((x) => x.includes('facebook.com'));
const L = he ? { home: 'ראשי', pros: 'בעלי מקצוע', menu: 'תפריט', tg: 'המבזקים בטלגרם', alerts: 'התראות', all: 'כל המבזקים ←', pause: 'עצירת המבזקים', play: 'הפעלת המבזקים',
  contact: 'צרו קשר', top: 'חזרה לראש העמוד', sharon: 'השרון', newer: 'ידיעות חדשות', newer1: 'ידיעה חדשה' }
  : { home: u.home, pros: u.directory, menu: 'Menu', tg: 'Telegram', alerts: u.alerts, all: u.allFlash, pause: 'Pause', play: 'Play', contact: u.contact, top: 'Back to top', sharon: 'Sharon', newer: 'new stories', newer1: 'new story' };
---
<!doctype html>
<html lang={lang} dir={LANG_DIR[lang]}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content={robots}>
{alts.map(([l, p]) => <link rel="alternate" hreflang={l} href={SITE_URL + p}>)}
{alts.length > 0 && alternates.he && <link rel="alternate" hreflang="x-default" href={SITE_URL + alternates.he}>}
<meta property="og:site_name" content={BRAND.he}>
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogAbs}>
{/* 29.10.2026: the real size of a story image (ogW/ogH); 1200x630 for the default, the hand made and the library cards; none when unknown */}
{(ogW || !Astro.props.ogImage || /^\/(og|img\/stock\/og)\//.test(ogImage)) && <><meta property="og:image:width" content={String(ogW || 1200)}><meta property="og:image:height" content={String(ogH || 630)}></>}
<meta property="og:locale" content={LANG_LOCALE[lang]}>
{published && <meta property="article:published_time" content={published}>}
{modified && <meta property="article:modified_time" content={modified}>}
{section && <meta property="article:section" content={section}>}
{tags.map((tg) => <meta property="article:tag" content={tg}>)}
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0D1321">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/rss+xml" title={BRAND.he} href={`${pre}/rss.xml`}>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Hebrew:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
{/* accessibility settings saved by the visitor are applied before the page is drawn */}
<script is:inline>(function(){try{var a=JSON.parse(localStorage.getItem('nwsA11y')||'{}'),h=document.documentElement;if(a.z)h.classList.add('a11y-z'+a.z);['contrast','gray','links','font','still','cursor','focus'].forEach(function(k){if(a[k])h.classList.add('a11y-'+k)})}catch(e){}})();</script>
{/* Google Analytics 4 (G-N0Q1GZWXF2) with Consent Mode v2: everything denied by default; the script itself loads only after the
   visitor agrees to statistics cookies (banner below), or on later visits when that choice is saved. window.nwsTrack(name, params). */}
{ADSENSE.client && <meta name="google-adsense-account" content={ADSENSE.client}>}
{ADSENSE.client && !PREVIEW && !noindex && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`} crossorigin="anonymous"></script>}
<script is:inline define:vars={{ GA: PREVIEW ? '' : 'G-N0Q1GZWXF2' }}>window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',functionality_storage:'granted',security_storage:'granted'});
gtag('js',new Date());if(GA)gtag('config',GA,{anonymize_ip:true,allow_google_signals:false,allow_ad_personalization_signals:false});
window.nwsTrack=function(n,p){try{gtag('event',n,p||{})}catch(e){}};
window.nwsLoadGA=function(){if(window.__nwsga||!GA)return;window.__nwsga=1;var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+GA;document.head.appendChild(s)};
var c=null;try{c=JSON.parse(localStorage.getItem('nwsConsent')||'null')}catch(e){}try{if(!c&&/(?:^|; )nws_consent=all/.test(document.cookie))c={a:1}}catch(e){}
if(c&&c.a){gtag('consent','update',{analytics_storage:'granted'});nwsLoadGA()}
if(c&&c.p)gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted'});</script>
{/* a story picture that fails to load is replaced by a city photo, so no broken image is shown */}
<script is:inline>addEventListener('error',function(e){var i=e.target;if(i&&i.tagName==='IMG'&&!i.dataset.fb){i.dataset.fb='1';i.removeAttribute('srcset');i.src='/img/stock/city-buildings-800.webp'}},true)</script>
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')}></script>)}
</head>
<body>
<a class="skip" href="#main">{he ? 'דלג לתוכן' : lang === 'ru' ? 'К содержанию' : lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
{PREVIEW && <div class="preview">{u.previewNote}</div>}
<div class="n-zoom">
{!compact && (
<div class="n-util"><div class="n-wrap">
  <div class="r">
    <span>{today}</span>{hdate && <><span class="sep" aria-hidden="true"></span><span>{hdate}</span></>}
    {wxDay && wxDay.max !== null && <><span class="sep" aria-hidden="true"></span><a class="wx" href={he ? '/now/' : `${pre}/now/`} title={he ? 'תחזית השירות המטאורולוגי' : 'IMS forecast'}><Icon name={wxIcon(wxDay.code)} size={16} sw={2} color="#FFD66B" /><span class="num">{he ? 'נתניה' : u.city} {wxDay.max}° / {wxDay.min}°</span></a></>}
    {sea && he && <><span class="sep sep2" aria-hidden="true"></span><a class="lnk" href="/now/beaches/">{seaWord(sea.waveMax)}, גלים עד {sea.waveMax.toFixed(1)} מ׳</a></>}
  </div>
  <div class="r">
    <a class="lnk" href={`${pre}/send-news/`}>{u.sendNews}</a><a class="lnk" href="/advertise/">{u.advertise}</a><a class="lnk" href="/contact/">{L.contact}</a><span class="sep sep2" aria-hidden="true"></span>
    <div class="soc">
      <a href={tgHref} {...tgAttr} aria-label={he ? 'ערוץ הטלגרם' : 'Telegram'} data-tg><Icon name="telegram" size={16} /></a>
      {fb && <a href={fb} target="_blank" rel="noopener" aria-label={he ? 'הדף בפייסבוק' : 'Facebook'}><Icon name="facebook" size={16} /></a>}
    </div>
    <span class="sep sep2" aria-hidden="true"></span>
    <nav class="lg" aria-label="שפה / Language">{LANGS.map((l) => <a href={langHref(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{langName(l)}</a>)}</nav>
  </div>
</div></div>)}
<header class={`n-head${compact ? ' cmp' : ''}`} id="nhead">
  {compact ? (
  <div class="n-bar"><div class="n-wrap">
    <a href={homeHref} class="n-logo" style="gap:12px" aria-label={`NWS ${u.brandName}`}><span class="n-mk">NWS<i></i></span><span class="bn">{u.brandName}</span></a>
    <nav class="nv" aria-label={u.sectionsH}>{nav.slice(0, 8).map((s) => <a href={sectionUrl(s.key, lang)} style={`--c:${s.color}`} aria-current={current === s.key ? 'page' : undefined}>{s.name[lang]}</a>)}<a href={`${pre}/directory/`} aria-current={current === 'directory' ? 'page' : undefined}>{L.pros}</a></nav>
    <a class="n-btn ink tgb" href={tgHref} {...tgAttr} data-tg aria-label={he ? 'ערוץ הטלגרם' : 'Telegram'}><Icon name="telegram" size={17} color="#fff" /><span class="tx">{he ? 'טלגרם' : 'Telegram'}</span></a>
  </div>{progress && <div class="n-prog" aria-hidden="true"><i id="nprog"></i></div>}</div>
  ) : (<>
  <div class="n-mast"><div class="n-wrap">
    <a class="n-logo" href={homeHref} aria-label={`NWS ${u.brandName}`}><span class="n-mk">NWS<i></i></span><span class="n-lt"><b>{u.brandName}</b><span>{u.tagline}</span></span></a>
    <div class="n-tools">
      <form class="n-srch" role="search" action={`${pre}/search/`} method="get"><Icon name="search" size={18} sw={2} /><label class="sr" for="q">{u.search}</label><input id="q" name="q" type="search" placeholder={he ? 'חיפוש ידיעות, רחובות, בעלי מקצוע' : u.searchPh}></form>
      {/* 29.10.2026 (Yakir): the city guide menu moved from the sections row to the header, so the sections row is not cut */}
      {he && guideCats.length > 0 && <details class="n-dd hdd" data-dd><summary aria-current={current === 'guide' ? 'page' : undefined}>שימושון עירוני<Icon name="chev" size={14} sw={2.4} /></summary>
        <div class="n-ddm"><b>שימושון עירוני</b>{guideCats.map((c) => <a href={guideHref(c)}>{c.name}</a>)}<a class="all" href="/guide/">כל השימושון ←</a></div></details>}
      <a class="n-btn ink" href={tgHref} {...tgAttr} data-tg><Icon name="telegram" size={18} color="#fff" />{L.tg}</a>
      <a class="n-btn line ico" href={`${pre}/join/#alerts`} aria-label={L.alerts}><Icon name="bell" size={19} /></a>
    </div>
    <div class="n-mtools"><a class="n-ib" href={`${pre}/search/`} aria-label={u.search}><Icon name="search" size={22} sw={2} /></a></div>
  </div></div>
  <nav class="n-nav" aria-label={u.sectionsH}><div class="n-wrap">
    <a href={homeHref} aria-current={current === 'home' ? 'page' : undefined}>{L.home}</a>
    {nav.map((s) => <a href={sectionUrl(s.key, lang)} aria-current={current === s.key ? 'page' : undefined}>{s.key === 'flash' && <span class="dot" aria-hidden="true"></span>}{s.name[lang]}</a>)}
    <a class="more" href={`${pre}/directory/`} aria-current={current === 'directory' ? 'page' : undefined}>{L.pros}</a>
  </div></nav></>)}
</header>
{!compact && tickerItems.length > 0 && (
<div class="n-tick" id="ntick"><div class="n-wrap">
  <span class="tl"><i aria-hidden="true"></i>{u.flash}</span>
  <div class="vp"><ul class="num" data-tk={he ? '1' : undefined}>{[...tickerItems, ...tickerItems].map((a, i) => <li aria-hidden={i >= tickerItems.length ? 'true' : undefined} data-at={a.at}><a href={a.href} tabindex={i >= tickerItems.length ? -1 : undefined}><b>{tickTime(a.at)}</b> {a.src ? `${a.src}: ` : ''}{a.text}</a></li>)}</ul></div>
  <button class="pz" type="button" aria-pressed="false" aria-label={L.pause} data-pause><Icon name="pause" size={16} sw={2.2} /></button>
  <a class="all" href={sectionUrl('flash', lang)}>{L.all}</a>
</div></div>)}
{ev && !compact && (
<aside class="n-ev" aria-label={ev.title} data-ends={ev.endsAt || undefined}><div class="n-wrap">
  <span class="tag">{ev.tag || 'מיוחד'}</span><b class="t">{ev.title}</b>
  {ev.stat1 && <span><span class="big num">{ev.stat1}</span> {ev.stat1Label}</span>}
  {ev.stat2 && <span class="s2 num">{ev.stat2} {ev.stat2Label}</span>}
  {ev.ctaText && ev.ctaUrl && <a href={ev.ctaUrl}>{ev.ctaText} ←</a>}
</div></aside>)}
<main id="main" tabindex="-1"><slot /></main>
<footer class="n-foot"><div class="n-wrap">
  <div class="n-fg">
    <div>
      <a class="n-logo" href={homeHref} aria-label={`NWS ${u.brandName}`}><span class="n-mk">NWS<i></i></span><span class="n-lt"><b>{u.brandName}</b><span>{he ? 'אתר חדשות מקומי ועצמאי' : u.tagline}</span></span></a>
      <p style="margin:18px 0 0;max-width:340px;line-height:1.7">{he ? 'חדשות, מבזקים ושירותים לתושבי נתניה והשרון, מסביב לשעון. ראיתם משהו? שלחו לנו ידיעה או תמונה.' : u.footAbout}</p>
    </div>
    <div><h2>{u.sectionsH}</h2><ul>{liveSections().filter((s) => (s.key as string) !== 'blog').map((s) => <li><a href={sectionUrl(s.key, lang)}>{s.name[lang]}</a></li>)}</ul></div>
    {he ? <div><h2>השרון</h2><ul>{sharonAreas.map((x) => <li><a href={placeUrl(x.slug)}>{x.he}</a></li>)}<li><a href="/sharon/">כל חדשות השרון</a></li></ul></div> : <div></div>}
    <div><h2>{u.usefulH}</h2><ul><li><a href={`${pre}/directory/`}>{L.pros}</a></li><li><a href={`${pre}/now/`}>{u.now}</a></li>{he && <><li><a href="/now/shabbat/">שבת ומועדים</a></li><li><a href="/now/roads/">כבישים וחסימות</a></li><li><a href="/now/phones/">מספרי חירום</a></li><li><a href="/now/pharmacy/">בית מרקחת תורן</a></li><li><a href="/netanya/">נתניה: מדריך העיר</a></li><li><a href="/blog/">בלוג: מדריכים לתושבים</a></li><li><a href="/guide/">שימושון עירוני</a></li><li><a href="/events/#cal">לוח אירועים</a></li></>}<li><a href={`${pre}/send-news/`}>{u.sendNews}</a></li></ul></div>
    <div><h2>{u.siteH}</h2><ul><li><a href={`${pre}/about/`}>{he ? 'אודות ומערכת' : u.about}</a></li><li><a href="/editorial-policy/">{u.editorial}</a></li><li><a href="/corrections/">{u.corrections}</a></li><li><a href="/advertise/">{u.advertise}</a></li><li><a href="/contact/">{u.contact}</a></li><li><a href="/accessibility/">{u.accessibility}</a></li></ul></div>
  </div>
  {he && <p style="margin:28px 0 0;font-size:12.5px;color:#7E8796">תמונות שמסומנות "תמונה להמחשה" נוצרו בבינה מלאכותית ואינן מתעדות את האירוע. תמונות שמסומנות "צילום אילוסטרציה" לקוחות מספריית צילומים חופשית ואינן מהאירוע. <a href="/editorial-policy/#images" style="text-decoration:underline">מדיניות התמונות</a></p>}
  <div class="n-fb"><span>© {new Date().getFullYear()} NWS {u.brandName}</span><span><a href="/terms/">{he ? 'תנאי שימוש' : u.terms}</a> · <a href="/privacy/">{u.privacy}</a> · <a href="/accessibility/">{he ? 'נגישות' : u.accessibility}</a> · {he && <><a href="/write/" rel="nofollow">כניסת כותבים</a> · </>}<button class="lk" type="button" data-ck-open>{he ? 'הגדרות עוגיות' : 'Cookie settings'}</button> · {he && <><button class="lk" type="button" data-push-toggle aria-pressed="false">התראות</button> · </>}{LANGS.map((l, i) => <>{i > 0 && ' · '}<a href={langHref(l)} lang={l}>{l === 'he' ? 'עברית' : l === 'ru' ? 'Русский' : l === 'fr' ? 'Français' : 'English'}</a></>)}</span></div>
</div></footer>
</div>

<nav class="n-tab" aria-label={he ? 'ניווט ראשי' : 'Main navigation'}>
  <a href={homeHref} aria-current={current === 'home' ? 'page' : undefined}><Icon name="home" size={22} sw={1.9} />{L.home}</a>
  <a href={sectionUrl('flash', lang)} aria-current={current === 'flash' ? 'page' : undefined}><span class="bdg"><Icon name="bolt" size={22} sw={1.9} /></span>{u.flash}</a>
  <a href={sectionUrl('sharon', lang)} aria-current={current === 'sharon' ? 'page' : undefined}><Icon name="pin" size={22} sw={1.9} />{L.sharon}</a>
  <a href={`${pre}/directory/`} aria-current={current === 'directory' ? 'page' : undefined}><Icon name="wrench" size={22} sw={1.9} />{L.pros}</a>
  <button type="button" aria-haspopup="dialog" aria-controls="nmenu" aria-expanded="false" data-menu><Icon name="menu" size={22} sw={1.9} />{L.menu}</button>
</nav>
<div class="n-menu" id="nmenu" role="dialog" aria-modal="true" aria-label={L.menu} hidden>
  <div class="hd"><b>{L.menu}</b><button class="n-ib" type="button" data-menu-close aria-label={he ? 'סגירה' : 'Close'}><Icon name="close" size={22} /></button></div>
  <form class="n-srch" role="search" action={`${pre}/search/`} method="get" style="width:100%"><Icon name="search" size={18} sw={2} /><label class="sr" for="q2">{u.search}</label><input id="q2" name="q" type="search" placeholder={u.searchPh}></form>
  <nav aria-label={u.sectionsH}>{liveSections().map((s) => <a href={sectionUrl(s.key, lang)} style={`--c:${s.color}`}><Icon name={s.key} size={18} />{s.name[lang]}</a>)}<a href={`${pre}/directory/`}><Icon name="wrench" size={18} />{L.pros}</a><a href={`${pre}/now/`}><Icon name="sun" size={18} />{u.now}</a>{he && <a href="/netanya/"><Icon name="pin" size={18} />מדריך העיר</a>}{he && guideCats.length > 0 && <a href="/guide/"><Icon name="list" size={18} />שימושון עירוני</a>}</nav>
