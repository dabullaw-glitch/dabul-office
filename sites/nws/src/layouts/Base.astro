 if(window.gtag)gtag('consent','update',{analytics_storage:a?'granted':'denied'});if(a&&window.nwsLoadGA)nwsLoadGA();
 if(!a){var dm=location.hostname.replace(/^www\./,'');d.cookie.split(';').forEach(function(c){var n=c.split('=')[0].trim();if(/^_ga/.test(n))['','.'+dm,dm].forEach(function(x){d.cookie=n+'=;path=/;max-age=0'+(x?';domain='+x:'')})})}
 ckShow(false);var f=ckFrom;ckFrom=null;if(f&&f.focus&&f.offsetParent!==null)f.focus()}
if(ck){if(!C){try{var mc=d.cookie.match(/(?:^|; )nws_consent=(all|necessary)/);if(mc)C={a:mc[1]==='all',v:1}}catch(e){}}
 var set=ck.querySelector('[data-ck-set]'),cbA=ck.querySelector('[data-ck-a]'),sv=ck.querySelector('[data-ck="save"]');
 ck.querySelector('[data-ck="all"]').addEventListener('click',function(){saveC(true)});
 ck.querySelector('[data-ck="min"]').addEventListener('click',function(){saveC(false)});
 ck.querySelector('[data-ck="set"]').addEventListener('click',function(){set.hidden=false;sv.hidden=false;cbA.checked=!!(C&&C.a);cbA.focus()});
 sv.addEventListener('click',function(){saveC(cbA.checked)});
 window.nwsCookieSettings=function(from){ckFrom=from||d.activeElement;ckShow(true);set.hidden=false;sv.hidden=false;cbA.checked=!!(C&&C.a);cbA.focus()};
 d.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-ck-open],#nws-cookie-settings');if(b){e.preventDefault();nwsCookieSettings(b)}});
 addEventListener('resize',function(){if(!ck.hidden)h.style.setProperty('--ck-h',ck.offsetHeight+'px')},{passive:true});
 if(!C)ckShow(true)}
