---
import '../styles/global.css';
import { SITE_URL, PREVIEW, LANGS, LANG_PREFIX, LANG_LOCALE, LANG_DIR, BRAND, TG_URL, type Lang } from '../data/site';
import { SECTIONS } from '../data/sections';
import { t } from '../i18n/ui';
import { ARTICLES, articlesFor, articleUrl, sectionUrl, fmtTime, fmtShort, EVENT, LIVE, hebrewDate, FLASHES, navSections, liveSections } from '../lib/content';

interface Crumb { name: string; href: string }
interface Props {
  lang?: Lang; title: string; description: string; path: string;
  alternates?: Partial<Record<Lang, string>>; ogImage?: string; ogType?: string; jsonld?: any[]; noindex?: boolean;
  crumbs?: Crumb[]; current?: string; published?: string; modified?: string; section?: string; tags?: string[];
}
const { lang = 'he', title, description, path, alternates = {}, ogImage = '/og/default.png', ogType = 'website', jsonld = [], noindex = false,
  crumbs = [], current = '', published, modified, section, tags = [] } = Astro.props;
const u = t(lang);
const canonical = SITE_URL + path;
const robots = PREVIEW || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const alts = Object.entries(alternates) as [Lang, string][];
const pre = LANG_PREFIX[lang];
// ticker: the latest flash items (or the latest stories when there are no flash items)
const pool0 = articlesFor(lang);
// 28.10.2026: official flashes (hns-feed) first, together with the flash section stories, newest first; when there are fewer than 2,
// the latest stories. The browser refreshes the official flashes every minute (script at the end of the page).
const flashOnly = pool0.filter((a) => a.section === 'flash');
type Tick = { at: string; text: string; href: string; src?: string };
const tk0: Tick[] = [...(lang === 'he' ? FLASHES.map((f) => ({ at: f.at, text: f.text, href: `/flash/#f${f.id}`, src: f.source })) : []),
  ...flashOnly.map((a) => ({ at: a.published, text: a.title, href: articleUrl(a, lang) }))].sort((x, y) => Date.parse(y.at) - Date.parse(x.at));
const tickerItems: Tick[] = (tk0.length >= 2 ? tk0 : pool0.map((a) => ({ at: a.published, text: a.title, href: articleUrl(a, lang) }))).slice(0, 8);
const ilDay = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jerusalem' }).format(d);
const tickTime = (iso: string) => (ilDay(new Date(iso)) === ilDay(new Date()) ? fmtTime(iso) : fmtShort(iso));
const hdate = lang === 'he' ? hebrewDate() : '';
const wx = LIVE?.ok && typeof LIVE.temp === 'number' ? Math.round(LIVE.temp) : null;
const wxIcon = (c: number | null | undefined) => (c == null ? 'sun' : c <= 1 ? 'sun' : c <= 3 ? 'cloud' : c >= 51 ? 'rain' : 'cloud');
// event strip (only on Hebrew pages, only while an event is active); its colors follow the kind of event
const ev = lang === 'he' ? EVENT : null;
const EVK: Record<string, { bg: string; tagBg: string; tagFg: string }> = {
  elections: { bg: 'linear-gradient(90deg,#0B3D6E,#0B5FCC)', tagBg: '#FFFFFF', tagFg: '#0B3D6E' },
  storm: { bg: 'linear-gradient(90deg,#1F2A37,#3B4656)', tagBg: '#F59F00', tagFg: '#0E1726' },
  holiday: { bg: 'linear-gradient(90deg,#6D28D9,#DB2777)', tagBg: '#FFFFFF', tagFg: '#6D28D9' },
  emergency: { bg: 'linear-gradient(90deg,#8F0B20,#C8102E)', tagBg: '#FFFFFF', tagFg: '#A60D26' },
  other: { bg: 'linear-gradient(90deg,#0E1726,#0B3D6E)', tagBg: '#FFFFFF', tagFg: '#0E1726' },
};
const evk = ev ? (EVK[ev.kind] ?? EVK.other) : null;
const flashS = SECTIONS.find((x) => x.key === 'flash')!;
const homeHref = (pre || '') + '/';
const langHref = (l: Lang) => (alternates[l] ?? (LANG_PREFIX[l] + '/'));
const today = new Intl.DateTimeFormat(lang === 'he' ? 'he-IL' : lang, { timeZone: 'Asia/Jerusalem', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
const crumbLd = crumbs.length ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE_URL + c.href })) }] : [];
const ld = [...jsonld, ...crumbLd];
---
<!doctype html>
<html lang={lang} dir={LANG_DIR[lang]}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content={robots}>
{alts.map(([l, p]) => <link rel="alternate" hreflang={l} href={SITE_URL + p}>)}
{alts.length > 0 && alternates.he && <link rel="alternate" hreflang="x-default" href={SITE_URL + alternates.he}>}
<meta property="og:site_name" content={BRAND.he}>
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={SITE_URL + ogImage}>
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta property="og:locale" content={LANG_LOCALE[lang]}>
{published && <meta property="article:published_time" content={published}>}
{modified && <meta property="article:modified_time" content={modified}>}
{section && <meta property="article:section" content={section}>}
{tags.map((tg) => <meta property="article:tag" content={tg}>)}
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0E1726">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/rss+xml" title={BRAND.he} href={`${pre}/rss.xml`}>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800&family=Rubik:wght@500;600;700;800&display=swap" rel="stylesheet">
{/* a story picture that fails to load (for example a missing AI file) is replaced by the city drawing, so no broken image is shown */}
{/* Google Analytics 4 (G-N0Q1GZWXF2, added 28.10.2026): loaded async, IP anonymized, no ad signals. window.nwsTrack(name, params)
   is the one helper for site events, e.g. nwsTrack('generate_lead', {form: 'directory'}) after a form was sent successfully. */}
{!PREVIEW && <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N0Q1GZWXF2"></script>}
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-N0Q1GZWXF2',{anonymize_ip:true,allow_google_signals:false,allow_ad_personalization_signals:false});
window.nwsTrack=function(n,p){try{gtag('event',n,p||{})}catch(e){}};</script>
<script is:inline>addEventListener('error',function(e){var i=e.target;if(i&&i.tagName==='IMG'&&!i.dataset.fb){i.dataset.fb='1';i.removeAttribute('srcset');i.src='/img/stock/city-buildings-800.webp'}},true)</script>
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')}></script>)}
</head>
<body>
<a class="skip" href="#main">{lang === 'he' ? 'דלג לתוכן' : lang === 'ru' ? 'К содержанию' : lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
{PREVIEW && <div class="preview">{u.previewNote}</div>}
<div class="ub"><div class="wrap">
  <div class="l"><span>{today}</span>{hdate && <span class="hd2x">{hdate}</span>}<span class="wx" data-wx>{wx !== null ? <><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F2B544" stroke-width="2" aria-hidden="true">{wxIcon(LIVE.code) === 'sun' ? <><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></> : wxIcon(LIVE.code) === 'rain' ? <><path d="M7 15a4 4 0 010-8 5 5 0 019.6 1.5A3.5 3.5 0 0117 15z"/><path d="M8 18l-1 3M12 18l-1 3M16 18l-1 3"/></> : <path d="M7 18a4 4 0 010-8 5 5 0 019.6 1.5A3.5 3.5 0 0117 18z"/>}</svg><b data-wx-t>{wx}°</b> {lang === 'he' ? 'נתניה' : u.city}</> : <span>{lang === 'he' ? 'נתניה' : u.city}</span>}</span></div>
  <div class="r">
    <a href={`${pre}/send-news/`}>{u.sendNews}</a>
    <a href="/advertise/">{u.advertise}</a>
    <nav class="langs" aria-label="שפה / Language">
      {LANGS.map((l) => <a href={langHref(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l === 'he' ? 'עב' : l.toUpperCase()}</a>)}
    </nav>
  </div>
</div></div>
<header class="hd">
  <div class="wrap top">
    <a class="logo" href={homeHref} aria-label={`NWS ${u.brandName}`}>
      <span class="mk">NWS<i></i></span>
      <span class="tx"><b>{u.brandName}</b><span>{u.tagline}</span></span>
    </a>
    <form class="srch" role="search" action={`${pre}/search/`} method="get">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5B6573" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <label class="sr" for="q">{u.search}</label>
      <input id="q" name="q" type="search" placeholder={u.searchPh}>
    </form>
    <div class="btns">
      <a class="btn pri pill" href={TG_URL || `${pre}/join/`} {...(TG_URL ? { target: '_blank', rel: 'noopener' } : {})} data-tg><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><path d="M21 4L3 11l6 2 2 6 3-4 5 4 2-15z"/></svg>{u.joinTelegram}</a>
    </div>
    <div class="mtools">
      <a href="/search/" aria-label={u.search}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0E1726" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></a>
      <details class="mm">
        <summary aria-label={lang === 'he' ? 'תפריט' : 'Menu'}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0E1726" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
        <div class="mmp">
          <nav aria-label={u.sectionsH}>{navSections().map((x) => <a href={sectionUrl(x.key, lang)}>{x.name[lang]}</a>)}<a href={`${pre}/now/`}>{u.now}</a>{lang === 'he' && <a href="/netanya/">מדריך העיר</a>}<a href={`${pre}/directory/`}>{u.directory}</a></nav>
          <div class="mmb"><a class="btn pri pill" href={TG_URL || `${pre}/join/`} {...(TG_URL ? { target: '_blank', rel: 'noopener' } : {})} data-tg>{u.joinTelegram}</a><a href={`${pre}/send-news/`}>{u.sendNews}</a><a href="/advertise/">{u.advertise}</a></div>
          <div class="langs">{LANGS.map((l) => <a href={langHref(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l === 'he' ? 'עב' : l.toUpperCase()}</a>)}</div>
        </div>
      </details>
    </div>
  </div>
  <div class="navw"><nav class="wrap nav" aria-label={u.sectionsH}>
    {navSections().map((s) => <a href={sectionUrl(s.key, lang)} class={s.key === 'flash' ? 'fl' : undefined} style={`--c:${s.color}`} aria-current={current === s.key ? 'page' : undefined}>{s.key === 'flash' && <i aria-hidden="true"></i>}{s.name[lang]}</a>)}
    <a class="hl" href={`${pre}/now/`} aria-current={current === 'now' ? 'page' : undefined}>{u.now}</a>
    <a class="hl" href={`${pre}/directory/`} aria-current={current === 'directory' ? 'page' : undefined}>{u.directory}</a>
  </nav></div>
</header>
{ev && evk && (
<aside class="evs" aria-label={ev.title} style={`background:${evk.bg}`} data-ends={ev.endsAt || undefined}><div class="wrap">
  <span class="evt"><span class="tg" style={`background:${evk.tagBg};color:${evk.tagFg}`}>{ev.tag || 'אירוע מיוחד'}</span><b>{ev.title}</b></span>
  {(ev.stat1 || ev.stat2) && <span class="evd" aria-hidden="true"></span>}
  <span class="evn">{ev.stat1 && <span><b>{ev.stat1}</b> {ev.stat1Label}</span>}{ev.stat2 && <span class="s2"><b>{ev.stat2}</b> {ev.stat2Label}</span>}</span>
  {ev.ctaText && ev.ctaUrl && <a class="evc" href={ev.ctaUrl}>{ev.ctaText} ←</a>}
</div></aside>)}
{tickerItems.length > 0 && (
<div class="tk"><div class="wrap">
  <span class="lb">{u.flash}</span>
  <div class="vp"><ul data-tk={lang === 'he' ? '1' : undefined}>{[...tickerItems, ...tickerItems].map((a, i) => <li aria-hidden={i >= tickerItems.length ? 'true' : undefined} data-at={a.at}><a href={a.href} tabindex={i >= tickerItems.length ? -1 : undefined}><b>{tickTime(a.at)}</b> {a.src ? `${a.src}: ` : ''}{a.text}</a></li>)}</ul></div>
</div></div>)}
<main id="main"><slot /></main>
<footer class="ft">
  <div class="wrap cols">
    <div><span class="mk">NWS<i>.</i></span><span>{u.footAbout}</span></div>
    <div><b>{u.sectionsH}</b>{liveSections().map((s) => <a href={sectionUrl(s.key, lang)}>{s.name[lang]}</a>)}</div>
    <div><b>{u.usefulH}</b><a href={`${pre}/now/`}>{u.now}</a>{lang === 'he' && <><a href="/now/pharmacy/">בית מרקחת תורן</a><a href="/now/shabbat/">זמני שבת בנתניה</a><a href="/now/beaches/">החופים של נתניה</a><a href="/now/phones/">טלפונים חיוניים</a><a href="/netanya/">נתניה: מדריך העיר</a><a href="/events/#cal">לוח אירועים בנתניה</a><a href="/flash/#official">מבזקים רשמיים</a></>}<a href={`${pre}/directory/`}>{u.directory}</a></div>
    <div><b>{u.siteH}</b><a href={`${pre}/about/`}>{u.about}</a><a href="/editorial-policy/">{u.editorial}</a><a href="/corrections/">{u.corrections}</a><a href={`${pre}/send-news/`}>{u.sendNews}</a><a href="/advertise/">{u.advertise}</a><a href="/contact/">{u.contact}</a><a href="/terms/">{u.terms}</a><a href="/privacy/">{u.privacy}</a><a href="/accessibility/">{u.accessibility}</a></div>
  </div>
  {lang === 'he' && <div class="wrap ainote">תמונות שמסומנות "להמחשה" נוצרו בבינה מלאכותית ואינן מתעדות את האירוע. <a href="/editorial-policy/#images">מדיניות התמונות</a></div>}
  <div class="wrap bt"><span>© {new Date().getFullYear()} NWS. {u.rights}</span><span>{LANGS.map((l, i) => <>{i > 0 && ' · '}<a href={langHref(l)} lang={l}>{l === 'he' ? 'עברית' : l === 'ru' ? 'Русский' : l === 'fr' ? 'Français' : 'English'}</a></>)}</span></div>
</footer>
<script is:inline>
/* time ago, past road closures, an event that ended, and the live sea and weather (Open-Meteo, free, no key) */
(function(){var L=document.documentElement.lang||'he',he=L==='he',rtf=null;try{rtf=new Intl.RelativeTimeFormat(L,{numeric:'auto'})}catch(e){}
function ago(){var n=Date.now();document.querySelectorAll('time[data-ago]').forEach(function(t){var d=Date.parse(t.getAttribute('datetime'));if(!d||!rtf)return;var s=Math.max(0,(n-d)/1e3);if(s>7*86400)return;
t.textContent=s<60?(he?'עכשיו':rtf.format(0,'minute')):s<3600?rtf.format(-Math.round(s/60),'minute'):s<86400?rtf.format(-Math.round(s/3600),'hour'):rtf.format(-Math.round(s/86400),'day')});
document.querySelectorAll('[data-until]').forEach(function(e){var u=Date.parse(e.getAttribute('data-until')+'T23:59:59+02:00');if(u&&u<n)e.remove()});
document.querySelectorAll('[data-ends]').forEach(function(e){var u=Date.parse(e.getAttribute('data-ends'));if(u&&u<n)e.remove()});}
ago();setInterval(ago,60000);
var w=document.querySelectorAll('[data-wx-t],[data-sea]');if(!w.length||!window.fetch)return;
var q='latitude=32.33&longitude=34.85&timezone=Asia%2FJerusalem';
Promise.all([fetch('https://marine-api.open-meteo.com/v1/marine?'+q+'&current=wave_height,sea_surface_temperature').then(function(r){return r.json()}),fetch('https://api.open-meteo.com/v1/forecast?'+q+'&current=temperature_2m,wind_speed_10m,weather_code').then(function(r){return r.json()})]).then(function(a){
var m=a[0].current||{},f=a[1].current||{},set=function(k,v){document.querySelectorAll('[data-live="'+k+'"]').forEach(function(e){e.textContent=v})};
if(typeof f.temperature_2m==='number'){document.querySelectorAll('[data-wx-t]').forEach(function(e){e.textContent=Math.round(f.temperature_2m)+'°'});set('temp',Math.round(f.temperature_2m)+'°')}
if(typeof m.wave_height==='number'){set('wave',m.wave_height.toFixed(1));var h=m.wave_height,st=document.querySelector('[data-states]'),S=st?st.getAttribute('data-states').split('|'):[];if(S.length===5)set('state',S[h<=0.5?0:h<=1?1:h<=1.6?2:h<=2.5?3:4])}
if(typeof m.sea_surface_temperature==='number')set('sst',Math.round(m.sea_surface_temperature)+'°');
if(typeof f.wind_speed_10m==='number')set('wind',Math.round(f.wind_speed_10m));
try{set('at',new Intl.DateTimeFormat('he-IL',{timeZone:'Asia/Jerusalem',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date()))}catch(e){}}).catch(function(){});})();
</script>
{lang === 'he' && <script is:inline define:vars={{ API: 'https://mgjmnvpnovkewvqevjmz.supabase.co/functions/v1/hns-feed?only=flashes' }}>
/* official flashes, refreshed every minute: the ticker and the list on /flash/. A flash past its time limit disappears. */
(function(){if(!window.fetch)return;var tk=document.querySelector('ul[data-tk]'),fl=document.querySelector('[data-flist]');if(!tk&&!fl)return;
var esc=function(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})};
var day=function(d){return new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Jerusalem'}).format(d)};
var tm=function(iso){var d=new Date(iso);return day(d)===day(new Date())?new Intl.DateTimeFormat('he-IL',{timeZone:'Asia/Jerusalem',hour:'2-digit',minute:'2-digit',hour12:false}).format(d):new Intl.DateTimeFormat('he-IL',{timeZone:'Asia/Jerusalem',day:'2-digit',month:'2-digit'}).format(d)};
var stories=tk?[].slice.call(tk.querySelectorAll('li:not([aria-hidden])')).map(function(li){var a=li.querySelector('a');return{at:li.getAttribute('data-at'),href:a.getAttribute('href'),text:a.textContent.replace(/^\s*\S+\s/,'')}}).filter(function(x){return x.href.indexOf('/flash/#f')!==0}):[];
function run(){fetch(API).then(function(r){return r.json()}).then(function(j){var now=Date.now();
var f=(j.flashes||[]).filter(function(x){return now-Date.parse(x.at)<(x.ttl||12)*36e5});
if(tk){var all=f.map(function(x){return{at:x.at,href:'/flash/#f'+x.id,text:x.source+': '+x.text}}).concat(stories).sort(function(a,b){return Date.parse(b.at)-Date.parse(a.at)}).slice(0,8);
if(all.length>=2){var h=all.map(function(x){return'<li data-at="'+esc(x.at)+'"><a href="'+esc(x.href)+'"><b>'+tm(x.at)+'</b> '+esc(x.text)+'</a></li>'}).join('');tk.innerHTML=h+h.replace(/<li /g,'<li aria-hidden="true" ').replace(/<a /g,'<a tabindex="-1" ')}}
if(fl){fl.innerHTML=f.map(function(x){return'<li id="f'+x.id+'"><time datetime="'+esc(x.at)+'">'+tm(x.at)+'</time><span><b>'+esc(x.source)+'</b> '+esc(x.text)+(x.url?' <a href="'+esc(x.url)+'" rel="noopener nofollow" target="_blank">למקור</a>':'')+'</span></li>'}).join('');var e=document.querySelector('[data-fempty]');if(e)e.hidden=f.length>0}
}).catch(function(){})}
setTimeout(run,4000);setInterval(run,60000);})();
</script>}
</body>
</html>
