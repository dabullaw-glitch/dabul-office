(function(){
var d=document,h=d.documentElement,hd=d.getElementById('nhead'),top=d.getElementById('ntop'),prog=d.getElementById('nprog');
function onScroll(){var y=window.scrollY||0;if(hd)hd.classList.toggle('sm',y>120);if(top)top.classList.toggle('on',y>window.innerHeight*1.5);
 if(prog){var a=d.querySelector('article'),r=a?a.getBoundingClientRect():null;if(r){var p=Math.min(1,Math.max(0,-r.top/Math.max(1,r.height-window.innerHeight)));prog.style.width=(p*100).toFixed(1)+'%'}}}
addEventListener('scroll',onScroll,{passive:true});onScroll();
if(top)top.addEventListener('click',function(){var still=h.classList.contains('a11y-still')||matchMedia('(prefers-reduced-motion: reduce)').matches;window.scrollTo({top:0,behavior:still?'auto':'smooth'});var m=d.getElementById('main');if(m)m.focus({preventScroll:true})});
var tk=d.getElementById('ntick'),pz=d.querySelector('[data-pause]');
