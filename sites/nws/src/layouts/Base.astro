/* dialogs: focus trap, Esc closes, focus returns to the opener */
function dialog(box,opener,onClose){var last=null;function keys(e){if(e.key==='Escape'){close();return}if(e.key!=='Tab')return;var f=[].slice.call(box.querySelectorAll('a[href],button:not([disabled]),input:not([disabled]),select,textarea,[tabindex]:not([tabindex="-1"])')).filter(function(x){return x.offsetParent!==null});if(!f.length)return;var a=f[0],z=f[f.length-1];if(e.shiftKey&&d.activeElement===a){e.preventDefault();z.focus()}else if(!e.shiftKey&&d.activeElement===z){e.preventDefault();a.focus()}}
 function open(){last=d.activeElement;box.hidden=false;if(opener)opener.setAttribute('aria-expanded','true');d.addEventListener('keydown',keys);var f=box.querySelector('button,a[href],input');if(f)f.focus()}
 function close(){box.hidden=true;if(opener)opener.setAttribute('aria-expanded','false');d.removeEventListener('keydown',keys);if(onClose)onClose();if(last&&last.focus)last.focus()}
 return{open:open,close:close,toggle:function(){box.hidden?open():close()}}}
var dd=d.querySelector('[data-dd]');if(dd){d.addEventListener('click',function(e){if(dd.open&&!dd.contains(e.target))dd.open=false});d.addEventListener('keydown',function(e){if(e.key==='Escape'&&dd.open){dd.open=false;dd.querySelector('summary').focus()}})}
var mb=d.querySelector('[data-menu]'),mn=d.getElementById('nmenu');if(mb&&mn){var md=dialog(mn,mb);mb.addEventListener('click',md.toggle);mn.querySelector('[data-menu-close]').addEventListener('click',md.close)}
/* accessibility panel: settings are classes on <html>, saved in localStorage */
var ab=d.getElementById('na11yb'),ap=d.getElementById('na11y'),A={};try{A=JSON.parse(localStorage.getItem('nwsA11y')||'{}')||{}}catch(e){A={}}
function applyA(){['z1','z2','z3'].forEach(function(z){h.classList.remove('a11y-'+z)});if(A.z)h.classList.add('a11y-z'+A.z);['contrast','gray','links','font','still','cursor','focus'].forEach(function(k){h.classList.toggle('a11y-'+k,!!A[k]);var b=ap&&ap.querySelector('[data-k="'+k+'"]');if(b)b.setAttribute('aria-pressed',A[k]?'true':'false')});var zl=ap&&ap.querySelector('[data-zl]');if(zl)zl.textContent=zl.getAttribute('data-l').split('|')[A.z||0];try{localStorage.setItem('nwsA11y',JSON.stringify(A))}catch(e){}}
if(ab&&ap){var ad=dialog(ap,ab);ab.addEventListener('click',ad.toggle);ap.querySelector('[data-a11y-close]').addEventListener('click',ad.close);
 ap.querySelectorAll('[data-k]').forEach(function(b){b.addEventListener('click',function(){var k=b.getAttribute('data-k');A[k]=!A[k];applyA()})});
 ap.querySelectorAll('[data-z]').forEach(function(b){b.addEventListener('click',function(){A.z=Math.max(0,Math.min(3,(A.z||0)+Number(b.getAttribute('data-z'))));applyA()})});
 ap.querySelector('[data-a11y-reset]').addEventListener('click',function(){A={};applyA()});applyA()}
/* cookies: necessary always; statistics (Google Analytics) only with consent */
var ck=d.getElementById('nck'),C=null;try{C=JSON.parse(localStorage.getItem('nwsConsent')||'null')}catch(e){}
var ckFrom=null,sec=location.protocol==='https:'?';Secure':'';
function ckShow(on){ck.hidden=!on;h.classList.toggle('ck-on',on);if(on)h.style.setProperty('--ck-h',ck.offsetHeight+'px')}
function saveC(a){C={a:!!a,at:new Date().toISOString(),v:1};try{localStorage.setItem('nwsConsent',JSON.stringify(C))}catch(e){}
