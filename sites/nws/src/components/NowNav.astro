---
import '../styles/list.css';
const items = [
  ['/now/', 'הכל'], ['/now/weather/', 'מזג אוויר'], ['/now/shabbat/', 'זמני שבת'], ['/now/weekend/', 'סוף השבוע'], ['/now/beaches/', 'החופים'], ['/now/pharmacy/', 'בית מרקחת תורן'], ['/now/roads/', 'חסימות'], ['/now/outages/', 'הפסקות מים וחשמל'], ['/now/alerts/', 'פיקוד העורף'], ['/now/phones/', 'טלפונים חיוניים'],
];
const cur = Astro.url.pathname;
---
<nav aria-label="נתניה עכשיו" class="nl-tabs">
  {items.map(([h, n]) => <a href={h} aria-current={cur === h ? 'page' : undefined}>{n}</a>)}
</nav>
