---
// Story page (redesign approved by Yakir 28.10.2026, Article.dc.html): kicker with the section color bar, headline, dek, byline
// (published, updated, reading time) with round share buttons, the hero picture with its caption, "בקצרה" (key points), the body
// (20px, line height 1.75; "## " opens a subheading, "> " a pull quote), "עוד בנושא" inside the text, "מה הלאה" only when the
// story has an event or a road closure, FAQ, sources, places and tags, "מצאתם טעות?", the sidebar (flashes, Telegram, more from
// the section, the Maccabi table on sports stories, local pros) and the related grid. Every block is hidden when its data is missing.
// Shared classes come from src/styles/nws.css (n- prefix); the few article-only rules are in src/styles/article.css.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import '../styles/article.css';
import { IMG, SITE_URL, LANG_PREFIX, LANGS, BRAND, TG_URL, type Lang } from '../data/site';
import { SECTION_BY_KEY } from '../data/sections';
import { CATEGORIES } from '../data/directory';
import { t } from '../i18n/ui';
import { ARTICLES, articlesFor, articleUrl, sectionUrl, fmtTime, placesOf, placeUrl, linkify, related, clip, localized, picOf, kickerOf, readMin,
  FLASHES, SPORT, tableAround, type Article } from '../lib/content';

interface Props { lang: Lang; a: Article }
const { lang, a } = Astro.props;
const he = lang === 'he';
const s = SECTION_BY_KEY[a.section]; const u = t(lang); const pre = LANG_PREFIX[lang];
const pic = picOf(a);
const heA = ARTICLES.find((x) => x.slug === a.slug)!;
const places = placesOf(heA);
const pool = articlesFor(lang);
const path = articleUrl(a, lang);
const alternates = Object.fromEntries(LANGS.filter((l) => localized(heA, l)).map((l) => [l, articleUrl(a, l)]));
const crumbs = [{ name: u.home, href: pre + '/' }, { name: s.name[lang], href: sectionUrl(a.section, lang) }, { name: a.title, href: path }];
const title = a.title.length > 62 ? clip(a.title, 92) : `${a.title} | ${he ? 'חדשות נתניה והשרון' : 'NWS'}`;
const desc = clip(a.dek || a.body[0] || a.title, 158);
const modified = a.updated || a.published;
const url = SITE_URL + path;
const words = [a.title, a.dek, ...a.body].join(' ').split(/\s+/).length;
const ogImage = a.og || pic.og;
const abs = (p: string) => (/^https?:/.test(p) ? p : SITE_URL + p);
// paid or marketing content (kind 'sponsored'): labelled "תוכן שיווקי", schema Article instead of NewsArticle, mini markup in the body
const sponsored = (a.kind as string) === 'sponsored';

// ---------- structured data (NewsArticle, FAQ, Event; the breadcrumb list is added by Base) ----------
const jsonld: any[] = [{
  '@context': 'https://schema.org', '@type': sponsored ? 'Article' : 'NewsArticle', '@id': url + '#article', mainEntityOfPage: url, url,
  headline: a.title.slice(0, 110), description: desc, image: [...new Set([abs(ogImage), abs(pic.src)])], inLanguage: lang,
  datePublished: a.published, dateModified: modified, articleSection: s.name[lang], ...(a.tags.length ? { keywords: a.tags.join(', ') } : {}), wordCount: words,
  author: a.kind === 'opinion' && a.author ? { '@type': 'Person', name: a.author } : { '@type': 'Organization', name: he ? 'מערכת חדשות נתניה והשרון' : 'NWS Desk', url: SITE_URL + '/about/' },
  ...(sponsored && a.author ? { sponsor: { '@type': 'Organization', name: a.author } } : {}),
  publisher: { '@id': SITE_URL + '/#org', '@type': 'NewsMediaOrganization', name: BRAND.he, logo: { '@type': 'ImageObject', url: SITE_URL + '/logo.png' } },
  ...(a.sourceName && a.sourceUrl ? { isBasedOn: a.sourceUrl, citation: { '@type': 'CreativeWork', name: a.sourceName, url: a.sourceUrl } } : {}),
  contentLocation: places.length ? places.map((p) => ({ '@type': 'Place', name: p.he })) : { '@type': 'City', name: 'נתניה' },
  isAccessibleForFree: true,
}];
if (a.faq.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: a.faq.map(([q, x]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: x } })) });
if (a.event?.startDate) jsonld.push({ '@context': 'https://schema.org', '@type': 'Event', name: a.event.name, startDate: a.event.startDate, eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: a.event.location, address: { '@type': 'PostalAddress', addressLocality: 'נתניה', addressCountry: 'IL' } }, description: desc, url });

// ---------- labels ----------
const TZ = 'Asia/Jerusalem';
const LOC: Record<Lang, string> = { he: 'he-IL', ru: 'ru-RU', fr: 'fr-FR', en: 'en-GB' };
const fmtNum = (iso: string) => new Intl.DateTimeFormat(LOC[lang], { timeZone: TZ, day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(iso)).replace(/\//g, '.');
const dayOf = (iso: string) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(new Date(iso));
const L = {
  he: { wa: 'שיתוף בוואטסאפ', tg: 'שיתוף בטלגרם', fb: 'שיתוף בפייסבוק', copy: 'העתקת קישור', copied: 'הקישור הועתק', read: 'דק׳ קריאה', desk: 'מערכת NWS',
    also: 'עוד בנושא', next: 'מה הלאה', when: 'מתי', where: 'איפה', what: 'מה', until: 'עד מתי', approx: 'בערך', sources: 'מקורות:', how: 'איך אנחנו עובדים',
    fix: 'מצאתם טעות בכתבה? יש לכם מידע נוסף?', report: 'דווחו על טעות', send: 'שלחו ידיעה', aiCap: 'נוצרה בבינה מלאכותית ואינה מתעדת את האירוע', tags: 'נושאים ומקומות',
    table: 'הטבלה', pts: 'נק׳', tgBtn: 'הצטרפו לערוץ בטלגרם', pros: 'בעלי מקצוע בנושא', inCity: 'בנתניה', crumbs: 'מיקום',
    spon: 'תוכן שיווקי', with: 'בשיתוף', disclose: 'הכתבה פורסמה כתוכן שיווקי בשיתוף המפרסם' },
  ru: { wa: 'Поделиться в WhatsApp', tg: 'Поделиться в Telegram', fb: 'Поделиться в Facebook', copy: 'Скопировать ссылку', copied: 'Ссылка скопирована', read: 'мин чтения', desk: 'Редакция NWS',
    also: 'По теме', next: 'Что дальше', when: 'Когда', where: 'Где', what: 'Что', until: 'До', approx: 'примерно', sources: 'Источники:', how: 'Как мы работаем',
    fix: 'Нашли ошибку? Есть информация?', report: 'Сообщить об ошибке', send: 'Прислать новость', aiCap: 'создано ИИ, не документирует событие', tags: 'Темы',
    table: 'Таблица', pts: 'очк.', tgBtn: 'Канал в Telegram', pros: 'Специалисты', inCity: '', crumbs: 'Навигация',
    spon: 'Реклама', with: 'При участии', disclose: 'Материал опубликован на правах рекламы при участии рекламодателя' },
  fr: { wa: 'Partager sur WhatsApp', tg: 'Partager sur Telegram', fb: 'Partager sur Facebook', copy: 'Copier le lien', copied: 'Lien copié', read: 'min de lecture', desk: 'Rédaction NWS',
    also: 'À lire aussi', next: 'La suite', when: 'Quand', where: 'Où', what: 'Quoi', until: 'Jusqu’à', approx: 'environ', sources: 'Sources :', how: 'Notre méthode',
    fix: 'Une erreur ? Une info en plus ?', report: 'Signaler une erreur', send: 'Envoyer une info', aiCap: 'générée par IA, ne documente pas l’événement', tags: 'Thèmes',
    table: 'Classement', pts: 'pts', tgBtn: 'Rejoindre la chaîne Telegram', pros: 'Professionnels', inCity: '', crumbs: 'Fil d’Ariane',
    spon: 'Contenu sponsorisé', with: 'En partenariat avec', disclose: 'Cet article est publié comme contenu sponsorisé en partenariat avec l’annonceur' },
  en: { wa: 'Share on WhatsApp', tg: 'Share on Telegram', fb: 'Share on Facebook', copy: 'Copy link', copied: 'Link copied', read: 'min read', desk: 'NWS Desk',
    also: 'Related', next: 'What’s next', when: 'When', where: 'Where', what: 'What', until: 'Until', approx: 'about', sources: 'Sources:', how: 'How we work',
    fix: 'Found an error? Have more information?', report: 'Report an error', send: 'Send a tip', aiCap: 'AI generated, it does not document the event', tags: 'Topics',
    table: 'Table', pts: 'pts', tgBtn: 'Join the Telegram channel', pros: 'Local pros', inCity: '', crumbs: 'Breadcrumbs',
    spon: 'Sponsored', with: 'In partnership with', disclose: 'This article was published as sponsored content in partnership with the advertiser' },
}[lang];

// ---------- byline ----------
const opinion = a.kind === 'opinion' && !!a.author;
const sponBy = sponsored && !!a.author;
const byName = opinion ? a.author! : sponBy ? `${L.with} ${a.author}` : sponsored ? L.spon : L.desk;
const initials = opinion || sponBy ? a.author!.split(/\s+/).slice(0, 2).map((w) => w[0]).join('') : 'NWS';
const showUpd = !!a.updated && Date.parse(a.updated) - Date.parse(a.published) > 60e3;
const updText = showUpd ? (dayOf(a.updated!) === dayOf(a.published) ? fmtTime(a.updated!) : `${fmtNum(a.updated!)}, ${fmtTime(a.updated!)}`) : '';

// ---------- picture: the story's AI image, or the section photo ----------
const STOCK_ALT: Record<string, string> = {
  'beach-rocks-sail': 'סלעים ומפרש מול חוף הים', 'concert-hands': 'ידיים מורמות בהופעה', 'cranes-sunset': 'עגורנים בשקיעה',
  'police-street': 'ניידת משטרה ברחוב', scaffold: 'פיגומים על בניין', 'stadium-aerial': 'אצטדיון כדורגל ממבט אווירי', 'stadium-crowd': 'קהל ביציע אצטדיון',
  'stadium-day': 'אצטדיון כדורגל ביום', 'traffic-night': 'תנועת מכוניות בלילה',
};
const stockName = pic.stock ? (pic.src.match(/\/img\/stock\/(.+)-1600\.webp$/)?.[1] ?? '') : '';
const picDesc = he ? (pic.ai ? pic.alt : (Object.values(IMG).find((x) => x.name === stockName)?.alt ?? STOCK_ALT[stockName] ?? '')) : '';
const labelOf = (p: typeof pic) => (he ? p.label : p.ai ? 'AI illustration' : lang === 'ru' ? 'Иллюстративное фото' : lang === 'fr' ? 'Photo d’illustration' : 'Illustrative photo');
const picLabel = labelOf(pic);
const picAlt = picDesc || picLabel;

// ---------- body ----------
// News: plain paragraphs (escaped, the first mention of up to 3 places links to its page), exactly as before.
// Sponsored only, a small markup: "## " opens a subheading, lines starting "- " make a list, lines starting "1. " a numbered list,
// "> " a pull quote (optional "| source" at the end), [text](https://...) a link (outside links get rel="sponsored noopener").
// Everything else is escaped; no raw HTML.
type Block = { k: 'p' | 'h2' | 'ul' | 'ol'; html: string } | { k: 'q'; text: string; cite: string };
const escA = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const inl = (x: string) => escA(x).replace(/\[([^\]\n]{1,200})\]\(((?:https?:\/\/|\/)[^\s()<>"]+)\)/g, (_m, t, h) => {
  const ext = /^https?:\/\//.test(h) && !/^https?:\/\/(www\.)?nws\.co\.il(\/|$)/.test(h);
  return `<a href="${h}"${ext ? ' rel="sponsored noopener" target="_blank"' : ''}>${t}</a>`;
});
const sponBlock = (p: string): Block => {
  const lines = p.split(/\n+/).map((x) => x.trim()).filter(Boolean);
  if (/^##\s/.test(p)) return { k: 'h2', html: inl(p.replace(/^##\s*/, '')) };
  if (/^>\s/.test(p)) { const [q, c = ''] = p.replace(/^>\s*/, '').split(/\s*\|\s*/); return { k: 'q', text: q.replace(/^["“״]|["”״]$/g, ''), cite: c }; }
  if (lines.length && lines.every((x) => /^-\s/.test(x))) return { k: 'ul', html: lines.map((x) => `<li>${inl(x.replace(/^-\s*/, ''))}</li>`).join('') };
  if (lines.length && lines.every((x) => /^\d+\.\s/.test(x))) return { k: 'ol', html: lines.map((x) => `<li>${inl(x.replace(/^\d+\.\s*/, ''))}</li>`).join('') };
  return { k: 'p', html: lines.map(inl).join('<br>') };
};
const linked = sponsored ? [] : linkify(a.body, places, lang);
const blocks: Block[] = sponsored ? a.body.map(sponBlock) : a.body.map((_p, i) => ({ k: 'p', html: linked[i] }));

// ---------- related: one inside the text, four in the grid, more from the section in the sidebar ----------
const rel = related(a, pool, 5);
const inline = rel.length > 0 && a.body.length >= 3 && !sponsored ? rel[0] : null;
const grid = (inline ? rel.slice(1) : rel).slice(0, 4);
const usedSlugs = new Set([a.slug, ...rel.map((r) => r.slug)]);
const more = pool.filter((x) => x.section === a.section && !usedSlugs.has(x.slug)).slice(0, 4);
// after the second paragraph (never right after a subheading), or after the last block
const pIdx = blocks.map((b, i) => (b.k === 'p' ? i : -1)).filter((i) => i >= 0);
const alsoAt = inline ? (pIdx[1] ?? blocks.length - 1) + 1 : -1;
const relHead = he ? `עוד מ${s.name.he}${places[0] ? ` ומ${places[0].he}` : ''}` : u.related;

// ---------- "מה הלאה": the story's event or road closure ----------
const fmtWhen = (iso: string) => {
  const d = new Date(iso); if (isNaN(+d)) return iso;
  const date = new Intl.DateTimeFormat(LOC[lang], { timeZone: TZ, weekday: 'long', day: 'numeric', month: 'long' }).format(d);
  return /T\d/.test(iso) && fmtTime(iso) !== '00:00' ? `${date}, ${fmtTime(iso)}` : date;
};
const nextRows: [string, string][] = [];
if (a.event?.startDate) { nextRows.push([L.when, fmtWhen(a.event.startDate)]); if (a.event.location) nextRows.push([L.where, a.event.location]); }
if (a.closure?.place) {
  nextRows.push([L.where, a.closure.place]);
  if (a.closure.what) nextRows.push([L.what, a.closure.what]);
  if (a.closure.until) nextRows.push([L.until, `${a.closure.approx ? L.approx + ' ' : ''}${fmtWhen(a.closure.until)}`]);
}

// ---------- sidebar ----------
type Fl = { at: string; text: string; href: string };
const flashes: Fl[] = [...(he ? FLASHES.map((f) => ({ at: f.at, text: f.text, href: `/flash/#f${f.id}` })) : []),
  ...pool.filter((x) => x.section === 'flash' && x.slug !== a.slug).map((x) => ({ at: x.published, text: x.title, href: articleUrl(x, lang) }))]
  .sort((x, y) => Date.parse(y.at) - Date.parse(x.at));
const flashList = (flashes.length >= 3 ? flashes : [...flashes, ...pool.filter((x) => x.slug !== a.slug && x.section !== 'flash').map((x) => ({ at: x.published, text: x.title, href: articleUrl(x, lang) }))]).slice(0, 5);
const today = dayOf(new Date().toISOString());
const flTime = (iso: string) => (dayOf(iso) === today ? fmtTime(iso) : `${fmtNum(iso).slice(0, 5)} ${fmtTime(iso)}`);
const table = a.section === 'sports' && he ? tableAround(3) : [];
const cats = he ? CATEGORIES.filter((c) => c.sections.includes(a.section)).slice(0, 3) : [];
const tgHref = TG_URL || `${pre}/join/`;
const tgAttr = TG_URL ? { target: '_blank', rel: 'noopener' } : {};

const share = encodeURIComponent(url); const shareT = encodeURIComponent(a.title);
const hasSrc = !!a.sourceName;
---
<Base lang={lang} title={title} description={desc} path={path} alternates={alternates} jsonld={jsonld} crumbs={crumbs} current={a.section}
  ogType="article" ogImage={ogImage} published={a.published} modified={modified} section={s.name[lang]} tags={a.tags} compact progress>
  <div class="n-wrap n-art" style={`--c:${s.ink}`}>
    <div class="n-lay">
      <article aria-labelledby="art-h">
        <nav aria-label={L.crumbs}><ol class="n-crumb">
          <li><a href={pre + '/'}>{u.home}</a></li>
          <li><a href={sectionUrl(a.section, lang)}>{s.name[lang]}</a></li>
        </ol></nav>
        <div class="art-k">{sponsored && <span class="art-spon">{L.spon}</span>}<span class="n-k">{sponsored && kickerOf(a, lang) === L.spon ? s.name[lang] : kickerOf(a, lang)}</span></div>
        <h1 class="n-t" id="art-h">{a.title}</h1>
        {a.dek && <p class="n-dek">{a.dek}</p>}
        <div class="n-by">
          <div class="n-who">
            <div class="n-av" aria-hidden="true">{initials}</div>
            <div>
              {opinion || sponsored ? <b>{byName}{(opinion || sponBy) && a.authorRole && a.authorRole !== L.spon && <span class="art-role">{a.authorRole}</span>}</b> : <a href={`${pre}/about/`}><b>{byName}</b></a>}
              <span class="num">{u.published} <time datetime={a.published}>{fmtNum(a.published)}, {fmtTime(a.published)}</time>{showUpd && <> · <span class="n-upd">{u.updated} <time datetime={a.updated}>{updText}</time></span></>} · {readMin(a)} {L.read}</span>
            </div>
          </div>
          <div class="n-share" aria-label={u.share} role="group">
            <a href={`https://wa.me/?text=${shareT}%20${share}`} aria-label={L.wa} rel="noopener nofollow" target="_blank"><Icon name="whatsapp" size={18} /></a>
            <a href={`https://t.me/share/url?url=${share}&text=${shareT}`} aria-label={L.tg} rel="noopener nofollow" target="_blank"><Icon name="telegram" size={18} /></a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} aria-label={L.fb} rel="noopener nofollow" target="_blank"><Icon name="facebook" size={18} /></a>
            <button type="button" data-copy={url} data-done={L.copied} aria-label={L.copy}><Icon name="link" size={18} /></button>
            <span class="art-sr" role="status" aria-live="polite" data-copy-msg></span>
          </div>
        </div>

        <figure class="n-hero">
          <div class="n-ph"><img src={pic.src} srcset={pic.srcset} sizes={pic.srcset ? '(max-width: 760px) 100vw, (max-width: 1100px) 94vw, 880px' : undefined} alt={picAlt} width={pic.w} height={pic.h} fetchpriority="high" decoding="async"></div>
          <figcaption>{picDesc ? <><span>{picDesc}</span><span class="art-lbl">{pic.ai ? `${picLabel}, ${L.aiCap}` : picLabel}</span></> : <span class="art-lbl">{pic.ai ? `${picLabel}, ${L.aiCap}` : picLabel}</span>}</figcaption>
        </figure>

        {a.keyPoints.length > 0 && <section class="n-brief" aria-labelledby="br-h"><h2 id="br-h">{u.keyPoints}</h2><ul>{a.keyPoints.map((k) => <li>{k}</li>)}</ul></section>}

        <div class="n-body">
          {blocks.map((b, i) => <>
            {b.k === 'p' && <p set:html={b.html}></p>}
            {b.k === 'h2' && <h2 set:html={b.html}></h2>}
            {b.k === 'ul' && <ul set:html={b.html}></ul>}
            {b.k === 'ol' && <ol set:html={b.html}></ol>}
            {b.k === 'q' && <blockquote class="n-q"><p>{b.text}</p>{b.cite && <cite>{b.cite}</cite>}</blockquote>}
            {inline && i === alsoAt - 1 && (
              <a class="n-also" href={articleUrl(inline, lang)}>
                <span class="n-ph" aria-hidden="true"><img src={picOf(inline).small} alt="" width="240" height="160" loading="lazy" decoding="async"></span>
                <span><small>{L.also}</small><b>{inline.title}</b></span>
              </a>)}
          </>)}
          {a.whatItMeans && <><h2>{u.whatItMeans}</h2><p>{a.whatItMeans}</p></>}
          {nextRows.length > 0 && <section class="n-next" aria-labelledby="nx-h"><h3 id="nx-h">{L.next}</h3>{nextRows.map(([k, v]) => <div class="n-nx"><b>{k}</b><span>{v}</span></div>)}</section>}
        </div>

        {a.faq.length > 0 && <section class="n-faq" aria-labelledby="faq-h"><h2 id="faq-h">{u.faq}</h2>{a.faq.map(([q, x]) => <details><summary>{q}</summary><p>{x}</p></details>)}</section>}

        {hasSrc && <div class="n-srcl"><b>{L.sources}</b> {a.sourceUrl ? <a href={a.sourceUrl} rel="noopener nofollow" target="_blank">{a.sourceName}</a> : a.sourceName}. <a href={he ? '/editorial-policy/' : `${pre}/about/`}>{L.how}</a></div>}

        {he && (places.length > 0 || a.tags.length > 0) && <nav class="n-tags" aria-label={L.tags}>
          {places.map((p) => <a href={placeUrl(p.slug)}>{p.he}</a>)}
          {a.tags.filter((tg) => !places.some((p) => p.he === tg)).map((tg) => <a href={`/search/?q=${encodeURIComponent(tg)}`}>{tg}</a>)}
        </nav>}

        {sponsored && <p class="art-disc">{L.disclose}</p>}
        <div class="n-fix"><span>{L.fix}</span><span><a href={`/corrections/?url=${encodeURIComponent(path)}`}>{L.report}</a> · <a href={`${pre}/send-news/`}>{L.send}</a></span></div>
      </article>

      <aside class="n-aside">
        {flashList.length > 0 && <section class="n-box" aria-labelledby="fl-h"><h2 class="bh" id="fl-h"><span class="n-pulse" aria-hidden="true"></span>{flashes.length >= 3 ? u.flash : u.latestNow}</h2>
          <ol class="n-fl num">{flashList.map((f) => <li><time datetime={f.at}>{flTime(f.at)}</time><a href={f.href}>{f.text}</a></li>)}</ol></section>}
        <div class="n-tgc"><b>{u.joinTitle}</b><p>{u.joinText}</p><a class="n-btn tg" href={tgHref} {...tgAttr} data-tg><Icon name="telegram" size={18} color="#fff" />{L.tgBtn}</a></div>
        {table.length > 0 && <section class="n-box" aria-labelledby="tb-h"><h2 class="bh" id="tb-h">{L.table}</h2>
          <ol class="n-fl num">{table.map((r) => <li class={r.me ? 'me' : undefined}>{r.pos}. {r.team} · {r.pts} {L.pts}</li>)}</ol>
          {SPORT.source && <p class="art-src">{SPORT.sourceUrl ? <a href={SPORT.sourceUrl} rel="noopener nofollow" target="_blank">{SPORT.source}</a> : SPORT.source}</p>}</section>}
        {more.length > 0 && <section class="n-box" aria-labelledby="mo-h"><h2 class="bh" id="mo-h" style={`--c:${s.ink}`}><span class="art-bar" aria-hidden="true"></span>{he ? `עוד מ${s.name.he}` : s.name[lang]}</h2>
          <ul class="n-fl">{more.map((m) => <li><a href={articleUrl(m, lang)}>{m.title}</a></li>)}</ul></section>}
        {cats.length > 0 && <section class="n-box" aria-labelledby="ct-h"><h2 class="bh" id="ct-h">{L.pros}</h2>
          <ul class="n-fl art-pros">{cats.map((c) => <li><a href={`/directory/${c.slug}/`}><span class="ic" style={`--c:${c.color}`} aria-hidden="true"><Icon name={c.slug} size={18} /></span>{c.plural} {L.inCity}</a></li>)}</ul></section>}
      </aside>
    </div>

    {grid.length > 0 && <section class="n-rel" aria-labelledby="rel-h">
      <h2 id="rel-h">{relHead}</h2>
      <div class="n-rg">{grid.map((r) => { const rp = picOf(r); return (
        <a href={articleUrl(r, lang)} style={`--c:${SECTION_BY_KEY[r.section].ink}`}>
          <span class="n-ph" aria-hidden="true"><img src={rp.small} alt="" width="800" height="533" loading="lazy" decoding="async"><span class="n-cap">{labelOf(rp)}</span></span>
          <small>{kickerOf(r, lang)}</small><b>{r.title}</b>
        </a>); })}</div>
    </section>}
  </div>
  <script is:inline>(function(){var b=document.querySelector('[data-copy]');if(!b)return;b.addEventListener('click',function(){var u=b.getAttribute('data-copy'),m=document.querySelector('[data-copy-msg]');
function ok(){if(m){m.textContent=b.getAttribute('data-done');setTimeout(function(){m.textContent=''},2500)}b.classList.add('done');setTimeout(function(){b.classList.remove('done')},2500)}
if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(u).then(ok,function(){prompt('',u)})}else{prompt('',u)}})})();</script>
</Base>
