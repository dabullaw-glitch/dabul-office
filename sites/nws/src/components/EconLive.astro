---
// כלכלה וכסף (31.10.2026, Yakir approved): the live market strip (Bank of Israel rate, the official USD and EUR rates, Bitcoin,
// TA-35) from docs nwslive 'markets' (hns-national econ_live, hourly) through hns-feed live.markets, and, on the section page, the
// newest stories by topic (economy / money / invest / crypto, extras.econ). A value that is missing is simply not shown.
import { SERVICES, articleUrl, fmtTime, fmtShort, type Article } from '../lib/content';
interface Props { tabs?: Article[] | null; compact?: boolean }
const { tabs = null, compact = false } = Astro.props;
const M: any = SERVICES.markets || {};
const ilDay = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jerusalem' }).format(d);
const todayIl = ilDay(new Date());
const when = (iso?: string) => (!iso ? '' : ilDay(new Date(iso)) === todayIl ? fmtTime(iso) : fmtShort(iso));
const ymd = (d?: string) => (d && /^\d{4}-\d{2}-\d{2}$/.test(d) ? d.slice(8, 10) + '.' + d.slice(5, 7) : '');
const n = (v: number, d = 2) => Number(v).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (v: number | null | undefined) => (v == null || !isFinite(v) ? '' : `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(2)}%`);
const dir = (v: number | null | undefined) => (v == null || Math.abs(v) < 0.005 ? '' : v > 0 ? 'up' : 'dn');
const cells: { k: string; v: string; sub: string; chg?: string; d?: string }[] = [];
if (M.rate?.value != null) cells.push({ k: 'ריבית בנק ישראל', v: `${n(M.rate.value, 2)}%`, sub: M.rate.date ? `נכון ל-${ymd(M.rate.date)}` : '' });
if (M.usd?.value) cells.push({ k: 'דולר', v: `${n(M.usd.value, 3)} ₪`, sub: M.usd.date ? `שער יציג ${ymd(M.usd.date)}` : 'שער יציג' });
if (M.eur?.value) cells.push({ k: 'אירו', v: `${n(M.eur.value, 3)} ₪`, sub: M.eur.date ? `שער יציג ${ymd(M.eur.date)}` : 'שער יציג' });
if (M.ta35?.value) cells.push({ k: 'מדד ת״א 35', v: n(M.ta35.value, 2), sub: M.ta35.time ? `נכון ל-${when(M.ta35.time)}` : '', chg: pct(M.ta35.chg), d: dir(M.ta35.chg) });
if (M.btc?.usd) cells.push({ k: 'ביטקוין', v: `$${Math.round(M.btc.usd).toLocaleString('en-US')}`, sub: '24 שעות', chg: pct(M.btc.chg24), d: dir(M.btc.chg24) });
const at = M.updatedAt ? when(M.updatedAt) : '';
const TOPICS: [string, string][] = [['economy', 'כלכלה'], ['money', 'כסף'], ['invest', 'השקעות'], ['crypto', 'קריפטו']];
const byTopic = tabs ? TOPICS.map(([k, he]) => ({ k, he, items: tabs.filter((a) => a.extras?.econ === k).slice(0, 6) })).filter((t) => t.items.length > 0) : [];
---
{cells.length > 0 && (
<section class={`ec-live${compact ? ' cmp' : ''}`} aria-label="נתוני שוק">
  <div class="ec-cells num">{cells.map((c) => (
    <div class="ec-c"><span class="k">{c.k}</span><b dir="ltr">{c.v}</b><span class="s">{c.chg && <i class={c.d} dir="ltr">{c.chg}</i>}{c.sub}</span></div>))}</div>
  <p class="ec-src">{at && <>עודכן {at} · </>}מקורות: בנק ישראל (ריבית ושערים יציגים), CoinGecko (ביטקוין), Yahoo Finance (מדד ת״א 35, בעיכוב). הנתונים למידע בלבד ואינם ייעוץ השקעות.</p>
</section>)}
{byTopic.length > 1 && (
<section class="ec-tabs" aria-label="לפי נושא">
  <div class="ec-tl" role="tablist">{byTopic.map((t, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-ect={t.k}>{t.he}</button>)}</div>
  {byTopic.map((t, i) => (
  <ul class="ec-tp num" role="tabpanel" data-ecp={t.k} hidden={i !== 0}>{t.items.map((a) => <li><time datetime={a.published}>{when(a.published)}</time><a href={articleUrl(a)}>{a.title}</a></li>)}</ul>))}
  <script is:inline>
  (function(){var b=document.querySelectorAll('[data-ect]'),p=document.querySelectorAll('[data-ecp]');b.forEach(function(x){x.addEventListener('click',function(){b.forEach(function(y){y.setAttribute('aria-selected',y===x?'true':'false')});p.forEach(function(q){q.hidden=q.dataset.ecp!==x.dataset.ect})})})})();
  </script>
</section>)}
<style is:global>
.ec-live{border:1px solid var(--line);border-top:4px solid #0E7A5A;border-radius:6px;background:#fff;padding:14px 16px 10px;margin:0 0 28px}
.ec-cells{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px 18px}
.ec-c{display:flex;flex-direction:column;gap:2px;min-width:0}
.ec-c .k{font-size:13px;color:var(--mut);font-weight:700}
.ec-c b{font-size:22px;font-weight:800;line-height:1.2;text-align:right;color:var(--ink)}
.ec-c .s{font-size:12.5px;color:var(--mut);display:flex;gap:6px;flex-wrap:wrap}
.ec-c .s i{font-style:normal;font-weight:800}.ec-c .s i.up{color:#0E7A5A}.ec-c .s i.dn{color:#B42318}
.ec-src{margin:10px 0 0;font-size:12px;color:var(--mut);line-height:1.5}
.ec-live.cmp{margin:0}.ec-live.cmp .ec-cells{grid-template-columns:repeat(auto-fit,minmax(130px,1fr))}.ec-live.cmp .ec-c b{font-size:19px}
.ec-tabs{margin:0 0 32px}
.ec-tl{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.ec-tl button{font:inherit;font-weight:700;font-size:15px;min-height:40px;padding:0 16px;border-radius:20px;border:1px solid var(--line);background:#fff;color:var(--ink);cursor:pointer}
.ec-tl button[aria-selected=true]{background:#0E7A5A;border-color:#0E7A5A;color:#fff}
.ec-tp{list-style:none;margin:0;padding:0;border:1px solid var(--line);border-radius:6px;background:#fff}
.ec-tp li{display:grid;grid-template-columns:52px minmax(0,1fr);gap:10px;padding:12px 16px;border-bottom:1px solid var(--line2);align-items:baseline}
.ec-tp li:last-child{border-bottom:0}.ec-tp time{font-size:13px;color:var(--mut)}.ec-tp a{font-weight:700;color:var(--ink);line-height:1.45}
</style>
