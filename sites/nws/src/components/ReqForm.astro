---
// One form component for every inquiry on the site (28.10.2026, business flows). Posts JSON to the Supabase function hns-biz
// ({action:'request'}), which validates, rate limits, saves to hns_requests and notifies Yakir in Telegram (requests.ts).
// Spam protection: hidden field company_fax, minimum fill time, server rate limits (5 an hour per sender and form type) and Cloudflare
// Turnstile (components/Turnstile.astro, loaded only near the form; 29.10.2026). Privacy consent required.
// No payment anywhere: purchase requests are saved and Yakir follows up himself.
import { HNS_API, type Lang } from '../data/site';
import Turnstile from './Turnstile.astro';
import { PLACES } from '../data/places';
interface Props { type: 'contact' | 'advertise' | 'tip' | 'correction' | 'newsletter'; lang?: Lang; id?: string; offer?: string }
const { type, lang = 'he', id = 'rqf', offer = '' } = Astro.props;
const OFFERS: [string, string][] = [['featured', 'קידום במדריך העסקים (עסק מומלץ)'], ['leader', 'מוביל בקטגוריה במדריך'], ['sponsored', 'כתבת תוכן שיווקי'],
  ['tgpost', 'פוסט ממומן בטלגרם'], ['banner', 'באנר באתר'], ['event', 'אירוע מקודם'], ['newsletter', 'חסות לניוזלטר'], ['other', 'משהו אחר']];
const T: Record<string, Record<string, string>> = {
  he: { story: 'מה קרה, איפה ומתי', photo: 'תמונה (לא חובה)', name: 'שם', nameTip: 'שם (לא יפורסם בלי רשותכם)', phone: 'טלפון', phoneTip: 'טלפון לחזרה (לא חובה)', place: 'איפה זה קרה (שכונה, רחוב או יישוב)', tipPriv: 'השם והטלפון לא מתפרסמים ולא עוברים לאף אחד. דיווח מתפרסם רק אחרי שאימתנו אותו ממקור רשמי או ממקור נוסף, ותמונה מתפרסמת רק באישורכם.', email: 'מייל',
    opt: ' (לא חובה)', photoOk: 'אני מאשר/ת לפרסם את התמונה ששלחתי', send: 'שליחה', sending: 'שולחים...', offline: 'אין חיבור. נסו שוב בעוד דקה.', fail: 'השליחה נכשלה, נסו שוב.',
    consentA: 'קראתי את ', privacy: 'מדיניות הפרטיות', consentB: ' ואני מסכים/ה שתשמרו את הפרטים ותחזרו אליי בעניין הפנייה.',
    consentNl: ' ואני מסכים/ה לקבל מכם במייל את הניוזלטר. אפשר להסיר בכל עת.', bigPhoto: 'התמונה גדולה מדי או לא נתמכת. נסו תמונה אחרת.',
    wait: 'בדיקת האבטחה עוד לא הסתיימה. חכו כמה שניות ונסו שוב.' },
  en: { story: 'What happened, where and when', photo: 'Photo (optional)', nameTip: 'Name (not published without your permission)', phoneTip: 'Phone for a callback (optional)', place: 'Where did it happen (neighborhood, street or town)', tipPriv: 'Your name and phone are never published or shared. A report is published only after we confirm it with an official or second source, and a photo only with your permission.', opt: ' (optional)',
    photoOk: 'I allow you to publish the photo I sent', send: 'Send', sending: 'Sending...', offline: 'No connection. Try again in a minute.', fail: 'Sending failed, try again.',
    consentA: 'I have read the ', privacy: 'privacy policy (Hebrew)', consentB: ' and agree that you keep these details to handle my message.', bigPhoto: 'The photo is too big or not supported.', wait: 'The security check is not finished yet. Wait a few seconds and try again.' },
  ru: { story: 'Что случилось, где и когда', photo: 'Фото (необязательно)', nameTip: 'Имя (не публикуется без вашего согласия)', phoneTip: 'Телефон для связи (необязательно)', place: 'Где это произошло (район, улица или населенный пункт)', tipPriv: 'Имя и телефон не публикуются и никому не передаются. Сообщение публикуется только после проверки по официальному или второму источнику, фото только с вашего согласия.', opt: ' (необязательно)',
    photoOk: 'Я разрешаю опубликовать отправленное фото', send: 'Отправить', sending: 'Отправляем...', offline: 'Нет связи. Попробуйте через минуту.', fail: 'Не удалось отправить.',
    consentA: 'Я прочитал(а) ', privacy: 'политику конфиденциальности (на иврите)', consentB: ' и согласен(на) на хранение этих данных для ответа.', bigPhoto: 'Фото слишком большое или не поддерживается.', wait: 'Проверка безопасности ещё идёт. Подождите несколько секунд.' },
  fr: { story: 'Que s’est-il passé, où et quand', photo: 'Photo (facultatif)', nameTip: 'Nom (jamais publié sans votre accord)', phoneTip: 'Téléphone pour vous rappeler (facultatif)', place: 'Où cela s’est passé (quartier, rue ou localité)', tipPriv: 'Votre nom et votre téléphone ne sont jamais publiés ni transmis. Une info est publiée seulement après confirmation par une source officielle ou une deuxième source, et une photo seulement avec votre accord.', opt: ' (facultatif)',
    photoOk: 'J’autorise la publication de la photo envoyée', send: 'Envoyer', sending: 'Envoi...', offline: 'Pas de connexion. Réessayez dans une minute.', fail: 'Envoi impossible.',
    consentA: 'J’ai lu la ', privacy: 'politique de confidentialité (en hébreu)', consentB: ' et j’accepte que ces données soient conservées pour traiter mon message.', bigPhoto: 'Photo trop grande ou non prise en charge.', wait: 'La vérification de sécurité n’est pas terminée. Patientez quelques secondes.' },
};
const t = T[lang] || T.he;
const he = lang === 'he';
const api = HNS_API + '/hns-biz';
const row = 'flex-direction:row;font-weight:400;gap:8px;align-items:flex-start';
---
<form class="f rq" id={id} novalidate data-type={type} data-lang={lang} data-api={api} data-msg={JSON.stringify({ sending: t.sending, offline: t.offline, fail: t.fail, big: t.bigPhoto, wait: t.wait })}>
  <div class="hp" aria-hidden="true"><label>אל תמלאו את השדה הזה<input name="company_fax" tabindex="-1" autocomplete="off"></label></div>
  {type === 'advertise' && <>
    <label>במה אתם מתעניינים<select name="offer" required><option value="">בחרו</option>{OFFERS.map(([v, l]) => <option value={v} selected={v === offer}>{l}</option>)}</select></label>
    <label>שם העסק{t.opt}<input name="business" maxlength="100" autocomplete="organization"></label>
    <label>{t.name}<input name="name" required maxlength="80" autocomplete="name"></label>
    <label>{t.phone}<input name="phone" type="tel" required inputmode="tel" autocomplete="tel" dir="ltr" placeholder="050-0000000"></label>
    <label>{t.email}{t.opt}<input name="email" type="email" dir="ltr" autocomplete="email"></label>
    <label>מה חשוב לכם שנדע{t.opt}<textarea name="message" rows="4" maxlength="3000" placeholder="למשל: איזה עסק, מתי, ומה המטרה"></textarea></label>
  </>}
  {type === 'contact' && <>
    <label>{t.name}{t.opt}<input name="name" maxlength="80" autocomplete="name"></label>
    <label>{t.phone}<input name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" placeholder="050-0000000"></label>
    <label>{t.email}{t.opt}<input name="email" type="email" dir="ltr" autocomplete="email"></label>
    <label>ההודעה<textarea name="message" rows="5" required maxlength="3000"></textarea></label>
    <p class="note" style="margin:0">צריך טלפון או מייל, כדי שנוכל לחזור אליכם.</p>
  </>}
  {type === 'tip' && <>
    <label>{t.story}<textarea name="message" rows="6" required minlength="10" maxlength="3000"></textarea></label>
    <label>{t.place}{t.opt}<input name="place" maxlength="120" list={`${id}-pl`} autocomplete="off"></label>
    <datalist id={`${id}-pl`}>{PLACES.map((p) => <option value={p.kind === 'neighborhood' ? `${p.he}, נתניה` : p.he} />)}</datalist>
    <label>{t.photo}<input name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/*"></label>
    <label>{t.nameTip}<input name="name" maxlength="80" autocomplete="name"></label>
    <label>{t.phoneTip}<input name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr"></label>
    <label style={row}><input type="checkbox" name="photo_ok" value="1"> {t.photoOk}</label>
    <p class="note" style="margin:0">{t.tipPriv}</p>
  </>}
  {type === 'correction' && <>
    <label>הקישור לידיעה<input name="url" type="url" required inputmode="url" dir="ltr" placeholder="https://nws.co.il/..."></label>
    <label>מה לא מדויק, ומה הנוסח הנכון<textarea name="message" rows="5" required maxlength="3000"></textarea></label>
    <label>שם מלא<input name="name" required maxlength="80" autocomplete="name"></label>
    <label>טלפון או מייל לחזרה<input name="reach" required dir="ltr"></label>
  </>}
  {type === 'newsletter' && <>
    <label>{t.email}<input name="email" type="email" required dir="ltr" autocomplete="email"></label>
  </>}
  <label style={row}><input type="checkbox" name="consent" value="1" required> <span>{t.consentA}<a href="/privacy/" target="_blank">{t.privacy}</a>{type === 'newsletter' ? t.consentNl : t.consentB}</span></label>
  <Turnstile lang={lang} />
  <button class="btn pri" type="submit">{t.send}</button>
  <p class="rqmsg" role="status" aria-live="polite" style="font-weight:700;margin:0"></p>
  {he && type !== 'newsletter' && <p class="note" style="margin:0">הפרטים מגיעים רק למערכת האתר ולא מועברים לאחרים. לא נגבה תשלום דרך האתר.</p>}
</form>
<script is:inline>
(function(){
  if (window.__rqInit) return; window.__rqInit = 1;
  function shrink(file){ return new Promise(function(res,rej){
    if(!file||!file.size) return res('');
    if(file.size>25*1024*1024) return rej('big');
    var url=URL.createObjectURL(file), img=new Image();
    img.onload=function(){ var m=1600, w=img.naturalWidth, h=img.naturalHeight, k=Math.min(1,m/Math.max(w,h)); var c=document.createElement('canvas'); c.width=Math.round(w*k); c.height=Math.round(h*k);
      c.getContext('2d').drawImage(img,0,0,c.width,c.height); URL.revokeObjectURL(url); var d=c.toDataURL('image/jpeg',0.82); d.length>8e6?rej('big'):res(d); };
    img.onerror=function(){ URL.revokeObjectURL(url); rej('big'); }; img.src=url; }); }
  function init(f){
    var t0=Date.now(), M=JSON.parse(f.dataset.msg||'{}'), msg=f.querySelector('.rqmsg');
    if(window.nwsTs) window.nwsTs.attach(f);
    try{ var sp=new URLSearchParams(location.search); if(f.elements.offer&&sp.get('offer')) f.elements.offer.value=sp.get('offer');
      if(f.elements.url&&sp.get('url')){ var u=sp.get('url'); f.elements.url.value=u.charAt(0)==='/'?location.origin+u:u; }
      if(f.elements.business&&sp.get('biz')) f.elements.business.value=sp.get('biz'); }catch(e){}
    f.addEventListener('submit',function(ev){
      ev.preventDefault();
      f.querySelectorAll('.ferr').forEach(function(x){x.remove()});
      var d={action:'request',type:f.dataset.type,lang:f.dataset.lang,page:location.pathname,t:Date.now()-t0}, fd=new FormData(f);
      fd.forEach(function(v,k){ if(k==='photo') return; if(k==='cf-turnstile-response'){d.turnstile=v} else {d[k]=String(v).trim()} });
      d.consent=!!(f.elements.consent&&f.elements.consent.checked); if(f.elements.photo_ok) d.photo_ok=f.elements.photo_ok.checked;
      var tk=window.nwsTs?window.nwsTs.token(f):null; if(tk==='' ){ msg.style.color='#C8102E'; msg.textContent=M.wait; return; } if(tk) d.turnstile=tk;
      var btn=f.querySelector('button[type=submit]'); btn.disabled=true; msg.style.color=''; msg.textContent=M.sending;
      var file=f.elements.photo&&f.elements.photo.files&&f.elements.photo.files[0];
      shrink(file).then(function(p){ if(p) d.photo=p;
        return fetch(f.dataset.api,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(d)}).then(function(r){return r.json()});
      }).then(function(j){
        btn.disabled=false;
        if(j.ok){ msg.style.color='#1E8A4C'; msg.textContent=j.message||'✓'; f.reset(); t0=Date.now(); if(window.nwsTs) window.nwsTs.reset(f); if(window.nwsTrack) try{window.nwsTrack('generate_lead',{form:f.dataset.type})}catch(e){} return; }
        if(window.nwsTs) window.nwsTs.reset(f);
        msg.style.color='#C8102E'; msg.textContent=j.error||M.fail;
        if(j.fields){ Object.keys(j.fields).forEach(function(k){ var el=f.elements[k]; if(!el) return; if(el.length&&!el.tagName) el=el[0]; var s=document.createElement('span'); s.className='ferr note'; s.style.color='#C8102E'; s.textContent=j.fields[k]; (el.closest('label')||el.parentNode).appendChild(s); }); }
      }).catch(function(e){ btn.disabled=false; if(window.nwsTs) window.nwsTs.reset(f); msg.style.color='#C8102E'; msg.textContent=e==='big'?M.big:M.offline; });
    });
  }
  function all(){ document.querySelectorAll('form.rq').forEach(init); }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',all); else all();
})();
</script>
