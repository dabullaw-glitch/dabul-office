---
// Story card (design kit 28.10.2026): photo (the story's own image labelled "תמונה להמחשה", or a section photo labelled
// "צילום אילוסטרציה"), the section color line, the title, an optional summary, and the meta line (desk, time, reading time).
// row: the small-photo row of lists and phones. The whole title is the link; the photo link is hidden from screen readers.
import { type Lang } from '../data/site';
import { SECTION_BY_KEY } from '../data/sections';
import { articleUrl, picOf, picLabel, kickerOf, readMin, fmtDay, type Article } from '../lib/content';
interface Props { a: Article; lang?: Lang; h?: 'h2' | 'h3'; eager?: boolean; read?: boolean; dek?: boolean; ratio?: string; sizes?: string; row?: boolean; size?: number }
const { a, lang = 'he', h = 'h3', eager = false, read = false, dek = false, ratio = '3/2', sizes = '(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 420px', row = false, size } = Astro.props;
const s = SECTION_BY_KEY[a.section];
const p = picOf(a);
const H = h;
const he = lang === 'he';
const flash = a.section === 'flash';
const href = articleUrl(a, lang);
const label = picLabel(p, lang);
const spon = a.kind === 'sponsored';
const by = a.kind === 'opinion' && a.author ? a.author : spon ? (a.author || (he ? 'תוכן שיווקי' : 'Sponsored')) : he ? 'מערכת NWS' : 'NWS';
---
{row ? (
<a class="n-row" href={href} style={`--c:${s.color}`}>
  <span><span class="n-k">{kickerOf(a, lang)}</span><b>{a.title}</b><small class="num">{spon ? <span class="n-spon">{he ? 'תוכן שיווקי' : 'Sponsored'}</span> : <time datetime={a.published} data-ago>{fmtDay(a.published, lang)}</time>}</small></span>
  <span class="n-ph" aria-hidden="true"><img src={p.thumb || p.small} alt="" width="224" height="152" loading={eager ? 'eager' : 'lazy'} decoding="async"></span>
</a>
) : (
<article class="n-card" style={`--c:${s.color}`}>
  <a class="n-ph" href={href} tabindex="-1" aria-hidden="true" style={`aspect-ratio:${ratio}`}>
    <img src={p.src} srcset={p.srcset} sizes={p.srcset ? sizes : undefined} alt="" width={p.w} height={p.h} loading={eager ? 'eager' : 'lazy'} decoding="async">
    {a.live ? <span class="n-badge"><i></i>{he ? 'מתעדכן' : 'Live'}</span> : flash && <span class="n-badge"><i></i>{he ? 'מבזק' : 'Breaking'}</span>}
    {a.video && <span class="n-play" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="#0D1321"/></svg></span>}
    <span class="n-cap">{label}</span>
  </a>
  <div class="k"><span class="n-k">{kickerOf(a, lang)}</span></div>
  <a class="t" href={href}><H style={size ? `font-size:${size}px` : undefined}>{a.title}</H></a>
  {dek && a.dek && <p>{a.dek}</p>}
  <div class="n-meta num">{spon ? <><span class="n-spon">{he ? 'תוכן שיווקי' : 'Sponsored'}</span>{a.author && <><i aria-hidden="true"></i><b>{a.author}</b></>}</> : <><b>{by}</b><i aria-hidden="true"></i><time datetime={a.published} data-ago class={flash ? 'n-upd' : undefined}>{fmtDay(a.published, lang)}</time></>}{read && <><i aria-hidden="true"></i><span>{readMin(a)} {he ? 'דק׳ קריאה' : 'min read'}</span></>}</div>
</article>
)}
