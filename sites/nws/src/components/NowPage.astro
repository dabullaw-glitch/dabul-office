---
// Frame of the "נתניה עכשיו" pages (redesign 28.10.2026): the photo band of the listing pages, the tabs of the "now" pages,
// the page content (the older content cards, restyled in list.css) and the questions and answers.
import Base from '../layouts/Base.astro';
import ListHero from './list/ListHero.astro';
import NowNav from './NowNav.astro';
import '../styles/list.css';
import { SITE_URL, IMG } from '../data/site';
interface Props { title: string; h1: string; description: string; path: string; intro: string; color?: string; img?: string; icon?: string; faq?: [string, string][]; jsonld?: any[] }
const { title, h1, description, path, intro, color = '#0D1321', img = 'city', icon, faq = [], jsonld = [] } = Astro.props;
const crumbs = [{ name: 'ראשי', href: '/' }, { name: 'נתניה עכשיו', href: '/now/' }, { name: h1, href: path }];
const ld = [...jsonld, { '@context': 'https://schema.org', '@type': 'WebPage', name: h1, url: SITE_URL + path, description, inLanguage: 'he', about: { '@type': 'City', name: 'נתניה' }, isPartOf: { '@id': SITE_URL + '/#website' } }];
if (faq.length) ld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) });
const photo = (IMG[img] || IMG.city).name;
---
<Base title={title} description={description} path={path} crumbs={crumbs} jsonld={ld} current="now" ogImage={`/img/stock/og/${photo}.jpg`}>
  <div class="nl-page">
  <ListHero crumbs={crumbs} h1={h1} intro={intro} color={color} photo={photo} icon={icon} />
  <div class="n-wrap nl-np">
    <NowNav />
    <slot />
    {faq.length > 0 && <section class="ncard faq" style="--c:#0D1321;margin-top:18px"><h2>שאלות ותשובות</h2>{faq.map(([q, a]) => <details open><summary>{q}</summary><p>{a}</p></details>)}</section>}
  </div>
  </div>
</Base>
