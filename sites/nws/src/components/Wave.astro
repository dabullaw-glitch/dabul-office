---
interface Props { top?: boolean; from?: string; to?: string }
const { top = true, from = '#FFFFFF', to = '#0B3D6E' } = Astro.props;
---
{top
  ? <svg class="wave" viewBox="0 0 1440 36" preserveAspectRatio="none" aria-hidden="true" style={`background:${from}`}><path d="M0 36V18c120-18 240 18 360 0s240-18 360 0 240 18 360 0 240-18 360 0v18z" fill={to}/></svg>
  : <svg class="wave" viewBox="0 0 1440 36" preserveAspectRatio="none" aria-hidden="true" style={`background:${from}`}><path d="M0 0v18c120 18 240-18 360 0s240 18 360 0 240-18 360 0 240 18 360 0V0z" fill={to}/></svg>}
