---
// Home page (redesign approved by Yakir 28.10.2026, Main.dc.html and Mobile.dc.html). Every block shows real data only and
// disappears when it has none: stories from the engine (hns-feed), official flashes, IMS weather and sea, Shabbat times computed
// from the sun, road closures from published stories, the Ligat HaAl table and next Maccabi Netanya game (sport5, scripts/sport.mjs),
// the events calendar of the city's culture hall, and the business directory.
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import Icon from './Icon.astro';
import { BRAND, SITE_URL, LANG_PREFIX, LANGS, TG_URL, SAME_AS, type Lang } from '../data/site';
import { SECTION_BY_KEY, type SectionKey } from '../data/sections';
import { CATEGORIES } from '../data/directory';
import { t } from '../i18n/ui';
import { articlesFor, articleUrl, sectionUrl, fmtTime, fmtShort, fmtDay, FACTS, EVENT, IMS, SPORT, FLASHES, CALENDAR, calTime, calVenue, leadOf, readMin, kickerOf, picOf, stockPic, stockFor, tableAround, type Article } from '../lib/content';
import { LISTINGS, countBy } from '../lib/biz';
import { shabbatTimes } from '../lib/shabbat';

interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang); const pre = LANG_PREFIX[lang]; const he = lang === 'he';
const all0 = articlesFor(lang);
// sponsored stories never lead, never enter the feed or the lists; at most one appears in its own slot below the directory
const all = all0.filter((a) => a.kind !== 'sponsored');
const spon = he ? all0.find((a) => a.kind === 'sponsored') : undefined;
const S = (k: string) => SECTION_BY_KEY[k as SectionKey];
const ev = he ? EVENT : null;
const used = new Set<string>();
const take = (list: Article[], n: number) => { const out = list.filter((a) => !used.has(a.slug)).slice(0, n); out.forEach((a) => used.add(a.slug)); return out; };
const ilDay = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jerusalem' }).format(d);
const todayIl = ilDay(new Date());
const when = (iso: string) => (ilDay(new Date(iso)) === todayIl ? fmtTime(iso) : fmtShort(iso));
const hot = (iso: string) => Date.now() - Date.parse(iso) < 2 * 3600e3;

// 1. the top: lead, two cards, three headlines (flash items go to the live feed)
const lead = leadOf(all, ev);
if (lead) used.add(lead.slug);
const news = all.filter((a) => a.section !== 'flash');
const duo = take(news, 2);
const tlist = take(news, 3);
// 2. the live feed: official flashes and the newest stories, by time
type Feed = { at: string; text: string; href: string; src?: string };
const feed: Feed[] = [...(he ? FLASHES.map((f) => ({ at: f.at, text: f.text, href: `/flash/#f${f.id}`, src: f.source })) : []),
  ...all.slice(0, 12).map((a) => ({ at: a.published, text: a.title, href: articleUrl(a, lang) }))]
  .sort((x, y) => Date.parse(y.at) - Date.parse(x.at)).filter((x, i, arr) => arr.findIndex((y) => y.text === x.text) === i).slice(0, 7);
const moreList = take(news, 5);
// 3. services (only with real data)
const wxDay = IMS?.day && IMS.day.date === todayIl ? IMS.day : null;
const sea = IMS?.sea || null;
const seaWord = (m: number) => (m <= 0.5 ? 'ים שקט' : m <= 1 ? 'נוח לרחצה' : m <= 1.6 ? 'ים גלי' : m <= 2.5 ? 'ים גבוה' : 'ים סוער');
const sh = shabbatTimes(new Date(), 1)[0];
const closures = all.filter((a) => a.closure && (a.closure.until ? a.closure.until >= todayIl : Date.now() - Date.parse(a.published) < 3 * 864e5));
const hotline = FACTS?.hotline?.number ?? '106';
// 4. three section columns: police; city and transport; community and health (or other sections with stories)
const groups: { keys: SectionKey[]; title: string }[] = [
  { keys: ['police'], title: 'משטרה ופלילים' }, { keys: ['city', 'transport'], title: 'העירייה ותחבורה' }, { keys: ['community', 'health'], title: 'קהילה ובריאות' },
  { keys: ['sharon'], title: 'השרון' }, { keys: ['tourism'], title: 'חופים ותיירות' }, { keys: ['law'], title: 'חוק ומשפט' }, { keys: ['realestate'], title: 'נדל״ן ותכנון' }];
const sportsAll = all.filter((a) => a.section === 'sports');
const reAll = all.filter((a) => a.section === 'realestate');
const cols = groups.map((g) => ({ ...g, items: all.filter((a) => g.keys.includes(a.section) && !used.has(a.slug) && !(g.keys.length === 1 && g.keys[0] === 'realestate' && reAll.length > 1)) }))
  .filter((g) => g.items.length > 0).slice(0, he ? 3 : 0);
cols.forEach((g) => g.items.slice(0, 4).forEach((a) => used.add(a.slug)));
// 5. sport: stories and the league data
const sports = take(sportsAll, 5);
// video slot: only stories that carry a real video
const videos = he ? all.filter((a) => a.video && !used.has(a.slug)).slice(0, 4) : [];
const tbl = tableAround(5);
const played = SPORT.table.find((r) => r.me)?.played;
const nx = SPORT.next;
const nxDay = nx ? new Intl.DateTimeFormat('he-IL', { timeZone: 'Asia/Jerusalem', weekday: 'long', day: 'numeric', month: 'numeric' }).format(new Date(nx.iso)) : '';
const showSport = he && (sports.length > 0 || tbl.length > 0 || !!nx);
const initials = (n: string) => n.replace(/״/g, '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('.');
// 6. real estate
const re = take(reAll, 6);
// 7. directory
const cats = CATEGORIES.slice(0, 9);
// 8. culture: stories of the section and the next events of the official calendar
const leisAll = all.filter((a) => a.section === 'leisure');
const leis = take(leisAll, 2);
const cal = he ? CALENDAR.slice(0, 4 - leis.length) : [];
if (leis.length + cal.length < 4) leis.push(...take(leisAll, 4 - leis.length - cal.length));
const mon = (iso: string) => new Intl.DateTimeFormat('he-IL', { timeZone: 'Asia/Jerusalem', month: 'short' }).format(new Date(iso));
const dayN = (iso: string) => new Intl.DateTimeFormat('he-IL', { timeZone: 'Asia/Jerusalem', day: 'numeric' }).format(new Date(iso));

const titles = {
  he: 'חדשות נתניה והשרון: מבזקים, עירייה, נדל״ן ומדריך עסקים',
  ru: 'NWS Новости Нетании и Шарона: срочные новости, мэрия, недвижимость',
  fr: 'NWS Actualités de Netanya et du Sharon : flashs, mairie, immobilier',
  en: 'NWS Netanya & Sharon News: breaking news, city hall, real estate',
}[lang];
const descs = {
  he: 'חדשות נתניה והשרון בזמן אמת: מבזקים, חסימות, עירייה, משטרה, נדל״ן והתחדשות עירונית, מכבי נתניה, אירועים, מזג אוויר ומדריך בעלי מקצוע בנתניה.',
  ru: 'Новости Нетании и Шарона: срочные сообщения, перекрытия дорог, мэрия, недвижимость, спорт и события, полезные данные и справочник мастеров.',
  fr: 'Actualités de Netanya et du Sharon : flashs, routes, mairie, immobilier, sport et sorties, données pratiques et annuaire des artisans.',
  en: 'Netanya and Sharon news: breaking updates, road closures, city hall, real estate, sports and events, live local data and a directory of local pros.',
}[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, LANG_PREFIX[l] + '/'])) as Record<Lang, string>;
const orgId = SITE_URL + '/#org';
const latest = [lead, ...duo, ...tlist].filter(Boolean) as Article[];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', '@id': orgId, name: BRAND.he, alternateName: ['NWS', 'חדשות נתניה והשרון'], url: SITE_URL + '/', logo: { '@type': 'ImageObject', url: SITE_URL + '/logo.png', width: 512, height: 512 },
    foundingDate: BRAND.foundingDate, areaServed: [{ '@type': 'City', name: 'נתניה' }, { '@type': 'Place', name: 'השרון' }], ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
    publishingPrinciples: SITE_URL + '/editorial-policy/', correctionsPolicy: SITE_URL + '/corrections/', ethicsPolicy: SITE_URL + '/editorial-policy/', actionableFeedbackPolicy: SITE_URL + '/corrections/',
    masthead: SITE_URL + '/about/', diversityPolicy: SITE_URL + '/about/', noBylinesPolicy: SITE_URL + '/editorial-policy/' },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE_URL + '/#website', url: SITE_URL + '/', name: BRAND.he, inLanguage: ['he', 'ru', 'fr', 'en'], publisher: { '@id': orgId },
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: SITE_URL + '/search/?q={search_term_string}' }, 'query-input': 'required name=search_term_string' } },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: he ? 'החדשות האחרונות בנתניה' : titles, itemListElement: latest.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE_URL + articleUrl(a, lang), name: a.title })) },
];
const leadPic = lead ? picOf(lead) : null;
const tgHref = TG_URL || `${pre}/join/`;
const tgAttr = TG_URL ? { target: '_blank', rel: 'noopener' } : {};
const T = he ? { live: 'עכשיו בנתניה והשרון', liveSub: 'מתעדכן כל הזמן', allFlash: 'לכל המבזקים ←', more: 'עוד ידיעות', toAll: 'לכל הידיעות ←', by: 'מערכת NWS', min: 'דק׳ קריאה' }
  : { live: u.latestNow, liveSub: '', allFlash: u.allFlash + ' →', more: u.more, toAll: u.toSection + ' →', by: 'NWS', min: 'min' };
---
<Base lang={lang} title={titles} description={descs} path={pre + '/'} alternates={alternates} jsonld={jsonld} current="home" ogImage={lead?.og}>
  <h1 class="sr">{he ? 'חדשות נתניה והשרון' : u.brandName}</h1>
  <div class="n-wrap" data-latest={he ? JSON.stringify(all.slice(0, 30).map((a) => articleUrl(a))) : undefined}>
    <section class="n-top" aria-label={he ? 'הידיעות המרכזיות' : 'Top stories'}>
      <div>
        {lead && leadPic && (
        <article class="n-lead" style={`--c:${S(lead.section).color}`}>
          <a class="n-ph" href={articleUrl(lead, lang)} tabindex="-1" aria-hidden="true"><img src={leadPic.src} srcset={leadPic.srcset} sizes="(max-width: 760px) 100vw, (max-width: 1100px) 100vw, 880px" alt="" width={leadPic.w} height={leadPic.h} fetchpriority="high" decoding="async"><span class="n-cap">{he ? leadPic.label : ''}</span></a>
          <div class="tx">
            <div style="margin-top:20px"><span class="n-k">{kickerOf(lead, lang)}</span></div>
            <h2><a href={articleUrl(lead, lang)}>{lead.title}</a></h2>
            {lead.dek && <p>{lead.dek}</p>}
            <div class="n-meta num"><b>{T.by}</b><i aria-hidden="true"></i>{lead.updated && lead.updated !== lead.published ? <span class="n-upd">{he ? 'עודכן ' : ''}<time datetime={lead.updated} data-ago>{when(lead.updated)}</time></span> : <time datetime={lead.published} data-ago>{fmtDay(lead.published, lang)}</time>}<i aria-hidden="true"></i><span>{readMin(lead)} {T.min}</span></div>
          </div>
        </article>)}
        {duo.length > 0 && <div class="n-duo">{duo.map((a) => <Card a={a} lang={lang} dek eager />)}</div>}
        {tlist.length > 0 && <div class="n-tlist">{tlist.map((a) => <a href={articleUrl(a, lang)} style={`--c:${S(a.section).color}`}><span class="n-k">{kickerOf(a, lang)}</span><b>{a.title}</b></a>)}</div>}
      </div>
      <aside>
        <section class="n-live" aria-labelledby="live-h">
          <div class="lh"><h2 id="live-h"><span class="n-pulse" aria-hidden="true"></span>{T.live}</h2>{T.liveSub && <span>{T.liveSub}</span>}</div>
          <ol class="n-feed num">{feed.map((f) => <li class={hot(f.at) ? 'hot' : undefined}><time datetime={f.at}>{ilDay(new Date(f.at)) === todayIl ? fmtTime(f.at) : `${fmtShort(f.at)} ${fmtTime(f.at)}`}</time><a href={f.href}>{f.src && <small>{f.src}: </small>}{f.text}</a></li>)}</ol>
          <a class="n-lf" href={sectionUrl('flash', lang)}>{T.allFlash}</a>
        </section>
        {moreList.length > 0 && (
        <section class="n-mr" aria-labelledby="mr-h">
          <h2 class="n-sh" id="mr-h" style="font-size:19px">{T.more}</h2>
          <ol class="n-mrl">{moreList.map((a, i) => <li><span class="n" aria-hidden="true">{i + 1}</span><a href={articleUrl(a, lang)}>{a.title}</a></li>)}</ol>
        </section>)}
      </aside>
    </section>
  </div>

  {he && (
  <section class="n-svc" aria-label="שירותים"><div class="n-wrap">
    {wxDay && wxDay.max !== null && <a class="n-sv" href="/now/"><span class="ic"><Icon name={wxDay.code && [1140, 1020, 1510, 1540, 1560].includes(wxDay.code) ? 'rain' : wxDay.code && [1220, 1230, 1530, 1160].includes(wxDay.code) ? 'cloud' : 'sun'} /></span><div><small>מזג אוויר בנתניה</small><b class="num">{wxDay.max}° / {wxDay.min}°</b><span>{wxDay.desc || 'השירות המטאורולוגי'}</span></div></a>}
    {sea && <a class="n-sv" href="/now/beaches/"><span class="ic"><Icon name="wave" /></span><div><small>מצב הים</small><b>{seaWord(sea.waveMax)}</b><span class="num">גלים {sea.waveMin.toFixed(1)} עד {sea.waveMax.toFixed(1)} מ׳{sea.temp ? `, מים ${sea.temp}°` : ''}</span></div></a>}
    <a class="n-sv" href="/now/shabbat/"><span class="ic"><Icon name="candle" /></span><div><small>שבת בנתניה</small><b class="num">{sh.candles} · {sh.end}</b><span>כניסה ויציאה, {sh.date}</span></div></a>
    <a class="n-sv" href="/now/pharmacy/"><span class="ic"><Icon name="plus" /></span><div><small>בית מרקחת תורן</small><b>לפי המוקד העירוני</b><span class="num">חיוג {hotline}</span></div></a>
    <a class="n-sv" href="/now/roads/"><span class="ic"><Icon name="road" /></span><div><small>כבישים</small><b class="num">{closures.length ? `${closures.length} ${closures.length === 1 ? 'חסימה פעילה' : 'חסימות פעילות'}` : 'אין חסימות שפורסמו'}</b><span>{closures.length ? closures.slice(0, 2).map((a) => a.closure!.place).join(', ') : 'לפי הידיעות באתר'}</span></div></a>
    <a class="n-sv" href="/now/phones/"><span class="ic"><Icon name="phone" /></span><div><small>מספרים חשובים</small><b class="num">{hotline} · 100 · 101</b><span>עירייה, משטרה, מד״א</span></div></a>
  </div></section>)}

  {cols.length > 0 && (
  <section class="n-sec n-wrap" aria-label="מדורים">
    <div class="n-tri">{cols.map((g) => { const first = g.items[0]; const k = first.section; return (
      <div style={`--c:${S(g.keys[0]).color}`}>
        <h2 class="n-sh">{g.title}<a href={sectionUrl(k, lang)}>{T.toAll}</a></h2>
        <Card a={first} lang={lang} ratio="16/10" />
        {g.items.length > 1 && <ul class="n-hl num">{g.items.slice(1, 4).map((a) => <li><time datetime={a.published}>{when(a.published)}</time><a href={articleUrl(a, lang)}>{a.title}</a></li>)}</ul>}
      </div>); })}</div>
  </section>)}

  {videos.length > 0 && (
  <section class="n-sec n-wrap" aria-labelledby="vd-h" style="--c:#C8102E">
    <h2 class="n-sh" id="vd-h">וידאו מנתניה והשרון</h2>
    <div class="n-grid n-g4">{videos.map((a) => <Card a={a} lang={lang} ratio="16/9" />)}</div>
  </section>)}

  {showSport && (
  <section class="n-sport" aria-labelledby="sp-h">
    <div class="bg" aria-hidden="true"><img src="/img/stock/stadium-night-1600.webp" alt="" width="1600" height="1067" loading="lazy" decoding="async"></div><div class="shade" aria-hidden="true"></div>
    <div class="n-wrap">
      <h2 class="n-sh" id="sp-h" style="--c:#5BD08A">ספורט<a href={sectionUrl('sports')}>לכל ידיעות הספורט ←</a></h2>
      <div class={`n-sg${sports.length === 0 ? " only" : sports.length === 1 ? " one" : ""}`}>
        {sports[0] ? (() => { const p = picOf(sports[0]); return (
        <article class="n-sl">
          <a class="n-ph" href={articleUrl(sports[0])} tabindex="-1" aria-hidden="true" style="aspect-ratio:16/10"><img src={p.src} srcset={p.srcset} sizes="(max-width: 1100px) 100vw, 520px" alt="" width={p.w} height={p.h} loading="lazy" decoding="async"><span class="n-cap">{p.label}</span></a>
          <div style="margin-top:16px"><span class="n-k" style="--c:#5BD08A">{kickerOf(sports[0])}</span></div>
          <h3><a href={articleUrl(sports[0])}>{sports[0].title}</a></h3>
          {sports[0].dek && <p>{sports[0].dek}</p>}
        </article>); })() : null}
        {sports.length > 1 && <ul class="n-sll">{sports.slice(1).map((a) => <li><small>{a.kicker || 'מכבי נתניה'}</small><a href={articleUrl(a)}>{a.title}</a></li>)}</ul>}
        <div class="n-sd">
          {nx && (
          <div class="n-fx">
            <div class="h"><span>המשחק הבא</span><span>{SPORT.league}{nx.round ? `, מחזור ${nx.round}` : ''}</span></div>
            <div class="m">
              <div><div class="n-crest me" aria-hidden="true">מ.נ</div><div class="t">מכבי נתניה</div></div>
              <div class="vs">נגד</div>
              <div><div class="n-crest" aria-hidden="true">{initials(nx.opponent)}</div><div class="t">{nx.opponent}</div></div>
            </div>
            <div class="when num"><span>{nx.home ? `משחק בית${nx.venue ? `, ${nx.venue}` : ''}` : 'משחק חוץ'}</span><span>{nxDay}{nx.time ? `, ${nx.time}` : ''}</span></div>
            {SPORT.last && <div class="lr num">במשחק הקודם: {SPORT.last.my}:{SPORT.last.their} {SPORT.last.home ? 'מול' : 'אצל'} {SPORT.last.opponent}</div>}
          </div>)}
          {tbl.length > 0 && (
          <div class="n-fx">
            <div class="h"><span>טבלת {SPORT.league}</span><span>{played ? `אחרי ${played} מחזורים` : ''}</span></div>
            <table class="n-tbl num"><caption class="sr">מכבי נתניה בטבלת ליגת העל</caption><thead><tr><th scope="col">#</th><th scope="col">קבוצה</th><th scope="col" class="c">מש׳</th><th scope="col" class="pts">נק׳</th></tr></thead>
              <tbody>{tbl.map((r) => <tr class={r.me ? 'me' : undefined}><td class="p">{r.pos}</td><td>{r.team}</td><td class="c">{r.played}</td><td class="pts">{r.pts}</td></tr>)}</tbody></table>
          </div>)}
          {(tbl.length > 0 || nx) && <p class="n-src">נתוני הליגה: <a href={SPORT.sourceUrl} rel="noopener nofollow" target="_blank">{SPORT.source}</a>{SPORT.notes.length > 0 && <>. {SPORT.notes.join('. ')}.</>}</p>}
        </div>
      </div>
    </div>
  </section>)}

  {he && re.length > 0 && (
  <section class="n-sec n-wrap" aria-labelledby="re-h" style="--c:#B86E00">
    <h2 class="n-sh" id="re-h">נדל״ן ותכנון<a href={sectionUrl('realestate')}>לכל ידיעות הנדל״ן ←</a></h2>
    <div class="n-re">
      <Card a={re[0]} ratio="16/9" dek size={28} sizes="(max-width: 1100px) 100vw, 700px" />
      <div class="n-box">
        <div class="h">עוד מנדל״ן ותכנון בנתניה<span>מהידיעות באתר</span></div>
        {re.slice(1).map((a) => <a class="pr" href={articleUrl(a)}><div><b>{a.title}</b><span class="num">{fmtDay(a.published)}</span></div><span class="n-st">{a.kicker ? a.kicker.split(' ').slice(0, 2).join(' ') : 'תכנון'}</span></a>)}
        <a class="n-lf" href="https://mavat.iplan.gov.il/" rel="noopener nofollow" target="_blank">חיפוש תוכניות באתר מנהל התכנון ←</a>
      </div>
    </div>
  </section>)}

  <section class="n-dir" aria-labelledby="dir-h"><div class="n-wrap n-sec">
    <h2 class="n-sh" id="dir-h">{he ? 'בעלי מקצוע בנתניה והשרון' : u.proTitle}<a href={`${pre}/directory/`}>{he ? 'לכל המדריך ←' : u.toDirectory}</a></h2>
    <div class="n-dg">
      {cats.map((c) => <a class="n-dc" href={he ? `/directory/${c.slug}/` : `${pre}/directory/`} style={`--c:${c.color};--t:${c.color}1A`}><span class="ic"><Icon name={c.slug} size={22} /></span><span><b>{he ? c.plural : c.name[lang]}</b><span>{countBy[c.slug] ? `${countBy[c.slug]} ${countBy[c.slug] === 1 ? 'עסק' : 'עסקים'} במדריך` : 'נתניה והסביבה'}</span></span></a>)}
      <a class="n-dc" href={`${pre}/directory/`} style="--c:#0D1321;--t:#EEF0F4"><span class="ic"><Icon name="list" size={22} /></span><span><b>{he ? `כל ${CATEGORIES.length} הקטגוריות` : u.toDirectory}</b><span>{he ? 'מוסכים, גננים, וטרינרים ועוד' : ''}</span></span></a>
    </div>
    {he && <div class="n-dcta"><div><b>יש לכם עסק בנתניה או בשרון?</b><span>רישום בסיסי במדריך בלי עלות. הטקסט נכתב בשבילכם, והעסק עולה אחרי בדיקה.</span></div><a class="n-btn wh" href="/directory/join/">הוסיפו את העסק</a></div>}
  </div></section>

  {spon && (
  <section class="n-sec n-wrap n-sponsor" aria-labelledby="sp2-h" style="padding-block:32px 0">
    <h2 class="n-sh" id="sp2-h" style="--c:#8A6A00;font-size:17px">תוכן שיווקי</h2>
    <div class="n-grid n-g2" style="max-width:860px"><Card a={spon} lang={lang} dek ratio="16/9" /></div>
  </section>)}

  {(leis.length > 0 || cal.length > 0) && (
  <section class="n-sec n-wrap" aria-labelledby="cu-h" style="--c:#B4286B">
    <h2 class="n-sh" id="cu-h">תרבות ובילוי<a href="/events/#cal">כל האירועים ←</a></h2>
    <div class="n-cult">
      {leis.map((a) => { const p = picOf(a); return <a class="n-ph" href={articleUrl(a)}><img src={p.small} alt="" width="800" height="533" loading="lazy" decoding="async"><span class="n-ov"><span class="n-k" style="--c:#FF9DC6">{kickerOf(a)}</span><b>{a.title}</b><small class="num">{fmtDay(a.published)}</small></span></a>; })}
      {cal.map((c) => { const p = stockPic(stockFor('leisure', c.id)); return <a class="n-ph" href={c.url || '/events/#cal'} {...(c.url ? { target: '_blank', rel: 'noopener nofollow' } : {})}><img src={p.small} alt="" width="800" height="533" loading="lazy" decoding="async"><span class="n-date num" aria-hidden="true"><b>{dayN(c.start)}</b><span>{mon(c.start)}</span></span><span class="n-ov"><span class="n-k" style="--c:#FFD66B">{calTime(c.start) ? `${dayN(c.start)} ב${mon(c.start)}, ${calTime(c.start)}` : `${dayN(c.start)} ב${mon(c.start)}`}</span><b>{c.title}</b>{calVenue(c) && <small>{calVenue(c)}</small>}</span></a>; })}
    </div>
  </section>)}

  <section class="n-join" aria-labelledby="join-h"><div class="n-wrap">
    <div><h2 id="join-h">{u.joinTitle}</h2><p>{he ? 'כל ידיעה ברגע שהיא קורית: חסימות, תאונות, הודעות העירייה וספורט. בלי ספאם, יוצאים בלחיצה.' : u.joinText}</p></div>
    <div class="n-jb">
      <a class="n-btn tg" href={tgHref} {...tgAttr} data-tg><Icon name="telegram" size={18} color="#fff" />{he ? 'ערוץ הטלגרם' : 'Telegram'}</a>
      <a class="n-btn wa" href={`${pre}/join/#whatsapp`}><Icon name="whatsapp" size={18} color="#fff" />{he ? 'ערוץ הוואטסאפ' : 'WhatsApp'}</a>
      <a class="n-btn gh" href={`${pre}/join/#alerts`}>{he ? 'התראות בדפדפן' : u.alerts}</a>
    </div>
  </div></section>
</Base>
