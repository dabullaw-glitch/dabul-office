---
// Home page (redesign approved by Yakir 28.10.2026, sketch Main.dc.html / Phone.dc.html):
// split lead, a row of 4 cards, "נתניה עכשיו" live data, a dark block (active event or the biggest story cluster),
// then the blocks that existed: real estate, section columns, what's on, local pros, join, footer.
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import { IMG, BRAND, SITE_URL, LANG_PREFIX, LANGS, TG_URL, SAME_AS, type Lang } from '../data/site';
import { SECTIONS, SECTION_BY_KEY } from '../data/sections';
import { CATEGORIES } from '../data/directory';
import { t } from '../i18n/ui';
import { articlesFor, articleUrl, sectionUrl, fmtTime, fmtDate, fmtShort, fmtDay, FACTS, EVENT, LIVE, leadOf, readMin, kickerOf, picOf, placesOf, placeUrl, type Article } from '../lib/content';
import { shabbatTimes } from '../lib/shabbat';
import { CALENDAR, calTime, calVenue } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang); const pre = LANG_PREFIX[lang]; const he = lang === 'he';
const all = articlesFor(lang);
const S = (k: string) => SECTION_BY_KEY[k as keyof typeof SECTION_BY_KEY];
const ev = he ? EVENT : null;
const evArts = (ev?.storyIds || []).map((id) => all.find((a) => a.slug === `n${id}`)).filter(Boolean) as Article[];
const evSet = new Set(evArts.map((a) => a.slug));

// 1. lead and the row of 4 (flash items of the event are left to the dark block)
const lead = leadOf(all, ev);
const used = new Set<string>([lead?.slug].filter(Boolean) as string[]);
const row = all.filter((a) => !used.has(a.slug) && !(evSet.has(a.slug) && a.section === 'flash')).slice(0, 4);
row.forEach((a) => used.add(a.slug));
const latest = [lead, ...row].filter(Boolean) as Article[];

// 2. the dark block: the active event, or the section with the most stories of the last 7 days
type Dark = { kicker: string; headline: string; text: string; href: string; bar?: { pct: number; left?: string; right?: string }; list: Article[]; bg: string; source?: string };
let dark: Dark | null = null;
if (ev && (ev.block?.headline || evArts.length)) {
  const b = ev.block || {};
  dark = { kicker: b.kicker || ev.title, headline: b.headline || evArts[0].title, text: b.text || evArts[0]?.dek || '', href: ev.ctaUrl || (evArts[0] ? articleUrl(evArts[0], lang) : '/'),
    bar: b.bar && typeof b.bar.pct === 'number' ? b.bar : undefined, list: evArts.slice(0, 3), bg: '/img/skyline.webp', source: b.source };
} else {
  const recent = all.filter((a) => !used.has(a.slug) && a.section !== 'flash' && Date.now() - Date.parse(a.published) < 7 * 864e5);
  const by = new Map<string, Article[]>(); for (const a of recent) by.set(a.section, [...(by.get(a.section) || []), a]);
  const best = [...by.values()].sort((x, y) => y.length - x.length)[0];
  if (best && best.length >= 2) dark = { kicker: S(best[0].section).name[lang], headline: best[0].title, text: best[0].dek, href: articleUrl(best[0], lang), list: best.slice(1, 4), bg: '/img/skyline.webp' };
}
dark?.list.forEach((a) => used.add(a.slug));
if (dark && !ev) used.add(all.find((a) => a.title === dark!.headline)?.slug || '');

// 3. "נתניה עכשיו": road closures from published stories (until date not passed), sea and weather snapshot
const ilToday = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jerusalem' }).format(new Date());
const closures = all.filter((a) => a.closure && (a.closure.until ? a.closure.until >= ilToday : Date.now() - Date.parse(a.published) < 3 * 864e5)).slice(0, 3);
const untilTxt = (c: NonNullable<Article['closure']>) => c.until ? `עד ${c.approx ? 'כ-' : ''}${new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long' }).format(new Date(c.until + 'T12:00:00Z'))}` : '';
const seaState = (h: number | null | undefined) => (h == null ? '' : h <= 0.5 ? 'ים שקט' : h <= 1 ? 'ים נוח' : h <= 1.6 ? 'ים גלי' : h <= 2.5 ? 'ים גבוה' : 'ים סוער');
const liveAt = LIVE?.ok && LIVE.at ? (new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jerusalem' }).format(new Date(LIVE.at)) === ilToday ? fmtTime(LIVE.at) : `${fmtShort(LIVE.at)}, ${fmtTime(LIVE.at)}`) : '';
const num = (v: number | null | undefined, d = 0) => (typeof v === 'number' ? (d ? v.toFixed(d) : String(Math.round(v))) : '…');

// 4. the blocks that existed
const re = all.filter((a) => a.section === 'realestate' && !used.has(a.slug));
const colAll = (['community', 'sports', 'sharon', 'city', 'tourism', 'law'] as const).filter((k) => all.some((a) => a.section === k && !used.has(a.slug)));
const colKeys = colAll.slice(0, colAll.length >= 6 ? 6 : 3); // full rows of three
const events = all.filter((a) => a.section === 'leisure' || a.event).slice(0, 4);
// 28.10.2026: the next events from the official calendar fill the "what's on" block when there are fewer than 4 stories
const calNext = he ? CALENDAR.slice(0, Math.max(0, 4 - events.length)) : [];
const sh = shabbatTimes(new Date(), 1)[0];
const hotline = FACTS?.hotline?.number ?? FACTS?.municipalHotline?.number ?? '106';
const L = {
  he: { now: 'נתניה עכשיו', live: 'נתונים חיים', upd: 'עודכן', sea: 'הים בנתניה', wave: 'מ׳ גובה גלים', water: 'מים', air: 'אוויר', wind: 'קמ״ש רוח', states: 'ים שקט|ים נוח|ים גלי|ים גבוה|ים סוער', wxSrc: 'נתוני ים ומזג אוויר',
    roads: 'חסימות כבישים', noRoads: 'לא פורסמו אצלנו חסימות פעילות. מידע רשמי על הסדרי תנועה מתפרסם באתר העירייה.', allRoads: 'לכל החסימות והעבודות ←',
    al: 'התרעות פיקוד העורף', alText: 'התרעות בזמן אמת מתקבלות רק מהמקור הרשמי. התקינו את אפליקציית פיקוד העורף, ובזמן אזעקה פעלו לפי ההנחיות.', alBtn: 'לאתר פיקוד העורף', alHow: 'מה עושים באזעקה ←',
    shab: 'שבת בנתניה', shabIn: 'כניסה', shabOut: 'יציאה', ph: 'בית מרקחת תורן', tel: 'מוקד עירוני',
    reTitle: 'נדל״ן ותכנון', eventsTitle: 'מה עושים בנתניה', proText: 'בעלי מקצוע עם טלפון מאומת, לפי שכונה. המדריך נפתח עכשיו: עסקים מצטרפים בחינם.', ill: 'תמונה להמחשה', min: 'דק׳ קריאה', by: 'מערכת חדשות נתניה והשרון', more: 'לכתבה המלאה ←' },
  ru: { now: 'Нетания сейчас', live: 'Данные в реальном времени', upd: 'Обновлено', sea: 'Море в Нетании', wave: 'м высота волн', water: 'Вода', air: 'Воздух', wind: 'км/ч ветер', states: 'спокойное|умеренное|волны|высокие волны|шторм', wxSrc: 'Данные о море и погоде',
    roads: 'Перекрытия', noRoads: 'Сейчас у нас нет сообщений о перекрытиях.', allRoads: 'Все перекрытия →',
    al: 'Служба тыла', alText: 'Тревоги в реальном времени: только в официальном приложении Службы тыла.', alBtn: 'Сайт Службы тыла', alHow: 'Что делать при тревоге →',
    shab: 'Шаббат', shabIn: 'Вход', shabOut: 'Выход', ph: 'Дежурная аптека', tel: 'Горячая линия',
    reTitle: 'Недвижимость', eventsTitle: 'Куда пойти', proText: 'Мастера с проверенным телефоном, по районам.', ill: 'AI иллюстрация', min: 'мин', by: 'Редакция NWS', more: 'Читать →' },
  fr: { now: 'Netanya maintenant', live: 'Données en direct', upd: 'Mis à jour', sea: 'La mer à Netanya', wave: 'm de vagues', water: 'Eau', air: 'Air', wind: 'km/h vent', states: 'calme|belle|agitée|forte|très forte', wxSrc: 'Données mer et météo',
    roads: 'Routes fermées', noRoads: 'Aucune fermeture signalée chez nous pour le moment.', allRoads: 'Toutes les fermetures →',
    al: 'Commandement du front intérieur', alText: 'Les alertes en temps réel viennent uniquement de l’application officielle.', alBtn: 'Site officiel', alHow: 'Que faire en cas d’alerte →',
    shab: 'Chabbat', shabIn: 'Entrée', shabOut: 'Sortie', ph: 'Pharmacie de garde', tel: 'Hotline municipale',
    reTitle: 'Immobilier', eventsTitle: 'Que faire à Netanya', proText: 'Des artisans au téléphone vérifié, par quartier.', ill: 'Illustration IA', min: 'min', by: 'Rédaction NWS', more: 'Lire →' },
  en: { now: 'Netanya Now', live: 'Live data', upd: 'Updated', sea: 'The sea in Netanya', wave: 'm waves', water: 'Water', air: 'Air', wind: 'km/h wind', states: 'calm|smooth|choppy|rough|very rough', wxSrc: 'Sea and weather data',
    roads: 'Road closures', noRoads: 'No active closures reported on our site right now.', allRoads: 'All closures →',
    al: 'Home Front Command alerts', alText: 'Real time alerts come only from the official Home Front Command app.', alBtn: 'Official site', alHow: 'What to do in an alert →',
    shab: 'Shabbat', shabIn: 'Starts', shabOut: 'Ends', ph: 'Duty pharmacy', tel: 'City hotline',
    reTitle: 'Real Estate', eventsTitle: 'What’s on in Netanya', proText: 'Local pros with verified phone numbers, by neighborhood.', ill: 'AI illustration', min: 'min read', by: 'NWS Desk', more: 'Read →' },
}[lang];
const nowHref = (p: string) => (he ? `/now/${p}/` : `${pre}/now/`);
const titles = {
  he: 'חדשות נתניה והשרון: מבזקים, עירייה, נדל״ן ומדריך עסקים',
  ru: 'NWS Новости Нетании и Шарона: срочные новости, мэрия, недвижимость',
  fr: 'NWS Actualités de Netanya et du Sharon : flashs, mairie, immobilier',
  en: 'NWS Netanya & Sharon News: breaking news, city hall, real estate',
}[lang];
const descs = {
  he: 'חדשות נתניה והשרון בזמן אמת: מבזקים, חסימות, עירייה, נדל״ן והתחדשות עירונית, ספורט ואירועים, נתונים חיים ומדריך בעלי מקצוע בנתניה.',
  ru: 'Новости Нетании и Шарона: срочные сообщения, перекрытия дорог, мэрия, недвижимость, спорт и события, полезные данные и справочник мастеров.',
  fr: 'Actualités de Netanya et du Sharon : flashs, routes, mairie, immobilier, sport et sorties, données pratiques et annuaire des artisans.',
  en: 'Netanya and Sharon news: breaking updates, road closures, city hall, real estate, sports and events, live local data and a directory of local pros.',
}[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, LANG_PREFIX[l] + '/'])) as Record<Lang, string>;
const orgId = SITE_URL + '/#org';
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', '@id': orgId, name: BRAND.he, alternateName: ['NWS', 'חדשות נתניה והשרון'], url: SITE_URL + '/', logo: { '@type': 'ImageObject', url: SITE_URL + '/logo.png', width: 512, height: 512 },
    foundingDate: BRAND.foundingDate, areaServed: [{ '@type': 'City', name: 'נתניה' }, { '@type': 'Place', name: 'השרון' }], email: BRAND.email, ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
    publishingPrinciples: SITE_URL + '/editorial-policy/', correctionsPolicy: SITE_URL + '/corrections/', ethicsPolicy: SITE_URL + '/editorial-policy/', actionableFeedbackPolicy: SITE_URL + '/corrections/',
    masthead: SITE_URL + '/about/', diversityPolicy: SITE_URL + '/about/', noBylinesPolicy: SITE_URL + '/editorial-policy/' },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE_URL + '/#website', url: SITE_URL + '/', name: BRAND.he, inLanguage: ['he', 'ru', 'fr', 'en'], publisher: { '@id': orgId },
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: SITE_URL + '/search/?q={search_term_string}' }, 'query-input': 'required name=search_term_string' } },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: lang === 'he' ? 'החדשות האחרונות בנתניה' : titles, itemListElement: latest.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE_URL + articleUrl(a, lang), name: a.title })) },
];
---
<Base lang={lang} title={titles} description={descs} path={pre + '/'} alternates={alternates} jsonld={jsonld} current="home">
  <h1 class="sr">{he ? 'חדשות נתניה והשרון' : u.brandName}</h1>

  {lead && (() => { const s = S(lead.section); const p = picOf(lead, IMG); const pl = he ? placesOf(lead).slice(0, 2) : []; return (
  <section class="wrap hl" aria-labelledby="lead-h" style={`--c:${s.color};--ci:${s.ink}`}>
    <div class="tx">
      <span class="kick"><i></i>{kickerOf(lead, lang)}</span>
      <h2 id="lead-h"><a href={articleUrl(lead, lang)}>{lead.title}</a></h2>
      {lead.dek && <p class="dek">{lead.dek}</p>}
      <div class="meta"><b>{L.by}</b><i class="sep" aria-hidden="true"></i><time datetime={lead.published} data-ago>{fmtDay(lead.published, lang)}</time><i class="sep" aria-hidden="true"></i><span>{readMin(lead)} {L.min}</span></div>
      {(pl.length > 0 || lead.closure || (he && lead.sourceName)) && <div class="tags">
        {lead.closure && <span class="tagc">{lead.closure.place}</span>}
        {pl.map((x) => <a class="tagc" href={placeUrl(x.slug)}>{x.he}</a>)}
        {he && lead.sourceName && <span class="tagc">לפי {lead.sourceName}</span>}
      </div>}
    </div>
    <a class="pic" href={articleUrl(lead, lang)} tabindex="-1" aria-hidden="true">
      <img src={p.src} srcset={p.srcset} sizes={p.srcset ? '(max-width: 900px) 100vw, 680px' : undefined} alt={p.ai ? p.alt : ''} width={p.w} height={p.h} fetchpriority="high" decoding="async">
      {p.ai && <span class="ill">{L.ill}</span>}
    </a>
  </section>); })()}

  {row.length > 0 && <section class="wrap r4w" aria-label={u.more}><div class="row4 lst">{row.map((a) => <Card a={a} lang={lang} eager />)}</div></section>}

  <section class="nw" aria-labelledby="now-h"><div class="wrap">
    <div class="hh"><h2 id="now-h"><i aria-hidden="true"></i>{L.now}</h2><span>{L.live}{liveAt && <>{` · ${L.upd} `}<span data-live="at">{liveAt}</span></>}</span></div>
    <div class="row4">
      <div class="wid ph" data-sea>
        <div class="wh"><img src="/img/sea.webp" alt="" width="640" height="360" loading="lazy" decoding="async"><b>{L.sea}</b></div>
        <div class="wb">
          <div class="bigl"><span class="big" data-live="wave">{num(LIVE.wave, 1)}</span><span>{L.wave}{he && <> · <span data-live="state" data-states={L.states}>{seaState(LIVE.wave)}</span></>}{!he && <span data-states={L.states} hidden></span>}</span></div>
          <div class="g3"><div><b data-live="sst">{num(LIVE.sst)}°</b>{L.water}</div><div><b data-live="temp">{num(LIVE.temp)}°</b>{L.air}</div><div><b data-live="wind">{num(LIVE.wind)}</b>{L.wind}</div></div>
          <span class="src">{L.wxSrc}: <a href="https://open-meteo.com/" rel="noopener nofollow" target="_blank">Open-Meteo</a></span>
        </div>
      </div>
      <div class="wid">
        <h3><span class="ico" style="background:#FFF1E6;color:#D9480F" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="9"/><path d="M7 12h10"/></svg></span>{L.roads}</h3>
        {closures.length ? <div class="cls">{closures.map((a, i) => <a class="cl" href={articleUrl(a, lang)} data-until={a.closure!.until || undefined} style={i ? '--k:#F59F00' : undefined}><b>{a.closure!.place}</b><span>{[a.closure!.what, untilTxt(a.closure!)].filter(Boolean).join(' · ')}</span></a>)}</div>
          : <p class="note" style="margin:0">{L.noRoads}</p>}
        <a class="mo" href={nowHref('roads')}>{L.allRoads}</a>
      </div>
      <div class="wid">
        <h3><span class="ico" style="background:#FFF4DB;color:#9A5A00" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M12 8v5M12 16v.5"/></svg></span>{L.al}</h3>
        <p class="altx">{L.alText}</p>
        <a class="btn pri pill alb" href="https://www.oref.org.il/" rel="noopener" target="_blank">{L.alBtn}</a>
        <a class="mo" href={nowHref('alerts')}>{L.alHow}</a>
      </div>
      <div class="wid">
        <h3><span class="ico" style="background:#F0EAFB;color:#6D3FC0" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 3c2 3 2 5 0 7-2-2-2-4 0-7z"/><rect x="9" y="10" width="6" height="11" rx="1"/></svg></span>{L.shab}</h3>
        <div class="g2"><div><span>{L.shabIn}</span><b>{sh.candles}</b></div><div><span>{L.shabOut}</span><b>{sh.end}</b></div></div>
        <span class="note" style="font-size:13px">{sh.date}</span>
        <div class="qk"><a href={nowHref('pharmacy')}>{L.ph}</a><a href={nowHref('phones')}>{L.tel} {hotline}</a></div>
      </div>
    </div>
  </div></section>

  {dark && (
  <section class="prem" aria-labelledby="prem-h">
    <img src={dark.bg} alt="" width="1280" height="720" loading="lazy" decoding="async">
    <div class="wrap">
      <div class="pt">
        <span class="kick"><i></i>{dark.kicker}</span>
        <h2 id="prem-h"><a href={dark.href}>{dark.headline}</a></h2>
        {dark.text && <p>{dark.text}</p>}
        {dark.bar && <div class="pb"><div class="pbar" role="img" aria-label={`${dark.bar.pct}%`}><span style={`width:${Math.max(0, Math.min(100, dark.bar.pct))}%`}></span></div><div class="pbl"><span>{dark.bar.left}</span><span>{dark.bar.right}</span></div></div>}
        {dark.source && <span class="psrc">{he ? 'מקור' : u.source}: {dark.source}</span>}
      </div>
      {dark.list.length > 0 && <div class="plist">{dark.list.map((a) => <a href={articleUrl(a, lang)}><small class={a.section === 'flash' ? 'f' : undefined}>{S(a.section).name[lang]}</small><b>{a.title}</b></a>)}</div>}
    </div>
  </section>)}

  {re.length > 0 && (() => { const p0 = picOf(re[0], IMG); return (
  <section class="wrap sec" aria-labelledby="re-h" style="--c:#E08A00;--ci:#9A5A00;--s:#FFF7EB">
    <h2 id="re-h" class="sh"><span class="bar"></span>{L.reTitle}<a class="mo" href={sectionUrl('realestate', lang)}>{u.toSection}</a></h2>
    <div class="feat">
      <a class="big" href={articleUrl(re[0], lang)}><span class="pw"><img src={p0.src} srcset={p0.srcset} sizes="(max-width: 900px) 100vw, 620px" alt={p0.ai ? p0.alt : ''} width={p0.w} height={p0.h} loading="lazy" decoding="async">{p0.ai && <span class="ill">{L.ill}</span>}</span><span class="kick"><i></i>{kickerOf(re[0], lang)}</span><h3>{re[0].title}</h3><span>{re[0].dek}</span></a>
      <div class="list">{re.slice(1, 5).map((a) => { const p = picOf(a, IMG); return <a class="row" href={articleUrl(a, lang)}><span class="pw"><img src={p.small} alt={p.ai ? p.alt : ''} width="96" height="68" loading="lazy" decoding="async">{p.ai && <span class="ill sm">{L.ill}</span>}</span><span><b>{a.title}</b><br><span class="note"><time datetime={a.published} data-ago>{fmtDate(a.published, lang)}</time></span></span></a>; })}</div>
    </div>
  </section>); })()}

  {colKeys.length > 0 && (
  <section class="wrap sec"><div class="grid cols3">
    {colKeys.map((k) => { const s = S(k); const items = all.filter((a) => a.section === k && !used.has(a.slug)); return (
      <div class="col" style={`--c:${s.color};--ci:${s.ink}`}>
        <h2>{s.name[lang]}<a class="mo" href={sectionUrl(k, lang)}>{u.more}</a></h2>
        <Card a={items[0]} lang={lang} />
        <ul>{items.slice(1, 3).map((a) => <li><a href={articleUrl(a, lang)}>{a.title}</a></li>)}</ul>
      </div>); })}
  </div></section>)}

  {(events.length > 0 || calNext.length > 0) && (
  <section class="dark" aria-labelledby="ev-h"><div class="wrap in">
    <h2 id="ev-h">{L.eventsTitle}</h2>
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px">
      {events.map((a) => { const p = picOf(a, IMG); return <a class="vcard" href={articleUrl(a, lang)}><img src={p.ai ? p.small : (IMG[a.imageHint] ?? IMG.concert).src} alt={p.ai ? p.alt : ''} width="400" height="500" loading="lazy" decoding="async">{p.ai && <i class="ill">{L.ill}</i>}<span><b>{a.title}</b><small>{a.event?.startDate ? fmtDate(a.event.startDate, lang) : fmtDate(a.published, lang)}{a.event?.location ? ` · ${a.event.location}` : ''}</small></span></a>; })}
          {calNext.map((c) => <a class="vcard" href="/events/#cal"><img src={IMG.concert.src} alt="" width="400" height="500" loading="lazy" decoding="async"><span><b>{c.title}</b><small>{fmtDate(c.start, lang)}{calTime(c.start) ? `, ${calTime(c.start)}` : ''}{calVenue(c) ? ` · ${calVenue(c)}` : ''}</small></span></a>)}
    </div>
  </div></section>)}

  <section class="pros" aria-labelledby="pros-h"><div class="wrap in">
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:12px">
      <h2 id="pros-h" style="font-weight:800;font-size:26px">{u.proTitle}</h2>
      <div style="display:flex;gap:16px;font-size:15px;font-weight:700"><a href={`${pre}/directory/`} style="color:#0B5FCC">{u.toDirectory}</a><a href="/advertise/" style="color:#0B5FCC">{u.addBiz}</a></div>
    </div>
    <p style="margin:0 0 16px;color:#3B4656">{L.proText}</p>
    <div class="chips">{CATEGORIES.map((c) => <a class="chip" href={he ? `/directory/${c.slug}/` : `${pre}/directory/`} style={`--c:${c.color}`}><i></i>{he ? c.plural : c.name[lang]}</a>)}</div>
  </div></section>

  <section class="wrap" aria-labelledby="join-h"><div class="join">
    <div style="flex:1 1 380px"><h2 id="join-h">{u.joinTitle}</h2><p>{u.joinText}</p></div>
    <div class="btns"><a class="btn wh" href={TG_URL || `${pre}/join/`} {...(TG_URL ? { target: '_blank', rel: 'noopener' } : {})} data-tg>{he ? 'טלגרם' : 'Telegram'}</a><a class="btn wh" href={`${pre}/join/#whatsapp`}>{he ? 'וואטסאפ' : 'WhatsApp'}</a><a class="btn ghost" href={`${pre}/join/#alerts`}>{u.alerts}</a></div>
  </div></section>
</Base>
