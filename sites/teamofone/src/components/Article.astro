---
import { md } from '../lib/md.js';
const { a } = Astro.props;
const base = import.meta.env.BASE_URL;
const date = a.published_at ? new Date(a.published_at).toLocaleDateString('he-IL') : '';
---
<main class="wrap page" style="max-width:860px">
  <div class="crumbs"><a href={base}>דף הבית</a> / <a href={base + 'maamarim/'}>מאמרים</a> / {a.category}</div>
  <span class="pill k">{a.category}</span>
  <h1 style="font-family:var(--body);font-weight:900;font-size:clamp(30px,4.4vw,50px);line-height:1.15;margin:14px 0 10px">{a.title}</h1>
  <p class="muted" style="font-size:18px;margin:0 0 6px">{a.description}</p>
  <p class="muted" style="font-size:14px">{a.author} · {date}</p>
  {a.cover_url && <div class="artcover"><img src={a.cover_url} alt={a.title} loading="eager"></div>}
  <p class="aff">חלק מהקישורים לכלים במאמרים שלנו הם קישורי שותפים: אם תצטרפו דרכם, ייתכן שנקבל עמלה, בלי עלות נוספת לכם. אנחנו ממליצים רק על כלים שאנחנו עובדים איתם.</p>
  <article class="prose" set:html={md(a.body_md)} />
  {(a.faq || []).length > 0 && (
    <section class="faqx" style="margin-top:30px"><h2 style="font-size:26px">שאלות נפוצות</h2>
      {a.faq.map((f) => <details><summary>{f.q}</summary><p style="margin:0 0 12px">{f.a}</p></details>)}
    </section>)}
  <div class="card dk" style="margin-top:34px"><h2 style="color:var(--lime)">רוצים צוות כזה בעסק שלכם?</h2><p class="mut" style="margin:0 0 14px">בקורס בונים אותו צעד אחר צעד: מאמרים, קידום בגוגל, סרטונים, רשתות ומענה לפניות.</p><a class="btn btn-l" href={base + '#course'}>לתוכנית הקורס <span class="arrow">←</span></a></div>
</main>
