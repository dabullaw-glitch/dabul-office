---
import '../styles/site.css';
interface Props { title: string; description?: string; app?: boolean; canonical?: string; ogImage?: string; jsonld?: any; noindex?: boolean }
const { title, description = 'צוות שלם. אדם אחד. קורס דיגיטלי לבניית צוות של בינה מלאכותית לעסק שלכם, צעד אחר צעד.', app = false, canonical, ogImage, jsonld, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
// PREVIEW is on unless the build was made with PREVIEW=0 (only the production build, when sites/teamofone/launch.json has live:true).
// Personal, login, purchase and admin pages pass noindex and stay out of search engines even after launch.
const preview = process.env.PREVIEW !== '0';
const url = canonical || new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(ogImage || base + 'img/podyt.webp', Astro.site).href;
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{(preview || noindex) && <meta name="robots" content="noindex, nofollow">}
<link rel="canonical" href={url}>
<meta property="og:type" content="website"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={og}><meta property="og:locale" content="he_IL">
<link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml">
<meta name="theme-color" content="#0B0B0C">
<meta name="build" content={process.env.GITHUB_SHA || "local"}>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Karantina:wght@400;700&family=Rubik:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;700&display=swap">
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}></script>}
</head>
<body class={app ? 'appb' : ''}>
{app && (
  <header class="ahead"><div class="wrap">
    <a class="logo" href={base} aria-label="Team of One, לדף הבית">
      <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="12" fill="#D7FF3B"/><circle cx="20" cy="20" r="5.5" fill="#0B0B0C"/><g fill="#0B0B0C" opacity=".55"><circle cx="20" cy="8" r="2.2"/><circle cx="30.4" cy="14" r="2.2"/><circle cx="30.4" cy="26" r="2.2"/><circle cx="20" cy="32" r="2.2"/><circle cx="9.6" cy="26" r="2.2"/><circle cx="9.6" cy="14" r="2.2"/></g></svg>
      <b>Team of One</b>
    </a>
    {Astro.url.pathname.includes('/ezor-ishi') || Astro.url.pathname.includes('/nihul') ? (
      <nav id="anav"><a class="hide-m" href={base + 'ezor-ishi/'}>הקורס והספרייה</a><a class="hide-m" href={base + 'ezor-ishi/kehila/'}>קהילה</a><a class="hide-m" href={base + 'ezor-ishi/laiv/'}>שידורים</a><a class="hide-m" href={base + 'ezor-ishi/etgar/'}>האתגר שלי</a><a class="hide-m" href={base}>לאתר</a></nav>
    ) : (
      <nav id="anav"><a class="hide-m" href={base}>דף הבית</a><a class="hide-m" href={base + 'kursim/'}>קורסים</a><a class="hide-m" href={base + 'maamarim/'}>מאמרים</a><a class="hide-m" href={base + 'kelim/'}>כלים</a><a class="hide-m" href={base + 'etgar/'}>אתגר חינמי</a><a class="hide-m" href={base + '#price'}>מסלולים</a><a href={base + 'ezor-ishi/'}>האזור האישי</a></nav>
    )}
    <button class="mbtn" type="button" aria-label="פתיחת התפריט" aria-expanded="false" aria-controls="mpanel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  </div></header>
)}
<slot />
<script is:inline>
(function () {
  // One phone menu for both headers: the member/app header (#anav) and the home page header (nav.nav).
  var btn = document.querySelector('.ahead .mbtn, nav.nav .mbtn'); if (!btn) return;
  var head = btn.closest('header, nav'), panel = null;
  function links() {
    var app = document.getElementById('anav');
    if (app && head.classList.contains('ahead')) return Array.prototype.slice.call(app.querySelectorAll('a, button'));
    return Array.prototype.slice.call(head.querySelectorAll('ul a, .navlogin'));
  }
  function close() { if (!panel) return; panel.remove(); panel = null; btn.setAttribute('aria-expanded', 'false'); btn.setAttribute('aria-label', 'פתיחת התפריט'); }
  function open() {
    panel = document.createElement('div'); panel.className = 'mpanel'; panel.id = 'mpanel';
    panel.style.top = head.getBoundingClientRect().bottom + 'px';
    links().forEach(function (el) {
      var item;
      if (el.tagName === 'A') { item = document.createElement('a'); item.href = el.getAttribute('href'); }
      else { item = document.createElement('button'); item.type = 'button'; item.onclick = function () { el.click(); }; }
      item.textContent = el.textContent.trim(); item.addEventListener('click', close); panel.appendChild(item);
    });
    document.body.appendChild(panel); btn.setAttribute('aria-expanded', 'true'); btn.setAttribute('aria-label', 'סגירת התפריט');
    var first = panel.querySelector('a, button'); if (first) first.focus();
  }
  btn.addEventListener('click', function (e) { e.stopPropagation(); panel ? close() : open(); });
  document.addEventListener('click', function (e) { if (panel && !panel.contains(e.target)) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && panel) { close(); btn.focus(); } });
  window.addEventListener('resize', close);
})();
</script>
</body>
</html>
