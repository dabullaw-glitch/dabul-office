---
import Base from '../../../layouts/Base.astro';
---
<Base title="הקהילה | Team of One" app noindex>
  <main class="wrap page kh-wrap">
    <div class="crumbs"><a href={import.meta.env.BASE_URL + 'ezor-ishi/'}>האזור האישי</a> / הקהילה</div>
    <div id="app"><div class="card">טוען...</div></div>
  </main>
  <script>
    // Community feed for members: compact composer (opens on tap), filter chips, post cards with comments inside.
    // The author can delete their own post or comment; an admin can delete, hide and pin anything. Every delete asks
    // for a second tap in the page itself. The database rules (RLS) decide who may do what; this only shapes the page.
    import { sb, BASE, esc, fmtDate, toast, errText } from '../../../lib/sb.js';
    import { requireLogin, logoutBtn, loadMe } from '../../../lib/member.js';
    const app = document.getElementById('app');
    const KIND = { question: 'שאלה', post: 'שיתוף', win: 'הצלחה', announce: 'הודעה מהצוות' };
    const FILTERS = [['all', 'הכל'], ['question', 'שאלות'], ['win', 'הצלחות'], ['post', 'שיתופים'], ['announce', 'הודעות']];
    const EMPTY = { all: 'עדיין אין כאן פוסטים. פתחו את השיחה הראשונה.', question: 'עדיין אין שאלות. יש לכם שאלה? זה המקום.', win: 'עדיין אין הצלחות. בניתם משהו? ספרו לכולם.', post: 'עדיין אין שיתופים.', announce: 'עדיין אין הודעות מהצוות.' };
    const ERRS = { no_access: 'הקהילה פתוחה לחברי הקורס והמנוי.', rate: 'פרסמתם הרבה בשעה האחרונה. נסו שוב מאוחר יותר.', blocked: 'החשבון חסום לפרסום.' };
    const msg = (e) => ERRS[String(e?.message || '').replace(/^.*?: /, '')] || errText(e);
    const ago = (d) => {
      const s = (Date.now() - new Date(d)) / 1000;
      if (s < 60) return 'עכשיו'; if (s < 120) return 'לפני דקה'; if (s < 3600) return 'לפני ' + Math.floor(s / 60) + ' דקות';
      if (s < 7200) return 'לפני שעה'; if (s < 86400) return 'לפני ' + Math.floor(s / 3600) + ' שעות'; if (s < 172800) return 'אתמול'; return fmtDate(d);
    };
    const initial = (n) => (String(n || '').trim()[0] || '?').toUpperCase();
    const tone = (n) => { let h = 0; for (const c of String(n || '')) h = (h * 31 + c.charCodeAt(0)) >>> 0; return ['a', 'b', 'c'][h % 3]; };
    const av = (n, cls = '') => `<span class="kh-av t-${tone(n)} ${cls}" aria-hidden="true">${esc(initial(n))}</span>`;
    let me, uid, filter = 'all', myName = '';

    (async () => {
      const ses = await requireLogin(); if (!ses) return;
      uid = ses.user.id; logoutBtn(document.getElementById('anav'));
      ({ data: me } = await loadMe());
      if (!me?.access) {
        app.innerHTML = `<div class="card dk"><h1 class="kh-h1" style="color:var(--lime)">הקהילה של Team of One</h1><p>מקום אחד לשאלות, לשיתוף מה שבניתם ולהצלחות של כולם. הקהילה פתוחה לחברי הקורס ולמנויים.</p><div class="row"><a class="btn btn-l" href="${BASE}kniya/?plan=monthly">הצטרפות במנוי חודשי</a><a class="btn btn-o" href="${BASE}kniya/?plan=course">הקורס המלא</a></div></div>`;
        return;
      }
      myName = me.profile?.full_name || me.profile?.email || '';
      render();
    })();

    function render() {
      const kinds = ['question', 'post', 'win', ...(me.admin ? ['announce'] : [])];
      app.innerHTML = `
        <header class="kh-head"><h1 class="kh-h1">הקהילה</h1><p class="muted">שואלים, משתפים מה בניתם ועוזרים אחד לשני.</p></header>
        <section class="kh-comp" aria-label="פוסט חדש">
          <button type="button" class="kh-open" id="open" aria-expanded="false" aria-controls="cform">${av(myName)}<span class="kh-ph">מה תרצו לשאול או לשתף?</span><span class="kh-new">פוסט חדש</span></button>
          <form id="cform" class="kh-form" hidden>
            <fieldset class="kh-kinds"><legend class="sr">סוג הפוסט</legend>${kinds.map((k, i) => `<label><input type="radio" name="kind" value="${k}" ${i === 0 ? 'checked' : ''}><span>${KIND[k]}</span></label>`).join('')}</fieldset>
            <label class="sr" for="pt">כותרת (לא חובה)</label><input id="pt" class="kh-in" maxlength="140" placeholder="כותרת (לא חובה)" autocomplete="off">
            <label class="sr" for="pb">מה רציתם לשתף?</label><textarea id="pb" class="kh-in" rows="4" maxlength="5000" placeholder="מה רציתם לשאול או לשתף?"></textarea>
            <div class="kh-fbar"><span class="kh-note">בלי פרטים מזהים של לקוחות ובלי מידע סודי.</span><span class="kh-fbtn"><button type="button" class="btn btn-w sm" id="close">ביטול</button><button type="submit" class="btn btn-k sm" id="send">פרסום</button></span></div>
          </form>
        </section>
        <div class="kh-filters" role="group" aria-label="סינון הפוסטים">${FILTERS.map(([k, t]) => `<button type="button" data-f="${k}" aria-pressed="${filter === k}">${t}</button>`).join('')}</div>
        <div class="kh-feed" id="feed" aria-live="polite"><div class="kh-skel"></div><div class="kh-skel"></div></div>`;
      const form = document.getElementById('cform'), open = document.getElementById('open');
      const setOpen = (on) => { form.hidden = !on; open.hidden = on; open.setAttribute('aria-expanded', on); if (on) document.getElementById('pb').focus(); else open.focus(); };
      open.onclick = () => setOpen(true);
      document.getElementById('close').onclick = () => setOpen(false);
      form.onsubmit = (e) => { e.preventDefault(); post(setOpen); };
      app.querySelector('.kh-filters').onclick = (e) => { const b = e.target.closest('[data-f]'); if (!b) return; filter = b.dataset.f; app.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', x === b)); load(); };
      load();
    }

    // In-page confirm: a small bar with "yes, delete" and "cancel". No browser dialogs.
    function confirmIn(box, text, onYes) {
      box.innerHTML = `<span>${esc(text)}</span><span class="kh-cbtn"><button type="button" class="btn btn-r sm" data-yes>כן, למחוק</button><button type="button" class="btn btn-w sm" data-no>ביטול</button></span>`;
      box.hidden = false; box.querySelector('[data-no]').focus();
      box.querySelector('[data-no]').onclick = () => { box.hidden = true; box.innerHTML = ''; };
      box.querySelector('[data-yes]').onclick = async (e) => { e.currentTarget.disabled = true; await onYes(); };
    }

    function commentHtml(c) {
      const can = c.user_id === uid || me.admin;
      return `<div class="kh-c" data-cid="${c.id}">${av(c.author_name, 'sm')}<div class="kh-cb">
        <div class="kh-cm"><b>${esc(c.author_name || 'חבר בקהילה')}</b><time datetime="${esc(c.created_at)}">${ago(c.created_at)}</time>${c.hidden ? '<span class="pill no">מוסתר</span>' : ''}${can ? `<button type="button" class="kh-x" data-cdel aria-label="מחיקת התגובה של ${esc(c.author_name || 'חבר בקהילה')}">מחיקה</button>` : ''}</div>
        <div class="kh-ct">${esc(c.body)}</div><div class="kh-confirm" hidden></div></div></div>`;
    }

    async function load() {
      const feed = document.getElementById('feed');
      let q = sb.from('too_posts').select('id,user_id,author_name,kind,title,body,pinned,hidden,created_at').order('pinned', { ascending: false }).order('created_at', { ascending: false }).limit(60);
      if (filter !== 'all') q = q.eq('kind', filter);
      const { data: posts, error } = await q;
      if (error) { feed.innerHTML = '<div class="kh-empty"><b>הפיד לא נטען</b><p>' + esc(msg(error)) + '</p></div>'; return; }
      if (!posts.length) {
        feed.innerHTML = `<div class="kh-empty"><span class="kh-ei" aria-hidden="true">💬</span><b>${esc(EMPTY[filter] || EMPTY.all)}</b><button type="button" class="btn btn-k sm" id="first">כתיבת פוסט</button></div>`;
        document.getElementById('first').onclick = () => document.getElementById('open').click();
        return;
      }
      const ids = posts.map((p) => p.id);
      const [{ data: cm }, { data: lk }] = await Promise.all([
        sb.from('too_comments').select('id,post_id,user_id,author_name,body,hidden,created_at').in('post_id', ids).order('created_at'),
        sb.from('too_likes').select('post_id,user_id').in('post_id', ids)]);
      feed.innerHTML = posts.map((p) => {
        const cs = (cm || []).filter((c) => c.post_id === p.id), ls = (lk || []).filter((l) => l.post_id === p.id), liked = ls.some((l) => l.user_id === uid);
        const canDel = p.user_id === uid || me.admin;
        return `<article class="kh-post ${p.pinned ? 'pin' : ''} ${p.hidden ? 'hid' : ''}" data-id="${p.id}" aria-label="${esc((KIND[p.kind] || 'פוסט') + ' של ' + (p.author_name || 'חבר בקהילה'))}">
          <header class="kh-top">${av(p.author_name, p.kind === 'announce' ? 't-l' : '')}<div class="kh-who"><b>${esc(p.author_name || 'חבר בקהילה')}</b><span><time datetime="${esc(p.created_at)}">${ago(p.created_at)}</time>${p.pinned ? '<span class="kh-pin">· 📌 נעוץ</span>' : ''}</span></div>
            <div class="kh-tags">${p.hidden ? '<span class="pill no">מוסתר</span>' : ''}<span class="kh-kind k-${esc(p.kind)}">${KIND[p.kind] || 'פוסט'}</span></div></header>
          ${p.title ? `<h2 class="kh-title">${esc(p.title)}</h2>` : ''}<div class="kh-body">${esc(p.body)}</div>
          <div class="kh-acts">
            <button type="button" class="kh-a ${liked ? 'on' : ''}" data-like aria-pressed="${liked}"><span aria-hidden="true">👍</span> ${liked ? 'אהבתי' : 'לייק'}${ls.length ? ' · ' + ls.length : ''}</button>
            <button type="button" class="kh-a" data-reply aria-expanded="${cs.length > 0}"><span aria-hidden="true">💬</span> תגובה${cs.length ? ' · ' + cs.length : ''}</button>
            <span class="kh-sp"></span>
            ${me.admin ? '<button type="button" class="kh-a" data-more aria-expanded="false" aria-label="עוד פעולות ניהול">⋯</button>' : ''}
            ${canDel ? '<button type="button" class="kh-a kh-del" data-del>מחיקה</button>' : ''}
          </div>
          ${me.admin ? `<div class="kh-tools" hidden><button type="button" class="btn btn-w sm" data-pin>${p.pinned ? 'ביטול נעיצה' : 'נעיצה למעלה'}</button><button type="button" class="btn btn-w sm" data-hide>${p.hidden ? 'החזרה לפיד' : 'הסתרה מהפיד'}</button></div>` : ''}
          <div class="kh-confirm" data-pc hidden></div>
          <section class="kh-cmts" aria-label="תגובות" ${cs.length ? '' : 'hidden'}>
            ${cs.map(commentHtml).join('')}
            <form class="kh-cform"><label class="sr" for="c${p.id}">תגובה</label><input id="c${p.id}" maxlength="2000" placeholder="כתבו תגובה..." autocomplete="off"><button class="btn btn-k sm">שליחה</button></form>
          </section>
        </article>`;
      }).join('');
      feed.querySelectorAll('.kh-post').forEach(wire);
    }

    function wire(el) {
      const id = Number(el.dataset.id);
      el.querySelector('[data-like]').onclick = async (e) => {
        const b = e.currentTarget, on = b.classList.contains('on'); b.disabled = true;
        const { error } = on ? await sb.from('too_likes').delete().eq('post_id', id).eq('user_id', uid) : await sb.from('too_likes').insert({ post_id: id });
        if (error) { b.disabled = false; return toast(msg(error), true); } load();
      };
      const cms = el.querySelector('.kh-cmts'), rep = el.querySelector('[data-reply]');
      rep.onclick = () => {
        const has = !!cms.querySelector('.kh-c');
        if (!has) cms.hidden = !cms.hidden; // no comments yet: the reply box opens and closes
        rep.setAttribute('aria-expanded', !cms.hidden);
        if (!cms.hidden) cms.querySelector('input').focus();
      };
      cms.querySelector('form').onsubmit = async (e) => {
        e.preventDefault(); const inp = e.currentTarget.querySelector('input'), btn = e.currentTarget.querySelector('button'), v = inp.value.trim(); if (!v) return;
        btn.disabled = true; const { error } = await sb.from('too_comments').insert({ post_id: id, body: v }); btn.disabled = false;
        if (error) return toast(msg(error), true); load();
      };
      const pc = el.querySelector('[data-pc]');
      const d = el.querySelector('[data-del]');
      if (d) d.onclick = () => confirmIn(pc, 'למחוק את הפוסט וכל התגובות שלו? אי אפשר לשחזר.', async () => {
        const { data, error } = await sb.from('too_posts').delete().eq('id', id).select('id');
        if (error || !(data || []).length) { pc.hidden = true; return toast(error ? msg(error) : 'לא הצלחנו למחוק. רעננו את הדף ונסו שוב.', true); }
        toast('הפוסט נמחק.'); load();
      });
      const more = el.querySelector('[data-more]'), tools = el.querySelector('.kh-tools');
      if (more) more.onclick = () => { tools.hidden = !tools.hidden; more.setAttribute('aria-expanded', !tools.hidden); };
      const pn = el.querySelector('[data-pin]'); if (pn) pn.onclick = async () => { const { error } = await sb.from('too_posts').update({ pinned: !el.classList.contains('pin') }).eq('id', id); if (error) return toast(msg(error), true); load(); };
      const hd = el.querySelector('[data-hide]'); if (hd) hd.onclick = async () => { const was = el.classList.contains('hid'); const { error } = await sb.from('too_posts').update({ hidden: !was }).eq('id', id); if (error) return toast(msg(error), true); toast(was ? 'הפוסט חזר לפיד.' : 'הפוסט הוסתר. רק מנהלים והכותב רואים אותו.'); load(); };
      el.querySelectorAll('[data-cdel]').forEach((b) => b.onclick = () => {
        const c = b.closest('.kh-c'), box = c.querySelector('.kh-confirm');
        confirmIn(box, 'למחוק את התגובה?', async () => {
          const { data, error } = await sb.from('too_comments').delete().eq('id', Number(c.dataset.cid)).select('id');
          if (error || !(data || []).length) { box.hidden = true; return toast(error ? msg(error) : 'לא הצלחנו למחוק. רעננו את הדף ונסו שוב.', true); }
          toast('התגובה נמחקה.'); load();
        });
      });
    }

    async function post(setOpen) {
      const body = document.getElementById('pb').value.trim(), title = document.getElementById('pt').value.trim();
      const kind = app.querySelector('input[name=kind]:checked')?.value || 'post';
      if (body.length < 2) { toast('כתבו כמה מילים לפני הפרסום.', true); document.getElementById('pb').focus(); return; }
      const b = document.getElementById('send'); b.disabled = true;
      const { error } = await sb.from('too_posts').insert({ kind, title: title || null, body, pinned: kind === 'announce' });
      b.disabled = false;
      if (error) return toast(msg(error), true);
      document.getElementById('pb').value = ''; document.getElementById('pt').value = ''; setOpen(false); toast('פורסם.');
      if (filter !== 'all' && filter !== kind) { filter = 'all'; app.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', x.dataset.f === 'all')); }
      load();
    }
  </script>
</Base>
