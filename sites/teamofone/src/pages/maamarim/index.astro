---
import Base from '../../layouts/Base.astro';
import { getArticles, CATS } from '../../lib/articles.js';
const list = await getArticles();
const base = import.meta.env.BASE_URL;
---
<Base title="מאמרים על בינה מלאכותית לעסקים | Team of One" description="חדשות, מדריכים והשוואות כלים של בינה מלאכותית לעסקים קטנים, מתוך מה שבאמת עובד בשטח." app>
  <main class="wrap page">
    <h1>מאמרים.</h1>
    <p class="muted" style="font-size:18px;max-width:60ch">חדשות, מדריכים והשוואות כלים של בינה מלאכותית לעסקים קטנים, מתוך מה שבאמת עובד אצלנו.</p>
    <div class="row" style="margin:18px 0 26px" id="cats"><button class="btn btn-k sm" data-c="">הכל</button>{CATS.map((c) => <button class="btn btn-w sm" data-c={c}>{c}</button>)}</div>
    {list.length ? (
      <div class="grid3" id="list">{list.map((a) => (
        <a class="card" data-cat={a.category} href={base + 'maamarim/' + a.slug + '/'} style="text-decoration:none;display:flex;flex-direction:column;gap:10px">
          <div style="aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:var(--paper2)"><img src={a.cover_url || base + 'img/covers/default.webp'} alt={a.title} loading="lazy" style="width:100%;height:100%;object-fit:cover"></div>
          <span class="pill k" style="width:max-content">{a.category}</span><h2 style="font-size:20px;line-height:1.3">{a.title}</h2><p class="muted" style="margin:0;font-size:15px">{a.description}</p></a>))}</div>
    ) : <div class="empty">המאמרים הראשונים יעלו בקרוב.</div>}
  </main>
  <script>
    const cats = document.getElementById('cats');
    cats.onclick = (e) => { const b = e.target.closest('[data-c]'); if (!b) return; cats.querySelectorAll('button').forEach((x) => (x.className = 'btn sm ' + (x === b ? 'btn-k' : 'btn-w'))); document.querySelectorAll('#list [data-cat]').forEach((el) => (el.hidden = !!b.dataset.c && el.dataset.cat !== b.dataset.c)); };
  </script>
</Base>
