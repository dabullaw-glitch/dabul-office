---
import Base from '../../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="מחשבון: כמה זמן בינה מלאכותית תחזיר לעסק שלכם | Team of One" description="מחשבון חינמי: רושמים משימות חוזרות, כמה זמן הן לוקחות, ומקבלים כמה שעות בחודש אפשר לחסוך ומה השווי שלהן." app>
  <main class="wrap page">
    <div class="crumbs"><a href={base + 'kelim/'}>כלים</a> / מחשבון הזמן</div>
    <h1 style="font-weight:900;font-size:clamp(28px,4vw,44px);margin:0 0 8px">מחשבון הזמן שחוזר אליכם</h1>
    <p class="muted" style="max-width:62ch;margin:0 0 20px">רשמו משימות שחוזרות כל שבוע. ליד כל אחת: כמה דקות היא לוקחת בשבוע, ואיזה חלק ממנה עובד דיגיטלי יכול לקחת. ההערכות שמופיעות הן נקודת התחלה, ואתם יכולים לשנות אותן.</p>
    <div class="card" style="margin-bottom:16px;overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;min-width:560px" id="t"><thead><tr style="text-align:right"><th style="padding:8px">משימה</th><th style="padding:8px">דקות בשבוע</th><th style="padding:8px">כמה אפשר להעביר</th><th></th></tr></thead><tbody></tbody></table>
      <div class="row" style="margin-top:10px"><button class="btn btn-w sm" id="add">הוספת משימה</button></div>
    </div>
    <div class="card" style="margin-bottom:16px"><div class="f" style="max-width:260px"><label for="rate">שווי שעת עבודה שלכם (₪)</label><input id="rate" type="number" min="0" value="250" inputmode="numeric"></div></div>
    <div class="grid3" id="out" aria-live="polite"></div>
    <p class="muted" style="font-size:14px;margin-top:14px">החישוב: דקות בשבוע כפול האחוז שאפשר להעביר, כפול 4.33 שבועות בחודש. זה חיסכון משוער, והזמן שתשקיעו בבדיקה כבר מנוכה מהאחוז.</p>
    <section class="card dk" style="margin-top:20px"><h2 style="color:var(--lime);margin-top:0">מתחילים מהמשימה הכי גדולה ברשימה</h2><p>באתגר החינמי בונים בדיוק את העובד הזה, צעד אחר צעד, בחמישה ימים.</p><a class="btn btn-l" href={base + 'etgar/'}>לאתגר החינמי</a></section>
  </main>
  <script>
    const START = [['תשובות לפניות של לקוחות', 120, 60], ['הצעות מחיר ומסמכים חוזרים', 90, 50], ['פוסטים לרשתות', 120, 60], ['סיכומי שיחות ופגישות', 60, 70], ['מיילים של מעקב', 45, 60]];
    const tb = document.querySelector('#t tbody'), out = document.getElementById('out'), rate = document.getElementById('rate');
    const fmt = (n) => Math.round(n).toLocaleString('he-IL');
    const row = ([name, min, pct]) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td style="padding:6px"><input aria-label="משימה" style="width:100%"></td><td style="padding:6px"><input type="number" min="0" inputmode="numeric" aria-label="דקות בשבוע" style="width:110px"></td><td style="padding:6px"><select aria-label="כמה אפשר להעביר">${[20, 30, 40, 50, 60, 70, 80].map((p) => `<option value="${p}">${p}%</option>`).join('')}</select></td><td><button class="btn btn-w sm" aria-label="מחיקת שורה">✕</button></td>`;
      const [a, b] = tr.querySelectorAll('input'); a.value = name; b.value = min; tr.querySelector('select').value = String(pct);
      tr.querySelector('button').onclick = () => { tr.remove(); calc(); };
      tr.oninput = calc; tr.onchange = calc; tb.appendChild(tr);
    };
    function calc() {
      let saved = 0, total = 0;
      tb.querySelectorAll('tr').forEach((tr) => { const m = Number(tr.querySelectorAll('input')[1].value) || 0, p = Number(tr.querySelector('select').value) / 100; total += m; saved += m * p; });
      const hMonth = (saved * 4.33) / 60, value = hMonth * (Number(rate.value) || 0);
      out.innerHTML = `<div class="kp dk"><b>${fmt(hMonth)} שעות</b><span>חוזרות אליכם בחודש</span></div><div class="kp"><b>${fmt(value)} ₪</b><span>השווי שלהן בחודש</span></div><div class="kp"><b>${fmt(hMonth * 12)} שעות</b><span>בשנה (מתוך ${fmt((total * 4.33 * 12) / 60)} שעות על המשימות האלה)</span></div>`;
    }
    START.forEach(row); rate.oninput = calc;
    document.getElementById('add').onclick = () => { row(['', 30, 50]); calc(); tb.lastElementChild.querySelector('input').focus(); };
    calc();
  </script>
</Base>
