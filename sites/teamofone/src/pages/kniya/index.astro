---
import Base from '../../layouts/Base.astro';
---
<Base title="השלמת הצטרפות | Team of One" app>
  <main class="wrap page" style="max-width:760px">
    <h1>כמעט<br>בפנים.</h1>
    <div id="box" class="vstack"><div class="card">טוען...</div></div>
  </main>
  <script>
    import { sb, BASE, esc, ils, errText, toast } from '../../lib/sb.js';
    const code = new URLSearchParams(location.search).get('plan') || 'course';
    const box = document.getElementById('box');
    (async () => {
      const { data: s } = await sb.auth.getSession();
      if (!s.session) { location.replace(BASE + 'knisa/?plan=' + encodeURIComponent(code)); return; }
      const [{ data: plan }, { data: tm }, { data: me }, { data: mp }] = await Promise.all([
        sb.from('too_plans').select('*').eq('code', code).maybeSingle(),
        sb.from('too_settings').select('value').eq('key', 'test_mode').maybeSingle(),
        sb.rpc('too_me'), sb.rpc('too_my_price', { p_plan: code })]);
      if (!plan) { box.innerHTML = '<div class="card">המסלול לא נמצא. <a href="' + BASE + '#price">חזרה למסלולים</a></div>'; return; }
      const test = tm && tm.value === true;
      const intro = mp && mp.intro !== null && mp.intro !== undefined ? Number(mp.intro) : null;
      const perks = (plan.perks || []).map((p) => '<li style="display:flex;gap:10px"><span class="pill ok">✓</span>' + esc(p) + '</li>').join('');
      box.innerHTML = `
        <div class="card">
          <div class="spread"><h2>${esc(plan.name)}</h2><span class="pill k">${plan.kind === 'monthly' ? 'מנוי חודשי' : 'תשלום אחד'}</span></div>
          ${intro !== null ? `<span class="pill l" style="margin-top:8px">מבצע השקה</span><div style="font-family:var(--disp);font-size:90px;line-height:.85;margin:10px 0">${ils(intro)}<small style="font-family:var(--body);font-size:18px;color:var(--mutD)"> לחודש הראשון</small></div><p style="margin:0 0 4px;font-weight:700">אחר כך ${ils(plan.price_ils)} לחודש. מבטלים מתי שרוצים.</p>` : `<div style="font-family:var(--disp);font-size:90px;line-height:.85;margin:10px 0">${ils(plan.price_ils)}${plan.kind === 'monthly' ? '<small style="font-family:var(--body);font-size:18px;color:var(--mutD)"> לחודש</small>' : ''}</div>`}
          <ul style="list-style:none;padding:0;margin:14px 0 0;display:grid;gap:10px">${perks}</ul>
        </div>
        <div class="card ${test ? '' : 'dk'}">
          ${test ? `<div class="row" style="margin-bottom:10px"><span class="pill warn">מצב בדיקה</span><b>לא יבוצע חיוב.</b></div>
            <p class="muted" style="margin:0 0 16px">האתר עדיין בבדיקה, והתשלום האמיתי עוד לא מחובר. הלחיצה פותחת גישה כאילו שילמתם, כדי לבדוק שהכל עובד.</p>
            <button class="btn btn-k wide" id="go">השלמת רכישת בדיקה <span class="arrow">←</span></button>`
          : `<h3>התשלום באתר ייפתח בקרוב</h3><p class="mut" style="margin:0">נעדכן אתכם במייל ברגע שאפשר להצטרף.</p>`}
          <p class="muted" style="font-size:14px;margin:14px 0 0">${plan.kind === 'monthly' ? 'מבטלים בכל חודש, בלחיצה באזור האישי.' : '14 ימים להחזר כספי מלא, אם עוד לא התחלתם לצפות.'} <a href="${BASE}tnaim/" target="_blank">תנאי השימוש</a></p>
        </div>
        ${me && me.access ? '<div class="card"><b>כבר יש לכם גישה פעילה.</b> <a href="' + BASE + 'ezor-ishi/">לאזור האישי</a></div>' : ''}`;
      const go = document.getElementById('go');
      if (go) go.onclick = async () => {
        go.disabled = true;
        const { error } = await sb.rpc('too_checkout_test', { p_plan: code });
        if (error) { toast(errText(error), true); go.disabled = false; return; }
        location.replace(BASE + 'ezor-ishi/?welcome=1');
      };
    })();
  </script>
</Base>
