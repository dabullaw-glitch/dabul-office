---
import Base from '../layouts/Base.astro';
import A from '../data/landing-a.html?raw';
import B from '../data/landing-b.html?raw';
import FALLBACK from '../data/articles-fallback.html?raw';
import { getArticles, CATS } from '../lib/articles.js';
import { getCatalog, teaserHtml } from '../lib/catalog.js';
const base = import.meta.env.BASE_URL;
const fix = (s) => s.replaceAll('__BASE__', base);
const arts = await getArticles();
const cat = await getCatalog();
const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
let ARTS = FALLBACK;
if (arts.length) {
  const f = arts[0], rest = arts.slice(1, 4);
  ARTS = `<section class="paper pad" id="articles"><div class="wrap">
    <div class="split-h reveal"><div><span class="tag"><i></i>מאמרים</span><h2 class="h2" style="margin-top:16px">בינה מלאכותית<br>לעסקים. מהשטח.</h2></div><p class="lead mut">חדשות, מדריכים והשוואות כלים, מתוך מה שבאמת עובד אצלי. בלי הייפ, עם צילומי מסך ומספרים. מתעדכן כל שבוע.</p></div>
    <div class="cats reveal"><a href="${base}maamarim/" style="text-decoration:none"><span style="background:var(--ink);color:var(--lime)">לכל המאמרים</span></a>${CATS.map((c) => `<span>${c}</span>`).join('')}</div>
    <div class="arts2">
      <a class="feat reveal" href="${base}maamarim/${f.slug}/"><div class="th"><img src="${esc(f.cover_url || base + 'img/covers/default.webp')}" alt="${esc(f.title)}" loading="lazy"><span>${esc(f.category)}</span></div><h3>${esc(f.title)}</h3><p>${esc(f.description)}</p></a>
      <ul class="alist reveal">${rest.map((a) => `<li><a href="${base}maamarim/${a.slug}/"><span><em>${esc(a.category)}</em><b>${esc(a.title)}</b></span><span class="go">←</span></a></li>`).join('')}</ul>
    </div><div style="margin-top:28px;text-align:center"><a class="btn btn-k" href="${base}maamarim/">לכל המאמרים <span class="arrow">←</span></a></div></div></section>`;
}
// "קורסים": every course on the site as an equal card (the full course and the single courses), prices from too_plans.
// #course (old "תוכנית הקורס") and #more-courses (old "קורסים נוספים") both land here.
const COURSES = `<section class="pad kts" id="course" aria-labelledby="kch">
  <div class="wrap">
    <div class="split-h reveal"><div><span class="tag" style="color:var(--fg)"><i></i>קורסים</span><h2 class="h2" id="kch" style="margin-top:16px">${cat.courses.length} קורסים.<br>בוחרים מה לבנות.</h2></div>
      <p class="lead mut">קורס מלא שבונה צוות שלם, וקורסים ממוקדים שכל אחד מהם בונה דבר אחד. שיעורים מוקלטים, עם הדגמה על המסך ותבניות מוכנות. קונים קורס אחד, או מצטרפים למנוי שכולל את כולם.</p></div>
    <div class="kt-grid" id="more-courses">
      ${cat.courses.map((c) => teaserHtml(c, base)).join('')}
      <a class="kt kt-all reveal" href="${base}kursim/"><span class="kt-top"><em>כל הקורסים</em></span><h3>משווים<br>ובוחרים.</h3><span class="kt-sub">כל השיעורים של כל קורס, כמה זמן הוא לוקח, ומה המסלולים להצטרפות.</span><span class="kt-foot"><span class="kt-go">לכל הקורסים <span aria-hidden="true">←</span></span></span></a>
    </div>
    <div class="kt-cta reveal"><a class="btn btn-l" href="${base}kursim/">לכל הקורסים <span class="arrow" aria-hidden="true">←</span></a>${cat.monthly ? `<span>מנוי חודשי${cat.monthly.intro ? `: החודש הראשון ב-${cat.monthly.intro}, ואחר כך ${cat.monthly.price} לחודש` : `: ${cat.monthly.price} לחודש`}. כולל את כל הקורסים.</span>` : ''}</div>
  </div>
</section>`;
// landing-b counts: every course on the site (the full course + the single courses), from the database
const nCourses = cat.courses && cat.courses.length ? cat.courses.length : 5;
const fixB = (s) => fix(s).replaceAll('__NCOURSES__', String(nCourses)).replaceAll('__NSINGLES__', String(nCourses - 1));
const html = fix(A).replace(/<!--COURSES:[^>]*-->/, () => COURSES) + (arts.length ? ARTS : fix(FALLBACK)) + fixB(B);
const jsonld = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Course', name: 'Team of One: צוות שלם. אדם אחד.', description: 'קורס דיגיטלי לבניית צוות של בינה מלאכותית לעסק: מאמרים, קידום בגוגל, סרטונים, רשתות, מענה לפניות ואתר.', inLanguage: 'he', provider: { '@type': 'Person', name: 'יקיר דבול' },
    offers: [{ '@type': 'Offer', price: cat.course ? cat.course.raw : 990, priceCurrency: 'ILS', category: 'Paid' }], hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT10H' } },
  { '@type': 'Person', name: 'יקיר דבול', jobTitle: 'עורך דין', knowsAbout: ['בינה מלאכותית לעסקים', 'קידום אתרים', 'אוטומציה'] } ] };
---
<Base title="Team of One: צוות שלם. אדם אחד." jsonld={jsonld}>
  <div id="testbar" class="testbar" hidden>אתר בבדיקה. הרכישות כאן הן לבדיקה בלבד, בלי חיוב.</div>
  <Fragment set:html={html} />
  <div class="mjoin" id="mjoin" aria-hidden="true"><span>חודש ראשון ב-1 ₪</span><a class="btn btn-l" href="#price" tabindex="-1">למסלולים <span class="arrow">←</span></a></div>
  <script>
    import { sb, BASE } from '../lib/sb.js';
    // phones: a small join bar once the visitor has scrolled past the first screen, hidden while the prices are on screen
    (() => {
      const bar = document.getElementById('mjoin'), price = document.getElementById('price'); if (!bar) return;
      let priceIn = false;
      if (price && 'IntersectionObserver' in window) new IntersectionObserver((es) => { priceIn = es[0].isIntersecting; tick(); }).observe(price);
      function tick() { const on = window.scrollY > window.innerHeight * 0.9 && !priceIn; bar.classList.toggle('on', on); bar.setAttribute('aria-hidden', on ? 'false' : 'true'); bar.querySelector('a').tabIndex = on ? 0 : -1; }
      window.addEventListener('scroll', tick, { passive: true }); tick();
    })();
    sb.from('too_settings').select('value').eq('key', 'test_mode').maybeSingle().then(({ data }) => { if (data && data.value === true) document.getElementById('testbar').hidden = false; });
    sb.auth.getSession().then(({ data }) => { if (data.session) { const a = document.querySelector('.navlogin'); if (a) { a.textContent = 'האזור האישי'; a.href = BASE + 'ezor-ishi/'; } } });
  </script>
</Base>
