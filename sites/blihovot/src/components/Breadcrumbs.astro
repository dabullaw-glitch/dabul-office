---
interface Props { items: { href?: string; label: string }[] }
const { items } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<nav class="bc" aria-label="פירורי לחם">
  <ol>
    <li><a href={B}>ראשי</a></li>
    {items.map((it) => <li>{it.href ? <a href={B + it.href.replace(/^\//, '')}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>)}
  </ol>
</nav>
<style>
.bc ol{list-style:none;display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0 0 14px;font-size:.88rem;color:var(--muted)}
.bc li+li:before{content:"‹";margin-inline-end:6px;color:var(--line)}
.bc a{color:var(--muted);text-decoration:none}.bc a:hover{color:var(--teal);text-decoration:underline}
</style>
