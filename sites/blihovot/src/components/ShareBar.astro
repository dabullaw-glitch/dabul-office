---
// "Send it to someone who needs it": WhatsApp, the phone's own share sheet (when it has one) and copy link.
// kind: what is shared, for the wording ('guide' | 'tool' | 'page').
interface Props { title: string; url: string; kind?: 'guide' | 'tool' | 'page' }
const { title, url, kind = 'guide' } = Astro.props;
const lead = kind === 'tool' ? 'מצאתי כלי חינמי שיכול לעזור:' : 'מצאתי מדריך שיכול לעזור:';
const waText = `${lead}\n${title}\n${url}`;
const head = kind === 'tool' ? 'מכירים מישהו שהכלי הזה יעזור לו?' : 'מכירים מישהו שהמדריך הזה יעזור לו?';
---
<aside class="shr no-embed" aria-label="שיתוף" data-url={url} data-title={title}>
  <p class="shr-h"><b>{head}</b> <span>שלחו לו. לפעמים זה כל מה שצריך כדי להתחיל.</span></p>
  <div class="shr-b">
    <a class="btn shr-wa" href={`https://wa.me/?text=${encodeURIComponent(waText)}`} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 .9-2.3c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.6-.1 1.2z"/></svg>
      שליחה בוואטסאפ
    </a>
    <button class="btn btn-line shr-native" type="button" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 8l5-5 5 5M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/></svg>
      שיתוף
    </button>
    <button class="btn btn-line shr-copy" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
      <span>העתקת קישור</span>
    </button>
  </div>
</aside>
<style is:global>
.shr{margin:30px 0;padding:18px 20px;border-radius:var(--r);background:var(--sand);border:1px solid var(--line)}
.shr-h{margin:0 0 12px;line-height:1.5}.shr-h span{color:var(--ink-2)}
.shr-b{display:flex;flex-wrap:wrap;gap:10px}
.shr .btn svg{width:20px;height:20px;flex:none}
.shr-wa{background:#1f8f4e;color:#fff}.shr-wa:hover{background:#18763f;color:#fff}
@media (max-width:520px){.shr-b .btn{flex:1 1 100%}}
</style>
<script>
document.querySelectorAll<HTMLElement>('.shr').forEach((box) => {
  const url = box.dataset.url || location.href, title = box.dataset.title || document.title;
  const nat = box.querySelector<HTMLButtonElement>('.shr-native')!;
  if (navigator.share) { nat.hidden = false; nat.addEventListener('click', () => { navigator.share({ title, url }).catch(() => {}); }); }
  const cp = box.querySelector<HTMLButtonElement>('.shr-copy')!, lbl = cp.querySelector('span')!;
  cp.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(url); } catch { const t = document.createElement('textarea'); t.value = url; document.body.appendChild(t); t.select(); document.execCommand('copy'); t.remove(); }
    lbl.textContent = 'הקישור הועתק ✓'; setTimeout(() => { lbl.textContent = 'העתקת קישור'; }, 2200);
  });
});
</script>
