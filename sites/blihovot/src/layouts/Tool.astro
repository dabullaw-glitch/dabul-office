---
// Shared frame for every calculator: title, the tool itself (slot), how it works, FAQ, sources, related guides and the lead form.
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import GuideCard from '../components/GuideCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../data/site';
interface Props { id: string; title: string; h1: string; description: string; intro: string; faq?: { q: string; a: string }[]; sources: { title: string; url: string }[]; related?: string[] }
const { id, title, h1, description, intro, faq = [], sources, related = [] } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const all = await getCollection('guides');
const rel = related.map((s) => all.find((g) => g.id === s)).filter(Boolean);
const url = new URL(`${B}kli/${id}/`, Astro.site).href;
const schema: object[] = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: h1, description, url, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', inLanguage: 'he-IL', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'ILS' }, publisher: { '@id': new URL(B + '#org', Astro.site).href } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'ראשי', item: new URL(B, Astro.site).href }, { '@type': 'ListItem', position: 2, name: 'מחשבונים וכלים', item: new URL(`${B}kli/`, Astro.site).href }, { '@type': 'ListItem', position: 3, name: h1, item: url }] },
];
if (faq.length) schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base title={title} description={description} schema={schema}>
  <div class="wrap tool-pg">
    <Breadcrumbs items={[{ href: 'kli/', label: 'מחשבונים וכלים' }, { label: h1 }]} />
    <h1>{h1}</h1>
    <p class="lede">{intro}</p>
    <section class="tool-box card" aria-label={h1}><slot /></section>
    <p class="note">התוצאה היא הערכה כללית לפי הנתונים שהזנתם ולפי הכללים המפורסמים, ולא ייעוץ משפטי. הנתונים שמזינים לא נשלחים לשום מקום ונשארים במכשיר שלכם.</p>
    <div class="cols2">
      <div class="prose"><slot name="explain" /></div>
    </div>
    <AdSlot />
    {faq.length > 0 && (
      <section class="faq" aria-labelledby="tf-h"><h2 id="tf-h">שאלות נפוצות</h2>{faq.map((f) => <details><summary>{f.q}</summary><div set:html={f.a} /></details>)}</section>
    )}
    <section class="src"><h2>מקורות</h2><ul>{sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}</ul></section>
    {rel.length > 0 && (<section style="margin:30px 0"><h2>מדריכים קשורים</h2><div class="grid g2">{rel.map((g) => <GuideCard g={g} />)}</div></section>)}
    <LeadForm source={`tool:${id}`} />
  </div>
</Base>
<style>
.tool-pg{padding-block:28px 10px;max-width:960px}
.lede{font-size:1.12rem;color:var(--ink-2);max-width:65ch}
.tool-box{padding:26px;margin:22px 0 10px;border-top:5px solid var(--teal)}
.faq details{border-bottom:1px solid var(--line);padding:14px 0}
.faq summary{cursor:pointer;font-weight:700;font-size:1.05rem}
.faq details div{margin-top:8px;color:var(--ink-2)}
.src ul{padding-inline-start:1.2em}
.cols2{margin-top:26px}
</style>
<style is:global>
.tool-box .q{margin-bottom:22px}
.tool-box .q>b{display:block;font-size:1.08rem;margin-bottom:10px}
.tool-box .opts{display:flex;flex-wrap:wrap;gap:8px}
.tool-box .opts label{display:inline-flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:999px;padding:9px 16px;cursor:pointer;background:var(--card);font-size:.98rem}
.tool-box .opts input{accent-color:var(--teal);width:18px;height:18px;margin:0}
.tool-box .opts label:has(input:checked){border-color:var(--teal);background:var(--teal-soft);font-weight:700}
.tool-box .opts label:has(input:focus-visible){outline:3px solid var(--focus);outline-offset:2px}
.tool-box .num{display:flex;align-items:center;gap:8px;max-width:320px}
.tool-box .num input{font:inherit;font-size:1.1rem;padding:11px 14px;border:1.5px solid var(--line);border-radius:var(--r-s);width:100%;background:var(--card);color:var(--ink);font-variant-numeric:tabular-nums}
.tool-box .num input:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px var(--teal-soft)}
.tool-box .row{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.tool-box .row label{display:grid;gap:6px;font-weight:700;font-size:.95rem}
.res{margin-top:22px;padding:20px 22px;border-radius:var(--r);background:var(--sand);border:1px solid var(--line)}
.res[hidden]{display:none}
.res h2{margin:0 0 .4em;font-size:1.45rem}
.res .big{font:700 2.2rem/1.1 var(--ff-d);color:var(--teal-2);font-variant-numeric:tabular-nums}
.res.good{background:var(--teal-soft);border-color:color-mix(in srgb,var(--teal) 40%,transparent)}
.res.warn{background:var(--sun-soft);border-color:color-mix(in srgb,var(--sun) 50%,transparent)}
.res.bad{background:var(--rose-soft);border-color:color-mix(in srgb,var(--rose) 40%,transparent)}
.res ul{margin:.4em 0 0;padding-inline-start:1.2em}
.res .next{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-top:10px}
.kv div{background:var(--card);border:1px solid var(--line);border-radius:var(--r-s);padding:12px 14px}
.kv small{display:block;color:var(--muted);font-size:.85rem}.kv b{font-size:1.25rem;font-variant-numeric:tabular-nums}
</style>
