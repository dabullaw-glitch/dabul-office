---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { HUBS } from '../../data/site';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const all = (await getCollection('guides')).filter((g) => !g.data.draft);
---
<Base title="כל המדריכים: חדלות פירעון, הוצאה לפועל והסדרי חוב" description={`${all.length} מדריכים בשפה פשוטה על חובות: חדלות פירעון, הוצאה לפועל, איחוד תיקים, הסדרי חוב, עצמאים והחיים אחרי ההפטר.`}>
  <div class="wrap" style="padding-block:28px 40px">
    <Breadcrumbs items={[{ label: 'כל המדריכים' }]} />
    <h1>כל המדריכים</h1>
    {HUBS.map((h) => {
      const list = all.filter((g) => g.data.hub === h.id).sort((a, b) => a.data.order - b.data.order);
      return list.length > 0 && (
        <section style="margin-top:34px"><div class="sec-head"><h2 style="margin:0">{h.title}</h2><a href={`${B}nose/${h.id}/`}>לעמוד הנושא ←</a></div><div class="grid g3">{list.map((g) => <GuideCard g={g} showHub={false} />)}</div></section>
      );
    })}
  </div>
</Base>
