---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import GuideCard from '../../components/GuideCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Video from '../../components/Video.astro';
import { HUBS, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';
import videos from '../../data/videos.json';

export async function getStaticPaths() {
  const all = (await getCollection('guides')).filter((g) => !g.data.draft);
  return all.map((g) => ({ params: { slug: g.id }, props: { g, all } }));
}
const { g, all } = Astro.props;
const { Content, headings } = await render(g);
const d = g.data;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const hub = HUBS.find((h) => h.id === d.hub)!;
const toc = headings.filter((h) => h.depth === 2);
// related: the ones named in the file first, then the closest in the same hub
const named = d.related.map((s) => all.find((x) => x.id === s)).filter(Boolean);
const sameHub = all.filter((x) => x.data.hub === d.hub && x.id !== g.id && !d.related.includes(x.id)).sort((a, b) => a.data.order - b.data.order);
const related = [...named, ...sameHub].slice(0, 3);
const tool = d.tool ? TOOLS.find((t) => t.id === d.tool) : null;
const video = d.video ? (videos as any[]).find((v) => v.id === d.video) : null;
const fmt = (x: Date) => x.toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
const words = (g.body || '').split(/\s+/).length;
const minutes = Math.max(2, Math.round(words / 190));
const url = new URL(`${B}madrich/${g.id}/`, Astro.site).href;
const schema: object[] = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, inLanguage: 'he-IL', datePublished: d.published.toISOString(), dateModified: d.updated.toISOString(), mainEntityOfPage: url,
    author: { '@type': 'Organization', name: `מערכת ${SITE.name}`, url: new URL(`${B}odot/`, Astro.site).href }, publisher: { '@id': new URL(B + '#org', Astro.site).href },
    image: new URL(`${B}og/${g.id}.png`, Astro.site).href, about: hub.title, citation: d.sources.map((s) => s.url), wordCount: words },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ראשי', item: new URL(B, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: hub.title, item: new URL(`${B}nose/${hub.id}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url }] },
];
if (d.faq.length) schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
if (video) schema.push({ '@context': 'https://schema.org', '@type': 'VideoObject', name: video.title, description: video.description, thumbnailUrl: new URL(B + video.poster.replace(/^\//, ''), Astro.site).href, contentUrl: new URL(B + video.src.replace(/^\//, ''), Astro.site).href, uploadDate: video.date, duration: video.duration });
---
<Base title={d.seoTitle || d.title} description={d.description} type="article" schema={schema} image={`og/${g.id}.png`}>
  <article class="wrap art">
    <header class="ah">
      <Breadcrumbs items={[{ href: `nose/${hub.id}/`, label: hub.title }, { label: d.title }]} />
      <h1>{d.title}</h1>
      <p class="meta muted"><span>עודכן: <time datetime={d.updated.toISOString().slice(0, 10)}>{fmt(d.updated)}</time></span><span>{minutes} דקות קריאה</span><span>נבדק מול {d.sources.length} {d.sources.length === 1 ? 'מקור רשמי' : 'מקורות'}</span></p>
    </header>
    <div class="cols">
      <div class="main">
        <section class="tldr" aria-labelledby="tldr-h">
          <h2 id="tldr-h">בקצרה</h2>
          <ul>{d.summary.map((s) => <li set:html={s} />)}</ul>
        </section>
        {toc.length > 2 && (
          <details class="toc-m" open={false}><summary>מה במדריך</summary><ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details>
        )}
        <div class="prose"><Content /></div>
        {video && <Video v={video} />}
        {tool && (
          <a class="toolcta card" href={`${B}kli/${tool.id}/`}><span class="tag">מחשבון</span><b>{tool.title}</b><span class="muted">{tool.blurb}</span><span class="go">{tool.cta} ←</span></a>
        )}
        <AdSlot />
        {d.faq.length > 0 && (
          <section class="faq" aria-labelledby="faq-h">
            <h2 id="faq-h">שאלות נפוצות</h2>
            {d.faq.map((f) => <details><summary>{f.q}</summary><div set:html={f.a} /></details>)}
          </section>
        )}
        <section class="src" aria-labelledby="src-h">
          <h2 id="src-h">מקורות</h2>
          <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ul>
          <p class="note">המדריך נכתב על ידי מערכת {SITE.name} לפי החוק ולפי המקורות הרשמיים שלמעלה, ונבדק לאחרונה ב-{fmt(d.updated)}. הוא מידע כללי בלבד ואינו ייעוץ משפטי. <a href={`${B}odot/`}>איך אנחנו כותבים ובודקים</a>.</p>
        </section>
        <LeadForm source={`guide:${g.id}`} />
      </div>
      <aside class="side" aria-label="בצד">
        {toc.length > 2 && (
          <nav class="toc card" aria-label="תוכן המדריך"><b>מה במדריך</b><ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
        )}
        <div class="card sidecta">
          <b>לא בטוחים מה מתאים לכם?</b>
          <p>6 שאלות קצרות, ותדעו איזה הליך הכי רלוונטי למצב שלכם.</p>
          <a class="btn btn-teal" href={`${B}kli/eize-halich/`}>לבדיקה</a>
        </div>
      </aside>
    </div>
    {related.length > 0 && (
      <section class="rel" aria-labelledby="rel-h"><h2 id="rel-h">כדאי לקרוא גם</h2><div class="grid g3">{related.map((r) => <GuideCard g={r} />)}</div></section>
    )}
  </article>
</Base>
<style>
.art{padding-block:28px 10px}
.ah{max-width:880px}
.meta{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:.92rem;margin:0 0 22px}
.meta span+span:before{content:"·";margin-inline-end:18px;color:var(--line)}
.cols{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:48px;align-items:start}
.main{min-width:0;max-width:var(--w-text)}
.side{position:sticky;top:92px;display:grid;gap:16px}
@media (max-width:1000px){.cols{grid-template-columns:1fr}.side{display:none}}
.tldr{background:var(--teal-soft);border:1px solid color-mix(in srgb,var(--teal) 30%,transparent);border-radius:var(--r);padding:18px 22px;margin-bottom:26px}
.tldr h2{font:700 1.05rem/1.3 var(--ff);margin:0 0 8px;color:var(--teal-2)}
.tldr ul{margin:0;padding-inline-start:1.2em}.tldr li{margin:.3em 0}
.toc{padding:18px}.toc b{display:block;margin-bottom:8px}
.toc ol,.toc-m ol{margin:0;padding-inline-start:1.2em;font-size:.93rem;line-height:1.5;display:grid;gap:6px}
.toc a,.toc-m a{color:var(--ink-2);text-decoration:none}.toc a:hover,.toc-m a:hover{color:var(--teal);text-decoration:underline}
.toc-m{display:none;border:1px solid var(--line);border-radius:var(--r-s);padding:12px 16px;margin-bottom:22px;background:var(--card)}
.toc-m summary{font-weight:700;cursor:pointer}
.toc-m ol{margin-top:10px}
@media (max-width:1000px){.toc-m{display:block}}
.sidecta p{font-size:.93rem;color:var(--muted);margin:6px 0 12px}
.toolcta{display:grid;gap:4px;margin:30px 0;border-inline-start:5px solid var(--sun)}
.toolcta b{font-size:1.15rem}.toolcta .go{color:var(--teal);font-weight:700;margin-top:4px}
.faq details{border-bottom:1px solid var(--line);padding:14px 0}
.faq summary{cursor:pointer;font-weight:700;font-size:1.05rem;list-style:none;display:flex;justify-content:space-between;gap:12px}
.faq summary::-webkit-details-marker{display:none}
.faq summary:after{content:"+";color:var(--teal);font-size:1.4rem;line-height:1}
.faq details[open] summary:after{content:"−"}
.faq details div{margin-top:8px;color:var(--ink-2)}
.src ul{padding-inline-start:1.2em;font-size:.95rem}
.src{margin-bottom:34px}
.rel{padding-block:30px 20px}
</style>
