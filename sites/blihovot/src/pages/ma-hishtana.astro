---
// "מה השתנה": the numbers the site quotes, each with its official source and the date it was last checked,
// a monthly log of changes (src/data/updates.json) and the newest guides. Updated by the monthly check task.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ShareBar from '../components/ShareBar.astro';
import numbers from '../data/numbers.json';
import updates from '../data/updates.json';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const url = new URL(`${B}ma-hishtana/`, Astro.site).href;
const guides = (await getCollection('guides')).filter((g) => !g.data.draft);
const titleOf = (slug?: string) => guides.find((g) => g.id === slug)?.data.title;
const fmt = (s: string) => new Date(s + 'T12:00:00').toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
const lastCheck = [...numbers.map((n) => n.checked), ...updates.map((u) => u.date)].sort().pop()!;
const log = [...updates].sort((a, b) => b.date.localeCompare(a.date));
const fresh = [...guides].sort((a, b) => +b.data.published - +a.data.published || +b.data.updated - +a.data.updated).slice(0, 8);
const topics = [...new Set(numbers.map((n) => n.topic))];
const KIND: Record<string, string> = { law: 'שינוי בחוק', numbers: 'מספרים', check: 'בדיקה', site: 'באתר' };
const schema = [{ '@context': 'https://schema.org', '@type': 'WebPage', name: 'מה השתנה: הסכומים, הספים והמועדים העדכניים', url, inLanguage: 'he-IL', dateModified: lastCheck, description: 'הסכומים, הספים והמועדים העדכניים בחדלות פירעון ובהוצאה לפועל, כל אחד עם מקור רשמי ותאריך בדיקה, ויומן עדכונים חודשי.', publisher: { '@id': new URL(B + '#org', Astro.site).href } }];
---
<Base title="מה השתנה: הסכומים, הספים והמועדים העדכניים בחובות ובהוצאה לפועל" description="כל המספרים החשובים בחדלות פירעון ובהוצאה לפועל במקום אחד: סף ההליך, סכום מוגן מעיקול שכר, מועדי התנגדות ודוחות, עם מקור רשמי ותאריך בדיקה. מתעדכן כל חודש." schema={schema}>
  <div class="wrap mh">
    <Breadcrumbs items={[{ label: 'מה השתנה' }]} />
    <h1>מה השתנה החודש</h1>
    <p class="lede">הסכומים, הספים והמועדים בחוק משתנים מעת לעת. פעם בחודש אנחנו בודקים את כל המספרים שמופיעים באתר מול המקורות הרשמיים, מעדכנים את המדריכים, ורושמים כאן מה השתנה.</p>
    <p class="stamp"><span class="dot" aria-hidden="true"></span> הבדיקה האחרונה: <time datetime={lastCheck}>{fmt(lastCheck)}</time></p>

    <section aria-labelledby="n-h">
      <h2 id="n-h">המספרים החשובים עכשיו</h2>
      {topics.map((t) => (
        <>
          <h3 class="tp">{t}</h3>
          <div class="nums card">
            {numbers.filter((n) => n.topic === t).map((n) => (
              <article class="num" id={n.id}>
                <p class="lb">{n.label}</p>
                {n.value.includes(' · ')
                  ? <ul class="vl vl-list">{n.value.split(' · ').map((v) => <li>{v}</li>)}</ul>
                  : <p class="vl">{n.value}</p>}
                {n.note && <p class="nt">{n.note}</p>}
                <p class="mt">
                  <span>נבדק: {fmt(n.checked)}</span>
                  <a href={n.src.url} target="_blank" rel="noopener">מקור רשמי</a>
                  {titleOf(n.guide) && <a href={`${B}madrich/${n.guide}/`}>למדריך המלא</a>}
                </p>
              </article>
            ))}
          </div>
        </>
      ))}
    </section>

    <section aria-labelledby="l-h">
      <h2 id="l-h">יומן עדכונים</h2>
      {log.map((m) => (
        <div class="mon">
          <h3>{m.title}</h3>
          <ul>{m.items.map((it: any) => <li><span class={`k k-${it.kind}`}>{KIND[it.kind] || 'עדכון'}</span> {it.text}{it.guide && titleOf(it.guide) && <> <a href={`${B}madrich/${it.guide}/`}>{titleOf(it.guide)}</a></>}</li>)}</ul>
        </div>
      ))}
    </section>

    <section aria-labelledby="f-h">
      <h2 id="f-h">חדש באתר</h2>
      <ul class="fresh">{fresh.map((g) => <li><a href={`${B}madrich/${g.id}/`}>{g.data.title}</a></li>)}</ul>
    </section>

    <ShareBar title="מה השתנה: הסכומים והמועדים העדכניים בחובות ובהוצאה לפועל" url={url} kind="page" />
    <p class="note">המידע כללי בלבד ואינו ייעוץ משפטי. לפני פעולה, בדקו את המקור הרשמי המעודכן. מצאתם מספר שהשתנה לפני שעדכנו? <a href={`${B}tzor-kesher/`}>כתבו לנו</a>.</p>
  </div>
</Base>
<style>
.mh{padding-block:28px 50px;max-width:980px}
.lede{font-size:1.1rem;color:var(--ink-2);max-width:68ch}
.stamp{display:inline-flex;align-items:center;gap:8px;background:var(--teal-soft);color:var(--teal-2);font-weight:700;border-radius:999px;padding:6px 14px;margin:4px 0 10px}
.dot{width:9px;height:9px;border-radius:50%;background:var(--teal)}
.tp{font-family:var(--ff);font-size:1rem;color:var(--muted);margin:26px 0 10px}
.nums{padding:4px 22px;max-width:820px}
.num{display:grid;gap:4px;padding:16px 0;border-bottom:1px solid var(--line)}
.num:last-child{border-bottom:0}
.num p{margin:0}
.lb{font-weight:700;line-height:1.4}
.vl{font:700 1.15rem/1.45 var(--ff);color:var(--teal-2);font-variant-numeric:tabular-nums}
.vl-list{list-style:none;padding:0;margin:4px 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:6px 18px;font-size:1rem}
.vl-list li{border-inline-start:3px solid var(--teal-soft);padding-inline-start:10px}
.nt{font-size:.93rem;color:var(--ink-2)}
.mt{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:.85rem;color:var(--muted);margin-top:2px!important}
.mon{border-inline-start:3px solid var(--sun);padding:2px 16px 2px 0;margin:14px 0 22px}
.mon h3{margin:0 0 8px;font-size:1.15rem}
.mon ul{margin:0;padding:0;list-style:none;display:grid;gap:10px}
.k{display:inline-block;font-size:.78rem;font-weight:700;border-radius:999px;padding:2px 10px;margin-inline-end:4px;background:var(--sand);color:var(--ink-2);border:1px solid var(--line)}
.k-law{background:var(--rose-soft);color:var(--rose)}.k-numbers{background:var(--sun-soft)}.k-check{background:var(--teal-soft);color:var(--teal-2)}
.fresh{padding-inline-start:1.2em;display:grid;gap:6px}
section{margin-top:34px}
</style>
