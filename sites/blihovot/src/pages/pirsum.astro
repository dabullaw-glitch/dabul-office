---
import Page from '../layouts/Page.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sample = (await getCollection('sponsored')).filter((a) => !a.data.draft).sort((x, y) => +y.data.published - +x.data.published)[0];
---
<Page title="פרסום באתר: כתבות ממומנות ומודעות" description="פרסום באתר בלי חובות: כתבה ממומנת מסומנת בנושאי כסף וחובות, עם קישור לאתר שלכם. מה מקבלים, איך התהליך עובד ואיך מזמינים אותה. המחיר לפי בקשה.">
  <p>האתר מגיע לאנשים שמחפשים מידע על חובות, הוצאה לפועל, חדלות פירעון וניהול כסף. אפשר לפרסם אצלנו בכמה דרכים.</p>

  <h2 id="kitva">1. כתבה ממומנת</h2>
  <p>כתבה בנושא שקשור לתחומי האתר: ניהול כסף, אשראי, ייעוץ פיננסי, שירותים משפטיים, ביטוח ועוד. הכתבה מתפרסמת במדור <a href={`${B}tochen-memuman/`}>התוכן הממומן</a>, בעיצוב של האתר, ונשארת באתר.</p>

  <h3>מה מקבלים</h3>
  <ul>
    <li><strong>כתבה בעמוד משלה</strong> באתר, עם כותרת, תקציר "בקצרה", שאלות נפוצות ותמונה (אם יש לכם).</li>
    <li><strong>תיבת מפרסם</strong> בסוף הכתבה ובצד שלה: שם העסק, כמה מילים עליו, כתובת, טלפון, וואטסאפ וכפתור לאתר שלכם.</li>
    <li><strong>קישורים לאתר שלכם</strong> בתיבת המפרסם ובכרטיס שליד הכתבה, ואם תרצו גם טלפון ווואטסאפ בלחיצה.</li>
    <li><strong>הופעה ברשימת הכתבות הממומנות</strong>, במפת האתר לגוגל, ובחיפוש של האתר.</li>
    <li><strong>עמוד מוכן למנועי חיפוש:</strong> כותרת ותיאור לגוגל, נתונים מובנים (Article) ותמונת שיתוף לרשתות.</li>
  </ul>

  <h3>חשוב לדעת על הקישור</h3>
  <p>הקישורים לאתר שלכם מסומנים <code dir="ltr">rel="sponsored"</code>, כמו שגוגל מבקש לסמן כל קישור שמשלמים עליו. כלומר, זה לא קישור <bdi dir="ltr" style="white-space:nowrap">do-follow</bdi> רגיל שנועד להעביר כוח קידום. הערך של הכתבה הוא בחשיפה לקהל שמחפש בדיוק את הנושא, ובאנשים שנכנסים מהכתבה לאתר שלכם או מתקשרים אליכם.</p>

  <h3>איך זה עובד</h3>
  <ol>
    <li><strong>פונים אלינו</strong> בטופס שבתחתית העמוד, ומספרים בכמה מילים על העסק ועל הנושא.</li>
    <li><strong>מסכמים נושא</strong> שיועיל לקוראים של האתר. כתבה שעוזרת לקורא עובדת טוב יותר מכתבה שרק מספרת על העסק.</li>
    <li><strong>שולחים טקסט, או שאנחנו כותבים.</strong> אפשר לשלוח כתבה מוכנה, ואפשר שנכתוב אותה בשבילכם לפי הפרטים שתעבירו.</li>
    <li><strong>עריכה ובדיקה.</strong> המערכת עוברת על הכתבה, ואתם מקבלים את הנוסח לאישור לפני הפרסום.</li>
    <li><strong>פרסום.</strong> בדרך כלל בתוך 5 ימי עבודה מהאישור הסופי של הנוסח. נשלח לכם קישור לכתבה.</li>
  </ol>

  <h3>הכללים שלנו</h3>
  <ul>
    <li>כל כתבה ממומנת <strong>מסומנת בבירור</strong> כתוכן ממומן, בראש הכתבה ובסופה.</li>
    <li>לא מפרסמים הבטחות לתוצאה, "מחיקת חובות מובטחת", הלוואות בתנאים פוגעניים או מידע לא נכון.</li>
    <li>עורכי דין: הכתבה צריכה לעמוד בכללי הפרסום של לשכת עורכי הדין. בלי סופרלטיבים, בלי הבטחות לתוצאה ובלי המלצות של לקוחות.</li>
    <li>אנחנו רשאים לא לפרסם תוכן שלא מתאים לקוראים שלנו.</li>
  </ul>

  <h3>מחיר</h3>
  <p>המחיר לפי בקשה. כתבו לנו מה אתם צריכים, ונחזור אליכם עם הצעה.</p>

  {sample && (
    <a class="card pr-sample" href={`${B}tochen-memuman/${sample.id}/`}>
      <span class="pr-pill">דוגמה</span>
      <b>{sample.data.title}</b>
      <span class="muted">כתבה ממומנת בשיתוף {sample.data.sponsor.name}. כך נראית כתבה ממומנת באתר.</span>
      <span class="pr-go">לצפייה בדוגמה ←</span>
    </a>
  )}

  <h2>2. מודעות</h2>
  <p>שטחי מודעות באתר, מסומנים כפרסומת ונפרדים מהתוכן.</p>

  <h2>3. עורכי דין</h2>
  <p>עורכי דין שעוסקים בחדלות פירעון, בהסדרי חובות או בהוצאה לפועל יכולים להופיע ב<a href={`${B}orchei-din/`}>רשימת עורכי הדין לפי עיר</a>. פרופיל בסיסי בחינם, וחבילות עם מיקום מקודם שמסומן ככזה. חבילת הפרימיום כוללת גם כתבה ממומנת אחת בשנה. הפרטים ב<a href={`${B}orchei-din/hitztarfut/`}>עמוד ההצטרפות</a>.</p>
  <ContactForm slot="after" kind="advertise" title="רוצים לפרסם כתבה ממומנת או מודעה? השאירו פרטים" fields={['name', 'phone', 'email', 'msg']} msgLabel="במה מדובר? (שם העסק, הנושא, האם יש לכם טקסט מוכן)" />
</Page>
<style>
.pr-sample{display:grid!important;gap:6px;margin:10px 0 8px;border-inline-start:5px solid var(--sun)}
.pr-sample b{font-size:1.15rem;line-height:1.4}
.pr-sample .muted{font-size:.95rem}
.pr-pill{justify-self:start;background:var(--sun);color:#1b1405;font-weight:700;font-size:.8rem;padding:3px 12px;border-radius:999px}
.pr-go{color:var(--teal);font-weight:700}
</style>
