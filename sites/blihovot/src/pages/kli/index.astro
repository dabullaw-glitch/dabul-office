---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { TOOLS, FORM_TOOLS } from '../../data/tools';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="מחשבונים, כלים ועוזרי בקשות לחובות: איחוד תיקים, צו תשלומים וחדלות פירעון" description="מחשבונים חינמיים למי שמתמודד עם חובות: איזה הליך מתאים לי, בית משפט או הוצאה לפועל, מחשבון איחוד תיקים, מחשבון סגירת חוב ומחשבון תקציב חודשי.">
  <div class="wrap" style="padding-block:28px 50px">
    <Breadcrumbs items={[{ label: 'מחשבונים וכלים' }]} />
    <h1>מחשבונים וכלים</h1>
    <p style="font-size:1.12rem;color:var(--ink-2);max-width:62ch">כלים קצרים שעוזרים להבין את המצב ולהחליט על הצעד הבא. החישובים נעשים אצלכם בדפדפן, ושום נתון לא נשלח לשום מקום.</p>
    <h2 style="margin-top:30px">עוזרים למילוי בקשות</h2>
    <p style="color:var(--ink-2);max-width:62ch">עונים על כמה שאלות, ומקבלים מה לכתוב בכל סעיף של הטופס הרשמי, רשימת מסמכים וקובץ PDF מסודר.</p>
    <div class="grid g2" style="margin-top:16px">
      {FORM_TOOLS.map((t) => <a class="card" href={`${B}kli/${t.id}/`}><span class="tag">עוזר בקשה</span><h3 style="font-size:1.25rem;margin:.5em 0 .3em">{t.title}</h3><p>{t.blurb}</p><span style="display:inline-block;margin-top:12px;font-weight:700;color:var(--teal)">{t.cta} ←</span></a>)}
    </div>
    <h2 style="margin-top:34px">מחשבונים</h2>
    <div class="grid g2" style="margin-top:16px">
      {TOOLS.map((t) => <a class="card" href={`${B}kli/${t.id}/`}><span class="tag">חינם</span><h2 style="font-size:1.3rem;margin:.5em 0 .3em">{t.title}</h2><p>{t.blurb}</p><span style="display:inline-block;margin-top:12px;font-weight:700;color:var(--teal)">{t.cta} ←</span></a>)}
    </div>
  </div>
</Base>
