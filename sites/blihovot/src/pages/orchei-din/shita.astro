---
import Portal from '../../layouts/Portal.astro';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const rows = [
  { n: 50, t: 'חוות דעת מאומתות', d: 'הממוצע של הדירוגים (עד 35 נקודות) וכמות חוות הדעת (עד 15 נקודות, מלא מ-10 חוות דעת ומעלה). נספרות רק חוות דעת שנבדקו: לפני הפרסום אנחנו מוודאים בטלפון שהכותב קיבל שירות מהמשרד.' },
  { n: 15, t: 'שנות רישיון', d: 'נקודה לכל שנה מאז קבלת הרישיון, עד 15 נקודות.' },
  { n: 15, t: 'שלמות הפרופיל', d: 'טלפון, מייל, אתר, כתובת, תיאור, שנת רישיון, תמונה, שפות, תחומים וערים. כל פרט מוסיף חלק שווה.' },
  { n: 10, t: 'מענה לפניות', d: 'החלק מהפניות דרך האתר שקיבלו מענה. עד שיש מספיק פניות, החלק הזה נשאר על אפס לכולם.' },
  { n: 10, t: 'הכרה מקצועית', d: 'הכרה ציבורית שאפשר לבדוק, כמו הכללה בדירוג שנתי בתחום. 5 נקודות לכל הכרה, עד 10.' },
];
const faq = [
  { q: 'האם עורך דין יכול לשלם כדי לקבל ציון גבוה יותר?', a: 'לא. חבילות בתשלום משנות רק את מקום ההצגה (תמיד עם התווית "מקודם") ואת מה שמופיע בפרופיל. הציון מחושב באותה שיטה לכולם.' },
  { q: 'למה לעורך דין חדש ברשימה יש ציון נמוך?', a: 'כי עוד אין לו חוות דעת מאומתות, ואולי הפרופיל שלו לא מלא. ציון נמוך לא אומר שהשירות לא טוב, רק שעוד אין מספיק מידע.' },
  { q: 'האם חוות דעת שליליות מתפרסמות?', a: 'כן, אחרי בדיקה שהן אמיתיות ושאין בהן פרטים אישיים, קללות או טענות שאינן על השירות.' },
  { q: 'מה עושים אם יש טעות בפרטים?', a: 'עורך הדין יכול לאשר שהפרופיל שלו ולעדכן אותו, או לבקש הסרה. כל אחד יכול לדווח על טעות דרך עמוד יצירת הקשר.' },
];
---
<Portal title="איך מחושב הציון של עורכי הדין" description="הציון ליד כל עורך דין הוא מספר בין 0 ל-100 שמחושב בשיטה פומבית: חוות דעת מאומתות, שנות רישיון, שלמות הפרופיל, מענה לפניות והכרה מקצועית." crumbs={[{ label: 'עורכי דין', href: 'orchei-din/' }, { label: 'איך מחושב הציון' }]} h1="איך מחושב הציון" lede="מספר בין 0 ל-100 ליד כל עורך דין ברשימה. הנה בדיוק ממה הוא מורכב." faq={faq}>
  <div class="prose">
    <p>הציון נועד לעזור להשוות בין עורכי דין לפי מידע שאפשר לבדוק. הוא לא ממליץ על עורך דין מסוים ולא מחליף שיחה איתו. כשיש מעט מידע על עורך דין, הציון שלו יהיה נמוך יותר, גם אם השירות שלו טוב.</p>
    <div class="panel" style="padding:6px 20px">
      <dl class="facts">
        {rows.map((r) => <div style="grid-template-columns:90px minmax(0,1fr)"><dt><b style="font:700 1.5rem/1 var(--ff-d);color:var(--teal)">{r.n}</b> נק׳</dt><dd><b>{r.t}</b><br /><span class="muted">{r.d}</span></dd></div>)}
      </dl>
    </div>
    <h2>מה לא משפיע על הציון</h2>
    <ul>
      <li><strong>תשלום.</strong> חבילה בתשלום לא משנה את הציון. מיקום מקודם מסומן תמיד במילה "מקודם", והוא נפרד מהציון.</li>
      <li>גודל המשרד או מספר עורכי הדין בו.</li>
      <li>דירוגים וביקורות מאתרים אחרים, שאין לנו דרך לבדוק.</li>
    </ul>
    <h2>הסדר ברשימות</h2>
    <p>בעמודי נושא (וגם נושא ועיר) מופיעים קודם עד שלושה עורכי דין מקודמים, עם תווית ברורה. אחריהם כל השאר, לפי הציון. בעמודי עיר ואזור הרשימה היא לפי הציון בלבד, בלי קידום בכלל.</p>
    <h2>מאיפה הפרטים</h2>
    <p>הפרטים הבסיסיים נאספו ממקורות ציבוריים, כמו האתרים של המשרדים עצמם, או נמסרו על ידי עורכי הדין. אנחנו לא מעתיקים ביקורות, תמונות או טקסטים מאתרים אחרים. עורך דין יכול <a href={`${B}orchei-din/hitztarfut/#claim`}>לאשר שהפרופיל שלו ולעדכן אותו</a> או <a href={`${B}orchei-din/hasara/`}>לבקש הסרה</a>.</p>
    <p><a href={`${B}orchei-din/`}>חזרה לרשימת עורכי הדין ←</a></p>
  </div>
</Portal>
