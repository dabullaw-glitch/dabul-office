---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import G from '../data/glossary.json';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sorted = [...G].sort((a, b) => a.t.localeCompare(b.t, 'he'));
const schema = [{ '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'מילון מונחי חובות וחדלות פירעון', inLanguage: 'he-IL', hasDefinedTerm: sorted.map((x) => ({ '@type': 'DefinedTerm', name: x.t, description: x.d, url: new URL(B + x.l, Astro.site).href })) }];
---
<Base title="מילון מונחים: חדלות פירעון, הוצאה לפועל וחובות" description="כל המונחים בשפה פשוטה: הפטר, צו לפתיחת הליכים, נאמן, קופת הנשייה, איחוד תיקים, חקירת יכולת, עיקול ועוד." schema={schema}>
  <div class="wrap" style="padding-block:28px 50px;max-width:860px">
    <Breadcrumbs items={[{ label: 'מילון מונחים' }]} />
    <h1>מילון מונחים</h1>
    <p style="font-size:1.1rem;color:var(--ink-2)">המילים שתשמעו בהוצאה לפועל ובהליך חדלות פירעון, בשפה פשוטה.</p>
    <dl class="gl">{sorted.map((x) => <div id={x.t.replace(/\s+/g, '-')}><dt>{x.t}</dt><dd>{x.d} <a href={B + x.l}>להסבר המלא</a></dd></div>)}</dl>
  </div>
</Base>
<style>.gl{margin:24px 0 0}.gl div{padding:16px 0;border-bottom:1px solid var(--line)}.gl dt{font:700 1.15rem/1.3 var(--ff-d)}.gl dd{margin:6px 0 0;color:var(--ink-2)}</style>
