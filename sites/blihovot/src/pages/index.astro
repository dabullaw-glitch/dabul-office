---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StagePath from '../components/StagePath.astro';
import GuideCard from '../components/GuideCard.astro';
import LeadForm from '../components/LeadForm.astro';
import HubIcon from '../components/HubIcon.astro';
import { SITE, HUBS, FACTS } from '../data/site';
import { TOOLS } from '../data/tools';
import videos from '../data/videos.json';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const guides = (await getCollection('guides')).filter((g) => !g.data.draft);
const byHub = (id: string) => guides.filter((g) => g.data.hub === id).length;
const starters = ['tzaadim-rishonim', 'hashvaat-maslulim', 'ma-ze-hadlut-piraon', 'ichud-tikim', 'hefter', 'hesder-im-noshim'].map((s) => guides.find((g) => g.id === s)).filter(Boolean);
const latest = [...guides].sort((a, b) => +b.data.updated - +a.data.updated).filter((g) => !starters.includes(g)).slice(0, 6);
const faq = [
  { q: 'מה זה חדלות פירעון?', a: 'הליך חוקי לאדם שלא מסוגל לשלם את החובות שלו. בזמן ההליך משלמים תשלום חודשי לפי היכולת, ובסופו אפשר לקבל הפטר: פטור מיתרת החובות. עד 2019 קראו לזה פשיטת רגל.' },
  { q: 'כמה זמן לוקח הליך חדלות פירעון?', a: `בדרך כלל כ-4 שנים: תקופת ביניים של כשנה, ואחריה צו לשיקום כלכלי של ${FACTS.rehabYears.label}. במקרים מסוימים התקופה קצרה יותר.` },
  { q: 'לאן מגישים בקשה לחדלות פירעון?', a: `תלוי בסכום. חובות מעל ${FACTS.threshold.label} (נכון ל-${FACTS.threshold.asOf}): לממונה על הליכי חדלות פירעון. חובות נמוכים יותר: לרשות האכיפה והגבייה (ההוצאה לפועל).` },
  { q: 'אילו חובות לא נמחקים בהפטר?', a: 'ככלל: קנסות ועיצומים, חובות שנוצרו ממרמה או מעבירות מסוימות, וחובות מזונות שנפסקו בפסק דין.' },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Base title={`${SITE.name}: ${SITE.tagline}`} description={SITE.description} schema={schema}>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-tx">
        <p class="eyebrow">חדלות פירעון · הוצאה לפועל · הסדרי חוב</p>
        <h1>יש דרך החוצה מהחובות. <span>בואו נמצא את שלכם.</span></h1>
        <p class="lede">כל מה שצריך לדעת, בשפה פשוטה: מה מותר לנושים ומה לא, מתי מתאים איחוד תיקים, איך עובד הליך חדלות פירעון, ומה קורה ביום שאחרי. לפי החוק ומקורות רשמיים, מעודכן ל-2026.</p>
        <div class="hero-cta">
          <a class="btn btn-sun" href={`${B}kli/eize-halich/`}>איזה הליך מתאים לי? (דקה אחת)</a>
          <a class="btn btn-line" href={`${B}madrich/ma-ze-hadlut-piraon/`}>המדריך המלא</a>
        </div>
        <form class="hsearch" action={`${B}chipus/`} role="search">
          <label for="hq" class="sr">חיפוש באתר</label>
          <input id="hq" name="q" type="search" placeholder="למשל: עיקול משכורת, איחוד תיקים, הפטר..." />
          <button class="btn btn-teal" type="submit">חיפוש</button>
        </form>
      </div>
      <figure class="hero-card card" aria-label="הדרך בהליך חדלות פירעון">
        <figcaption><b>הדרך, בקצרה</b><span>הליך חדלות פירעון של יחיד, לפי החוק</span></figcaption>
        <ol class="mini">
          <li><span>1</span><div><b>צו לפתיחת הליכים</b><small>ההליכים נגדכם מוקפאים</small></div></li>
          <li><span>2</span><div><b>תקופת ביניים</b><small>{FACTS.interimMonths.label}</small></div></li>
          <li><span>3</span><div><b>צו לשיקום כלכלי</b><small>{FACTS.rehabYears.label} של תוכנית תשלומים</small></div></li>
          <li class="end"><span>✓</span><div><b>הפטר</b><small>פטור מיתרת החובות</small></div></li>
        </ol>
        <p class="fact"><b class="tnum">{FACTS.threshold.label}</b> הסף שקובע לאן מגישים (נכון ל-{FACTS.threshold.asOf})</p>
      </figure>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><h2>מאיפה מתחילים?</h2><a href={`${B}madrich/`}>כל המדריכים ←</a></div>
      <div class="grid g3">{starters.map((g) => <GuideCard g={g} />)}</div>
    </div>
  </section>

  <section class="sec sec-sand">
    <div class="wrap">
      <div class="sec-head"><h2>כלים שעושים לכם סדר</h2><a href={`${B}kli/`}>כל הכלים ←</a></div>
      <div class="grid g3 tools">
        {TOOLS.map((t, i) => <a class={`card tool ${i === 0 ? 'big' : ''}`} href={`${B}kli/${t.id}/`}><span class="tag">{i === 0 ? 'הכי פופולרי' : 'מחשבון'}</span><h3>{t.title}</h3><p>{t.blurb}</p><span class="go">{t.cta} ←</span></a>)}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><h2>איך עובד הליך חדלות פירעון</h2><a href={`${B}madrich/ma-ze-hadlut-piraon/`}>הסבר מלא ←</a></div>
      <StagePath />
    </div>
  </section>

  <section class="sec sec-sand">
    <div class="wrap">
      <div class="sec-head"><h2>לפי נושא</h2></div>
      <div class="grid g4">
        {HUBS.map((h) => <a class="card hub" href={`${B}nose/${h.id}/`}><HubIcon name={h.icon} /><h3>{h.title}</h3><p>{h.blurb}</p><span class="muted cnt">{byHub(h.id)} מדריכים</span></a>)}
        <a class="card hub" href={`${B}milon/`}><HubIcon name="file" /><h3>מילון מונחים</h3><p>הפטר, נאמן, קופת הנשייה, חקירת יכולת: כל המילים בשפה פשוטה.</p><span class="muted cnt">למילון ←</span></a>
        <a class="card hub kurs" href={`${B}kurs/`}><HubIcon name="cap" /><h3>קורס חינמי: יוצאים מחובות</h3><p>שיעורים קצרים עם סרטון ושאלות תרגול, מהצעד הראשון ועד הפטר.</p><span class="cnt">להתחיל ללמוד ←</span></a>
      </div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-head"><h2>עודכנו לאחרונה</h2></div>
        <div class="grid g3">{latest.map((g) => <GuideCard g={g} />)}</div>
      </div>
    </section>
  )}

  <section class="sec">
    <div class="wrap two">
      <div>
        <h2 style="margin-top:0">שאלות שכולם שואלים</h2>
        <div class="faq">{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
        <p class="note" style="margin-top:18px">המידע באתר כללי ואינו ייעוץ משפטי. <a href={`${B}odot/`}>איך אנחנו כותבים ובודקים את המידע</a>.</p>
      </div>
      <LeadForm source="home" />
    </div>
  </section>
</Base>
<style>
.hero{background:radial-gradient(1200px 500px at 85% -10%,color-mix(in srgb,var(--sun) 22%,transparent),transparent 60%),linear-gradient(180deg,var(--sand),var(--paper));border-bottom:1px solid var(--line)}
.hero-in{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.9fr);gap:48px;align-items:center;padding-block:56px 64px}
.hero h1{font-size:clamp(2.1rem,4.6vw,3.4rem);margin:.25em 0 .4em}
.hero h1 span{color:var(--teal);display:block}
.lede{font-size:1.15rem;color:var(--ink-2);max-width:56ch}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin:22px 0}
.hsearch{display:flex;gap:8px;max-width:520px}
.hsearch input{flex:1;min-width:0;font:inherit;padding:12px 16px;border-radius:999px;border:1.5px solid var(--line);background:var(--card);color:var(--ink)}
.hsearch input:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px var(--teal-soft)}
.hero-card{padding:24px;box-shadow:var(--shadow)}
.hero-card figcaption{display:grid;margin-bottom:16px}.hero-card figcaption span{color:var(--muted);font-size:.9rem}
.mini{list-style:none;margin:0;padding:0;display:grid;gap:0;position:relative}
.mini li{display:flex;gap:14px;align-items:flex-start;padding:10px 0;position:relative}
.mini li:not(:last-child):after{content:"";position:absolute;inset-inline-start:17px;top:46px;bottom:-10px;border-inline-start:2px dotted var(--teal)}
.mini span{width:36px;height:36px;flex:none;border-radius:50%;display:grid;place-items:center;border:2px solid var(--teal);color:var(--teal);font-weight:700;background:var(--card)}
.mini .end span{background:var(--sun);border-color:var(--sun);color:#1b1405}
.mini b{display:block;line-height:1.3}.mini small{color:var(--muted);font-size:.9rem}
.fact{margin:14px 0 0;padding-top:14px;border-top:1px solid var(--line);font-size:.92rem;color:var(--muted)}
.fact b{display:block;font:700 1.6rem/1.2 var(--ff-d);color:var(--ink)}
@media (max-width:900px){.hero-in{grid-template-columns:1fr;gap:28px;padding-block:36px 44px}}
.tool .go,.hub .cnt{display:inline-block;margin-top:12px;font-weight:700;color:var(--teal);font-size:.95rem}
.tool.big{border-inline-start:5px solid var(--sun)}
@media (min-width:900px){.tool.big{grid-column:span 2}}
.hub h3{margin-top:12px}
.hub.kurs{background:var(--ink);border-color:var(--ink)}.hub.kurs h3{color:#fff}.hub.kurs p{color:#c9d3e0}.hub.kurs .cnt{color:var(--sun)}
.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:start}
@media (max-width:900px){.two{grid-template-columns:1fr}}
.faq details{border-bottom:1px solid var(--line);padding:14px 0}
.faq summary{cursor:pointer;font-weight:700;font-size:1.05rem;list-style:none;display:flex;justify-content:space-between;gap:12px}
.faq summary::-webkit-details-marker{display:none}
.faq summary:after{content:"+";color:var(--teal);font-size:1.4rem;line-height:1}
.faq details[open] summary:after{content:"−"}
.faq p{margin:8px 0 0;color:var(--ink-2)}
</style>
