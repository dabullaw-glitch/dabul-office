---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE } from '../../data/site';
import { COURSES } from '../../data/courses';
export function getStaticPaths() { return COURSES.filter((c) => c.id !== 'yotzim').map((c) => ({ params: { course: c.id }, props: { c } })); }
const { c } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const L = (await getCollection('lessons')).filter((l) => l.data.course === c.id).sort((a, b) => a.data.n - b.data.n);
const total = L.reduce((s, l) => s + l.data.minutes, 0);
const others = COURSES.filter((x) => x.id !== c.id);
const schema = [{ '@context': 'https://schema.org', '@type': 'Course', name: c.title, description: c.blurb, inLanguage: 'he-IL', isAccessibleForFree: true, provider: { '@type': 'Organization', name: SITE.name, url: new URL(B, Astro.site).href },
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: `PT${total}M` }, offers: { '@type': 'Offer', price: '0', priceCurrency: 'ILS', category: 'Free' },
  syllabusSections: L.map((l) => ({ '@type': 'Syllabus', name: l.data.title, description: l.data.description, timeRequired: `PT${l.data.minutes}M` })) }];
---
<Base title={`קורס חינמי: ${c.title} (${L.length} שיעורים)`} description={`${c.blurb} קורס חינמי וקצר, כ-${total} דקות, עם שאלות תרגול בכל שיעור.`} schema={schema}>
  <section class="kh">
    <div class="wrap">
      <Breadcrumbs items={[{ href: 'kurs/', label: 'קורסים' }, { label: c.short }]} />
      <p class="eyebrow">קורס חינמי · {L.length} שיעורים · כ-{total} דקות</p>
      <h1>{c.title}</h1>
      <p class="lede">{c.blurb} בלי הרשמה ובלי תשלום.</p>
      {L[0] && <a class="btn btn-sun" href={`${B}kurs/${L[0].id}/`}>מתחילים בשיעור הראשון</a>}
    </div>
  </section>
  <div class="wrap" style="padding-block:34px 50px">
    <ol class="les">
      {L.map((l) => <li><a class="card" href={`${B}kurs/${l.id}/`}><span class="n">{l.data.n}</span><div><h2>{l.data.title.replace(/^שיעור \d+: /, '')}</h2><p>{l.data.description}</p><small>{l.data.minutes} דקות{l.data.quiz.length ? ` · ${l.data.quiz.length} שאלות תרגול` : ''}</small></div><span class="done" data-les={l.id} hidden>✓ נקרא</span></a></li>)}
    </ol>
    <h2 style="margin-top:44px">קורסים נוספים</h2>
    <ul class="oc">{others.map((o) => <li><a href={`${B}kurs/${o.id === 'yotzim' ? '' : o.id + '/'}`}>{o.title}</a></li>)}</ul>
    <div style="margin-top:40px"><LeadForm source={`kurs:${c.id}`} /></div>
  </div>
</Base>
<style>
.kh{background:var(--ink);color:#e8edf3;padding-block:30px 46px}.kh h1{color:#fff}.kh .lede{font-size:1.15rem;max-width:60ch;color:#c9d3e0}.kh :global(.bc a),.kh :global(.bc ol){color:#9fb0c5}.kh .eyebrow{color:var(--sun)}
.les{list-style:none;padding:0;margin:0;display:grid;gap:14px}
.les a{display:flex;gap:18px;align-items:flex-start}
.les .n{flex:none;width:46px;height:46px;border-radius:50%;background:var(--teal-soft);color:var(--teal-2);display:grid;place-items:center;font:700 1.25rem/1 var(--ff-d)}
.les h2{font-size:1.2rem;margin:0 0 .3em;font-family:var(--ff)}.les p{margin:0}.les small{color:var(--muted)}.les div{flex:1;min-width:0}
.done{color:var(--teal);font-weight:700;white-space:nowrap}
.oc{display:flex;flex-wrap:wrap;gap:10px 22px;padding:0;list-style:none}
</style>
<script is:inline>try { const d = JSON.parse(localStorage.getItem('bh-kurs') || '{}'); document.querySelectorAll('[data-les]').forEach((e) => { if (d[e.dataset.les]) e.hidden = false; }); } catch (e) {}</script>
